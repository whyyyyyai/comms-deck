#!/usr/bin/env python3
"""pricefeed: SOL/XRP spot and perpetual futures prices, and the seats' company
stocks (claude: ANT). No AI.

Y, 2026-11-28 (t121/t122): SOL at the core, XRP in warp, and the ticker
should "flicker in according to price action ... relative distribution
function of price action". Every 30 s this reads Coinbase's public spot
price for each symbol (no account, nothing sent but the request) and
keeps two hours of samples in ~/.local/state/warp-core/prices.json, which
the warp core reads. A failed fetch keeps the last good samples.

    pricefeed            run forever (warp-core-prices.service)
    pricefeed --once     one fetch
    pricefeed --self-test

Written by: claude
"""
import json
import os
import sys
import time
import urllib.request
from pathlib import Path

SPOT_SYMBOLS = ("SOL", "XRP")
SPOT_URL = "https://api.coinbase.com/v2/prices/{}-USD/spot"
FUTURES = {
    "SOL-PERP": ("SOL_USDC-PERPETUAL", "SOL", "USDC"),
    "XRP-PERP": ("XRP_USDC-PERPETUAL", "XRP", "USDC"),
}
# Each seat's company stock (Y, 2026-11-28: "Planets should flicker the
# stock ticker of their relevant agent"). Only listed companies: the other
# seats' makers (xAI, OpenAI, Mistral, Cognition, Proton) have no ticker.
SEAT_STOCKS = {"claude": "ANT", "gravity": "GOOGL"}
STOCK_URL = "https://query1.finance.yahoo.com/v8/finance/chart/{}?interval=1d&range=5d"
DERIBIT_URL = "https://www.deribit.com/api/v2/public/ticker?instrument_name={}"
OUT = Path(os.environ.get("PRICEFEED_OUT", Path.home() / ".local/state/warp-core/prices.json"))
EVERY_S = 30
KEEP_S = 2 * 3600


def request_json(url, timeout=10):
    req = urllib.request.Request(url, headers={"User-Agent": "warp-core-pricefeed/1.0"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.load(r)


def fetch_spot(symbol, timeout=10):
    return float(request_json(SPOT_URL.format(symbol), timeout)["data"]["amount"])


def fetch_future(instrument, timeout=10):
    """Return Deribit's public perpetual mark, in the instrument's quote currency."""
    result = request_json(DERIBIT_URL.format(instrument), timeout)["result"]
    return float(result["mark_price"])


def fetch_stock(symbol, timeout=10):
    """The latest price and the session close before it, from daily bars."""
    result = request_json(STOCK_URL.format(symbol), timeout)["chart"]["result"][0]
    return stock_quote(result)


def stock_quote(result):
    """(price, previous close) from a chart result. Pure: tested."""
    closes = [c for c in result["indicators"]["quote"][0]["close"] if c is not None]
    price = float(result["meta"].get("regularMarketPrice") or closes[-1])
    if len(closes) < 2:
        raise ValueError("fewer than two closes")
    return price, float(closes[-2])


def merge_stock(doc, seat, symbol, price, prev_close, now):
    """One stock sample for a seat's planet: up or down on the session."""
    doc.setdefault("stocks", {})[seat] = {
        "symbol": symbol, "price": price, "prev_close": prev_close,
        "up": price >= prev_close, "time": round(now, 1),
    }
    return doc


def merge(doc, symbol, price, now, *, source=None, quote=None, instrument=None):
    """Add one sample, dropping ones older than KEEP_S. Pure: tested."""
    hist = [s for s in (doc.get(symbol) or {}).get("history", []) if now - s[0] <= KEEP_S]
    hist.append([round(now, 1), price])
    entry = {"price": price, "history": hist}
    if source is not None:
        entry["source"] = source
    if quote is not None:
        entry["quote"] = quote
    if instrument is not None:
        entry["instrument"] = instrument
    doc[symbol] = entry
    doc["time"] = now
    return doc


def once():
    try:
        doc = json.loads(OUT.read_text())
    except (OSError, ValueError):
        doc = {}
    now = time.time()
    for symbol in SPOT_SYMBOLS:
        try:
            doc = merge(doc, symbol, fetch_spot(symbol), now,
                        source="coinbase", quote="USD", instrument=f"{symbol}-USD")
        except (OSError, ValueError, KeyError) as error:
            print(time.strftime("%H:%M:%S"), f"{symbol}: {error}", flush=True)
    for key, (instrument, _base, quote) in FUTURES.items():
        try:
            doc = merge(doc, key, fetch_future(instrument), now,
                        source="deribit", quote=quote, instrument=instrument)
        except (OSError, ValueError, KeyError) as error:
            print(time.strftime("%H:%M:%S"), f"{key}: {error}", flush=True)
    for seat, symbol in SEAT_STOCKS.items():
        try:
            price, prev_close = fetch_stock(symbol)
            doc = merge_stock(doc, seat, symbol, price, prev_close, now)
        except (OSError, ValueError, KeyError, IndexError, TypeError) as error:
            print(time.strftime("%H:%M:%S"), f"{symbol}: {error}", flush=True)
    OUT.parent.mkdir(parents=True, exist_ok=True)
    tmp = OUT.with_suffix(".tmp")
    tmp.write_text(json.dumps(doc))
    tmp.replace(OUT)


def self_test():
    doc = {}
    for i, p in enumerate((70.0, 70.1, 69.9)):
        doc = merge(doc, "SOL", p, 1000.0 + 30 * i)
    doc = merge(doc, "SOL", 71.0, 1000.0 + KEEP_S + 45)
    checks = [
        ("samples kept in order, the price is the latest", doc["SOL"]["price"] == 71.0 and doc["SOL"]["history"][-1][1] == 71.0),
        ("samples older than two hours are dropped", [s[1] for s in doc["SOL"]["history"]] == [69.9, 71.0]),
        ("the other symbol is untouched", "XRP" not in doc),
    ]
    bars = {"meta": {"regularMarketPrice": 91.88},
            "indicators": {"quote": [{"close": [87.64, 81.91, None, 82.79, 91.88]}]}}
    price, prev = stock_quote(bars)
    doc = merge_stock(doc, "claude", "ANT", price, prev, 2000.0)
    checks += [
        ("a stock compares with the session before", (price, prev) == (91.88, 82.79)),
        ("a stock up on the session is up", doc["stocks"]["claude"]["up"] is True),
        ("a stock down is not up", merge_stock({}, "claude", "ANT", 80.0, 82.79, 1.0)["stocks"]["claude"]["up"] is False),
    ]
    bad = 0
    for name, ok in checks:
        print(("ok  " if ok else "FAIL") + " " + name)
        bad += not ok
    print("all passed" if not bad else f"{bad} failed")
    return bad == 0


if __name__ == "__main__":
    if "--self-test" in sys.argv:
        sys.exit(0 if self_test() else 1)
    if "--once" in sys.argv:
        once()
        sys.exit(0)
    while True:
        once()
        time.sleep(EVERY_S)
