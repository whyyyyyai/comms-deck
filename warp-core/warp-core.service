# warp-core as a user service: kept alive, and kept ahead of the crowd.
#
# Installed by warp-core/install.sh. Start with
#   systemctl --user enable --now warp-core
# Whatever ends it (a crash, a closed window, a stray key) it comes back
# after 5 s (Y, 2026-11-27: survival first; at 04:22 a clean exit left it
# down because this said on-failure). To stop it on purpose:
#   systemctl --user stop warp-core
# At most 3 starts in 15 minutes, 20 s apart, then it stays down and says so
# in `systemctl --user status warp-core`. Every start opens a GPU window, and
# restarts are what crashed the GPU on 2026-11-27 (02:53-03:02, and 05:19-05:31:
# a fault during a restart, then 18 more restarts until the iMac rebooted).
# gpu-ok.sh refuses a start after a GPU timeout or crash this boot.
#
# Written by: claude

[Unit]
Description=warp-core: the comms-deck on the GPU
After=graphical-session.target comms-deck.service
PartOf=graphical-session.target
StartLimitIntervalSec=900
StartLimitBurst=3

[Service]
ExecStartPre=%h/.local/lib/warp-core/gpu-ok.sh
ExecStart=%h/.local/lib/warp-core/warp-core
Environment=WARP_CORE_MODS=%h/.config/warp-core/mods
Restart=always
RestartSec=20
# Ahead of everything else in the session for CPU and disk, and its memory
# is the last the kernel reclaims (the iMac runs with ~1 GB free). No
# MemoryMax on purpose: a cap would make it the first thing killed.
CPUWeight=400
IOWeight=400
MemoryLow=256M
TimeoutStopSec=10

[Install]
WantedBy=graphical-session.target
