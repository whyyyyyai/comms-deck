# -----------------------------------------------------------------------------
# SECTION 8b: desktop actions - "@deck <action>" in any note
# -----------------------------------------------------------------------------
#
# Any seat (an app seat like alice included) can ask comms-deck itself to do
# something on this desktop by writing a line that starts "@deck", e.g.
#   @deck scratchpad          @deck workspace 3        @deck layout
#   @deck open https://...    @deck youtube lofi beats @deck help
# The service runs a FIXED list of actions with the desktop session's own
# environment, so it works whether or not the asker can run commands, and
# without any LLM. Nothing else is run: no shell, no arbitrary programs.
# That matters because app seats read the web, and a page must not be able
# to make one of them run commands here. A request that isn't on the list is
# handed to a free agent (claude, grok, gravity) as a task note only when the
# owner or one of those agents asked; from anyone else (an app seat) it is
# refused with "not on the list", so a web page can't give an agent orders
# through an app seat's reply (found by Grok). The answer keeps the note's
# private flag. Every action is logged, answered with a note "from deck",
# and shown on the chat screen.

DECK_LINE = re.compile(r"^\s*@deck\b[ \t]*(.*)$", re.IGNORECASE | re.MULTILINE)
ACTION_RATE = 10  # at most this many actions a minute, from everyone together
HANDOFF_FROM = ("owner", "claude", "grok", "gravity")  # who may pass an unlisted request to an agent


def hypr_dispatch(expr):
    """Run one Hyprland dispatcher (Lua form). Raise if Hyprland refuses."""
    result = subprocess.run(["hyprctl", "dispatch", expr], capture_output=True, text=True, timeout=5)
    if result.returncode or result.stdout.strip() != "ok":
        raise RuntimeError((result.stdout or result.stderr).strip() or "hyprctl failed")


def launch(*cmd):
    """Start a program detached from the service, so it outlives it.

    Returns "" when it started, or "would " on a dry run, to put before the answer."""
    if setting("DRY_ACTIONS"):
        log(f"(dry run) would start: {' '.join(cmd)}")
        return "would "
    subprocess.Popen(cmd, start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return ""


def act_scratchpad(arg):
    if setting("DRY_ACTIONS"):
        return "would toggle the scratchpad"
    hypr_dispatch('hl.dsp.workspace.toggle_special("magic")')
    return "toggled the scratchpad"


def act_workspace(arg):
    if not re.fullmatch(r"(10|[1-9])", arg.strip()):
        raise ValueError("give a workspace number from 1 to 10")
    if setting("DRY_ACTIONS"):
        return f"would switch to workspace {arg.strip()}"
    hypr_dispatch(f"hl.dsp.focus({{ workspace = {int(arg)} }})")
    return f"switched to workspace {int(arg)}"


def act_open(arg):
    url = arg.strip()
    if not re.fullmatch(r"https://[^\s\"'<>]+", url) or len(url) > 2000:
        raise ValueError("only a single https:// link can be opened")
    return launch("firefox", "--new-tab", url) + f"open {url[:80]} in Firefox"


def act_youtube(arg):
    query = re.sub(r"\s+", " ", arg).strip()
    if not query or len(query) > 200:
        raise ValueError("give a YouTube search of up to 200 characters")
    import urllib.parse
    return (launch("firefox", "--new-tab", "https://www.youtube.com/results?search_query=" + urllib.parse.quote_plus(query))
            + f"open a YouTube search for {query[:60]!r} in Firefox")


def act_layout(arg):
    return launch(str(HOME / ".local/bin/scratchpad-layout")) + "arrange the scratchpad"


def act_chat(arg):
    return launch(str(HOME / ".local/bin/comms-deck-chat")) + "open the chat screen"


ACTIONS = {
    "scratchpad": (act_scratchpad, "show or hide the scratchpad"),
    "workspace": (act_workspace, "switch to workspace N (1-10)"),
    "open": (act_open, "open an https:// link in Firefox"),
    "youtube": (act_youtube, "open a YouTube search in Firefox"),
    "layout": (act_layout, "arrange the agents on the scratchpad"),
    "chat": (act_chat, "open the comms-deck chat screen"),
}


def queue_actions(record):
    """Queue every '@deck ...' line in a note for the service to carry out."""
    if record.get("kind") != "message" or record.get("from") == "deck":
        return
    for request in DECK_LINE.findall(record.get("text", "")):
        write_json(DATA / "queue/actions" / f"{new_id()}.json",
                   {"from": record["from"], "request": request.strip()[:500], "time": time.time(),
                    "private": bool(record.get("private"))})


def free_agent():
    """The agent to hand a task to: the most available, as ACTIVITY ranks them."""
    return most_available()


def run_action(asker, request, private=False):
    """Carry out one request. Returns the text of the answer to `asker`."""
    words = request.split(None, 1)
    name, arg = (words[0].lower() if words else ""), (words[1] if len(words) > 1 else "")
    if name in ("", "help"):
        return "comms-deck can do: " + "; ".join(f"@deck {n} ({d})" for n, (_, d) in ACTIONS.items())
    if name in ACTIONS:
        try:
            done = ACTIONS[name][0](arg)
        except (ValueError, RuntimeError, OSError, subprocess.SubprocessError) as error:
            log(f"deck: {asker} asked for {name}: refused or failed: {error}")
            return f"couldn't do '{name}': {error}"
        log(f"deck: {asker} asked for {name}: {done}")
        return f"done: {done}"
    if asker not in HANDOFF_FROM:
        log(f"deck: {asker} asked for something not on the list; refused")
        return f"'{name}' is not on the list, so I did nothing. Try @deck help."
    agent = free_agent()
    send("deck", agent, f"Task from {asker}, asked of comms-deck: {request}\n\n"
                        f"It isn't one of comms-deck's own actions, so it's yours. Do it on this "
                        f"machine if it's appropriate and your rules allow it, then tell {asker} "
                        f"the result with send_message"
                        + (", with private set: this request was private." if private else "."),
                        private=private)
    log(f"deck: {asker} asked for something not on the list; handed to {agent}")
    return f"that isn't one of my actions, so I've passed it to {agent}"


def do_actions():
    """Carry out queued '@deck' requests, oldest first, within the rate limit."""
    queue = DATA / "queue/actions"
    if not queue.is_dir():
        return
    recent = [t for t in getattr(do_actions, "recent", []) if time.time() - t < 60]
    for path in sorted(queue.glob("*.json")):
        if len(recent) >= ACTION_RATE:
            break
        job = read_json(path)
        path.unlink(missing_ok=True)
        if not job:
            continue
        recent.append(time.time())
        private = bool(job.get("private"))
        answer = run_action(job["from"], job["request"], private)
        if job["from"] in SEATS:
            send("deck", job["from"], answer, quiet=job["from"] in AGENTS, private=private)
    do_actions.recent = recent


LIVE_BRANCH = "test"   # the live tree (~/comms-deck) runs this branch; nothing else
LIVE_GUARD_EVERY = 10  # seconds between checks


def live_tree_verdict(branch, dirty, pushed):
    """What to do about the live tree: "ok", "restore" or "alert".

    On 2026-11-26 an agent checked out its own branch in ~/comms-deck twice,
    and every service ran unreviewed code until someone noticed. The tree
    goes back on LIVE_BRANCH by itself only when nothing can be lost: no
    uncommitted change to a tracked file, and the commit is on a remote
    branch. Otherwise STOX and the crew are told, and nothing is touched.
    """
    if branch == LIVE_BRANCH:
        return "ok"
    return "restore" if (not dirty and pushed) else "alert"


def guard_live_tree(state):
    """Keep the live tree on LIVE_BRANCH (see live_tree_verdict). `state`
    remembers what was last reported, so one slip makes one note."""
    tree = PROGRAM.parent
    if tree != HOME / "comms-deck" or not (tree / ".git").exists():
        return  # a worktree or a copy: not the live tree

    def git(*args):
        return subprocess.run(["git", "-C", str(tree), *args], capture_output=True,
                              text=True, timeout=20)

    branch = git("rev-parse", "--abbrev-ref", "HEAD").stdout.strip()
    if not branch or branch == LIVE_BRANCH:
        state.pop("reported", None)
        return
    head = git("rev-parse", "--short", "HEAD").stdout.strip()
    dirty = bool(git("status", "--porcelain", "--untracked-files=no").stdout.strip())
    pushed = bool(git("branch", "-r", "--contains", "HEAD").stdout.strip())
    verdict = live_tree_verdict(branch, dirty, pushed)
    if verdict == "restore":
        r = git("checkout", "-q", LIVE_BRANCH)
        if r.returncode == 0:
            log(f"the live tree was on {branch} ({head}); put it back on {LIVE_BRANCH}")
            text = (f"The live comms-deck (~/comms-deck) was switched to {branch} ({head}), so "
                    f"every service was running unreviewed code. Its work is safe on GitHub, so "
                    f"I've put the live tree back on {LIVE_BRANCH}. Agents: work in a git "
                    f"worktree, never in ~/comms-deck.")
            send("comms-deck", "owner", text)
            send("comms-deck", "all", text, quiet=True)
            state.pop("reported", None)
            return
        verdict = "alert"
    key = (branch, head, dirty, pushed)
    if state.get("reported") == key:
        return
    state["reported"] = key
    why = ("it has uncommitted changes" if dirty else "its commit isn't pushed anywhere")
    log(f"the live tree is on {branch} ({head}), not {LIVE_BRANCH}; {why}, so left as it is")
    text = (f"The live comms-deck (~/comms-deck) is on {branch} ({head}), not {LIVE_BRANCH}, so "
            f"every service is running unreviewed code. I haven't switched it back because {why}. "
            f"Whoever did this: commit and push your work, move it to a worktree, then put "
            f"~/comms-deck back on {LIVE_BRANCH}.")
    send("comms-deck", "owner", text)
    send("comms-deck", "all", text, quiet=True)


# The "bots help bots come online" pass (the owner, 2026-11-27): once a seat
# can read and answer notes, it gets one note naming the seats that are
# down, so it can spend a turn helping them back. The service watches the
# roster every WELCOME_CHECK seconds; a seat already online when the service
# started isn't greeted, and a seat is greeted at most once per
# WELCOME_EVERY.

# States that mean a seat can take a note and answer it: a live agent
# process, or an app seat whose connector is up (a draft in its box still
# counts - its own tools answer notes even while the deck's are held).
ONLINE_STATES = {"idle", "busy", "connected", "draft in box"}
WELCOME_EVERY = int(setting("WELCOME_EVERY", "21600"))  # seconds between greetings
WELCOME_CHECK = 15                                     # seconds between passes


def seat_live_state(seat):
    """The seat's current state, or None for the owner."""
    if seat in AGENTS:
        return load_seat(seat).get("state")
    if seat in APP_SEATS:
        return app_seat_state(seat)
    return None


def welcome_pass(seen, greeted, now_ts=None):
    """One pass of the online-watch: greet the seats that just came online.

    `seen` maps seat -> was-online as of the last pass; `greeted` maps seat
    -> when it was last told who's down. The first pass only fills `seen`,
    so a service restart doesn't re-greet the whole roster.
    """
    now_ts = time.time() if now_ts is None else now_ts
    states = {seat: seat_live_state(seat) for seat in tuple(AGENTS) + APP_SEATS}
    was_online = dict(seen)
    first = not seen
    online = {seat: state in ONLINE_STATES and not seat_spent(seat)
              for seat, state in states.items()}
    seen.clear()
    seen.update(online)
    if first:
        return
    # Down and worth mentioning: not online, not spent (nobody can hurry a
    # limit reset), and not remote (nothing on this desktop reaches it).
    down = [seat for seat, state in states.items()
            if not online[seat] and not seat_spent(seat)
            and APP_PROCESS.get(seat) != "remote"]
    if not down:
        return
    who = ", ".join(f"{shown_name(seat)} ({states[seat]})" for seat in down)
    for seat, is_online in online.items():
        # Only a seat that was down last pass and can answer now: one that
        # was already online at the seed pass never "came online" at all.
        if not is_online or was_online.get(seat):
            continue
        last = greeted.get(seat)
        if last is not None and now_ts - last < WELCOME_EVERY:
            continue
        greeted[seat] = now_ts
        send("deck", seat,
             f"You're online and can answer notes. These seats are down: {who}. "
             "If you can help bring them back - reopen their window or app - do it, "
             "then send the deck a note saying what you tried.")
        log(f"welcomed {seat} online; down: {', '.join(down)}")


def serve():
    """Run forever: wake agents, drive Grok Bot seats, refresh usage, copy records, mirror to Discord."""
    log(f"comms-deck serving on {MACHINE}; data in {DATA}")
    threading.Thread(target=otel_serve, daemon=True).start()
    last_sync, discord_wait_until, last_usage = 0.0, 0.0, 0.0
    notify_pos = 0
    live_guard, last_live_check = {}, 0.0
    welcome_seen, welcome_greeted, last_welcome = {}, {}, 0.0
    while True:
        if time.time() - last_live_check >= LIVE_GUARD_EVERY:
            last_live_check = time.time()
            try:
                guard_live_tree(live_guard)
            except Exception as error:  # the guard must never stop the service
                log(f"live tree check failed: {error}")
        if fresh_code():
            log("the program changed on disk; restarting the service on the new code")
            run_fresh()
        try:
            notify_pos = refresh_notifications(notify_pos)
        except Exception as error:  # the bar feed is a nicety; never stop the service for it
            log(f"couldn't mirror notifications: {error}")
        for seat in AGENTS:
            try:
                try_wake(seat)
            except Exception as error:  # one bad seat must not stop the service
                log(f"wake check for {seat} failed: {error}")
        try:
            try_app_seats()
        except Exception as error:
            log(f"app seat check failed: {type(error).__name__}")
        try:
            do_actions()
        except Exception as error:  # an action must never stop the service
            log(f"desktop actions failed: {error}")
        if time.time() - last_welcome >= WELCOME_CHECK:
            last_welcome = time.time()
            try:
                welcome_pass(welcome_seen, welcome_greeted)
            except Exception as error:  # the welcome pass must never stop the service
                log(f"welcome pass failed: {error}")
        if time.time() - last_usage >= 30:
            last_usage = time.time()
            try:
                refresh_grok_usage()
            except Exception as error:  # usage is a nicety; never stop the service for it
                log(f"couldn't read Grok's usage: {error}")
            try:
                refresh_devin_usage()
            except Exception as error:
                log(f"couldn't read Devin's usage: {error}")
            try:
                refresh_vibe_usage()
            except Exception as error:  # the same: never stop the service for it
                log(f"couldn't read Vibe's usage: {error}")
            try:
                ledger_sweep()
                ledger_mirror()
            except Exception as error:  # the ledger must never stop the service
                log(f"cost ledger pass failed: {error}")
            balancer = load_balancer()
            if balancer:
                try:
                    balancer.refresh_tasks()  # keep every task with someone who can do it
                except Exception as error:
                    log(f"load-balancer pass failed: {error}")
            try:
                refresh_screen_limits()
            except Exception as error:  # never stop the service for it
                log(f"couldn't read a usage-limit screen: {error}")
        if time.time() - last_sync >= SYNC_EVERY:
            last_sync = time.time()
            sync_records()
            try:
                import_remote()
            except Exception as error:  # a remote seat must not stop the service
                log(f"importing remote seats' notes failed: {error}")
        if time.time() >= discord_wait_until:
            discord_wait_until = time.time() + post_discord()
        time.sleep(1)


def watch():
