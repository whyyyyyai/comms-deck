# SECTION 7: kitty wake - paste a note into an idle agent's window
# -----------------------------------------------------------------------------
#
# Needs kitty remote control, which `comms-deck install` turns on:
#   allow_remote_control socket-only
#   listen_on unix:${XDG_RUNTIME_DIR}/kitty
# The socket sits in the owner's private runtime folder (mode 700).


def kitty(socket, *args, data=None):
    """Run `kitten @ --to <socket> ...`. Returns stdout, or raises."""
    result = subprocess.run(["kitten", "@", "--to", socket, *args], input=data,
                            capture_output=True, text=True, timeout=10)
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or "kitten @ failed")
    return result.stdout


def window_focused(socket, window_id):
    """True/False if that kitty window has focus. None if it's gone."""
    for os_window in json.loads(kitty(socket, "ls")):
        for tab in os_window.get("tabs", []):
            for win in tab.get("windows", []):
                if str(win.get("id")) == str(window_id):
                    return bool(win.get("is_focused") and os_window.get("is_focused"))
    return None


def _is_hbar(line):
    """True if `line` is a horizontal rule (Claude's composer border)."""
    text = line.strip()
    return len(text) >= 8 and set(text) <= set("─━═-")


def _after_marker(line):
    """Text typed after a ❯ or '>' prompt marker, with the box drawing removed."""
    text = line.replace("│", " ").replace("\u00a0", " ").strip()
    for marker in ("❯", ">"):
        if text.startswith(marker):
            return text[len(marker):].strip()
    return text


SGR = re.compile(r"\033\[([0-9;:]*)m")
STRUCTURE = set("❯>│─━═╭╮╰╯-|")


def drop_placeholders(ansi_screen):
    """The screen as plain text, with greyed-out text blanked.

    Agents draw hints in the prompt in grey or dim text: Claude Code's
    suggested next prompt, Grok's placeholder. Typed text is drawn in the
    normal colour. So grey or dim characters, apart from the box drawing and
    prompt markers the composer is found by, become spaces, and only what
    the owner really typed is left for composer_text().
    """
    out, pos, dim, grey = [], 0, False, False

    def is_grey(params):
        nums = [int(n) for n in re.split(r"[;:]", params) if n.isdigit()]
        for i, n in enumerate(nums):
            if n == 38 and i + 1 < len(nums):
                if nums[i + 1] == 5 and i + 2 < len(nums):
                    c = nums[i + 2]
                    return c in (8, 59, 102, 145) or 237 <= c <= 250
                if nums[i + 1] == 2 and i + 4 < len(nums):
                    r, g, b = nums[i + 2:i + 5]
                    return max(r, g, b) - min(r, g, b) <= 12 and max(r, g, b) <= 200
            if n == 90:
                return True
        return None  # no colour change in this code

    for m in SGR.finditer(ansi_screen):
        for ch in ansi_screen[pos:m.start()]:
            muted = (dim or grey) and ch not in STRUCTURE and not ch.isspace()
            out.append(" " if muted else ch)
        params = m.group(1)
        codes = [c for c in re.split(r"[;:]", params) if c] or ["0"]
        if "0" in codes and params.split(";")[0] in ("", "0"):
            dim = grey = False
        if "2" in codes and params.split(";")[0] == "2":
            dim = True
        if "22" in codes:
            dim = False
        if "39" in codes:
            grey = False
        g = is_grey(params)
        if g is not None:
            grey = g
        pos = m.end()
    for ch in ansi_screen[pos:]:
        muted = (dim or grey) and ch not in STRUCTURE and not ch.isspace()
        out.append(" " if muted else ch)
    return re.sub(r"\033\[[0-9;:?]*[A-Za-z]", "", "".join(out))


def composer_text(screen):
    """Text already typed in an agent's composer, or None if it can't be seen.

    Grok's composer is the last `│ ❯ … │` line of the input box, plus any
    wrapped lines before the box closes. Claude Code's is the `❯` line between
    the two rules at the bottom of the screen. Antigravity's is a `>` between
    two rules, with a hint such as "? for shortcuts" under the bottom rule;
    that hint is not part of the draft. A bare `>` marker uses the next line
    (Claude Code's composer when the marker sits on its own line).
    An empty string means the composer is on screen and has no draft.
    """
    # Only the bottom of the window: the composer always sits there, while
    # the scrollback above can hold anything (a quoted "> " line, a copy of
    # another agent's screen) that would look like a prompt.
    lines = screen.rstrip("\n").splitlines()[-15:]
    box = None
    for i, line in enumerate(lines):
        if "❯" in line and "│" in line:
            box = i
    if box is not None:
        parts = [_after_marker(lines[box])]
        for line in lines[box + 1:]:
            if "╰" in line or "╭" in line:
                break
            if "│" in line:
                parts.append(line.replace("│", "").replace("\u00a0", " ").strip())
            else:
                break
        return "\n".join(part for part in parts if part).strip()

    rules = [i for i, line in enumerate(lines) if _is_hbar(line)]
    if len(rules) >= 2:
        start, end = rules[-2], rules[-1]
        middle = lines[start + 1:end]
        if 0 < end - start <= 8 and any(
                line.strip().startswith("❯") or line.strip().startswith(">") for line in middle):
            parts = []
            for line in middle:
                stripped = line.strip()
                if stripped.startswith("❯") or stripped.startswith(">"):
                    parts.append(_after_marker(line))
                else:
                    parts.append(line.replace("\u00a0", " ").strip())
            return "\n".join(part for part in parts if part).strip()

    marker = None
    for i, line in enumerate(lines):
        stripped = line.strip().replace("\u00a0", " ")
        if stripped.startswith("❯") or stripped == ">" or stripped.startswith("> "):
            marker = i
    if marker is None:
        return None
    typed = _after_marker(lines[marker])
    if typed:
        return typed
    if marker + 1 >= len(lines):
        return ""
    nxt = lines[marker + 1]
    if _is_hbar(nxt) or "╰" in nxt:
        return ""
    return nxt.replace("│", "").replace("\u00a0", " ").strip()


def try_wake(seat):
    """If `seat` is idle with a normal note waiting, paste it in. True if done."""
    state = load_seat(seat)
    socket, window = state.get("kitty_socket"), state.get("kitty_window")
    if state["state"] != "idle" or not socket or not window:
        return False
    if not any(not r.get("quiet") for _, r in pending(seat)):
        return False
    if state["auto"] >= AUTO_LIMIT and not owner_waiting(seat):
        pause_notice(seat)
        return False
    try:
        focused = window_focused(socket, window)
    except (RuntimeError, OSError, ValueError, subprocess.SubprocessError):
        return False
    if focused is None:
        update_seat(seat, state="away")
        return False
    if focused:
        return False  # the owner may be typing there: wait
    try:
        screen = drop_placeholders(kitty(socket, "get-text", "--match", f"id:{window}", "--ansi"))
    except (RuntimeError, OSError, subprocess.SubprocessError) as error:
        log(f"not waking {seat}: couldn't read the window ({error})")
        return False
    typed = composer_text(screen)
    if typed is None:
        log(f"not waking {seat}: couldn't see the prompt line")
        return False
    if typed:
        if not state.get("held_by_draft"):
            log(f"not waking {seat}: a draft is already in the prompt: {typed[:60]!r}")
        update_seat(seat, held_by_draft=time.time())
        return False
    if state.get("held_by_draft"):
        update_seat(seat, held_by_draft=0)
    notes = take(seat, include_quiet=False, limit_chars=HANDOVER_MAX)
    if not notes:
        return False
    text = render(notes, seat)
    update_seat(seat, state="busy", auto=next_auto(state, notes), woke_at=time.time(),
                doing=describe_notes(notes))
    try:
        match = f"id:{window}"
        kitty(socket, "send-text", "--match", match, "--bracketed-paste=enable",
              "--stdin", data=text)
        time.sleep(0.3)
        kitty(socket, "send-text", "--match", match, "\r")
    except (RuntimeError, OSError, subprocess.SubprocessError) as error:
        for r in notes:  # put them back so nothing is lost
            write_json(DATA / "inbox" / seat / f"{r['id']}.json", r)
        update_seat(seat, state="idle")
        log(f"couldn't wake {seat}: {error}")
        return False
    log(f"woke {seat} with {len(notes)} note(s)")
    return True


