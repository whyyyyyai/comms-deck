HOME = Path.home()


def setting(name, default=None):
    """$COMMS_DECK_<name>, or the older $LAUNCHPAD_<name>, or `default`."""
    return os.environ.get(f"COMMS_DECK_{name}") or os.environ.get(f"LAUNCHPAD_{name}") or default


DATA = Path(setting("HOME") or HOME / ".local/share/comms-deck")
CONFIG = Path(setting("CONFIG") or HOME / ".config/comms-deck")
WEBHOOK_FILE = CONFIG / "discord-webhook"

# Agent seats: the process name each one runs as. Extra seats can be added
# with COMMS_DECK_SEATS="name:process,name2:process2".
AGENTS = {"claude": "claude", "grok": "grok", "codex": "codex", "gravity": "agy"}  # gravity: the Antigravity CLI, whose program is agy
for _pair in filter(None, setting("SEATS", "").split(",")):
    _name, _, _proc = _pair.partition(":")
    AGENTS[_name.strip()] = (_proc or _name).strip()
# App seats: bots with no hooks and no kitty window. One name per line in
# ~/.config/comms-deck/app-seats ("#" starts a comment). A seat that appears
# in the Grok Bot window is woken from that chat (section 7b). Any other app
# seat is left to its own connector.
_app_file = CONFIG / "app-seats"
APP_PROCESS = {}  # seat -> the app it lives in; "name:app" in the file, default grok-bot
HIDDEN_SEATS = set()  # "name hidden": works as a seat, but not shown in the status bar or chat box
for _line in (_app_file.read_text().splitlines() if _app_file.exists() else []):
    _line = _line.split("#")[0].strip()
    if _line:
        _words = _line.split()
        _name, _, _app = _words[0].partition(":")
        APP_PROCESS[_name.strip()] = _app.strip() or "grok-bot"
        if "hidden" in _words[1:]:
            HIDDEN_SEATS.add(_name.strip())
APP_SEATS = tuple(APP_PROCESS)
SEATS = tuple(AGENTS) + APP_SEATS + ("owner",)

# The repos the notes are copied to. A missing clone just means no copy.
PUBLIC_REPO = Path(setting("PUBLIC_REPO") or HOME / "flight-log")
PRIVATE_REPO = Path(setting("PRIVATE_REPO") or HOME / "private-relay")

SYNC_EVERY = int(setting("SYNC_EVERY", "300"))   # seconds between git copies
AUTO_LIMIT = int(setting("AUTO_LIMIT", "20"))    # loop guard
HANDOVER_MAX = 8000          # characters handed over at once (Grok clips at 10,000)
MARK = "[comms-deck]"         # every typed wake starts with this
MACHINE = (Path("/etc/hostname").read_text().strip()
           if Path("/etc/hostname").exists() else os.uname().nodename)

# Anything that looks like a secret is made private, and is never sent to
# Discord. Same list the old relay used.
SECRET_PATTERNS = [
    re.compile(r"\b(gh[opusr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,})"),
    re.compile(r"\bsk-[A-Za-z0-9_-]{20,}"),
    re.compile(r"\bxai-[A-Za-z0-9]{20,}"),
    re.compile(r"\bAKIA[0-9A-Z]{16}\b"),
    re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----"),
    re.compile(r"\b[A-Z0-9]{4}-[A-Z0-9]{4}\b"),
    re.compile(r"https://(?:\w+\.)?discord(?:app)?\.com/api/webhooks/\S+"),
    re.compile(r"(?i)\b(password|passwd|passphrase|api[_ -]?key|secret|token)\s*[:=]\s*\S+"),
]

# -----------------------------------------------------------------------------
# SECTION 2: small helpers
# -----------------------------------------------------------------------------


def now():
    """The local time as text, for records."""
    return time.strftime("%Y-%m-%d %H:%M:%S")


def looks_secret(text):
    """True if `text` matches a SECRET_PATTERN."""
    return any(p.search(text) for p in SECRET_PATTERNS)


def write_json(path, data):
    """Write `data` to `path` atomically: a reader never sees half a file."""
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=".tmp-")
    with os.fdopen(fd, "w") as f:
        json.dump(data, f, ensure_ascii=False)
    os.replace(tmp, path)


def read_json(path, default=None):
    """Read a JSON file, or return `default` if it's missing or broken."""
    try:
        return json.loads(Path(path).read_text())
    except (OSError, ValueError):
        return default


def append_log(record):
    """Add one record to log.jsonl, under a lock so lines never interleave."""
    DATA.mkdir(parents=True, exist_ok=True)
    with open(DATA / "log.jsonl", "a") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        f.write(json.dumps(record, ensure_ascii=False) + "\n")


def notify(title, body):
    """Show a desktop notification. Never fails."""
    try:
        subprocess.run(["notify-send", "-a", "comms-deck", title, body[:400]],
                       timeout=5, capture_output=True)
    except (OSError, subprocess.SubprocessError):
        pass


def pid_alive(pid):
    """True if process `pid` exists."""
    try:
        os.kill(int(pid), 0)
        return True
    except (OSError, ValueError, TypeError):
        return False


# -----------------------------------------------------------------------------
# SECTION 3: seats - who is who, and what state each agent is in
# -----------------------------------------------------------------------------


def proc_name(pid):
    """The short process name of `pid` (from /proc), or ''."""
    try:
        return Path(f"/proc/{pid}/comm").read_text().strip()
    except OSError:
        return ""


def parent_of(pid):
    """The parent pid of `pid`, or 0."""
    try:
        stat = Path(f"/proc/{pid}/stat").read_text()
        return int(stat.rsplit(")", 1)[1].split()[1])
    except (OSError, ValueError, IndexError):
        return 0


def find_agent():
    """Walk up from this process to the nearest agent. Return (seat, pid).

    $COMMS_DECK_SEAT wins if set. The program agy is the seat gravity.
    Returns (None, 0) outside any agent, e.g. in a plain terminal.
    """
    forced = setting("SEAT")
    if forced:
        return forced, 0
    by_proc = {proc: seat for seat, proc in AGENTS.items()}
    pid = os.getppid()
    for _ in range(40):
        if pid <= 1:
            break
        seat = by_proc.get(proc_name(pid))
        if seat:
            return seat, pid
        pid = parent_of(pid)
    return None, 0


def agent_env(pid):
    """The environment of process `pid`, as a dict (empty if unreadable)."""
    try:
        raw = Path(f"/proc/{pid}/environ").read_bytes()
    except OSError:
        return {}
    pairs = (item.split(b"=", 1) for item in raw.split(b"\0") if b"=" in item)
    return {k.decode(errors="replace"): v.decode(errors="replace") for k, v in pairs}


def seat_file(seat):
    """Path of this seat's state file (busy, window, loop count)."""
    return DATA / "seats" / f"{seat}.json"


def interactive_agents(seat):
    """Pids of `seat`'s agent processes that run in a terminal.

    Helpers the agents start in the background (e.g. `claude mcp list`)
    have no terminal, so they're left out.
    """
    want = AGENTS.get(seat)
    found = []
    for d in Path("/proc").iterdir():
        if not d.name.isdigit():
            continue
        try:
            if (d / "comm").read_text().strip() != want:
                continue
            fields = (d / "stat").read_text().rsplit(")", 1)[1].split()
            if int(fields[4]) != 0 and proc_name(int(fields[1])) != want:  # has a tty; not a child of itself
                found.append(int(d.name))
        except (OSError, ValueError, IndexError):
            continue
    return found


def load_seat(seat):
    """The seat's state dict. 'away' if its agent process has gone.

    If the recorded process has gone but exactly one copy of that agent is
    running in a terminal, that copy is adopted (it was restarted, or the
    record was stale), so the seat doesn't show away by mistake.
    """
    state = read_json(seat_file(seat), {}) or {}
    if seat in AGENTS and not (state.get("pid") and pid_alive(state["pid"])):
        live = interactive_agents(seat)
        if len(live) == 1:
            remember_window(seat, live[0])
            state = read_json(seat_file(seat), {}) or {}
            if state.get("state") in (None, "away"):
                state = update_seat(seat, state="idle")
        elif state.get("pid"):
            state["state"] = "away"
    state.setdefault("state", "away")
    state.setdefault("auto", 0)
    return state


def app_seat_state(seat):
    """Busy or idle when the Grok Bot page was just read. Otherwise
    'connected' if a comms-deck MCP server is running for this seat,
    'not connected' if the Grok Bot app is open without one, 'away' if closed."""
    state = read_json(seat_file(seat), {}) or {}
    seen = float(state.get("app_seen") or 0)
    if time.time() - seen < 15 and state.get("state") in (
            "busy", "idle", "away", "not connected", "chat not open", "no chat yet"):
        return state["state"]
    if APP_PROCESS.get(seat, "grok-bot") != "grok-bot":
        # Not a Grok Bot seat: it can only connect through its own app's MCP.
        for d in Path("/proc").iterdir():
            try:
                cmd = (d / "cmdline").read_bytes()
                if b"comms-deck\0mcp" in cmd and f"COMMS_DECK_SEAT={seat}".encode() in \
                        (d / "environ").read_bytes().split(b"\0"):
                    return "connected"
            except OSError:
                continue
        return "not set up"
    app_open = False
    for d in Path("/proc").iterdir():
        if not d.name.isdigit():
            continue
        try:
            comm = (d / "comm").read_text().strip()
            if comm == "grok-bot":
                app_open = True
                continue
            cmd = (d / "cmdline").read_bytes()
            if b"comms-deck\0mcp" in cmd or b"launchpad\0mcp" in cmd:
                env = (d / "environ").read_bytes().split(b"\0")
                if f"COMMS_DECK_SEAT={seat}".encode() in env or f"LAUNCHPAD_SEAT={seat}".encode() in env:
                    return "connected"
        except OSError:
            continue
    return "not connected" if app_open else "away"


def update_seat(seat, **changes):
    """Change some fields of a seat's state file, under a lock."""
    path = seat_file(seat)
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(path.with_suffix(".lock"), "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        state = read_json(path, {}) or {}
        before, doing_before = state.get("state"), state.get("doing")
        state.update(changes)
        state["updated"] = time.time()
        if state.get("state") != "busy" and "doing" not in changes:
            state["doing"] = ""  # a finished turn is no longer working on anything
        moved = "state" in changes and changes["state"] != before
        new_task = state.get("state") == "busy" and state.get("doing") != doing_before
        if moved:
            state["since"] = time.time()
        if moved or new_task:
            record_activity(seat, state["state"], state.get("doing") if state["state"] == "busy" else "")
        write_json(path, state)
        return state


def describe(text, limit=70):
    """A few words for the activity log: what started this turn.

    A delivered note ("[comms-deck] 1 note(s)... From grok at 02:58: ...")
    becomes "note from grok: <its first line>"; anything else is its own
    first line. Private names are redacted.
    """
    # Claude Code wraps a pasted note in <pasted_content ...> tags before its
    # hook sees the prompt; those aren't part of the text.
    text = re.sub(r"</?pasted_content[^>]*>", "", str(text or "")).strip()
    if text.startswith(MARK):
        m = re.search(r"^From (\S+)[^\n]*:\n+(.+)$", text, re.M)
        if m:
            text = f"note from {m.group(1)}: {m.group(2)}"
    if looks_secret(text):
        return "(something private)"  # a key or password must never reach the screen (found by Grok)
    first = next((line.strip() for line in text.splitlines() if line.strip()), "")
    first = redact(re.sub(r"\s+", " ", first))
    return first if len(first) <= limit else first[:limit - 1] + "…"


def describe_notes(notes):
    """A few words for notes being handed over."""
    if not notes:
        return ""
    first = notes[0]
    more = f" (+{len(notes) - 1} more)" if len(notes) > 1 else ""
    return describe(f"note from {first['from']}: {first.get('text', '')}", 70 - len(more)) + more


def record_activity(seat, new_state, doing=""):
    """Add one line to activity.jsonl: a seat changed state. Kept to 2000 lines."""
    path = DATA / "activity.jsonl"
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(path, "a+") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        f.write(json.dumps({"time": time.time(), "seat": seat, "state": new_state,
                            "doing": doing or ""}) + "\n")
        f.flush()
        if f.tell() > 400_000:
            f.seek(0)
            keep = f.readlines()[-2000:]
            f.seek(0)
            f.truncate()
            f.writelines(keep)


def recent_activity(limit, path=None):
    """The newest `limit` state changes, newest first, with repeats folded."""
    try:
        lines = Path(path or DATA / "activity.jsonl").read_text().splitlines()[-400:]
    except OSError:
        return []
    rows = []
    for line in lines:
        try:
            rows.append(json.loads(line))
        except ValueError:
            continue
    # A state that lasted under 3 s is flicker (a page's typing signal, say):
    # leave it out of the view. The file keeps everything.
    next_time = {}
    keep = []
    for r in reversed(rows):
        later = next_time.get(r["seat"])
        next_time[r["seat"]] = r["time"]
        if later is not None and later - r["time"] < 3:
            continue
        keep.append(r)
    # Fold repeats, then give each entry its duration: until that seat's next
    # change, or (the newest one per seat) until now, marked live.
    folded = []
    for r in reversed(keep):  # oldest first
        if folded and any(f["seat"] == r["seat"] for f in folded):
            last = next(f for f in reversed(folded) if f["seat"] == r["seat"])
            if last["state"] == r["state"] and last.get("doing", "") == r.get("doing", ""):
                continue
        folded.append(dict(r))
    ends = {}
    for r in reversed(folded):  # newest first
        r["live"] = r["seat"] not in ends
        r["duration"] = (time.time() if r["live"] else ends[r["seat"]]) - r["time"]
        ends[r["seat"]] = r["time"]
    return list(reversed(folded))[:limit]


def remember_window(seat, pid):
    """Record which agent process and kitty window `seat` lives in."""
    env = dict(agent_env(pid)) if pid else {}
    # Our own kitty details only count if we run inside that agent (a hook);
    # a process elsewhere (the chat screen) has its own window's details.
    if "KITTY_WINDOW_ID" not in env and find_agent()[1] == pid:
        env.update({k: v for k, v in os.environ.items() if k.startswith("KITTY_")})
    update_seat(seat, pid=pid or None,
                kitty_window=env.get("KITTY_WINDOW_ID"),
                kitty_socket=env.get("KITTY_LISTEN_ON"))


# -----------------------------------------------------------------------------
# SECTION 4: the mailbox
# -----------------------------------------------------------------------------


def new_id():
    """A unique note id: <nanoseconds>-<machine>-<pid>. Sorts by time."""
    return f"{time.time_ns()}-{MACHINE}-{os.getpid()}"


def send(sender, to, text, quiet=False, private=False):
    """Send a note. Returns (record, warning or None).

    `to` is a seat, several seats ("claude, grok", "claude+grok" or a list),
    or "all" (every agent seat except the sender). Several seats make one
    note with several recipients, so it's shown and logged once.
    """
    text = text.strip()
    if not text:
        raise ValueError("the note is empty")
    names = to if isinstance(to, (list, tuple)) else re.split(r"[\s,+]+", str(to).strip().lower())
    names = list(dict.fromkeys(n.strip().lstrip("@") for n in names if n.strip()))
    unknown = [n for n in names if n not in SEATS and n != "all"]
    if unknown or not names:
        raise ValueError(f"unknown seat {(unknown or [to])[0]!r}; seats are: {', '.join(SEATS)}, all")
    if "all" in names:
        to, targets = "all", [s for s in tuple(AGENTS) + APP_SEATS if s != sender]
    else:
        targets = names
        to = "+".join(names)
    warning = None
    if looks_secret(text) and not private:
        private = True
        warning = "That note looks like it holds a secret, so it was made private."
    record = {"kind": "message", "id": new_id(), "from": sender or "unknown",
              "to": to, "time": now(), "machine": MACHINE,
              "quiet": bool(quiet), "private": bool(private), "text": text}
    for seat in targets:
        if seat == "owner":
            notify(f"Note from {record['from']}", text)
        else:
            write_json(DATA / "inbox" / seat / f"{record['id']}.json", record)
    queue_out(record)
    append_log(record)
    return record, warning


def add_note(sender, text):
    """Add a commentary entry: what was done and why."""
    text = text.strip()
    if not text:
        raise ValueError("the note is empty")
    record = {"kind": "commentary", "id": new_id(), "from": sender or "unknown",
              "time": now(), "machine": MACHINE, "private": looks_secret(text),
              "text": text}
    queue_out(record)
    append_log(record)
    return record


PRIVATE_NAMES_FILE = CONFIG / "private-names"


def redact(text):
    """`text` with every private name replaced by "the owner".

    Names live in ~/.config/comms-deck/private-names, one per line, on this
    machine only: never in this repo. Whole words, any case. Applied to
    every copy that leaves the machine (git, Discord); the local log keeps
    the original.
    """
    try:
        names = [n.strip() for n in PRIVATE_NAMES_FILE.read_text().splitlines()
                 if n.strip() and not n.strip().startswith("#")]
    except OSError:
        return text
    for name in sorted(names, key=len, reverse=True):
        text = re.sub(rf"(?<!\w){re.escape(name)}(?!\w)", "the owner", text, flags=re.IGNORECASE)
    return text


def queue_out(record):
    """Queue a record for the git copy, and for Discord if it's public.

    Both copies leave the machine, so private names are redacted first.
    """
    out = dict(record, text=redact(record["text"]))
    write_json(DATA / "queue/sync" / f"{record['id']}.json", out)
    if not record["private"] and WEBHOOK_FILE.exists():
        write_json(DATA / "queue/discord" / f"{record['id']}.json", out)


def pending(seat):
    """The notes waiting for `seat`, oldest first, as (path, record)."""
    box = DATA / "inbox" / seat
    if not box.is_dir():
        return []
    out = []
    for path in sorted(box.glob("*.json")):
        record = read_json(path)
        if record:
            out.append((path, record))
    return out


def take(seat, include_quiet=True, limit_chars=None):
    """Take notes from `seat`'s inbox. Returns the records taken.

    Taking is a rename into delivered/, so a note is only ever taken once
    even if two processes try at the same moment. `include_quiet=False`
    leaves quiet notes unless a normal note is being taken anyway (then they
    ride along). `limit_chars` stops before the hand-over gets too long.
    """
    waiting = pending(seat)
    if not include_quiet and not any(not r.get("quiet") for _, r in waiting):
        return []
    taken, size = [], 0
    done = DATA / "delivered" / seat
    done.mkdir(parents=True, exist_ok=True)
    for path, record in waiting:
        size += len(record.get("text", "")) + 80
        if limit_chars and taken and size > limit_chars:
            break
        try:
            os.rename(path, done / path.name)
        except OSError:
            continue  # someone else took it
        taken.append(record)
    return taken


# -----------------------------------------------------------------------------
# SECTION 5: delivery text - what the agent actually reads
# -----------------------------------------------------------------------------


def render(records, seat):
    """Turn notes into one block of text for `seat` to read."""
    lines = []
    for r in records:
        tags = [t for t, on in (("quiet", r.get("quiet")), ("private", r.get("private"))) if on]
        to = "" if r.get("to") == seat else f" (to {str(r.get('to')).replace('+', ', ')})"
        tag = f" [{', '.join(tags)}]" if tags else ""
        lines.append(f"From {r['from']}{to} at {r['time'][11:16]}{tag}:\n{r['text']}")
    senders = sorted({r["from"] for r in records} & set(SEATS))
    reply = (f"\n\nReply with the send_message tool (to: {senders[0]})"
             f" or `comms-deck send {senders[0]} \"...\"`." if senders else "")
    if seat in APP_SEATS:
        # An app seat reads this in its own chat and has no comms-deck tools:
        # its chat reply is picked up and filed, so tell it how that works.
        who = senders[0] if senders else "owner"
        return (f"{MARK} {len(records)} note(s) for {seat}:\n\n" + "\n\n".join(lines)
                + f"\n\nReply here in this chat. Your reply goes to {'the owner' if who == 'owner' else who}"
                  " on the comms-deck screen; start it with @claude, @grok or another seat to send it"
                  " to that agent instead. Say \"the owner\", never a name.")
    if "owner" in senders:
        reply = ("\n\nThe owner sent this from the comms-deck chat screen and reads the answer "
                 "there, not in this window. Answer with the send_message tool, to: owner "
                 "(or `comms-deck send owner \"...\"`). Anything you say only in this window, "
                 "the owner won't see.")
    return f"{MARK} {len(records)} note(s) for {seat}:\n\n" + "\n\n".join(lines) + reply


# -----------------------------------------------------------------------------
# SECTION 6: hooks - Claude Code, the Grok CLI, and Antigravity (agy)
# -----------------------------------------------------------------------------
#
# Claude and Grok events, and what each does:
#   SessionStart       remember the window; Claude is told about waiting notes
#   UserPromptSubmit   mark busy; record promptId; reset the loop count if the
#                      owner typed it. Claude also gets waiting notes.
#   Stop               hand over a waiting note and keep working. Never marks
#                      idle. channel_closed / shutdown mark away.
#   StopCancelled      a late cancel can arrive after the next prompt, so this
#                      does not mark idle. Older promptIds are ignored on Stop.
#   Notification       idle_prompt only: mark idle. StopFailure is not hooked:
#                      idle_prompt also fires after an errored turn.
#   SessionEnd         mark away
#
# A child session's events carry subagentType. They are not this seat's.
#
# Antigravity (agy, the seat gravity) uses different events, in agy_hook:
#   SessionStart     remember the window
#   PreInvocation    notes before the next model call; save the model name
#   Stop             mark idle only when fullyIdle; a waiting note continues


def event_prompt_id(data):
    """The turn id on a hook payload, or None. Grok's field is promptId."""
    value = data.get("promptId")
    if value is None or value == "":
        return None
    return str(value)


def turn_relation(state, data):
    """How this event sits against the newest promptId for the seat.

    'session' has no promptId (idle_prompt, a session-end Stop): act on it.
    'older' belongs to a turn that UserPromptSubmit has already moved past.
    'current' is the newest turn, or the first id this seat has seen.
    """
    pid = event_prompt_id(data)
    if pid is None:
        return "session"
    newest = state.get("prompt_id")
    if newest and pid != str(newest):
        return "older"
    return "current"


def paused_for_background(data):
    """True if this Stop is a pause for work that will wake the session."""
    return bool(data.get("backgroundTasks") or data.get("sessionCrons"))


def hook(source, event):
    """Handle one hook event (JSON on stdin). Prints the reply, if any."""
    if source == "agy":
        return agy_hook(event)
    running_in = "grok" if os.environ.get("GROK_HOOK_EVENT") else "claude"
    if source != running_in:
        return  # e.g. Grok reading Claude's settings file: not our hook here
    try:
        data = json.loads(sys.stdin.read() or "{}")
    except ValueError:
        data = {}
    event = event or data.get("hook_event_name") or ""
    if data.get("subagentType"):
        return
    seat, pid = find_agent()
    if seat not in AGENTS:
        return
    state = load_seat(seat)
    if pid and state.get("pid") != pid:
        remember_window(seat, pid)  # a restarted agent, or a stale record
        state = load_seat(seat)

    def reply(obj):
        print(json.dumps(obj))

    if event == "SessionStart":
        remember_window(seat, pid)
        update_seat(seat, state="idle", auto=0, prompt_id=None)
        count = len(pending(seat))
        if count and source == "claude":
            reply({"hookSpecificOutput": {"hookEventName": "SessionStart",
                   "additionalContext": f"{MARK} {count} note(s) are waiting for you "
                                        f"({seat}). Read them with read_messages."}})
    elif event == "UserPromptSubmit":
        # The text field is `prompt`. A missing key must not look like the
        # owner typed something, or the loop guard resets on every such event.
        if "prompt" in data and data.get("prompt") is not None:
            prompt = str(data.get("prompt"))
            woke = time.time() - float(state.get("woke_at") or 0) < 10
            automatic = prompt.lstrip().startswith(MARK) or woke
            auto = state["auto"] if automatic else 0
            owner_typed = not automatic
        else:
            auto = state["auto"]
            owner_typed = False
        changes = {"state": "busy", "auto": auto, "woke_at": 0}
        if "prompt" in data and data.get("prompt"):
            changes["doing"] = describe(data.get("prompt"))
        if auto == 0:
            changes["paused_notice"] = False
        prompt_id = event_prompt_id(data)
        if prompt_id:
            changes["prompt_id"] = prompt_id
        update_seat(seat, **changes)
        if source == "claude" and owner_typed:
            notes = take(seat, limit_chars=HANDOVER_MAX)
            if notes:
                reply({"hookSpecificOutput": {"hookEventName": "UserPromptSubmit",
                       "additionalContext": render(notes, seat)}})
    elif event == "Stop":
        if data.get("reason") in ("channel_closed", "shutdown"):
            update_seat(seat, state="away")
            return
        if turn_relation(state, data) == "older":
            return
        if paused_for_background(data):
            return  # the session will wake itself; leave the notes
        if state["auto"] < AUTO_LIMIT or owner_waiting(seat):
            notes = take(seat, include_quiet=False, limit_chars=HANDOVER_MAX)
            if notes:
                new_auto = next_auto(state, notes)
                changes = {"state": "busy", "auto": new_auto, "doing": describe_notes(notes)}
                if new_auto == 0:
                    changes["paused_notice"] = False
                update_seat(seat, **changes)
                reply({"decision": "block", "reason": render(notes, seat)})
                return
        elif any(not r.get("quiet") for _, r in pending(seat)):
            pause_notice(seat)
        if source == "claude":
            # On Claude an allowed Stop is the end of the turn (comms-deck's
            # is the only Stop hook), so idle now rather than waiting the
            # minute for idle_prompt. Grok settles idle on idle_prompt only.
            update_seat(seat, state="idle")
    elif event == "StopCancelled":
        # Idle waits for idle_prompt. An older cancel must not touch the seat:
        # Grok can deliver it after the next turn's UserPromptSubmit.
        return
    elif event == "Notification":
        # Claude's hook is installed with matcher idle_prompt, so whatever
        # reaches it is idle; Grok's payload is checked field by field.
        if source == "grok" and data.get("notification_type") != "idle_prompt":
            return
        if turn_relation(state, data) == "older":
            return
        update_seat(seat, state="idle")
    elif event == "SessionEnd":
        update_seat(seat, state="away")


def owner_waiting(seat):
    """True if a note from the owner is in `seat`'s inbox. The owner always gets through."""
    return any(r.get("from") == "owner" for _, r in pending(seat))


def next_auto(state, notes):
    """The loop count after handing `notes` over: reset by the owner, else one more."""
    if any(r.get("from") == "owner" for r in notes):
        return 0
    return state["auto"] + 1


def remember_gravity_model(data):
    """Save the model name from a PreInvocation hook, for the usage panel.

    The payload has modelName and no token or quota figures, so the panel
    names the model and draws no bar. A repeat of the same name inside a
    minute does not rewrite the file.
    """
    model = str(data.get("modelName") or "").strip()
    if not model:
        return
    path = DATA / "usage" / "gravity.json"
    prev = read_json(path) or {}
    same = (prev.get("source") == "gravity-hook"
            and dig(prev, "data", "model", "display_name") == model)
    if same and time.time() - float(prev.get("time") or 0) < 60:
        return
    write_json(path, {"time": time.time(), "source": "gravity-hook",
                      "data": {"model": {"display_name": model}}})


def agy_hook(event):
    """Hooks for the Antigravity CLI (program agy, seat gravity). Its events and replies differ:

      SessionStart   remember the window; say how many notes wait (injectSteps)
      PreInvocation  runs before every model call. Call 0 is a new turn: mark
                     busy, and reset the loop guard if the owner typed it.
                     Waiting notes are handed over here as a system message,
                     so they arrive mid-turn, not only at the end.
      Stop           a note waiting: {"decision": "continue", "reason": notes}.
                     Otherwise idle once fullyIdle says nothing is still running.
    Payload fields are camelCase (lastUserInput, invocationNum, fullyIdle).
    """
    try:
        data = json.loads(sys.stdin.read() or "{}")
    except ValueError:
        data = {}
    seat, pid = find_agent()
    if seat != "gravity":
        return  # not running inside agy: not this hook's business
    state = load_seat(seat)
    if pid and state.get("pid") != pid:
        remember_window(seat, pid)
        state = load_seat(seat)

    def system(text):
        return {"injectSteps": [{"systemMessage": {"systemMessage": text}}]}

    if event == "SessionStart":
        remember_window(seat, pid)
        update_seat(seat, state="idle", auto=0)
        count = len(pending(seat))
        if count:
            print(json.dumps(system(f"{MARK} {count} note(s) are waiting for you (gravity). "
                                    "Read them with the read_messages tool.")))
    elif event == "PreInvocation":
        remember_gravity_model(data)
        if int(data.get("invocationNum") or 0) == 0:
            typed = str(data.get("lastUserInput") or "")
            woke = time.time() - float(state.get("woke_at") or 0) < 10
            automatic = typed.lstrip().startswith(MARK) or woke or "lastUserInput" not in data
            update_seat(seat, state="busy", woke_at=0, **({} if automatic else {"auto": 0}),
                        **({"doing": describe(typed)} if typed and not typed.lstrip().startswith(MARK) else {}))
            state = load_seat(seat)
        if state["auto"] < AUTO_LIMIT or owner_waiting(seat):
            notes = take(seat, limit_chars=HANDOVER_MAX)
            if notes:
                update_seat(seat, auto=next_auto(state, notes), doing=describe_notes(notes))
                print(json.dumps(system(render(notes, seat))))
    elif event == "Stop":
        if state["auto"] < AUTO_LIMIT or owner_waiting(seat):
            notes = take(seat, include_quiet=False, limit_chars=HANDOVER_MAX)
            if notes:
                update_seat(seat, state="busy", auto=next_auto(state, notes), doing=describe_notes(notes))
                print(json.dumps({"decision": "continue", "reason": render(notes, seat)}))
                return
        elif any(not r.get("quiet") for _, r in pending(seat)):
            pause_notice(seat)
        if data.get("fullyIdle", True):
            update_seat(seat, state="idle")


# Tools Gravity may call without a per-call Allow prompt. install adds any
# that are missing and leaves the rest of agy's settings file alone.
GRAVITY_MCP_ALLOW = (
    "mcp(comms-deck/team_status)",
    "mcp(comms-deck/read_messages)",
    "mcp(comms-deck/send_message)",
    "mcp(comms-deck/add_note)",
    "mcp(comms-deck/set_status)",
)


def grant_gravity_tools(settings):
    """Add the comms-deck MCP tools to agy's allow list. Other settings stay."""
    settings = dict(settings or {})
    permissions = dict(settings.get("permissions") or {})
    allow = list(permissions.get("allow") or [])
    for entry in GRAVITY_MCP_ALLOW:
        if entry not in allow:
            allow.append(entry)
    permissions["allow"] = allow
    settings["permissions"] = permissions
    return settings


def agy_hooks(cmd):
    """The hooks file for ~/.gemini/config/hooks.json (Antigravity)."""
    return {"comms-deck": {event: [{"type": "command", "timeout": 10,
                                    "command": f"{cmd} hook --source agy --event {event}"}]
                           for event in ("SessionStart", "PreInvocation", "Stop")}}


def pause_notice(seat):
    """Tell the owner (once) that the loop guard paused `seat`."""
    state = load_seat(seat)
    if not state.get("paused_notice"):
        update_seat(seat, paused_notice=True)
        notify("comms-deck paused", f"{seat} has had {AUTO_LIMIT} notes handed over in a row "
               "with no prompt from you. Notes are waiting; type in its window to resume.")


# -----------------------------------------------------------------------------
# SECTION 7: kitty wake - paste a note into an idle agent's window
# -----------------------------------------------------------------------------
#
# Needs kitty remote control, which `comms-deck install` turns on:
#   allow_remote_control socket-only
#   listen_on unix:${XDG_RUNTIME_DIR}/kitty
# The socket sits in the owner's private runtime folder (mode 700).


def kitty(socket, *args, data=None):
    """Run `kitten @ --to <socket> ...`. Returns stdout, or raises."""
    result = subprocess.run(["kitten", "@", "--to", socket, *args], input=data,
                            capture_output=True, text=True, timeout=10)
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or "kitten @ failed")
    return result.stdout


def window_focused(socket, window_id):
    """True/False if that kitty window has focus. None if it's gone."""
    for os_window in json.loads(kitty(socket, "ls")):
        for tab in os_window.get("tabs", []):
            for win in tab.get("windows", []):
                if str(win.get("id")) == str(window_id):
                    return bool(win.get("is_focused") and os_window.get("is_focused"))
    return None


def _is_hbar(line):
    """True if `line` is a horizontal rule (Claude's composer border)."""
    text = line.strip()
    return len(text) >= 8 and set(text) <= set("─━═-")


def _after_marker(line):
    """Text typed after a ❯ or '>' prompt marker, with the box drawing removed."""
    text = line.replace("│", " ").replace("\u00a0", " ").strip()
    for marker in ("❯", ">"):
        if text.startswith(marker):
            return text[len(marker):].strip()
    return text


SGR = re.compile(r"\033\[([0-9;:]*)m")
STRUCTURE = set("❯>│─━═╭╮╰╯-|")


def drop_placeholders(ansi_screen):
    """The screen as plain text, with greyed-out text blanked.

    Agents draw hints in the prompt in grey or dim text: Claude Code's
    suggested next prompt, Grok's placeholder. Typed text is drawn in the
    normal colour. So grey or dim characters, apart from the box drawing and
    prompt markers the composer is found by, become spaces, and only what
    the owner really typed is left for composer_text().
    """
    out, pos, dim, grey = [], 0, False, False

    def is_grey(params):
        nums = [int(n) for n in re.split(r"[;:]", params) if n.isdigit()]
        for i, n in enumerate(nums):
            if n == 38 and i + 1 < len(nums):
                if nums[i + 1] == 5 and i + 2 < len(nums):
                    c = nums[i + 2]
                    return c in (8, 59, 102, 145) or 237 <= c <= 250
                if nums[i + 1] == 2 and i + 4 < len(nums):
                    r, g, b = nums[i + 2:i + 5]
                    return max(r, g, b) - min(r, g, b) <= 12 and max(r, g, b) <= 200
            if n == 90:
                return True
        return None  # no colour change in this code

    for m in SGR.finditer(ansi_screen):
        for ch in ansi_screen[pos:m.start()]:
            muted = (dim or grey) and ch not in STRUCTURE and not ch.isspace()
            out.append(" " if muted else ch)
        params = m.group(1)
        codes = [c for c in re.split(r"[;:]", params) if c] or ["0"]
        if "0" in codes and params.split(";")[0] in ("", "0"):
            dim = grey = False
        if "2" in codes and params.split(";")[0] == "2":
            dim = True
        if "22" in codes:
            dim = False
        if "39" in codes:
            grey = False
        g = is_grey(params)
        if g is not None:
            grey = g
        pos = m.end()
    for ch in ansi_screen[pos:]:
        muted = (dim or grey) and ch not in STRUCTURE and not ch.isspace()
        out.append(" " if muted else ch)
    return re.sub(r"\033\[[0-9;:?]*[A-Za-z]", "", "".join(out))


def composer_text(screen):
    """Text already typed in an agent's composer, or None if it can't be seen.

    Grok's composer is the last `│ ❯ … │` line of the input box, plus any
    wrapped lines before the box closes. Claude Code's is the `❯` line between
    the two rules at the bottom of the screen. Antigravity's is a `>` between
    two rules, with a hint such as "? for shortcuts" under the bottom rule;
    that hint is not part of the draft. A bare `>` marker uses the next line
    (Claude Code's composer when the marker sits on its own line).
    An empty string means the composer is on screen and has no draft.
    """
    # Only the bottom of the window: the composer always sits there, while
    # the scrollback above can hold anything (a quoted "> " line, a copy of
    # another agent's screen) that would look like a prompt.
    lines = screen.rstrip("\n").splitlines()[-15:]
    box = None
    for i, line in enumerate(lines):
        if "❯" in line and "│" in line:
            box = i
    if box is not None:
        parts = [_after_marker(lines[box])]
        for line in lines[box + 1:]:
            if "╰" in line or "╭" in line:
                break
            if "│" in line:
                parts.append(line.replace("│", "").replace("\u00a0", " ").strip())
            else:
                break
        return "\n".join(part for part in parts if part).strip()

    rules = [i for i, line in enumerate(lines) if _is_hbar(line)]
    if len(rules) >= 2:
        start, end = rules[-2], rules[-1]
        middle = lines[start + 1:end]
        if 0 < end - start <= 8 and any(
                line.strip().startswith("❯") or line.strip().startswith(">") for line in middle):
            parts = []
            for line in middle:
                stripped = line.strip()
                if stripped.startswith("❯") or stripped.startswith(">"):
                    parts.append(_after_marker(line))
                else:
                    parts.append(line.replace("\u00a0", " ").strip())
            return "\n".join(part for part in parts if part).strip()

    marker = None
    for i, line in enumerate(lines):
        stripped = line.strip().replace("\u00a0", " ")
        if stripped.startswith("❯") or stripped == ">" or stripped.startswith("> "):
            marker = i
    if marker is None:
        return None
    typed = _after_marker(lines[marker])
    if typed:
        return typed
    if marker + 1 >= len(lines):
        return ""
    nxt = lines[marker + 1]
    if _is_hbar(nxt) or "╰" in nxt:
        return ""
    return nxt.replace("│", "").replace("\u00a0", " ").strip()


def try_wake(seat):
    """If `seat` is idle with a normal note waiting, paste it in. True if done."""
    state = load_seat(seat)
    socket, window = state.get("kitty_socket"), state.get("kitty_window")
    if state["state"] != "idle" or not socket or not window:
        return False
    if not any(not r.get("quiet") for _, r in pending(seat)):
        return False
    if state["auto"] >= AUTO_LIMIT and not owner_waiting(seat):
        pause_notice(seat)
        return False
    try:
        focused = window_focused(socket, window)
    except (RuntimeError, OSError, ValueError, subprocess.SubprocessError):
        return False
    if focused is None:
        update_seat(seat, state="away")
        return False
    if focused:
        return False  # the owner may be typing there: wait
    try:
        screen = drop_placeholders(kitty(socket, "get-text", "--match", f"id:{window}", "--ansi"))
    except (RuntimeError, OSError, subprocess.SubprocessError) as error:
        log(f"not waking {seat}: couldn't read the window ({error})")
        return False
    typed = composer_text(screen)
    if typed is None:
        log(f"not waking {seat}: couldn't see the prompt line")
        return False
    if typed:
        if not state.get("held_by_draft"):
            log(f"not waking {seat}: a draft is already in the prompt: {typed[:60]!r}")
        update_seat(seat, held_by_draft=time.time())
        return False
    if state.get("held_by_draft"):
        update_seat(seat, held_by_draft=0)
    notes = take(seat, include_quiet=False, limit_chars=HANDOVER_MAX)
    if not notes:
        return False
    text = render(notes, seat)
    update_seat(seat, state="busy", auto=next_auto(state, notes), woke_at=time.time(),
                doing=describe_notes(notes))
    try:
        match = f"id:{window}"
        kitty(socket, "send-text", "--match", match, "--bracketed-paste=enable",
              "--stdin", data=text)
        time.sleep(0.3)
        kitty(socket, "send-text", "--match", match, "\r")
    except (RuntimeError, OSError, subprocess.SubprocessError) as error:
        for r in notes:  # put them back so nothing is lost
            write_json(DATA / "inbox" / seat / f"{r['id']}.json", r)
        update_seat(seat, state="idle")
        log(f"couldn't wake {seat}: {error}")
        return False
    log(f"woke {seat} with {len(notes)} note(s)")
    return True


def log(text):
    """A line on the service's log (journalctl --user -u comms-deck)."""
    print(f"{now()} {text}", flush=True)


# -----------------------------------------------------------------------------
# SECTION 7b: Grok Bot page - type a note into an app seat's own chat
# -----------------------------------------------------------------------------
#
# The Grok Bot app can listen on 127.0.0.1:9222. This client speaks only to
# that loopback debugger: a page whose url is not on this machine is refused.
# It never reads cookies, storage or tokens. Note text is typed in and not
# written to the service log.
#
# A seat is driven only when its name is a chat in that window. Seats that
# live in another app (lumo, for one) are not touched.


GROK_BOT_PORT = 9222


