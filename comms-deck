        # Replace our own [[hooks]] tables (named comms-deck-*); keep the rest.
        tables = re.split(r"(?m)^(?=\[\[hooks\]\])", text)
        kept = [t for t in tables if not re.search(r'(?m)^name = "comms-deck-', t)]
        hooks_path.write_text("".join(kept).rstrip("\n") + ("\n\n" if "".join(kept).strip() else "")
                              + vibe_hooks_toml(cmd))
        config_path = folder / "config.toml"
        config = config_path.read_text() if config_path.exists() else ""
        if not re.search(r'(?m)^name = "comms-deck"', config):
            config = (config.rstrip("\n") + ("\n\n" if config.strip() else "")
                      + f'[[mcp_servers]]\nname = "comms-deck"\ntransport = "stdio"\n'
                        f'command = "{cmd}"\nargs = ["mcp"]\nenv = {{ COMMS_DECK_SEAT = "vibe" }}\n')
        granted = grant_vibe_tools(config)
