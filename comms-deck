def now():
    """The local time as text, for records."""
    return time.strftime("%Y-%m-%d %H:%M:%S")


def looks_secret(text):
    """True if `text` matches a SECRET_PATTERN."""
    return any(p.search(text) for p in SECRET_PATTERNS)


def write_json(path, data):
    """Write `data` to `path` atomically: a reader never sees half a file."""
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=".tmp-")
    with os.fdopen(fd, "w") as f:
        json.dump(data, f, ensure_ascii=False)
    os.replace(tmp, path)


def read_json(path, default=None):
    """Read a JSON file, or return `default` if it's missing or broken."""
    try:
        return json.loads(Path(path).read_text())
    except (OSError, ValueError):
        return default


def append_log(record):
    """Add one record to log.jsonl, under a lock so lines never interleave."""
    DATA.mkdir(parents=True, exist_ok=True)
    with open(DATA / "log.jsonl", "a") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        f.write(json.dumps(record, ensure_ascii=False) + "\n")


def notify(title, body):
    """Show a desktop notification. Never fails. Off under the self-test."""
    if setting("NO_NOTIFY"):
        return
    try:
        subprocess.run(["notify-send", "-a", "comms-deck", title, body[:400]],
                       timeout=5, capture_output=True)
    except (OSError, subprocess.SubprocessError):
        pass


def pid_alive(pid):
    """True if process `pid` exists."""
    try:
        os.kill(int(pid), 0)
        return True
    except (OSError, ValueError, TypeError):
        return False


