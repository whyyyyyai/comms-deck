def claude_hooks(cmd):
    """The hooks block for ~/.claude/settings.json."""
    def entry(event, matcher=None):
        h = {"hooks": [{"type": "command", "command": f"{cmd} hook --source claude --event {event}",
                        "timeout": 10}]}
        if matcher:
            h["matcher"] = matcher
        return h
    return {e: [entry(e)] for e in ("SessionStart", "UserPromptSubmit", "Stop", "SessionEnd")} | {
        "Notification": [entry("Notification", "idle_prompt")]}


def grok_hooks(cmd):
    """The hooks file for ~/.grok/hooks/comms-deck.json.

    Notification is matched on idle_prompt only. StopFailure is left out:
    idle_prompt also fires after an errored turn, and that is what marks idle.
    """
    def entry(event, matcher=None):
        group = {"hooks": [{"type": "command", "timeout": 10,
                            "command": f"{cmd} hook --source grok --event {event}"}]}
        if matcher:
            group["matcher"] = matcher
        return group
    events = ("SessionStart", "UserPromptSubmit", "Stop", "StopCancelled", "SessionEnd")
    hooks = {event: [entry(event)] for event in events}
    hooks["Notification"] = [entry("Notification", "idle_prompt")]
    return {"hooks": hooks}


def install(yes):
    """Set up: command link, hooks, MCP, kitty, services. Prints each step."""
    here = Path(__file__).resolve().parent
    bin_dir = HOME / ".local/bin"
    cmd = str(bin_dir / "comms-deck")
    steps = []

    def step(text, action):
        steps.append((text, action))

    def link(name, target):
        dest = bin_dir / name
        if dest.is_symlink() or not dest.exists():
            dest.unlink(missing_ok=True)
            dest.symlink_to(target)

    def migrate():
        """Move launchpad's data and config to the comms-deck names, leaving
        links behind so anything still running under the old name keeps
        working until it restarts."""
        for old, new in ((HOME / ".local/share/launchpad", DATA), (HOME / ".config/launchpad", CONFIG)):
            if old.is_dir() and not old.is_symlink() and not new.exists():
                new.parent.mkdir(parents=True, exist_ok=True)
                old.rename(new)
                old.symlink_to(new)
    step("move ~/.local/share/launchpad and ~/.config/launchpad to the comms-deck names", migrate)

    step(f"link {bin_dir}/comms-deck (and the old name, launchpad) and push-courier to this repo",
         lambda: (bin_dir.mkdir(parents=True, exist_ok=True), link("comms-deck", here / "comms-deck"),
                  link("launchpad", here / "comms-deck"), link("push-courier", here / "push-courier")))

    def claude_settings():
        path = HOME / ".claude/settings.json"
        settings = read_json(path, {}) or {}
        if path.exists():
            shutil.copy(path, path.with_suffix(".json.comms-deck-backup"))
        hooks = settings.setdefault("hooks", {})
        for event, entries in claude_hooks(cmd).items():
            kept = [e for e in hooks.get(event, [])
                    if "comms-deck hook" not in json.dumps(e) and "launchpad hook" not in json.dumps(e)]
            hooks[event] = kept + entries
        line = str((settings.get("statusLine") or {}).get("command", ""))
        if not line or "launchpad statusline" in line or "comms-deck statusline" in line:
            settings["statusLine"] = {"type": "command", "command": f"{cmd} statusline --source claude",
                                      "padding": 0}
        path.write_text(json.dumps(settings, indent=2) + "\n")
    step("add comms-deck hooks and status line to ~/.claude/settings.json (backup kept)", claude_settings)

    def grok_files():
        (HOME / ".grok/hooks/launchpad.json").unlink(missing_ok=True)
        write_json(HOME / ".grok/hooks/comms-deck.json", grok_hooks(cmd))
    step("write ~/.grok/hooks/comms-deck.json (replacing launchpad.json)", grok_files)

    def mcp_claude():
        if shutil.which("claude"):
            for name in ("launchpad", "comms-deck"):
                subprocess.run(["claude", "mcp", "remove", "-s", "user", name], capture_output=True)
            subprocess.run(["claude", "mcp", "add", "-s", "user", "comms-deck", "--", cmd, "mcp"],
                           check=True, capture_output=True)
    step("register the MCP server with Claude Code (user scope)", mcp_claude)

    def mcp_toml(path, header, status_line=False):
        if not path.parent.exists():
            return
        text = path.read_text() if path.exists() else ""
        # Drop the old [mcp_servers.launchpad] table (header and its key lines).
        text = re.sub(r"\n*\[mcp_servers\.launchpad\]\n(?:[a-z_]+ = .*\n?)*", "\n", text)
        text = re.sub(r"[^\"\s]*launchpad statusline", f"{cmd} statusline", text)
        if header not in text:
            text = text.rstrip("\n") + f"\n\n{header}\ncommand = \"{cmd}\"\nargs = [\"mcp\"]\n"
        if status_line and "[ui.status_line]" not in text:
            text += (f"\n[ui.status_line]\ntype = \"command\"\n"
                     f"command = \"{cmd} statusline --source grok\"\nrefresh_interval = 60\n")
        path.write_text(text)
    step("register the MCP server and status line with Grok (~/.grok/config.toml)",
         lambda: mcp_toml(HOME / ".grok/config.toml", "[mcp_servers.comms-deck]", status_line=True))
    def desktop():
        """The chat screen's launcher, the scratchpad layout, an app menu
        entry, and (for a Lua Hyprland config) the rule that puts the chat
        screen fullscreen on workspace 5."""
        for name in ("comms-deck-chat", "scratchpad-layout"):
            link(name, here / "desktop" / name)
        apps = HOME / ".local/share/applications"
        apps.mkdir(parents=True, exist_ok=True)
        (apps / "comms-deck-chat.desktop").write_text(
            "[Desktop Entry]\nType=Application\nName=comms-deck chat\n"
            "Comment=Live view of the agents' notes, with usage and a chat box\n"
            f"Exec={bin_dir / 'comms-deck-chat'}\nIcon=utilities-terminal\nTerminal=false\n"
            "Categories=Utility;\n")
        lua = HOME / ".config/hypr/hyprland.lua"
        if lua.exists() and "comms-deck-chat" not in lua.read_text():
            with open(lua, "a") as f:
                f.write('\n-- comms-deck chat: the agents\' live notes, fullscreen on workspace 5.\n'
                        'hl.window_rule({\n    name       = "comms-deck-chat",\n'
                        '    match      = { class = "^comms-deck-chat$" },\n'
                        '    workspace  = "5 silent",\n    fullscreen = true,\n})\n')
            subprocess.run(["hyprctl", "reload"], capture_output=True)
    step("link the chat screen launcher and scratchpad-layout, add an app menu entry, "
         "and the Hyprland rule for workspace 5 (Lua config)", desktop)

    def antigravity():
        if not (HOME / ".local/bin/agy").exists() and not shutil.which("agy"):
            return
        folder = HOME / ".gemini/config"
        folder.mkdir(parents=True, exist_ok=True)
        hooks_path = folder / "hooks.json"
        hooks = read_json(hooks_path, {}) or {}
        hooks.update(agy_hooks(cmd))
        hooks_path.write_text(json.dumps(hooks, indent=2) + "\n")
        mcp_path = folder / "mcp_config.json"
        config = read_json(mcp_path, {}) or {}
        config.setdefault("mcpServers", {})["comms-deck"] = {
            "command": cmd, "args": ["mcp"], "env": {"COMMS_DECK_SEAT": "gravity"}}
        mcp_path.write_text(json.dumps(config, indent=2) + "\n")
        settings_path = HOME / ".gemini/antigravity-cli/settings.json"
        settings_path.parent.mkdir(parents=True, exist_ok=True)
        current = read_json(settings_path, {}) or {}
        updated = grant_gravity_tools(current)
        if updated != current:
            settings_path.write_text(json.dumps(updated, indent=2) + "\n")
    step("add hooks and the MCP server for Antigravity, if installed (~/.gemini/config)", antigravity)
    step("register the MCP server with Codex, if installed (~/.codex/config.toml)",
         lambda: mcp_toml(HOME / ".codex/config.toml", "[mcp_servers.comms-deck]"))

    def kitty_conf():
        path = HOME / ".config/kitty/kitty.conf"
        text = path.read_text() if path.exists() else ""
        if "# >>> launchpad" in text:
            text = text.replace("# >>> launchpad", "# >>> comms-deck").replace("# <<< launchpad", "# <<< comms-deck")
            path.write_text(text)
        if "# >>> comms-deck" not in text:
            path.parent.mkdir(parents=True, exist_ok=True)
            with open(path, "a") as f:
                f.write(KITTY_BLOCK)
    step("turn on kitty remote control (~/.config/kitty/kitty.conf, new windows only)", kitty_conf)

    def services():
        unit_dir = HOME / ".config/systemd/user"
        unit_dir.mkdir(parents=True, exist_ok=True)
        for unit in ("comms-deck.service", "push-courier.service"):
            link_path = unit_dir / unit
            link_path.unlink(missing_ok=True)
            link_path.symlink_to(here / "systemd" / unit)
        for old in ("relay-protocol.service", "relay-scheduler.service", "launchpad.service"):
            subprocess.run(["systemctl", "--user", "disable", "--now", old], capture_output=True)
            (unit_dir / old).unlink(missing_ok=True)
        subprocess.run(["systemctl", "--user", "daemon-reload"], check=True)
        subprocess.run(["systemctl", "--user", "enable", "--now", "comms-deck.service",
                        "push-courier.service"], check=True, capture_output=True)
    step("install and start comms-deck.service and push-courier.service", services)

    for text, _ in steps:
        print(f"  - {text}")
    if not yes:
        print("\nNothing changed yet. Run `comms-deck install --yes` to do the above.")
        return
    for text, action in steps:
        action()
        print(f"done: {text}")
    print("\nOpen new kitty windows for the agents so they pick up remote control.")


