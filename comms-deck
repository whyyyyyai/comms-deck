        "assert x.load_seat('pollseat')['state'] == 'busy', 'no state argument still means busy'",
        "assert x.app_seat_state('pollseat') == 'away', 'set up once (history exists) but its app is gone: away'",
        "fa = x.APP_SEATS + ('freshapp',); x.APP_SEATS = fa; x.APP_PROCESS['freshapp'] = 'some-app'; (x.DATA / 'seats' / 'freshapp.json').unlink(missing_ok=True)",
        "assert x.app_seat_state('freshapp') == 'not set up', 'never touched: still not set up'",
        "box = x.DATA / 'inbox' / 'scratch-seat'",
        "box.mkdir(parents=True, exist_ok=True)",
        "(box / '1.json').write_text(json.dumps({'from': 'owner', 'text': 'token: ghp_' + 'a' * 30, 'private': True}))",
        "(box / '2.json').write_text(json.dumps({'from': 'owner', 'text': 'open the scratchpad', 'private': False}))",
        "summary = x.waiting_summary(x.pending('scratch-seat'))",
        "assert summary.startswith('2 waiting · private note') and '(+1 more)' in summary",
        "assert 'ghp_' not in summary and 'scratchpad' not in summary",
        "seat = json.loads((x.DATA / 'seats' / 'claude.json').read_text()) if (x.DATA / 'seats' / 'claude.json').exists() else {}",
        "x.activity_view(seat.get('state', 'idle'), {'rate_limits': {'five_hour': full(future)}}, now)",
        "after = json.loads((x.DATA / 'seats' / 'claude.json').read_text()) if (x.DATA / 'seats' / 'claude.json').exists() else {}",
        "assert after.get('state') == seat.get('state')",
        "print('ok')",
    ])
    r = subprocess.run([sys.executable, "-c", code], env=env, capture_output=True, text=True, timeout=30)
    check("a full plan limit is spent until its reset, and waiting notes are counted from the inbox",
          r.returncode == 0 and r.stdout.strip() == "ok", r.stdout + r.stderr)
    body = Path(tmp) / "pr-body.txt"
    body.write_text("Written by: Grok\nReviewed by: Claude\n")
    r = run(["review-check", "--file", str(body)], "grok")
    check("a review from another seat passes", r.returncode == 0 and "claude" in r.stdout, r.stdout + r.stderr)
    body.write_text("Written by: Grok\nReviewed by: Grok\n")
    r = run(["review-check", "--file", str(body)], "grok")
    check("the author's own review does not count", r.returncode != 0, r.stdout + r.stderr)
    body.write_text("Written by: Grok\n")
    r = run(["review-check", "--file", str(body)], "grok")
    check("a missing review line fails", r.returncode != 0 and "no Reviewed by" in r.stderr, r.stderr)
    body.write_text("Reviewed by: Claude\n")
    r = run(["review-check", "--file", str(body)], "grok")
    check("a review with no author line fails", r.returncode != 0 and "no Written by" in r.stderr, r.stderr)
    shutil.rmtree(tmp, ignore_errors=True)
    print(f"\n{'all passed' if not failures else f'{len(failures)} failed'}")
    return 1 if failures else 0


