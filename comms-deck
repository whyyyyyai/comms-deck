MCP_BUSY_FOR = 180       # an MCP-only app seat counts as busy this long after set_status
POLL_DEFAULT = 60        # seconds between checks assumed for an app seat that polls
POLL_RANGE = (30, 86400)  # a measured gap between checks is kept inside this (Lumo's app can only schedule daily)


def note_mcp_call(seat, name, now=None):
    """Record an MCP-only app seat's tool call: when it last checked its mail,
    and the gap since the check before, which sets its countdown."""
    if seat not in APP_SEATS or APP_PROCESS.get(seat, "grok-bot") == "grok-bot":
        return
    now = time.time() if now is None else now
    changes = {"mcp_seen": now}
    if name == "read_messages":
        last = float(load_seat(seat).get("polled_at") or 0)
        changes["polled_at"] = now
        if last and now - last > 5:  # two reads in one turn aren't a cadence
            changes["poll_gap"] = min(max(now - last, POLL_RANGE[0]), POLL_RANGE[1])
    if name == "set_status":
        changes["status_at"] = now
    update_seat(seat, **changes)


def poll_left(state, now=None):
    """Seconds until the next check. Negative once that time has passed.

    None when this seat has never checked, which is not the same as late.
    """
    now = time.time() if now is None else now
    polled = float(state.get("polled_at") or 0)
    if not polled:
        return None
    return int(polled + float(state.get("poll_gap") or POLL_DEFAULT) - now)


def poll_is_late(seat, now=None):
    """True when a polling app seat's expected check has not come back."""
    if seat not in APP_SEATS or APP_PROCESS.get(seat, "grok-bot") == "grok-bot":
        return False
    left = poll_left(load_seat(seat), now)
    return left is not None and left < 0


def poll_countdown(state, now=None):
    """'next check in 0:42', or 'check late 1:05' once the expected time has passed."""
    left = poll_left(state, now)
    if left is None:
        return "hasn't checked yet"
    clock = lambda n: f"{n // 3600}:{n % 3600 // 60:02d}:{n % 60:02d}" if n >= 3600 else f"{n // 60}:{n % 60:02d}"
    return f"next check in {clock(left)}" if left >= 0 else f"check late {clock(-left)}"


def mcp_call(seat, name, args):
    """Run one MCP tool. Returns (text, is_error)."""
    try:
        note_mcp_call(seat, name)
    except OSError:
        pass  # the record is for the screen only; never fail the tool for it
    if name == "send_message":
        record, warning = send(seat, str(args.get("to", "")), str(args.get("text", "")),
                               bool(args.get("quiet")), bool(args.get("private")))
        return (f"Sent to {record['to']}." + (f" {warning}" if warning else "")), False
    if name == "read_messages":
        notes = take(seat)
        return (render(notes, seat) if notes else "No notes waiting."), False
    if name == "add_note":
        add_note(seat, str(args.get("text", "")))
        return "Added to the commentary.", False
    if name == "set_status":
        wanted = str(args.get("state") or "").strip().lower()
        update_seat(seat, state=wanted if wanted in ("busy", "idle", "away") else "busy",
                    doing=describe(args.get("text", "")))
        return "Status set.", False
    if name == "team_status":
        return status_text(), False
    return f"Unknown tool {name}", True


def mcp_call_fresh(seat, name, arguments):
    """mcp_call() run by the program on disk, in a child process: (text, failed)."""
    request = json.dumps({"seat": seat, "name": name, "arguments": arguments})
    r = subprocess.run([sys.executable, str(PROGRAM), "mcp-call"], input=request,
                       capture_output=True, text=True, timeout=60,
                       env=dict(os.environ, COMMS_DECK_SEAT=seat))
    try:
        reply = json.loads(r.stdout)
        return reply["text"], bool(reply["failed"])
    except (ValueError, KeyError):
        return mcp_call(seat, name, arguments)  # the new code failed: answer with ours


def mcp_call_once():
    """The `mcp-call` command: one tool call from JSON on stdin, answer as JSON."""
    request = json.loads(sys.stdin.read() or "{}")
    try:
        text, failed = mcp_call(request.get("seat"), request.get("name"), request.get("arguments") or {})
    except ValueError as error:
        text, failed = str(error), True
    print(json.dumps({"text": text, "failed": failed}))


def mcp():
    """Serve MCP on stdin/stdout until stdin closes."""
    seat, _ = find_agent()
    seat = seat or "unknown"
    # The MCP server never records the seat's window: agents also start it
    # from short-lived helper processes (e.g. `claude mcp list` checking the
    # connection), which would record a pid that's gone a moment later and
    # make the seat look away. Only the hooks record it.
    out = sys.stdout

    def answer(msg_id, result=None, error=None):
        reply = {"jsonrpc": "2.0", "id": msg_id}
        reply.update({"error": error} if error else {"result": result})
        out.write(json.dumps(reply) + "\n")
        out.flush()

    for line in sys.stdin:
        try:
            msg = json.loads(line)
        except ValueError:
            continue
        method, msg_id = msg.get("method"), msg.get("id")
        if msg_id is None:
            continue  # a notification, e.g. notifications/initialized
        if method == "initialize":
            answer(msg_id, {
                "protocolVersion": (msg.get("params") or {}).get("protocolVersion", "2025-06-18"),
                "capabilities": {"tools": {}},
                "serverInfo": {"name": "comms-deck", "version": "2.0"},
                "instructions": f"You are the '{seat}' seat. Notes from other agents arrive "
                                f"on their own, starting with {MARK}. Use send_message to reply."})
        elif method == "tools/list":
            answer(msg_id, {"tools": MCP_TOOLS})
        elif method == "tools/call":
            params = msg.get("params") or {}
            try:
                if fresh_code(settle=0):
                    # This server started before the program changed (a merge
                    # into the live tree). Run the call in the program on disk,
                    # so a new seat or a fixed rule works without restarting
                    # the agent. The tool list itself stays as it was.
                    text, failed = mcp_call_fresh(seat, params.get("name"), params.get("arguments") or {})
                else:
                    text, failed = mcp_call(seat, params.get("name"), params.get("arguments") or {})
            except ValueError as error:
                text, failed = str(error), True
            answer(msg_id, {"content": [{"type": "text", "text": text}], "isError": failed})
        elif method == "ping":
            answer(msg_id, {})
        else:
            answer(msg_id, error={"code": -32601, "message": f"no method {method}"})


