def ws_mask(payload, mask):
    """XOR `payload` with the 4-byte websocket mask. Applying it twice is the identity."""
    return bytes(b ^ mask[i % 4] for i, b in enumerate(payload))


def ws_client_frame(opcode, payload, mask):
    """One masked client frame. The server rejects an unmasked client frame."""
    n = len(payload)
    head = bytes([0x80 | (opcode & 0x0F)])
    if n < 126:
        head += bytes([0x80 | n])
    elif n < 65536:
        head += bytes([0x80 | 126]) + struct.pack("!H", n)
    else:
        head += bytes([0x80 | 127]) + struct.pack("!Q", n)
    return head + mask + ws_mask(payload, mask)


def ws_parse_frame(buf):
    """Parse one frame from `buf`. Returns (fin, opcode, payload, rest), or None if short."""
    if len(buf) < 2:
        return None
    fin = bool(buf[0] & 0x80)
    opcode = buf[0] & 0x0F
    masked = buf[1] & 0x80
    length = buf[1] & 0x7F
    i = 2
    if length == 126:
        if len(buf) < 4:
            return None
        length = struct.unpack("!H", buf[2:4])[0]
        i = 4
    elif length == 127:
        if len(buf) < 10:
            return None
        length = struct.unpack("!Q", buf[2:10])[0]
        i = 10
    if length > 4_000_000:
        raise RuntimeError("websocket frame too large")
    mask = b""
    if masked:
        if len(buf) < i + 4:
            return None
        mask = buf[i:i + 4]
        i += 4
    if len(buf) < i + length:
        return None
    payload = buf[i:i + length]
    if masked:
        payload = ws_mask(payload, mask)
    return fin, opcode, payload, buf[i + length:]


class Cdp:
    """A small Chrome DevTools Protocol client over one websocket."""

    def __init__(self, sock, leftover=b""):
        """Keep the socket, any bytes past the handshake, and the next call id."""
        self.sock = sock
        self.buf = leftover
        self.next_id = 0

    def close(self):
        """Close the socket. Closing twice is fine."""
        try:
            self.sock.close()
        except OSError:
            pass

    def send_frame(self, opcode, payload):
        """Send one masked client frame."""
        self.sock.sendall(ws_client_frame(opcode, payload, secrets.token_bytes(4)))

    def _read_more(self):
        """Read more bytes, or raise if the socket closed."""
        chunk = self.sock.recv(65536)
        if not chunk:
            raise RuntimeError("websocket closed")
        self.buf += chunk

    def read_message(self):
        """The next data message, answering ping frames on the way."""
        parts = []
        opcode = None
        while True:
            parsed = ws_parse_frame(self.buf)
            while parsed is None:
                self._read_more()
                parsed = ws_parse_frame(self.buf)
            fin, op, payload, self.buf = parsed
            if op == 9:  # ping
                self.send_frame(10, payload)
                continue
            if op == 8:
                raise RuntimeError("websocket closed")
            if op == 10 or op not in (0, 1, 2):
                continue
            if op != 0:
                opcode = op
                parts = [payload]
            else:
                parts.append(payload)
            if fin:
                return opcode, b"".join(parts)

    def call(self, method, params=None, timeout=8):
        """Send one DevTools command and return its result. Raise on error or timeout."""
        self.next_id += 1
        mid = self.next_id
        self.send_frame(1, json.dumps({"id": mid, "method": method, "params": params or {}}).encode())
        deadline = time.time() + timeout
        while time.time() < deadline:
            self.sock.settimeout(max(0.2, deadline - time.time()))
            opcode, payload = self.read_message()
            if opcode != 1:
                continue
            try:
                msg = json.loads(payload.decode())
            except ValueError:
                continue
            if msg.get("id") != mid:
                continue
            if "error" in msg:
                raise RuntimeError("cdp call failed")
            return msg.get("result")
        raise TimeoutError(method)


def cdp_connect(ws_url):
    """Open a debugger websocket. The host must be loopback."""
    match = re.match(r"^ws://([^/:]+)(?::(\d+))?(/.*)$", ws_url)
    if not match:
        raise RuntimeError("refusing debugger url")
    host, port, path = match.group(1), int(match.group(2) or 80), match.group(3)
    if host not in ("127.0.0.1", "localhost"):
        raise RuntimeError("refusing debugger host")
    sock = socket.create_connection(("127.0.0.1", port), timeout=5)
    sock.settimeout(5)
    key = base64.b64encode(secrets.token_bytes(16)).decode()
    req = (f"GET {path} HTTP/1.1\r\nHost: {host}:{port}\r\nUpgrade: websocket\r\n"
           f"Connection: Upgrade\r\nSec-WebSocket-Key: {key}\r\nSec-WebSocket-Version: 13\r\n\r\n")
    sock.sendall(req.encode())
    data = b""
    while b"\r\n\r\n" not in data:
        chunk = sock.recv(4096)
        if not chunk:
            break
        data += chunk
        if len(data) > 8192:
            break
    head, _, leftover = data.partition(b"\r\n\r\n")
    accept = base64.b64encode(hashlib.sha1((key + _WS_GUID).encode()).digest()).decode()
    if b" 101 " not in head.split(b"\r\n", 1)[0] or accept.encode() not in head:
        sock.close()
        raise RuntimeError("debugger refused the websocket")
    return Cdp(sock, leftover)


def open_grok_bot_page():
    """The Grok Bot renderer page on 127.0.0.1, or raise if it isn't there."""
    req = urllib.request.Request(f"http://127.0.0.1:{GROK_BOT_PORT}/json/list")
    with urllib.request.urlopen(req, timeout=2) as resp:
        targets = json.loads(resp.read().decode())
    for target in targets:
        url = target.get("url") or ""
        ws = target.get("webSocketDebuggerUrl") or ""
        if target.get("type") == "page" and GROK_BOT_PAGE in url and ws.startswith("ws://"):
            return cdp_connect(ws)
    raise RuntimeError("no grok-bot page")


def cdp_eval(cdp, expression):
    """Run JavaScript in the page and return its value."""
    result = cdp.call("Runtime.evaluate", {"expression": expression, "returnByValue": True})
    if not isinstance(result, dict) or result.get("exceptionDetails"):
        raise RuntimeError("page script failed")
    return (result.get("result") or {}).get("value")


def page_script(template, seat):
    """Put this seat's name into a page script, in place of __SEAT__."""
    return template.replace("__SEAT__", json.dumps(seat))


def app_snapshot(cdp, seat, with_usage):
    """Read one seat's chat from the page: rows, composer, and usage when asked."""
    script = _SNAP_JS.replace("__SEAT__", json.dumps(seat)).replace(
        "__USAGE__", "true" if with_usage else "false")
    snap = cdp_eval(cdp, script)
    if not isinstance(snap, dict) or snap.get("error"):
        raise RuntimeError("page script failed")
    return snap


def row_key_order(key):
    """Sort a transcript row key. The number after @ is the message order."""
    match = re.search(r"@(\d+)", key or "")
    return (int(match.group(1)) if match else 0, key or "")


def join_assistant(messages):
    """Assistant bubbles, with rows marked continued-next joined into one."""
    groups, buf, key, start = [], [], None, None

    def flush():
        nonlocal buf, key, start
        text = "\n".join(part for part in buf if part).strip()
        if key and text:
            groups.append({"key": key, "text": text, "start": start})
        buf, key, start = [], None, None

    for msg in messages:
        if not str(msg.get("key") or "").startswith("t"):
            continue
        if msg.get("role") != "assistant":
            flush()
            continue
        if start is None:
            start = msg.get("key")
        buf.append(msg.get("text") or "")
        key = msg.get("key")
        if not msg.get("continued"):
            flush()
    flush()
    return groups


def new_assistant_replies(messages, cursor):
    """Assistant bubbles newer than `cursor`. The first sight files nothing.

    Returns (replies, new cursor). `new cursor` is None when there is nothing
    on the page yet, so the baseline waits until a row is actually visible.
    """
    keys = [m.get("key") for m in messages or [] if str(m.get("key") or "").startswith("t")]
    newest = max(keys, key=row_key_order) if keys else None
    if not cursor:
        return [], newest
    fresh = []
    for group in join_assistant(messages or []):
        if row_key_order(group["key"]) > row_key_order(cursor) and row_key_order(group["start"]) > row_key_order(cursor):
            fresh.append({"key": group["key"], "text": group["text"]})
    new_cursor = cursor
    if newest and row_key_order(newest) > row_key_order(cursor):
        new_cursor = newest
    return fresh, new_cursor


def reply_target(text):
    """Where an app seat's reply goes: a seat named at the start, or the owner."""
    match = re.match(r"\s*@([A-Za-z][\w-]*)", text or "")
    if match:
        name = match.group(1).lower()
        if name in SEATS and name != "owner":
            return name
    return "owner"


def app_delivery_allowed(snapshot, focused, state, seat):
    """True when a note may be typed into this chat right now."""
    if not snapshot.get("open") or snapshot.get("replying"):
        return False
    if snapshot.get("composer") is None or snapshot.get("composer"):
        return False
    if focused is None or focused:
        return False
    if state.get("auto", 0) >= AUTO_LIMIT and not owner_waiting(seat):
        return False
    return True


def usage_record(usage, now_ts=None):
    """The chat panel's usage file for one reading of the account weekly limit."""
    if not isinstance(usage, dict):
        return None
    pct = usage.get("used_percentage")
    reset = usage.get("resets_at")
    if not isinstance(pct, (int, float)) or isinstance(pct, bool):
        return None
    if not isinstance(reset, (int, float)) or isinstance(reset, bool):
        return None
    reset = int(reset / 1000) if reset > 1e12 else int(reset)
    return {
        "time": time.time() if now_ts is None else now_ts,
        "source": "grok-bot",
        "data": {
            "model": {"display_name": "account usage, shared by all bots"},
            "rate_limits": {"seven_day": {"used_percentage": pct, "resets_at": reset}},
        },
    }


def write_app_usage(seat, usage):
    """Save the weekly account usage. Skip a repeat inside a minute."""
    record = usage_record(usage)
    if not record:
        return False
    path = DATA / "usage" / f"{seat}.json"
    prev = read_json(path) or {}
    prev_week = dig(prev, "data", "rate_limits", "seven_day") or {}
    week = record["data"]["rate_limits"]["seven_day"]
    if (prev.get("source") == "grok-bot" and prev_week.get("resets_at") == week["resets_at"]
            and isinstance(prev_week.get("used_percentage"), (int, float))
            and abs(prev_week["used_percentage"] - week["used_percentage"]) < 0.05
            and time.time() - float(prev.get("time") or 0) < APP_USAGE_EVERY):
        return False
    write_json(path, record)
    return True


def app_window_focused():
    """True when the Grok Bot window is focused, or when focus can't be read."""
    try:
        result = subprocess.run(["hyprctl", "activewindow", "-j"],
                                capture_output=True, text=True, timeout=2)
        if result.returncode != 0 or not result.stdout.strip():
            return True
        return json.loads(result.stdout).get("class") == "grok-bot"
    except (OSError, subprocess.SubprocessError, ValueError):
        return True


def grok_bot_open():
    """True when a grok-bot process is running."""
    for entry in Path("/proc").iterdir():
        if not entry.name.isdigit():
            continue
        try:
            if (entry / "comm").read_text().strip() == "grok-bot":
                return True
        except OSError:
            continue
    return False


def mark_app_down(seat, state):
    """The page can't be read. Remember that, and say so once when it changes."""
    new = "not connected" if grok_bot_open() else "away"
    if state.get("state") != new:
        log(f"app seat {seat}: {new}")
    update_seat(seat, state=new, app_seen=time.time(), app_page="grok-bot")


def reply_already_logged(seat, text):
    """True when this seat already filed the same words, so a chat copy is not sent again."""
    needle = (text or "").strip()
    path = DATA / "log.jsonl"
    if not needle or not path.exists():
        return False
    try:
        blob = path.read_bytes()[-200000:]
    except OSError:
        return False
    for line in blob.splitlines()[-40:]:
        try:
            record = json.loads(line)
        except ValueError:
            continue
        if record.get("from") == seat and (record.get("text") or "").strip() == needle:
            return True
    return False


def file_app_replies(seat, state, snap):
    """File assistant bubbles newer than the cursor.

    The first sight only stores the newest row. The second sight catches the
    cursor up again and still files nothing, so rows that appear once the
    transcript has scrolled are not posted as new replies. After that, assistant
    text is filed. Nothing is filed or moved while a reply is still being written,
    so a growing bubble is posted once, when it finishes.
    """
    if snap.get("replying"):
        return
    fresh, cursor = new_assistant_replies(snap.get("messages") or [], state.get("app_cursor"))
    if not state.get("app_cursor"):
        if cursor:
            update_seat(seat, app_cursor=cursor)
        return
    if not state.get("app_primed"):
        update_seat(seat, app_cursor=cursor or state.get("app_cursor"), app_primed=True)
        return
    for reply in fresh:
        if reply_already_logged(seat, reply["text"]):
            continue
        send(seat, reply_target(reply["text"]), reply["text"])
    if cursor and cursor != state.get("app_cursor"):
        update_seat(seat, app_cursor=cursor)


def app_key(cdp, kind, key, code, vk, modifiers=0, text=None):
    """Send one key event to the Grok Bot page."""
    params = {"type": kind, "key": key, "code": code, "windowsVirtualKeyCode": vk,
              "nativeVirtualKeyCode": vk, "modifiers": modifiers}
    if text is not None:
        params["text"] = text
    cdp.call("Input.dispatchKeyEvent", params)


def app_press_enter(cdp):
    """Press Enter. This page submits on the Send click; Enter is only a fallback."""
    app_key(cdp, "keyDown", "Enter", "Enter", 13, text="\r")
    app_key(cdp, "keyUp", "Enter", "Enter", 13)


def app_click_send_button(cdp):
    """Click Send at its on-screen point. A DOM click does not submit this composer."""
    box = cdp_eval(cdp, r"""(() => {
      const button = document.querySelector('button[aria-label="Send message"]');
      if (!button) return null;
      const rect = button.getBoundingClientRect();
      if (rect.width < 1 || rect.height < 1) return null;
      return {x: rect.x + rect.width / 2, y: rect.y + rect.height / 2};
    })()""")
    if not isinstance(box, dict):
        return False
    for kind in ("mousePressed", "mouseReleased"):
        cdp.call("Input.dispatchMouseEvent", {
            "type": kind, "x": box["x"], "y": box["y"], "button": "left", "clickCount": 1})
    return True


def app_clear_composer(cdp):
    """Select all and delete, so a note that did not send is not left in the box."""
    app_key(cdp, "keyDown", "a", "KeyA", 65, modifiers=2)
    app_key(cdp, "keyUp", "a", "KeyA", 65, modifiers=2)
    app_key(cdp, "keyDown", "Backspace", "Backspace", 8)
    app_key(cdp, "keyUp", "Backspace", "Backspace", 8)


def composer_text_now(cdp):
    """The composer's text right now, or None if the page has no composer."""
    value = cdp_eval(cdp, _COMPOSER_JS)
    return None if value is None else str(value)


def restore_notes(seat, notes):
    """Write the notes back into the inbox after a send that did not land.

    take() has already renamed them into delivered/. Those copies stay.
    """
    for record in notes:
        write_json(DATA / "inbox" / seat / f"{record['id']}.json", record)


def wake_failure_reason(error):
    """One short line for the service log. The note text is never included."""
    reason = str(error).splitlines()[0].strip()
    if not reason or MARK in reason:
        reason = type(error).__name__
    return reason[:120]


def squash(text):
    """Text with every run of whitespace made one space. The chat box turns each
    newline into a paragraph, so an exact match never finds our note in it."""
    return re.sub(r"\s+", " ", text or "").strip()


APP_RETRY = (60, 900)  # after a failed send: wait 60 s, doubling, at most 15 min


def deliver_app_notes(seat, state, cdp):
    """take() the waiting notes, type them, and put them back if the send fails."""
    if time.time() < float(state.get("app_retry_at") or 0):
        return False  # backing off after a failed send, not retrying every pass
    snap = app_snapshot(cdp, seat, with_usage=False)
    if not app_delivery_allowed(snap, app_window_focused(), state, seat):
        return False
    notes = take(seat, include_quiet=False, limit_chars=HANDOVER_MAX)
    if not notes:
        return False
    text = render(notes, seat)
    marker = squash(text)[:120]
    in_box = lambda: marker in squash(composer_text_now(cdp))
    update_seat(seat, state="busy", auto=next_auto(state, notes), woke_at=time.time(),
                app_seen=time.time(), app_page="grok-bot", doing=describe_notes(notes))
    try:
        if not cdp_eval(cdp, _FOCUS_JS):
            raise RuntimeError("no composer")
        cdp.call("Input.insertText", {"text": text})
        if in_box():
            if not app_click_send_button(cdp):
                app_press_enter(cdp)
            time.sleep(0.4)
        if in_box():
            app_press_enter(cdp)
            time.sleep(0.3)
        deadline = time.time() + 1.5
        while in_box() and time.time() < deadline:
            time.sleep(0.2)
        if in_box():
            cdp_eval(cdp, _FOCUS_JS)
            app_clear_composer(cdp)
            time.sleep(0.2)
            raise RuntimeError("composer still holds the note")
        cdp_eval(cdp, _SCROLL_JS)
        time.sleep(0.2)
        # The bubble has to be a user message. An empty composer alone can mean the insert missed.
        # Compare with runs of whitespace collapsed: the chat renders blank lines
        # differently, and a strict match called a sent note failed and sent it twice.
        landed = cdp_eval(cdp, "(() => { const squash = t => (t||'').replace(/\\s+/g,' ').trim();"
                          " const want = " + json.dumps(marker) + ";"
                          " return [...document.querySelectorAll('.sand-message')]"
                          ".some(m => m.getAttribute('data-role')==='user' && squash(m.innerText).includes(want)); })()")
        if not landed:
            raise RuntimeError("the note never reached the chat")
    except Exception as error:
        restore_notes(seat, notes)
        fails = int(state.get("app_fails") or 0) + 1
        wait = min(APP_RETRY[0] * 2 ** (fails - 1), APP_RETRY[1])
        update_seat(seat, state="idle", app_seen=time.time(), app_fails=fails, app_retry_at=time.time() + wait)
        log(f"couldn't wake {seat}: send failed: {wake_failure_reason(error)}; next try in {wait}s")
        return False
    update_seat(seat, app_fails=0, app_retry_at=0)
    log(f"woke {seat} with {len(notes)} note(s)")
    return True


def drive_app_seat(seat, cdp, focused):
    """Read one app seat's chat, file new replies, and type a waiting note."""
    state = load_seat(seat)
    prev_usage = read_json(DATA / "usage" / f"{seat}.json") or {}
    with_usage = time.time() - float(prev_usage.get("time") or 0) >= APP_USAGE_EVERY
    snap = app_snapshot(cdp, seat, with_usage)
    if not snap.get("has_row"):
        update_seat(seat, state="no chat yet", app_seen=time.time(), app_page="grok-bot")
        return False  # this seat has no chat in the Grok Bot window
    if with_usage:
        write_app_usage(seat, snap.get("usage"))
    if not snap.get("open"):
        waiting = any(not record.get("quiet") for _, record in pending(seat))
        if waiting and not focused and not snap.get("replying"):
            cdp_eval(cdp, page_script(_CLICK_JS, seat))
        update_seat(seat, state="chat not open", app_seen=time.time(), app_page="grok-bot")
        return False
    file_app_replies(seat, state, snap)
    waiting = any(not record.get("quiet") for _, record in pending(seat))
    changes, stale = draft_status(state, snap.get("composer"), time.time())
    if changes:
        state.update(update_seat(seat, **changes))
    leftover = (snap.get("composer") or "").startswith(MARK)  # the deck's own text from a failed send
    if (stale or leftover) and waiting and focused is False and not snap.get("replying"):
        draft = snap.get("composer") or ""
        minutes = int((time.time() - float(state.get("app_draft_since") or time.time())) // 60)
        cdp_eval(cdp, _FOCUS_JS)
        app_clear_composer(cdp)
        time.sleep(0.2)
        if not (composer_text_now(cdp) or "").strip() and leftover:
            log(f"{seat}: cleared the deck's own text left from a failed send")
            state.update(update_seat(seat, app_draft="", app_draft_since=0))
            snap["composer"] = ""
        elif not (composer_text_now(cdp) or "").strip():
            send("deck", "owner", f"{seat.title()}'s chat box held an unsent draft for {minutes} minutes, "
                                  f"so no notes could be typed in. I cleared it; here is what it said:\n\n{draft}",
                 private=True)
            log(f"{seat}: cleared a draft left unchanged for {minutes} min")
            state.update(update_seat(seat, app_draft="", app_draft_since=0))
            snap["composer"] = ""
    if snap.get("replying"):
        page_state = "busy"
    elif waiting and (snap.get("composer") or "").strip():
        page_state = "draft in box"  # not idle: a draft is holding the notes back
    else:
        page_state = "idle"
    update_seat(seat, state=page_state, app_seen=time.time(), app_page="grok-bot")
    if not waiting:
        return False
    if state.get("auto", 0) >= AUTO_LIMIT and not owner_waiting(seat):
        pause_notice(seat)
        return False
    if not app_delivery_allowed(snap, focused, state, seat):
        return False
    return deliver_app_notes(seat, state, cdp)


def try_app_seats():
    """One pass over the Grok Bot window for every app seat that lives there."""
    if not APP_SEATS:
        return
    if not GROK_BOT_SEATS():
        return
    focused = app_window_focused()
    try:
        cdp = open_grok_bot_page()
    except (OSError, RuntimeError, TimeoutError, ValueError, urllib.error.URLError):
        for seat in GROK_BOT_SEATS():
            state = load_seat(seat)
            if state.get("app_page") == "grok-bot":
                mark_app_down(seat, state)
        return
    try:
        cdp_eval(cdp, _SCROLL_JS)
        time.sleep(0.2)
        for seat in GROK_BOT_SEATS():
            try:
                drive_app_seat(seat, cdp, focused)
            except Exception as error:
                log(f"app seat {seat} failed: {type(error).__name__}")
    finally:
        cdp.close()


