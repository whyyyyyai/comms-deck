# -----------------------------------------------------------------------------
# SECTION 8b: desktop actions - "@deck <action>" in any note
# -----------------------------------------------------------------------------
#
# Any seat (an app seat like alice included) can ask comms-deck itself to do
# something on this desktop by writing a line that starts "@deck", e.g.
#   @deck scratchpad          @deck workspace 3        @deck layout
#   @deck open https://...    @deck youtube lofi beats @deck help
# The service runs a FIXED list of actions with the desktop session's own
# environment, so it works whether or not the asker can run commands, and
# without any LLM. Nothing else is run: no shell, no arbitrary programs.
# That matters because app seats read the web, and a page must not be able
# to make one of them run commands here. A request that isn't on the list is
# handed to a free agent (claude, grok, gravity) as a task note only when the
# owner or one of those agents asked; from anyone else (an app seat) it is
# refused with "not on the list", so a web page can't give an agent orders
# through an app seat's reply (found by Grok). The answer keeps the note's
# private flag. Every action is logged, answered with a note "from deck",
# and shown on the chat screen.

DECK_LINE = re.compile(r"^\s*@deck\b[ \t]*(.*)$", re.IGNORECASE | re.MULTILINE)
ACTION_RATE = 10  # at most this many actions a minute, from everyone together
HANDOFF_FROM = ("owner", "claude", "grok", "gravity")  # who may pass an unlisted request to an agent


def hypr_dispatch(expr):
    """Run one Hyprland dispatcher (Lua form). Raise if Hyprland refuses."""
    result = subprocess.run(["hyprctl", "dispatch", expr], capture_output=True, text=True, timeout=5)
    if result.returncode or result.stdout.strip() != "ok":
        raise RuntimeError((result.stdout or result.stderr).strip() or "hyprctl failed")


def launch(*cmd):
    """Start a program detached from the service, so it outlives it.

    Returns "" when it started, or "would " on a dry run, to put before the answer."""
    if setting("DRY_ACTIONS"):
        log(f"(dry run) would start: {' '.join(cmd)}")
        return "would "
    subprocess.Popen(cmd, start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return ""


def act_scratchpad(arg):
    if setting("DRY_ACTIONS"):
        return "would toggle the scratchpad"
    hypr_dispatch('hl.dsp.workspace.toggle_special("magic")')
    return "toggled the scratchpad"


def act_workspace(arg):
    if not re.fullmatch(r"(10|[1-9])", arg.strip()):
        raise ValueError("give a workspace number from 1 to 10")
    if setting("DRY_ACTIONS"):
        return f"would switch to workspace {arg.strip()}"
    hypr_dispatch(f"hl.dsp.focus({{ workspace = {int(arg)} }})")
    return f"switched to workspace {int(arg)}"


def act_open(arg):
    url = arg.strip()
    if not re.fullmatch(r"https://[^\s\"'<>]+", url) or len(url) > 2000:
        raise ValueError("only a single https:// link can be opened")
    return launch("firefox", "--new-tab", url) + f"open {url[:80]} in Firefox"


def act_youtube(arg):
    query = re.sub(r"\s+", " ", arg).strip()
    if not query or len(query) > 200:
        raise ValueError("give a YouTube search of up to 200 characters")
    import urllib.parse
    return (launch("firefox", "--new-tab", "https://www.youtube.com/results?search_query=" + urllib.parse.quote_plus(query))
            + f"open a YouTube search for {query[:60]!r} in Firefox")


def act_layout(arg):
