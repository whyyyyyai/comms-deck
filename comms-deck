# SECTION 12b: kitten - one small cat, for no reason the program needs
# -----------------------------------------------------------------------------
#
# The deck is called quantum-kittens. This section prints a small one. It is
# decorative on purpose: it reads no state, sends nothing and changes nothing.
# Like everything else in here it is plain code, not an AI: sha256 of the
# date (and the seat's name) picks the face, so everyone on every machine
# gets the same kitten of the day, and the same kitten can't be unfixed by a
# random seed. Written by: Mystra (2026-11-25).


KITTEN_NAMES = ("Mochi", "Pixel", "Bagel", "Biscuit", "Comet", "Toffee",
                "Wasabi", "Nimbus", "Pudding", "Ziggy")
KITTEN_EYES = ("o.o", "^.^", "> <", "0.0", "=.=", "@.@")

def kitten_lines(which):
    """The lines of one kitten. `which` (a date, or 'seat on date') picks the
    face, so kitten-of-the-day is one shared kitten on every machine, worked
    out by sha256 like everything else in here - no randomness, no AI."""
    seed = int(hashlib.sha256(which.encode()).hexdigest(), 16)
    eyes = KITTEN_EYES[seed % len(KITTEN_EYES)]
    mouth = ("^", "w", "o", ".", "~")[seed // len(KITTEN_EYES) % 5]
    tail = (" ~", " /", " ?", "")[seed // 61 % 4]
    ears = "/\\_/\\"   # ears: /\_/\
    return [ears,
            f"( {eyes} )",
            f" > {mouth} <" + tail]


def kitten_block(name, day):
    """One kitten plus its seat's name under it, never a truncated name: the
    block is as wide as the wider of the picture and the name."""
    picture = kitten_lines(f"{name} on {day}")
    width = max(max(len(line) for line in picture), len(name))
    return [line.ljust(width) for line in picture] + [name.center(width)]


def kitten_row(blocks):
    """Blocks side by side, two spaces apart, one flat picture."""
    height = max(len(block) for block in blocks)
    widths = [max(len(line) for line in block) for block in blocks]
    full = [[line.ljust(width) for line in block] + [" " * width] * (height - len(block))
            for block, width in zip(blocks, widths)]
    return ["  ".join(parts).rstrip() for parts in zip(*full)]


def kitten(name="", everyone=False):
    """The kitten verb: no argument, the shared kitten of the day; a seat
    name, that seat's own kitten; --all, the whole team. Pure decoration."""
    day = now()[:10]
    header = KITTEN_NAMES[int(hashlib.sha256(day.encode()).hexdigest(), 16) % len(KITTEN_NAMES)]
    if everyone:
        lines = [f"the team on {day} - kitten of the day: {header}"]
        row = []
        for seat in tuple(AGENTS) + APP_SEATS:
            block = kitten_block(seat, day)
            width = max(len(line) for line in block)
            if row and sum(max(len(line) for line in b) + 2 for b in row) + width > 78:
                lines += kitten_row(row)
                row = []
            row.append(block)
        if row:
            lines += kitten_row(row)
        return "\n".join(lines)
    if name and name not in SEATS:
        raise ValueError(f"no seat called {name!r}; seats are: {', '.join(SEATS)},"
                         " or leave it off for the kitten of the day")
    picture = kitten_lines(f"{name} on {day}" if name else f"{day}")
    for_ = f", for {name}" if name else ""
    return "\n".join(picture + [f"kitten of the day: {header} ({day}{for_})"])


