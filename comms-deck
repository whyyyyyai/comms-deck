# The live chat view (`comms-deck chat`): a full-screen log for a spare
# workspace. Notes scroll in the top part of the terminal; the bottom line is
# a status bar that stays put (an ANSI scroll region), showing each seat.

SEAT_COLOURS = {"claude": 208, "grok": 45, "codex": 78, "vibe": 203, "devin": 141, "owner": 220,
                "push-courier": 245}
# One symbol per state, so busy and idle differ at a glance (not by colour alone).
STATE_MARKS = {"busy": "●", "idle": "○", "away": "·"}
STATE_COLOURS = {"busy": 208, "idle": 78, "away": 240, "connected": 78, "not connected": 214,
                 "chat not open": 214, "no chat yet": 240, "not set up": 240}


def colour(seat):
    """A 256-colour code for `seat` (stable for seats without one)."""
    return SEAT_COLOURS.get(seat, 140 + sum(map(ord, seat)) % 40)


def chat_lines(r, width):
    """The terminal lines for one record, wrapped to `width`."""
    import textwrap
    esc = "\033["
    name = shown_name
    who = f"{esc}1;38;5;{colour(r['from'])}m{name(r['from'])}{esc}0m"
    if r["kind"] == "message":
        to = "everyone" if r["to"] == "all" else ", ".join(name(t) for t in r["to"].split("+"))
        head = f"{who} {esc}2m→{esc}0m {esc}38;5;{colour(r['to'])}m{to}{esc}0m"
        tags = "".join(f"  {esc}2m{t}{esc}0m" for t, on in
                       (("quiet", r.get("quiet")), ("private", r.get("private"))) if on)
        body_style = ""
    else:
        head, tags, body_style = f"{who} {esc}2mcommentary{esc}0m", "", f"{esc}3;2m"
    lines = [f"{esc}2m{r['time'][11:16]}{esc}0m  {head}{tags}"]
    for para in r["text"].splitlines() or [""]:
        for line in textwrap.wrap(para, max(20, width - 9)) or [""]:
            lines.append(f"       {body_style}{line}{esc}0m")
    return lines + [""]


ANSI = re.compile(r"\033\[[0-9;?]*[A-Za-z]")


def visible_len(text):
    """Length of `text` on screen, ignoring colour codes."""
    return len(ANSI.sub("", text))


def fit(text, width):
    """Pad or cut `text` to exactly `width` columns on screen."""
    n = visible_len(text)
    if n <= width:
        return text + " " * (width - n) + "\033[0m"
    return ANSI.sub("", text)[:max(0, width - 1)] + "…"


def bar(pct, width, step=None, animate=True):
    """A coloured bar for a 0-100 percentage, pulsing like the context rows.

    Same holographic recipe (the owner, 02:15): the threshold hue never
    changes (green/amber/red by how full), each cell breathes
    dim/normal/bold, and one white glint sweeps left to right. The phase
    is now continuous in time (a float on the 0-8 breathe cycle), so on
    the fast redraw clock the wave and glint glide instead of stepping.
    `step` freezes the phase (tests). `animate=False` (the agent is
    idle, 04:02) draws a still fill in the threshold hue: no breathing,
    no glint, no trail -- bars only glow while the agent works.
    """
    pct = max(0.0, min(100.0, float(pct)))
    full = round(width * pct / 100)
    shade = 78 if pct < 60 else 214 if pct < 85 else 196
    fstep = float(step) if step is not None else time.time() / PULSE_EVERY
    glint = (fstep * 2) % (width + 4) - 2
    esc = "\033["
    cells = []
    for pos in range(width):
        if pos >= full:
            cells.append(f"{esc}0;38;5;238m░{esc}0m")
        elif not animate:
            cells.append(f"{esc}38;5;{shade}m█{esc}0m")
        elif abs(pos - glint) <= 0.5:
            cells.append(f"{esc}1;38;5;255m█{esc}0m")  # the foil's white glint
        elif 0 < glint - pos <= 1.5:
            cells.append(f"{esc}38;5;250m█{esc}0m")    # its fading trail
        else:
            cells.append(f"{esc}{breathe_style(shade, pos + fstep)}m█{esc}0m")
    return "".join(cells)


def short_tokens(n):
    """1234567 -> '1.2M', 228000 -> '228k'."""
    n = float(n)
    for unit, size in (("M", 1e6), ("k", 1e3)):
        if n >= size:
            return f"{n / size:.1f}{unit}".replace(".0" + unit, unit)
    return f"{n:.0f}"


def when(ts, now=None):
    """A time for the panel: '15:02' today, 'tomorrow 15:02', 'Wed 15:02' up to
    6 days away, 'Dec 9 15:02' further (agreed with Alice, 08:18).

    Past times (an agent's 'since') use the weekday within 6 days, else the date.
    """
    import datetime
    now = time.time() if now is None else now
    t = datetime.datetime.fromtimestamp(ts)
    days = (t.date() - datetime.datetime.fromtimestamp(now).date()).days
    clock = t.strftime("%H:%M")
    if days == 0:
        return clock
    if days == 1:
        return f"tomorrow {clock}"
    if abs(days) <= 6:
        return f"{t.strftime('%a')} {clock}"
    return f"{t.strftime('%b')} {t.day} {clock}"


def ago(seconds):
    """How long ago, for the panel: '45s ago', '12m ago', '3h ago'."""
    seconds = int(max(0, seconds))
    if seconds < 90:
        return f"{seconds}s ago"
    if seconds < 5400:
        return f"{seconds // 60}m ago"
    return f"{seconds // 3600}h ago"


def limit_reset(data, now=None):
    """When a full plan limit in `data` resets: a time, math.inf if unknown, or None.

    None means nothing is full. With several full limits, the latest reset
    wins, since the agent is blocked until every one of them clears.
    """
    now = time.time() if now is None else now
    limits = data.get("rate_limits") if isinstance(data, dict) else None
    if not isinstance(limits, dict):
        return None
    latest = None
    for entry in limits.values():
        if not isinstance(entry, dict):
            continue
        used = entry.get("used_percentage")
        if isinstance(used, bool) or not isinstance(used, (int, float)) or used < 100:
            continue
        reset = entry.get("resets_at")
        if isinstance(reset, bool) or not isinstance(reset, (int, float)):
            reset = math.inf
        elif reset > 1e12:  # milliseconds, the shape some meters emit
            reset = reset / 1000
        if reset > now:
            latest = reset if latest is None else max(latest, reset)
    return latest


SPENT_DIR = "limits"  # DATA/limits/<seat>.json: {"resets_at": unix time} set by `comms-deck spent`


def spent_mark(seat, now=None):
    """The reset time from a `comms-deck spent` mark, or None if unset or past.

    For an agent with no usage meter (Gravity's agy has none). A mark that
    has passed counts as cleared, so the row reverts with no agent and no
    service; the file is only tidied by the next `comms-deck spent`.
    """
    now = time.time() if now is None else now
    mark = read_json(DATA / SPENT_DIR / f"{seat}.json") or {}
    reset = mark.get("resets_at")
    if isinstance(reset, bool) or not isinstance(reset, (int, float)) or reset <= now:
        return None
    return float(reset)


def seat_spent(seat, now=None):
    """True when `seat` is spent, by its usage meter or a `comms-deck spent` mark."""
    usage = (read_json(DATA / "usage" / f"{seat}.json") or {}).get("data") or {}
    return spent_reset(usage, spent_mark(seat, now), now) is not None


def spent_reset(data, marked=None, now=None):
    """The later of the meter's reset and the mark's, or None if neither says spent."""
    times = [t for t in (limit_reset(data, now), marked) if t is not None]
    return max(times) if times else None


def countdown(reset, now=None):
    """'back in 6d 19h 12m', 'back in 1h 12m 05s', 'back in 42m 05s', or 'back: time unknown'."""
    if reset is None or reset == math.inf:
        return "back: time unknown"
    left = max(0, int(reset - (time.time() if now is None else now)))
    days, rest = divmod(left, 86400)
    hours, rest = divmod(rest, 3600)
    minutes, seconds = divmod(rest, 60)
    if days:
        return f"back in {days}d {hours}h {minutes:02d}m"
    if hours:
        return f"back in {hours}h {minutes:02d}m {seconds:02d}s"
    return f"back in {minutes}m {seconds:02d}s"


def metric_time(seconds):
    """A countdown to the millisecond, metric style: '6d 19:12:07.456',
    '1:12:05.000', '42:05.500'. The owner asked for ms on the ACTIVITY
    cooldowns (the deck redraws fast while one is live)."""
    ms = max(0, int(round(seconds * 1000)))
    days, ms = divmod(ms, 86400000)
    hours, ms = divmod(ms, 3600000)
    minutes, ms = divmod(ms, 60000)
    secs, ms = divmod(ms, 1000)
    if days:
        return f"{days}d {hours:02d}:{minutes:02d}:{secs:02d}.{ms:03d}"
    if hours:
        return f"{hours}:{minutes:02d}:{secs:02d}.{ms:03d}"
    return f"{minutes}:{secs:02d}.{ms:03d}"


def idle_until(reset, now=None):
    """'idle until Tue 05:08 · 6d 19:12:07.456': when a spent agent is back,
    to the millisecond while the row counts down."""
    if reset is None or reset == math.inf:
        return "idle until its limit resets"
    left = reset - (time.time() if now is None else now)
    # Metric time to the ms once the row counts down live (< 1 h, when the
    # screen redraws fast); the coarse countdown beyond that.
    tail = metric_time(left) if left < 3600 else countdown(reset, now)[len("back in "):]
    return f"idle until {when(reset)} · {tail}"


# The ACTIVITY list is sorted by how available each agent is, most available
# first (the owner's ranking): ready, busy, stuck; then the rows that can't
# take work now (away, app not connected); idle until its limit resets is
# always last. Within a level, fewer
# notes waiting ranks higher (each one weighs an agent down); then seat order.
AVAILABILITY = {"ready": 0, "busy": 1, "stuck": 3, "draft in box": 3,
                "idle": 4,  # a polling seat whose check is late: not stuck, not ready
                "away": 5, "chat not open": 6, "not connected": 6, "no chat yet": 6, "not set up": 6,
                "spent": 7}  # idle until its limit resets: always the bottom (the owner, 07:23)


def seat_title(seat, online=False):
    """A seat's display name. Easter egg (the owner, 2026-11-26): Gravity is
    Gravity while offline and Antigravity while it's online."""
    return "Antigravity" if seat == "gravity" and online else shown_name(seat)


def availability(seat, state, now=None, snap=None):
    """How available `seat` is, as the ACTIVITY panel shows it and the router uses it.

    One function for both, so the screen always shows who the next task
    would go to. `state` is the seat file's state (or an app seat's). Returns
    a dict: rank (level, notes waiting; lower is more available), word
    ("ready", "busy", "stuck", "spent", ...), mark, shade, waiting, usage.
    `snap`, when given (the chat screen's panel_scans snapshot), is where
    the waiting count comes from.
    """
    usage = (read_json(DATA / "usage" / f"{seat}.json") or {}).get("data") or {}
    waiting = len(pending(seat)) if snap is None else len(snap["waiting"].get(seat, ()))
    mark, word, shade = activity_view(state, usage, now, waiting=waiting, marked=spent_mark(seat, now))
    # A seat that only checks on its own (Lumo) is not stuck, and not busy, once
    # that check is late: the row says idle until she calls again.
    if word in ("busy", "idle", "stuck") and poll_is_late(seat, now):
        mark, word, shade = STATE_MARKS["idle"], "idle", STATE_COLOURS["idle"]
    elif word == "idle":
        word = "ready"  # the owner's word: idle, and here on time, means ready
    return {"rank": (AVAILABILITY.get(word, 6), waiting), "word": word, "mark": mark,
            "shade": shade, "waiting": waiting, "usage": usage}


ROUTABLE = ("claude", "grok", "gravity", "codex")  # agents an @deck task can be handed to (not app seats); codex back 2026-11-27


def most_available(seats=ROUTABLE, now=None):
    """The seat a task should go to: the best availability() rank that can take
    work (ready, busy or stuck). If none can, the least encumbered of claude and
    grok, so a task is never dropped; their notes wait until they're back."""
    ranked = [(availability(s, load_seat(s)["state"], now)["rank"], i, s)
              for i, s in enumerate(seats) if s in AGENTS]
    usable = [r for r in ranked if r[0][0] <= AVAILABILITY["stuck"]]
    if usable:
        return min(usable)[2]
    fallback = [(r[0][1], r[1], r[2]) for r in ranked if r[2] in ("claude", "grok")]
    return min(fallback)[2] if fallback else "claude"


def parse_until(text, now=None):
    """A reset time from '+166h', '+90m', '+2d', '06:20' (the next one), or 'YYYY-MM-DD HH:MM'."""
    import datetime
    now = time.time() if now is None else now
    text = text.strip()
    m = re.fullmatch(r"\+(\d+(?:\.\d+)?)\s*([mhd])", text, re.IGNORECASE)
    if m:
        return now + float(m.group(1)) * {"m": 60, "h": 3600, "d": 86400}[m.group(2).lower()]
    m = re.fullmatch(r"(\d{1,2}):(\d\d)", text)
    if m:
        base = datetime.datetime.fromtimestamp(now)
        at = base.replace(hour=int(m.group(1)), minute=int(m.group(2)), second=0, microsecond=0)
        if at.timestamp() <= now:
            at += datetime.timedelta(days=1)
        return at.timestamp()
    try:
        return datetime.datetime.strptime(text, "%Y-%m-%d %H:%M").timestamp()
    except ValueError:
        raise ValueError("give the reset as +166h, +90m, +2d, 06:20 or 'YYYY-MM-DD HH:MM'") from None


def mark_spent(seat, until, who):
    """Mark `seat` spent until `until` ('clear' removes the mark). Returns a line to print."""
    if seat not in SEATS or seat == "owner":
        raise ValueError(f"no seat called {seat!r}")
    path = DATA / SPENT_DIR / f"{seat}.json"
    if until.strip().lower() == "clear":
        path.unlink(missing_ok=True)
        return f"{seat}: spent mark cleared"
    reset = parse_until(until)
    write_json(path, {"resets_at": reset, "set_by": who, "set_at": time.time()})
    return f"{seat}: spent until {when(reset)} ({countdown(reset)})"


def limit_spent(data, now=None):
    """True when a plan limit in `data` is full and has not reset yet.

    `data` is the object stored under "data" in usage/<seat>.json. Any
    rate_limits entry with used_percentage >= 100 counts. A missing
    resets_at stays spent, because the file can stop updating while that
    agent is blocked. A resets_at that is already past clears it, so the
    row reverts on the next redraw with no agent. The context percentage
    is not a plan limit. No rate_limits means not spent.
    """
    return limit_reset(data, now) is not None


def activity_view(state, usage_data, now=None, waiting=0, marked=None):
    """How one activity row looks: (mark, word, colour).

    A full plan limit, or a `comms-deck spent` mark (`marked`, its reset
    time), draws spent, in red. Otherwise idle with notes waiting is stuck.
    Spent wins: an agent that can't run isn't stuck. This does not write the
    seat file, so wake and the loop guard still see idle, busy or away.
    """
    if limit_spent(usage_data, now) or marked is not None:
        return "○", "spent", 245  # a grey empty circle: out of usage until its reset (the owner's choice)
    mark, shade, word = row_status(state, waiting)
    return mark, (word or "")[:13], shade


def task_summary(doing, notes, words=6):
    """Six words on what an agent has outstanding, for the line under its row.

    The owner asked for this instead of a count (the blue squares count).
    Deterministic, no model: what it said it is doing (set_status) while
    busy, otherwise the first words of the oldest note waiting, with @names,
    links and the deck's own wrapper left out. A private note shows only
    "private note". '' when there is nothing outstanding.
    """
    doing = re.sub(r"<[^>\n]{1,60}>", " ", doing or "").strip()
    if doing:
        text = doing
    elif notes:
        _, record = notes[0]
        if record.get("private"):
            return "private note"
        text = record.get("text", "")
    else:
        return ""
    if looks_secret(text):
        return "(something private)"  # a key or password never reaches the screen, as in describe()
    text = redact(text)
    text = re.sub(r"<[^>\n]{1,60}>", " ", text)  # markup like <system-reminder> or <pasted_content ...>
    text = re.sub(r"^(task from \w+, asked of comms-deck:|note from \w+:)\s*", "", text.strip(), flags=re.I)
    kept = [w for w in text.split() if not w.startswith(("@", "http://", "https://"))]
    return " ".join(kept[:words]) + (" …" if len(kept) > words else "")


def waiting_summary(notes):
    """One line for notes still in the inbox, or '' when there are none.

    The count is first, so a narrow panel still shows how many are waiting.
    The words are the oldest note. A private note adds none of its text.
    Drawn on every redraw from the inbox, so it does not need an agent.
    """
    if not notes:
        return ""
    _, record = notes[0]
    if record.get("private"):
        detail = "private note"
    else:
        detail = describe(f"note from {record.get('from', '?')}: {record.get('text', '')}", 50)
    extra = f" (+{len(notes) - 1} more)" if len(notes) > 1 else ""
    return f"{len(notes)} waiting · {detail}{extra}"


_split_cache = {"sig": None, "value": []}


def context_split():
    """[(seat, tokens)] for every seat that reports a live context figure.

    A seat joins with context_tokens when it has them, or with a used
    percentage times a known window size (what the rows above show). A seat
    with no usage file, or no context in it (today codex's screen meter and
    gravity's agy), is left out rather than counted as zero. The Grok Bot
    app seats (SHARED_ACCOUNTS) share one account, which gives a weekly
    limit, not a context window, so the shared row drops out here too.

    Both chat panels ask for this every frame, so the answer is cached on
    the usage folder and its files' names, sizes and mtimes: a stat per
    file is far cheaper than re-reading and re-parsing them all, and any
    write to a usage file still recomputes at once.
    """
    usage_dir = DATA / "usage"
    try:
        sig = (str(usage_dir), tuple(sorted((p.name, p.stat().st_size, p.stat().st_mtime_ns)
                                            for p in usage_dir.glob("*.json")))) \
            if usage_dir.is_dir() else (str(usage_dir), ())
    except OSError:
        sig = None  # a file vanished between glob and stat: recompute next frame
    if sig is not None and sig == _split_cache["sig"]:
        return _split_cache["value"]
    out = []
    for seat in tuple(AGENTS) + APP_SEATS:
        d = (read_json(DATA / "usage" / f"{seat}.json", {}) or {}).get("data", {}) or {}
        used = dig(d, "context_window", "context_tokens")
        if not isinstance(used, (int, float)) or used <= 0:
            pct, size = context_percent(d), dig(d, "context_window", "context_window_size")
            if not (isinstance(pct, (int, float)) and pct > 0
                    and isinstance(size, (int, float)) and size > 0):
                continue
            used = size * pct / 100
        out.append([seat, float(used)])
    _split_cache.update(sig=sig, value=out)
    return out  # the cached list is shared by every caller: treat it as read-only


def context_pie(split, width, step=None, busy=None):
    """The CONTEXT SPLIT lines: a box of dots filled in each seat's colour.

    The owner (06:36): no pie, a box of dots that fill up with the right
    colour and glow while in use. Every dot is an equal slice of the context
    pool, so a seat with a quarter of the tokens fills a quarter of the box.
    Seats fill in order, biggest first, left to right and row by row, so
    each seat is one solid run of colour, and the box's glow wave runs
    straight on through the row break (one phase per dot, the dot's flat
    index) at the bars' speed. A working seat's dots breathe (`busy` is
    the set of working seats; None makes everything glow, for tests). An
    idle seat's dots sit still in its colour. Under the box: one legend
    row per seat (biggest first, like the box), then the total -- which
    names the seats when they fit and "N seats" when they don't. The name
    is kept so callers don't change. Returns [] when nobody reports a
    figure.
    """
    if not split:
        return []
    esc = "\033["
    fstep = float(step) if step is not None else time.time() / PULSE_EVERY
    total = sum(used for _, used in split)
    cols = max(10, min(width - 2, 40))
    rows = 4
    cells = cols * rows
    order = sorted(split, key=lambda s: -s[1])
    # Largest remainder: the counts add up to every dot, and no reporting
    # seat is left with none.
    raw = [(seat, cells * used / total) for seat, used in order]
    counts = {seat: max(1, int(share)) for seat, share in raw}
    spare = cells - sum(counts.values())
    for seat, share in sorted(raw, key=lambda r: -(r[1] - int(r[1]))):
        if spare <= 0:
            break
        counts[seat] += 1
        spare -= 1
    while spare < 0:  # the minimum of one dot overshot: take from the biggest
        big = max(counts, key=counts.get)
        counts[big] -= 1
        spare += 1
    owners = [seat for seat, _ in order for _ in range(counts[seat])]
    lines = [f"{esc}1mCONTEXT SPLIT{esc}0m", ""]
    for r in range(rows):
        row = ""
        for c in range(cols):
            seat = owners[r * cols + c]
            if busy is not None and seat not in busy:
                row += f"{esc}38;5;{colour(seat)}m●{esc}0m"   # idle: still
            else:
                # one continuous phase, left to right then row by row (the
                # flat index), so the wave runs straight through the row
                # break at the bars' speed instead of tilting and resetting
                row += f"{esc}{breathe_style(colour(seat), r * cols + c + fstep)}m●{esc}0m"
        lines.append(row)
    lines.append("")
    # the legend follows the box: biggest first, so run and row line up
    lines += [f"{esc}38;5;{colour(seat)}m■{esc}0m {seat:8} {100 * used / total:4.1f}%  {esc}2m{short_tokens(used)}{esc}0m"
              for seat, used in order]
    names = " + ".join(seat for seat, _ in split)
    tail = (f"across {names}" if 1 + len(f"Total {short_tokens(total)} across {names}") <= width
            else f"across {len(split)} seats")  # narrow: don't chop mid-name
    lines.append(f"{esc}1mTotal{esc}0m {short_tokens(total)} {esc}2m{tail}{esc}0m")
    return lines


PULSE_EVERY = 0.5  # seconds per shimmer step (0-8 breathe cycle, so 4 s a wave);
                   # animated frames redraw far faster now -- the phase is continuous


def pulse_style(colour_code, phase):
    """The ANSI code for one cell of pulsing material this step.

    The hue never changes -- the seat's colour from the key -- it breathes
    through dim, normal and bold, so any terminal shows shimmer without
    inventing a second palette.
    """
    if phase in (0, 1):
        return f"2;38;5;{colour_code}"   # shadow
    if phase in (4, 5):
        return f"1;38;5;{colour_code}"   # highlight
    return f"38;5;{colour_code}"


def breathe_style(colour_code, phase):
    """pulse_style made continuous: `phase` may be a float on the 0-8 cycle.

    A cosine on the same dim/normal/bold recipe, matching pulse_style at
    every integer phase, so on the fast clock (up to 120 frames a second)
    the brightness wave glides instead of jumping.
    """
    b = 0.5 + 0.5 * math.cos(math.tau * (float(phase) - 4) / 8)  # 0..1, peak at 4
    if b <= 0.15:
        return f"2;38;5;{colour_code}"   # shadow
    if b >= 0.85:
        return f"1;38;5;{colour_code}"   # highlight
    return f"38;5;{colour_code}"


def pulse_step():
    """The current shimmer step: the redraw clock drives the pulsing.

    Kept for anything that wants the coarse integer phase; the bars
    themselves now run on a continuous phase (time / PULSE_EVERY).
    """
    return int(time.time() // PULSE_EVERY)


def context_rows(split, width, step=None, busy=None):
    """One small bar per reporting seat, under the pie: the seat's colour.

    Each bar shows how full that seat's context window is (not its share of
    the total, which is the pie's job), so a seat near its limit stands out
    at a glance. A seat reports over 100% when its meter's tokens pass the
    model's nominal window (compaction pulls it back): the fill caps at
    full but the number stays honest. The bars pulse -- the owner wants
    them holographic: a brightness wave along the seat's colour and a white
    glint sweeping left to right, foil rather than strobe -- but only
    while that seat is actually working (`busy`: the working seats, None
    pulses everything, tests). Idle bars sit still in the seat's colour.
    `step` freezes the phase (tests); None means the clock.
    """
    if not split:
        return []
    esc = "\033["
    fstep = float(step) if step is not None else time.time() / PULSE_EVERY
    bar_w = max(4, min(10, width - 15))
    lines = []
    for seat, used in split:
        d = (read_json(DATA / "usage" / f"{seat}.json", {}) or {}).get("data", {}) or {}
        pct = context_percent(d)
        c = colour(seat)
        if not isinstance(pct, (int, float)):
            # No window size reported (Devin's CLI gives tokens only): a bar
            # would claim 0%, so show the tokens it does report instead.
            lines.append(f"{esc}38;5;{c}m■{esc}0m {seat:8} {esc}2m{short_tokens(used)} tokens, window unknown{esc}0m")
            continue
        full = round(bar_w * min(pct, 100.0) / 100)
        anim = busy is None or seat in busy
        glint = (fstep * 2) % (bar_w + 4) - 2  # the white speck travels with time
        cells = []
        for pos in range(bar_w):
            if pos >= full:
                cells.append(f"{esc}0;38;5;238m░{esc}0m")  # the track stays still and dim
            elif not anim:
                cells.append(f"{esc}38;5;{c}m█{esc}0m")    # idle: still, no glow
            elif abs(pos - glint) <= 0.5:
                cells.append(f"{esc}1;38;5;255m█{esc}0m")  # the foil's white glint
            elif 0 < glint - pos <= 1.5:
                cells.append(f"{esc}38;5;250m█{esc}0m")    # the glint's fading trail
            else:
                cells.append(f"{esc}{breathe_style(c, pos + fstep)}m█{esc}0m")
        lines.append(f"{esc}38;5;{c}m■{esc}0m {seat:8} {''.join(cells)} {pct:3.0f}%"
                     + (" over the window" if pct > 100 else ""))
    return lines




# -- Telemetry: one shape for every provider's usage ---------------------
# The owner (22:03, relayed by Alice): 03 must cover every connected
# provider, model, bot and account, with new ones appearing on their own,
# and must never invent figures. telemetry() is the data layer the 03
# renderer and `comms-deck usage` read; nothing below names a seat.
#
# A label for the company behind a usage file's source; a feed's own
# data.provider wins. It's only a label: an unknown source falls back to
# the source name itself, and a seat with no usage file at all still gets
# a record (connected, telemetry unavailable).
PROVIDER_LABELS = {"claude": "Anthropic", "grok": "xAI", "grok-bot": "xAI",
                   "devin-db": "Cognition", "devin-otel": "Cognition",
                   "vibe-session": "Mistral", "gravity-hook": "Google",
                   "codex": "OpenAI", "lumo": "Proton", "lumo-desktop": "Proton"}
# Sources whose seats draw on one pool, by the account id they share. The
# owner (22:53): Grok and the Grok Bot bots all draw from the
# same xAI pool, so 03 shows them as one GROK row.
SHARED_ACCOUNTS = {"grok": "grok", "grok-bot": "grok"}
TELEMETRY_STALE = 6 * 3600  # seconds: an older update is shown as stale, not hidden


def _num(v):
    """v when it's a real number, else None (bools and strings aren't figures)."""
    return v if isinstance(v, (int, float)) and not isinstance(v, bool) else None


def telemetry_record(seat, record):
    """One seat's usage file as the common record; see telemetry()."""
    record = record or {}
    d = record.get("data") or {}
    source = record.get("source")
    program = AGENTS.get(seat) or APP_PROCESS.get(seat)  # what the seat runs as: names a provider with no file yet
    acct = d.get("account") or d.get("account_id")
    account = (str(acct) if isinstance(acct, (str, int, float)) and not isinstance(acct, bool)
               and str(acct) else SHARED_ACCOUNTS.get(source))  # seats on one pool share an id
    model = dig(d, "model", "display_name") or dig(d, "model", "id")
    declared = d.get("models")
    models = [str(m).strip() for m in declared
              if isinstance(m, (str, int, float)) and not isinstance(m, bool) and str(m).strip()] \
        if isinstance(declared, list) else []
    if not models and model:
        models = [model]
    provider = d.get("provider")
    provider = provider.strip() if isinstance(provider, str) and provider.strip() else None
    allocation = []
    limits = dig(d, "rate_limits")
    for key, rl in sorted((limits if isinstance(limits, dict) else {}).items()):
        rl = rl if isinstance(rl, dict) else {}  # a malformed window is skipped, not a crash (vibe's #91 nit)
        used = _num(rl.get("used_percentage"))
        if used is None:
            continue
        window = {"five_hour": "5h", "seven_day": "wk", "monthly": "mo"}.get(key, key)
        left = _num(rl.get("remaining_percentage"))
        allocation.append({"window": window, "used_pct": float(used),
                           "remaining_pct": float(left if left is not None else max(0.0, 100.0 - used)),
                           "resets_at": _num(rl.get("resets_at"))})
    cw = dig(d, "context_window") or {}
    metrics = dig(d, "otel", "metrics") or {}
    tokens = {
        "input": _num(cw.get("session_input_tokens")) if _num(cw.get("session_input_tokens")) is not None
        else _num(cw.get("total_input_tokens")),
        "output": _num(cw.get("session_output_tokens")) if _num(cw.get("session_output_tokens")) is not None
        else _num(cw.get("total_output_tokens")),
        "cache_read": _num(dig(d, "devin", "cache_read_tokens")) if _num(dig(d, "devin", "cache_read_tokens")) is not None
        else _num(dig(cw, "session_usage", "cache_read_input_tokens")),
        "requests": _num(dig(d, "devin", "requests")),
        "sessions": _num(metrics.get("devin.session.count")),
        "active_s": _num(metrics.get("devin.active_time.total")),
    }
    cost = _num(dig(d, "cost", "total_cost_usd"))
    # Claude Code prices the session at API list rates while the seat runs on
    # a plan (it reports rate_limits), so that figure is an estimate. Nobody
    # reports a confirmed bill or a running total across sessions yet.
    kind = None if cost is None else ("estimate" if dig(d, "rate_limits") is not None or source == "claude" else "reported")
    updated = _num(record.get("time"))
    has = bool(allocation) or any(v is not None for v in tokens.values()) or cost is not None
    return {
        "seat": seat,
        "provider": provider or PROVIDER_LABELS.get(source) or PROVIDER_LABELS.get(program)
        or source or (program if program != "remote" else None) or "unknown",
        "account": account, "models": models,
        "connected": seat in SEATS, "available": has, "source": source,
        "updated": updated, "stale": updated is not None and time.time() - updated > TELEMETRY_STALE,
        "allocation": allocation, "tokens": tokens,
        "spend": {"session_usd": cost, "cumulative_usd": ledger_seat_total(seat), "kind": kind},
        "raw": d,
    }


def telemetry():
    """Every seat's usage in one shape, for 03 USAGE and `comms-deck usage`.

    Seats come from the registry (SEATS: the built-in agents,
    COMMS_DECK_SEATS and ~/.config/comms-deck/app-seats), plus any usage
    file whose seat isn't registered, so a new integration shows up as soon
    as it is registered or writes its first figure. Each record:

      seat, provider, account (seats sharing one carry the same id), models,
      connected, available (reports any usage figure at all), source,
      updated (epoch of the last write) and stale,
      allocation: [{window, used_pct, remaining_pct, resets_at}],
      tokens: {input, output, cache_read, requests, sessions, active_s},
      spend: {session_usd, cumulative_usd, kind: estimate|reported|None},
      raw: the file's data, untouched. A feed may declare provider, account
      (or account_id) and models in data; the labels above are the fallback.

    A figure the provider doesn't report is None, never 0, and no
    percentage is derived from token counts. Context isn't here: that's
    06 CONTEXT SPLIT's (context_split()).
    """
    usage_dir = DATA / "usage"
    seats = [s for s in SEATS if s != "owner"]
    extra = sorted(p.stem for p in usage_dir.glob("*.json")) if usage_dir.is_dir() else []
    seats += [s for s in extra if s not in seats]
    return [telemetry_record(s, read_json(usage_dir / f"{s}.json")) for s in seats]


def telemetry_rows(records=None):
    """telemetry() with seats that share a provider and account folded into one row.

    Seats on one pool report different parts of it at different moments
    (the bots the weekly limit, Grok's CLI its session cost), so each part
    of the row comes from the freshest seat that reports it: allocation,
    each token field, and spend. The row's `updated`, `stale`, `models`
    and `available` cover the whole account, and "seats" lists every seat
    on it. A seat with no account is its own row, seats == [seat]. Account
    ids are provider-scoped: the same id under two providers is two pools.
    """
    rows, groups = [], {}
    for r in telemetry() if records is None else records:
        key = (r["provider"], r["account"]) if r["account"] is not None else None
        if key is None:
            rows.append(dict(r, seats=[r["seat"]]))
        elif key in groups:
            groups[key].append(r)
        else:
            groups[key] = [r]
            rows.append(key)  # placeholder: keeps the first seat's place in the order
    out = []
    for row in rows:
        if not isinstance(row, tuple):
            out.append(row)
            continue
        group = sorted(groups[row], key=lambda r: r["updated"] or 0, reverse=True)  # freshest first
        first = lambda pick: next((pick(r) for r in group if pick(r)), None)
        merged = dict(group[0], seats=[r["seat"] for r in groups[row]])
        merged["allocation"] = first(lambda r: r["allocation"]) or []
        merged["tokens"] = {k: next((r["tokens"][k] for r in group if r["tokens"][k] is not None), None)
                            for k in group[0]["tokens"]}
        merged["spend"] = first(lambda r: r["spend"] if r["spend"]["session_usd"] is not None else None) \
            or group[0]["spend"]
        merged["models"] = list(dict.fromkeys(m for r in group for m in r["models"]))
        merged["available"] = any(r["available"] for r in group)
        merged["stale"] = all(r["stale"] for r in group)
        out.append(merged)
    return out


def telemetry_detail(seat=None):
    """`comms-deck usage <seat>`: one provider's telemetry in full, for inspection.

    03 shows the overview; this is the other half of the owner's brief
    (22:03): every model, account, window, token count and spend figure a
    seat reports, how fresh it is, and the raw fields as written, so
    nothing the panel summarises is out of reach. `seat` may be a seat, an
    account id (every seat on it) or a provider label; None lists every
    record in brief. A figure the provider doesn't report prints as
    "not reported", never 0.
    """
    recs = telemetry()
    if seat is None:
        out = [f"{'SEAT':9} {'PROVIDER':11} {'ACCOUNT':10} {'TELEMETRY':12} UPDATED"]
        for r in sorted(recs, key=lambda r: (r["provider"], r["seat"])):
            state = "available" if r["available"] else "unavailable"
            upd = ago(time.time() - r["updated"]) if r["updated"] else "never"
            out.append(f"{r['seat']:9} {r['provider']:11} {(r['account'] or '-'):10} {state:12} "
                       f"{upd}{' (stale)' if r['stale'] else ''}")
        return out + ["", "comms-deck usage <seat|account|provider> for the full record"]
    want = seat.lower()
    pick = [r for r in recs if want in (r["seat"].lower(), (r["account"] or "").lower(), r["provider"].lower())]
    if not pick:
        return [f"no seat, account or provider called {seat!r}; known seats: "
                + ", ".join(r["seat"] for r in recs)]
    nr = "not reported"
    out = []
    for r in pick:
        out += [f"{r['seat'].upper()}  ·  {r['provider']}"
                + (f"  ·  account {r['account']}" if r["account"] else ""),
                f"  registered   {'yes' if r['connected'] else 'no (usage file only)'}",
                f"  telemetry    {'available' if r['available'] else 'CONNECTED / TELEMETRY UNAVAILABLE'}",
                f"  source       {r['source'] or nr}",
                f"  updated      " + (f"{when(r['updated'])} ({ago(time.time() - r['updated'])})"
                                      + (" · stale" if r["stale"] else "") if r["updated"] else "never"),
                f"  models       {', '.join(r['models']) or nr}",
                "  ALLOCATION"]
        if r["allocation"]:
            for a in r["allocation"]:
                reset = f" · resets {when(a['resets_at'])}" if a["resets_at"] else " · reset not reported"
                out.append(f"    {a['window']:4} {a['used_pct']:5.1f}% used · {a['remaining_pct']:5.1f}% left{reset}")
        else:
            out.append(f"    {nr}")
        out.append("  TOKENS & ACTIVITY")
        for k, label in (("input", "input"), ("output", "output"), ("cache_read", "cache read"),
                         ("requests", "requests"), ("sessions", "sessions"), ("active_s", "active")):
            v = r["tokens"][k]
            shown = nr if v is None else (f"{v / 60:.0f}m" if k == "active_s" else f"{v:,.0f}")
            out.append(f"    {label:11} {shown}")
        sp = r["spend"]
        out += ["  FINANCIAL",
                f"    session     " + (nr if sp["session_usd"] is None else f"${sp['session_usd']:,.2f} ({sp['kind']})"),
                f"    cumulative  " + (nr if sp["cumulative_usd"] is None else f"${sp['cumulative_usd']:,.2f}"),
                "  RAW (as the source wrote it)"]
        raw = json.dumps(redact_raw(r["raw"]), indent=2, sort_keys=True, default=str).splitlines()
        out += ["    " + l for l in raw] + [""]
    return out


def redact_raw(d):
    """The raw usage data minus paths and ids that say nothing about usage.

    A Claude Code status line carries the transcript path, working folder and
    session id; they aren't telemetry and needn't be on a screen.
    """
    if not isinstance(d, dict):
        return d
    drop = {"transcript_path", "cwd", "workspace", "session_id", "prompt_id", "scratchpad_dir"}
    return {k: redact_raw(v) for k, v in d.items() if k not in drop}


# -- The cost ledger: all-time spend that survives restarts ---------------
# The owner (23:08): the top bar's COST should be the all-time total, kept
# so that a reboot, a reinstall or an upgrade doesn't lose it. Feeds only
# report the running cost of the session they're in, so the ledger keeps
# one entry per (seat, session) at the highest figure seen and sums them.
# Entries only ever go up; none is ever removed. A copy lives in the
# private relay repo (ledger/costs.json), merged both ways, so cloning it
# on a fresh machine brings the history back.
def ledger_path():
    """Where the ledger lives: DATA/cost-ledger.json (read each time, so tests can move DATA)."""
    return DATA / "cost-ledger.json"


LEDGER_MIRROR_EVERY = 600  # seconds between pushes of a changed ledger


_ledger_cache = {}


def _ledger_load(path):
    """The ledger at `path` (a fresh copy), cached on its mtime and size: the
    chat reads it every frame, once per seat."""
    try:
        st = Path(path).stat()
        sig = (st.st_mtime_ns, st.st_size)
    except OSError:
        sig = None
    hit = _ledger_cache.get(str(path))
    if sig is None or hit is None or hit[0] != sig:
        d = read_json(path, {}) or {} if sig else {}
        entries = d.get("entries") if isinstance(d.get("entries"), dict) else {}
        gens = d.get("gens") if isinstance(d.get("gens"), dict) else {}
        dips = d.get("dips") if isinstance(d.get("dips"), dict) else {}
        hit = (sig, {"version": 1, "entries": entries, "gens": gens, "dips": dips})
        _ledger_cache[str(path)] = hit
    return {"version": 1, "entries": dict(hit[1]["entries"]), "gens": dict(hit[1]["gens"]),
            "dips": dict(hit[1]["dips"])}


def ledger_merge(a, b):
    """Two ledgers as one: every entry from either, each at its higher figure."""
    out = {"version": 1, "entries": dict(a["entries"]), "gens": dict(a["gens"]), "dips": dict(a.get("dips", {}))}
    for key, e in b["entries"].items():
        mine = out["entries"].get(key)
        if not isinstance(e, dict) or _num(e.get("usd")) is None:
            continue
        if mine is None or e["usd"] > (_num(mine.get("usd")) or 0):
            merged = dict(e)
            if mine and mine.get("first"):
                merged["first"] = min(mine["first"], e.get("first") or mine["first"])
            out["entries"][key] = merged
    for seat, n in b["gens"].items():
        if isinstance(n, int) and n > (out["gens"].get(seat) or 0):
            out["gens"][seat] = n
    return out


def ledger_note(seat, record, path=None):
    """Fold one usage record's session cost into the ledger. True if it changed.

    The session is the feed's session_id where it has one. Without one, a
    cost lower than the seat's open entry means a new session began, so the
    seat's generation number goes up and a new entry opens.
    """
    path = path or ledger_path()
    spend = telemetry_record(seat, record)["spend"]
    cost = spend["session_usd"]
    if cost is None or cost <= 0:
        return False
    d = (record or {}).get("data") or {}
    sid = d.get("session_id")
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(path.with_suffix(".lock"), "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        ledger = _ledger_load(path)
        if isinstance(sid, str) and sid:
            key = f"{seat}|{sid}"  # one session, wherever it's seen: machines max-merge into one entry
        else:
            # A generation counter is per machine (each starts at 0), so the
            # key names the machine; else a restored ledger would merge two
            # machines' different sessions (vibe's review of #102).
            gseat = f"{seat}@{MACHINE}"
            gen = ledger["gens"].get(gseat) or 0
            open_entry = ledger["entries"].get(f"{seat}|{MACHINE}|gen-{gen}")
            if open_entry and cost < (_num(open_entry.get("usd")) or 0) - 0.005:
                # A drop opens a new session only when the next reading is low
                # too: one flaky low figure would otherwise count the climb
                # back twice (vibe's review of #102).
                held = _num(ledger.setdefault("dips", {}).get(gseat))
                if held is None:
                    ledger["dips"][gseat] = cost
                    write_json(path, ledger)
                    return False
                ledger["dips"].pop(gseat, None)
                gen += 1
                ledger["gens"][gseat] = gen
            elif ledger.get("dips", {}).pop(gseat, None) is not None:
                write_json(path, ledger)  # the dip didn't hold: it was a blip
            key = f"{seat}|{MACHINE}|gen-{gen}"
        entry = ledger["entries"].get(key)
        if entry and cost <= (_num(entry.get("usd")) or 0):
            return False
        now = time.time()
        ledger["entries"][key] = {"usd": round(float(cost), 6), "kind": spend["kind"],
                                  "first": (entry or {}).get("first") or now, "last": now,
                                  "machine": MACHINE}
        write_json(path, ledger)
        return True


def ledger_sweep():
    """Fold every seat's current usage file into the ledger (the service, every 30 s)."""
    changed = False
    for r in telemetry():
        record = read_json(DATA / "usage" / f"{r['seat']}.json")
        if record:
            changed = ledger_note(r["seat"], record) or changed
    return changed


def ledger_seat_total(seat, path=None):
    """One seat's all-time spend from the ledger, or None if it has no entry.

    Cost is per seat, unlike limits (per account): a pool's all-time figure
    is the sum of its seats' totals, so a second cost reporter joining a
    pool adds its own sessions and nothing is counted twice."""
    usd = [e["usd"] for k, e in _ledger_load(path or ledger_path())["entries"].items()
           if k.split("|", 1)[0] == seat and isinstance(e, dict) and _num(e.get("usd")) is not None]
    return sum(usd) if usd else None


def ledger_total(path=None):
    """(all-time usd, any estimate in it, epoch of the first entry or None)."""
    entries = [e for e in _ledger_load(path or ledger_path())["entries"].values()
               if isinstance(e, dict) and _num(e.get("usd")) is not None]
    firsts = [e["first"] for e in entries if _num(e.get("first"))]
    return (sum(e["usd"] for e in entries), any(e.get("kind") == "estimate" for e in entries),
            min(firsts) if firsts else None)


_ledger_pushed = {"at": 0.0}


def ledger_mirror(force=False):
    """Merge the ledger with its copy in the private relay repo, both ways, and push.

    Runs in the service. A missing clone is skipped (the ledger stays local
    until there is one). The repo copy is pulled first, so a ledger restored
    on a new machine, or written by another, is merged in rather than
    overwritten. Pushes at most every LEDGER_MIRROR_EVERY seconds.
    """
    repo = PRIVATE_REPO
    if not (repo / ".git").exists():
        return
    if not force and time.time() - _ledger_pushed["at"] < LEDGER_MIRROR_EVERY:
        return
    _ledger_pushed["at"] = time.time()
    mirror = repo / "ledger" / "costs.json"
    try:
        git(repo, "pull", "--rebase", "--autostash", "-q")
        ledger_path().parent.mkdir(parents=True, exist_ok=True)  # a fresh machine: no DATA yet
        with open(ledger_path().with_suffix(".lock"), "w") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            local, remote = _ledger_load(ledger_path()), _ledger_load(mirror)
            merged = ledger_merge(local, remote)
            if merged != local:
                write_json(ledger_path(), merged)
        if merged != remote:
            mirror.parent.mkdir(parents=True, exist_ok=True)
            mirror.write_text(json.dumps(merged, indent=1, sort_keys=True) + "\n")
            git(repo, "add", "ledger/costs.json")
            git(repo, "commit", "-q", "-m", f"cost ledger from {MACHINE}")
            git(repo, "push", "-q")
            log(f"cost ledger mirrored to {repo.name}: ${ledger_total()[0]:,.2f} all time")
    except (RuntimeError, OSError, subprocess.SubprocessError) as error:
        log(f"couldn't mirror the cost ledger (will retry): {error}")


PANEL_SCAN_TTL = 0.5  # seconds; the chat's fast clock must not hammer /proc

_panel_scans = {"at": 0.0, "seats": {}, "waiting": {}}


def panel_scans():
    """A half-second cache of the scans the chat panels make.

    load_seat() walks /proc whenever an agent process is gone (an away
    seat) and pending() reads every inbox -- at up to 120 frames a second
    (04:02) that's a scan storm. The chat panels read this snapshot
    instead; the service, the hooks and anything taking notes keep
    calling load_seat and pending live.
    """
    if time.time() - _panel_scans["at"] < PANEL_SCAN_TTL:
        return _panel_scans
    now, seats, waiting = time.time(), {}, {}
    for seat in tuple(AGENTS) + APP_SEATS:
        if seat in AGENTS:
            seats[seat] = load_seat(seat)
        else:
            d = read_json(seat_file(seat), {}) or {}
            d["state"] = app_seat_state(seat)
            seats[seat] = d
        waiting[seat] = pending(seat)
    _panel_scans.update(at=now, seats=seats, waiting=waiting)
    return _panel_scans


def busy_seats(snap=None):
    """The seats whose agent is working right now (state busy).

    This is what lets the bars obey 04:02: only these shimmer. App seats
    count when the app reports the bot busy (the shared Grok Bot account
    serves them all, so the account row moves when any bot does).
    """
    if snap is None:
        snap = panel_scans()
    return {seat for seat, d in snap["seats"].items() if d.get("state") == "busy"}


# 03's sort. The owner's choice (the chat box's /sort command) lives in a
# one-line file under DATA so it survives a restart; usage_panel reads it
# every frame, so a switch moves the panel on the next redraw.
USAGE_SORTS = ("provider", "consumption", "spend")


def usage_sort():
    """03's sort as the owner last set it with /sort (default: provider)."""
    try:
        mode = (DATA / "usage-sort").read_text().strip()
    except OSError:
        return "provider"
    return mode if mode in USAGE_SORTS else "provider"  # a stale file never wins


def set_sort(mode):
    """Set 03's sort (the chat box's /sort command). Returns an error
    string, or None once the choice is stored; the panel reads it on the
    next redraw, so nothing has to be told."""
    mode = (mode or "").strip().lower()
    if mode not in USAGE_SORTS:
        return "no sort called " + repr(mode or "(nothing)") + "; try " + " | ".join(USAGE_SORTS)
    (DATA / "usage-sort").parent.mkdir(parents=True, exist_ok=True)
    (DATA / "usage-sort").write_text(mode + "\n")
    return None


def usage_panel(width, sort=None):
    """The usage column: two blocks from telemetry_rows(), then the rest.

    The owner's multi-provider brief (22:03, via alice): 03 is one
    observability panel over every connected provider, not a per-provider
    collection. It renders ALLOCATION (family A: subscription and window
    limits) and FINANCIAL (family C), each
    from the pinned telemetry() records via telemetry_rows(), so the
    families never merge and seats sharing an account (the grok-bot bots)
    are one row, that account's freshest figures. TOKENS & ACTIVITY (family
    B) was dropped from the screen (the owner, 22:53: not useful to show);
    `comms-deck usage <seat>` still prints it. A seat with no limit and no
    cost renders under CONNECTED / NO LIMIT OR COST REPORTED with its last
    update, never a misleading zero, and a stale row says so. `sort` orders the rows: "provider"
    orders every block by provider then seat; "consumption" and "spend"
    order their own block only (allocation's percentages and the financial
    figures). A `sort` argument at the call site wins; the default reads
    the owner's /sort choice (usage_sort(), the chat box). Allocation
    rows carry a compact bar, shaded by severity, which shimmers only
    while a seat on the account is busy (04:02); idle bars are still.
    Sets usage_panel.running for the redraw clock: true while any bar
    has something to animate, so the screen can tick fast then.
    """
    sort = sort or usage_sort()
    if sort not in USAGE_SORTS:
        sort = "provider"  # an unknown sort at a call site never draws "by <junk>"
    inner = width - 2
    # A compact bar: name + bar + "40% · 5h · resets 22:19" must share the
    # row, so the bar stays small and the words survive even at 50 columns.
    bar_w = max(6, inner - 38)  # "  5h " + bar + " 69% · resets tomorrow 02:30"
    esc = "\033["
    recs = telemetry()
    snap = panel_scans()  # one shared half-second snapshot for every panel
    running = busy_seats(snap)
    usage_panel.running = bool(running) and width > 2

    def who(r):
        # One row per account: a shared account's row is named for the
        # account, everyone else for their seat. The label comes from the
        # record; no provider is named in the renderer (the brief's rule 1).
        if r["account"]:  # one pool (the owner, 22:53): just the account's name
            return r["account"].upper(), colour(r["seats"][0])
        return r["seats"][0].upper(), colour(r["seats"][0])

    def by_provider(rs):
        # The provider sort: the registry's label first, then the seat, so
        # new providers slot in among the known ones (the brief's rule 4).
        return sorted(rs, key=lambda r: (r["provider"], r["seat"]))

    # Family C's head total: the spend the seat reporting it claims for the
    # account, one figure per row.
    priced = [r for r in telemetry_rows(recs)
              if r["available"] and isinstance(r["spend"]["session_usd"], (int, float))]
    total = sum(r["spend"]["session_usd"] for r in priced)
    # Any estimate in the sum makes the sum an estimate.
    est_total = " est." if any(r["spend"]["kind"] == "estimate" for r in priced) else ""
    head = f"{esc}1mUSAGE{esc}0m"
    if sort != "provider":
        # The panel says which way it's ordered, so a /sort can't be mistaken
        # for the deck surprising the owner.
        head += f" {esc}2m· by {sort}{esc}0m"
    if total > 0:
        money = f"~${total:,.2f}{est_total}"
        gap = max(1, inner - len(ANSI.sub("", head)) - len(money))  # the sort tag counts too
        head += " " * gap + f"{esc}1;38;5;220m{money}{esc}0m"
    lines = [head, ""]  # where the figures come from is in the README, not on screen
    rows = telemetry_rows([r for r in recs if r["available"]])

    # Family A: allocation. The tighter of the windows a row reports (the
    # one about to bite), shaded by severity, shimmering only while a seat
    # on the account works.
    alloc = [r for r in rows if r["allocation"]]
    if alloc:
        alloc = by_provider(alloc) if sort != "consumption" else \
            sorted(alloc, key=lambda r: -max(a["used_pct"] for a in r["allocation"]))
        out = []
        for r in alloc:
            # The name on its own line, then every window the row reports
            # (rolling and weekly alike, the brief's rule 2), so a long
            # account label never pushes a figure off the edge.
            anim = any(s in running for s in r["seats"])
            name, c = who(r)
            out.append(f"{esc}38;5;{c}m■{esc}0m {esc}1;38;5;{c}m{name}{esc}0m")
            for a in sorted(r["allocation"], key=lambda a: a["window"] != "5h"):
                shade = 78 if a["used_pct"] < 60 else 214 if a["used_pct"] < 85 else 196
                reset = (f" · resets {when(a['resets_at'])}"
                         if isinstance(a["resets_at"], (int, float)) else "")
                out.append(f"  {a['window']:3} {bar(a['used_pct'], bar_w, animate=anim)} "
                           f"{esc}38;5;{shade}m{a['used_pct']:3.0f}%{esc}0m{esc}2m{reset}{esc}0m")
        lines += [f"{esc}1mALLOCATION{esc}0m"] + out + [""]
    else:
        lines += [f"{esc}1mALLOCATION{esc}0m {esc}2mnone reported{esc}0m", ""]

    # Family C: financial. Only expenditure a source itself reported, kind
    # tagging the estimate.
    spend = [r for r in rows if isinstance(r["spend"]["session_usd"], (int, float))]
    out = []
    for r in (sorted(spend, key=lambda r: -r["spend"]["session_usd"]) if sort == "spend" else by_provider(spend)):
        est = " est." if r["spend"]["kind"] == "estimate" else ""
        name, c = who(r)
        out.append(f"{esc}38;5;{c}m■{esc}0m {esc}1;38;5;{c}m{name}{esc}0m "
                   f"{esc}38;5;220m${r['spend']['session_usd']:,.2f}{esc}0m{est}")
    if out:
        lines += [f"{esc}1mFINANCIAL{esc}0m"] + out + [""]

    # The brief's rule 5: connected but silent is a state -- shown, not
    # hidden, and never a zero. The row reads as an inventory: what the
    # seat is, when it last reported, and whether that report is stale.
    # Token counts left 03 (the owner, 22:53: not useful on screen; they're
    # in `comms-deck usage <seat>`), so a seat with no limit and no cost
    # has nothing above and is listed here rather than vanishing.
    quiet = [r for r in telemetry_rows(recs)
             if not r["allocation"] and r["spend"]["session_usd"] is None]
    if quiet:
        lines.append(f"{esc}1mCONNECTED / NO LIMIT OR COST REPORTED{esc}0m")
        for r in by_provider(quiet):
            fresh = (f"last update {ago(time.time() - r['updated'])}"
                     if isinstance(r["updated"], (int, float)) and r["updated"]
                     else "never reported") + (" · stale" if r["stale"] else "")
            names = ", ".join(r["seats"]) if r.get("seats") else r["seat"]
            lines.append(f"{esc}2m  {names:8} {r['provider']} · {fresh}{esc}0m")
        lines.append("")
    return [fit(" " + line, width) for line in lines]


def refresh_notifications(pos=0):
    """Mirror new bar-ticker queue lines into DATA/notifications.jsonl.

    Mako's on-notify already drops do-not-disturb and dismisses the popup;
    the queue is exactly the text the top bar scrolls, so the deck shows
    the same feed without replacing waybar or mako. `pos` is the byte
    offset already copied; returns the new one. A missing queue (other
    machines, self-test) is a no-op.
    """
    try:
        size = NOTIFY_QUEUE.stat().st_size
    except OSError:
        return pos
    if size < pos:
        pos = 0
    if size == pos:
        return pos
    try:
        with NOTIFY_QUEUE.open("r", encoding="utf-8") as handle:
            handle.seek(pos)
            raw = handle.read()
            pos = handle.tell()
    except OSError:
        return pos
    out = DATA / "notifications.jsonl"
    now = time.time()
    wrote = False
    try:
        DATA.mkdir(parents=True, exist_ok=True)
        with out.open("a", encoding="utf-8") as handle:
            for line in raw.splitlines():
                line = line.strip()
                if not line:
                    continue
                try:
                    item = json.loads(line)
                except ValueError:
                    continue
                text = item.get("text") if isinstance(item, dict) else None
                if text:
                    handle.write(json.dumps({"time": now, "text": text}, ensure_ascii=False) + "\n")
                    wrote = True
    except OSError:
        return pos
    if wrote:
        trim_notifications()
    return pos


def trim_notifications(keep=500, max_lines=5000):
    """Keep notifications.jsonl bounded: past max_lines, rewrite the tail."""
    path = DATA / "notifications.jsonl"
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError:
        return
    if len(lines) <= max_lines:
        return
    tmp = path.parent / (path.name + ".tmp")
    try:
        tmp.write_text("\n".join(lines[-keep:]) + "\n", encoding="utf-8")
        tmp.replace(path)
    except OSError:
        pass


def notify_lines(width, count=6):
    """The NOTIFICATIONS block for the right column: what the top bar scrolled.

    Newest first, dimmed, with the age on the left. Only the tail of
    notifications.jsonl is read, so the redraw stays cheap as it grows.
    """
    path = DATA / "notifications.jsonl"
    try:
        lines = path.read_text(encoding="utf-8").splitlines()[-count:]
    except OSError:
        return []
    items = []
    for line in lines:
        try:
            r = json.loads(line)
        except ValueError:
            continue
        if isinstance(r, dict) and r.get("text"):
            items.append(r)
    if not items:
        return []
    limit = max(10, width - 14)
    out = ["", "\033[1mNOTIFICATIONS\033[0m", ""]
    for r in reversed(items):
        text = str(r["text"])
        if len(text) > limit:
            text = text[: limit - 1] + "…"
        out.append(f"\033[2m{ago(time.time() - float(r.get('time') or 0)):>7}\033[0m {text}")
    return out


def activity_panel(width):
    """The ready-order column: one row per agent, marks and waiting squares.

    The mark, the word and the colour come from activity_view, which can
    say spent (a full plan limit, from the agent's meter or a mark set with
    `comms-deck spent`) or stuck (idle with notes waiting) while the seat
    file stays as it was. Spent beats stuck. The blue squares count the
    notes waiting (the owner asked for no line of note text under the
    row). Only a spent row counts down to its reset. Seconds show only in
    the last hour, so only then does the screen redraw every second;
    otherwise every 2 s, as before. (The history stays in activity.jsonl.)
    The words and countdowns don't animate: the owner put the pulse on the
    bars only. Since #61 this column is its own on the right of the chat,
    so the ready order is visible instead of scrolling away under the pie.
    """
    snap = panel_scans()  # one shared half-second snapshot for every panel
    lines = ["\033[1mACTIVITY\033[0m", ""]
    activity_panel.ticking = False
    activity_panel.fast = False  # a live ms countdown redraws at 10 fps, not 1-2 s
    rows = []
    for order, (seat, st, since) in enumerate(current_states(snap)):
        a = availability(seat, st, snap=snap)
        usage, waiting, mark, word, shade = a["usage"], a["waiting"], a["mark"], a["word"], a["shade"]
        if word == "spent":
            reset = spent_reset(usage, spent_mark(seat))
            began = idle_until(reset)
            if reset is not None and reset - time.time() < 3600:
                activity_panel.ticking = True  # seconds are shown only in the last hour
                activity_panel.fast = True    # ...and ms while it counts down
        elif seat in APP_SEATS and APP_PROCESS.get(seat, "grok-bot") != "grok-bot" and st != "not set up":
            activity_panel.ticking = True  # it polls rather than being woken, so show when it next looks
            activity_panel.fast = True    # its check countdown is in metric time
            began = poll_countdown(snap["seats"].get(seat) or load_seat(seat))
        else:
            began = when(since) if since else ""  # static: "03:27" today, "Fri 18:00" this week, "Nov 12 18:00" further back
        squares = "■" * min(waiting, 5) + (f"+{waiting - 5}" if waiting > 5 else "")
        state_text = f"{mark} {began}" if word == "spent" else f"{mark} {word:9}\033[0m \033[2m{began}"
        # A spent row is all grey, name and squares too, and has no line
        # under it: nothing it holds can start until the reset (the owner, 08:07-08:08).
        spent = word == "spent"
        doing = (snap["seats"].get(seat) or load_seat(seat)).get("doing")
        summary = "" if spent else task_summary(doing if word == "busy" else "", snap["waiting"].get(seat, ()))
        name_shade, square_shade = (shade, shade) if spent else (colour(seat), 33)
        rows.append((*a["rank"], order,
                     [f"  \033[38;5;{name_shade}m{seat_title(seat, word in ('busy', 'ready', 'stuck')):8}\033[0m "
                      f"\033[38;5;{shade}m{state_text}\033[0m"
                      + (f" \033[38;5;{square_shade}m{squares}\033[0m" if squares else "")]
                     + ([f"    \033[2m↳ {summary}\033[0m"] if summary else [])))
    lines += [line for row in sorted(rows) for line in row[-1]]
    balancer = load_balancer()
    board = [t for t in balancer.all_tasks() if t["state"] in balancer.TASK_ACTIVE] if balancer else []
    if board:
        lines += ["", "\033[1mTASKS\033[0m"]
        for t in board[-6:]:
            who = display_seat(t.get("holder")) if t.get("holder") else "open"
            lines.append(f"  \033[38;5;{colour(t.get('holder')) if t.get('holder') else 245}m{t['id']:4} {who:7}\033[0m "
                         f"\033[2m{'(private)' if t.get('private') else t['summary']}\033[0m")
    # The context split lives on this column now (the owner, 05:17): the pie
    # and bars were too tall for the usage column on the left.
    split = context_split()
    pie = context_pie(split, width - 2, busy=busy_seats(snap))  # [] when nobody reports a figure
    if pie:
        lines += [""] + pie + context_rows(split, width - 2, busy=busy_seats(snap)) + [""]
    return [fit(" " + line, width) for line in lines]


def row_status(state, waiting):
    """The mark, colour and word for one activity row.

    Idle with notes still in the inbox is stuck: a red row that says stuck,
    so a queue nobody has picked up stands out from a genuinely idle agent.
    """
    if state == "idle" and waiting:
        return "●", 196, "stuck"
    return STATE_MARKS.get(state, "◌"), STATE_COLOURS.get(state, 245), state


def current_states(snap=None):
    """(seat, state, since) for every seat shown on the chat screen.

    Terminal agents that are away are left out, except Claude and Grok;
    hidden app seats are never shown. `snap`, when given, is the chat
    screen's panel_scans snapshot (the fast clock must not re-scan); the
    router and team_status keep the live reads.
    """
    out = []
    for seat in AGENTS:
        st = snap["seats"][seat] if snap is not None else load_seat(seat)
        if st["state"] == "away" and seat not in ("claude", "grok") and not seat_spent(seat):
            continue  # a spent seat stays shown, so its countdown can be seen
        out.append((seat, st["state"], st.get("since")))
    for seat in APP_SEATS:
        if seat in HIDDEN_SEATS:
            continue
        d = snap["seats"][seat] if snap is not None else read_json(seat_file(seat), {}) or {}
        out.append((seat, d.get("state") if snap is not None else app_seat_state(seat),
                    d.get("since")))
    return out


MENTION = re.compile(r"(?<![\w@])@([A-Za-z][\w-]*)")
EXCLUDE = re.compile(r"(?<![\w-])-([A-Za-z][\w-]*)")


def route(text):
    """Who the owner's chat-box line goes to: (seats, error or None).

    @seat names a seat (several are fine); @all, or no @ at all, is everyone.
    A "-seat" token drops that seat instead (the inverse of an @command):
    "-grok hello" goes to everyone but Grok. Only real seat names count, and
    only at the start of a word, so "re-run" and "-rf" are left as text.
    """
    names = [seat_id(m) for m in MENTION.findall(text)]
    excludes = list(dict.fromkeys(name for name in (seat_id(m.group(1)) for m in EXCLUDE.finditer(text))
                                  if name in SEATS))
    if not names or "all" in names:
        return ["all"] + ["-" + s for s in excludes], None
    unknown = [n for n in names if n not in SEATS or n == "owner"]
    if unknown:
        names = " ".join(f"@{display_seat(s).lower()}" for s in SEATS if s != "owner" and s not in HIDDEN_SEATS)
        return [], f"no seat called @{display_seat(unknown[0]).lower()}; try {names} @all"
    if not [n for n in dict.fromkeys(names) if n not in excludes]:
        return [], f"-{', -'.join(excludes)} leaves nobody to send to"
    return list(dict.fromkeys(names)) + ["-" + s for s in excludes], None


def fit_column(lines, height):
    """A side column's lines, trimmed to fit `height` rows without losing content.

    The "updated 3s ago" footers go first, then the blank spacer lines. Only
    if it still doesn't fit is the bottom cut. (The owner, 2026-11-25: after
    the context split was added, ACTIVITY and its blue squares were pushed
    off the bottom of the screen.)
    """
    if len(lines) <= height:
        return lines
    plain = [re.sub(r"\033\[[0-9;:?]*[A-Za-z]", "", line) for line in lines]
    lines = [line for line, text in zip(lines, plain) if not text.strip().startswith("updated ")]
    if len(lines) > height:
        lines = [line for i, line in enumerate(lines)
                 if i == 0 or re.sub(r"\033\[[0-9;:?]*[A-Za-z]", "", line).strip()]
    return lines[:height]


class FreshCode(Exception):
    """Raised inside chat() to leave the screen cleanly before run_fresh()."""


def deck_version(max_age=2.0):
    """The deck's version, derived from the git checkout so it moves with
    every change (the owner, 04:26): 'v<commits>·<short-hash>', '+' when
    the deck script itself has uncommitted edits. Nothing is bumped by
    hand -- every commit and every merge renumbers the screen.

    Cached for `max_age` seconds, so the fast redraw clock (up to 120
    frames a second, 04:02) doesn't fork git every frame. '' when git
    can't tell (no repo, no git); the bar then just shows 'v·?'.
    """
    c = deck_version._c
    if time.time() - c["at"] < max_age:
        return c["v"]
    v = ""
    try:
        def g(*args):
            return subprocess.run(["git", "-C", str(PROGRAM.parent), *args],
                                  capture_output=True, text=True, timeout=2)
        count = g("rev-list", "--count", "HEAD").stdout.strip()
        short = g("rev-parse", "--short", "HEAD").stdout.strip()
        if count.isdigit() and short:
            dirty = g("status", "--porcelain", "--", str(PROGRAM)).stdout.strip()
            v = f"{count}·{short}{'+' if dirty else ''}"
    except Exception:
        v = ""  # a missing git or repo never takes the screen down
    c.update(at=time.time(), v=v)
    return v


deck_version._c = {"at": 0.0, "v": ""}


def deck_header(cols):
    """The chat screen's top bar (the owner, 04:26): a full-width dim band
    like the input line it sits over, 'comms-deck · live notes on
    <machine>' on the left and the version on the right -- v<commits> and
    the short hash from deck_version(), gold for the number so a change
    catches the eye, dim for the hash. Too narrow for all of it, the
    subtitle drops first, then the version."""
    sub = f" · live notes on {MACHINE}"
    ver = deck_version()
    count, _, tail = ver.partition("·") if ver else ("", "", "")
    tail = f" · {tail}" if tail else ""
    v_plain = ("v" + count + tail) if count else "v·?"
    if 1 + len("comms-deck") + len(sub) + 1 + len(v_plain) + 1 > cols:
        sub = ""  # narrow: the machine's name goes first
    if 1 + len("comms-deck") + len(sub) + 1 + len(v_plain) + 1 > cols:
        v_plain = ""  # narrower still: just the name
    gap = max(0, cols - (1 + len("comms-deck") + len(sub)) - len(v_plain) - 1)
    out = "\033[48;5;234m\033[1;38;5;255m comms-deck"
    out += ("\033[22;38;5;244m" + sub) if sub else ""
    out += " " * gap
    if v_plain:
        out += "\033[22;38;5;220m" + v_plain[:1 + len(count)]
        out += ("\033[2;38;5;244m" + v_plain[1 + len(count):]) if v_plain[1 + len(count):] else ""
    out += " \033[0m"
    return out


# -----------------------------------------------------------------------------
# The deck look: the chat screen as a dashboard (the owner, 2026-11-25)
# -----------------------------------------------------------------------------
#
# The owner (07:54) wants comms-deck to look a bit like the dashboard in
# Argona's video, without losing any of the data the screen shows (08:03).
# So on a wide screen the chat is drawn as numbered panels, each in a frame
# with bright corner brackets and its own accent, under a strip of big
# numbers and over a ticker of the latest notes. Every panel's content comes
# from the builders the old layout used (usage_panel, activity_panel cut at
# its headings, notify_lines, chat_lines): only the framing is new, plus
# 01 CREW, a braille graph of who talks to whom. Under LOOK_MIN_COLS, or with
# COMMS_DECK_OLD_LOOK=1, the old three-column screen draws instead.

LOOK_MIN_COLS = 150
LOOK_ACCENT = {"crew": 208, "activity": 45, "notes": 255, "usage": 220,
               "tasks": 141, "split": 213, "alerts": 203}
LOOK_BORDER = 238
_LOOK_DOT = ((0x01, 0x08), (0x02, 0x10), (0x04, 0x20), (0x40, 0x80))


def look_frame(num, title, sub, right, accent, w, h, body):
    """One panel, `w` x `h`: corner brackets in the accent over a dim
    border, a header line with a numbered badge, then `body` fitted inside."""
    esc = "\033["
    iw = max(1, w - 4)
    a, d = f"{esc}38;5;{accent}m", f"{esc}38;5;{LOOK_BORDER}m"
    arm = min(3, max(0, (w - 2) // 4))
    rule = lambda l, r: a + l + "─" * arm + d + "─" * max(0, w - 2 - 2 * arm) + a + "─" * arm + r + f"{esc}0m"
    head = f"{esc}48;5;{accent};38;5;232;1m {num} {esc}0m {esc}1;38;5;255m{title}{esc}0m"
    head += f" {esc}2m· {sub}{esc}0m" if sub else ""
    if right and visible_len(head) + visible_len(right) + 1 <= iw:
        head += " " * (iw - visible_len(head) - visible_len(right)) + right
    inner = ([head, ""] + list(body) + [""] * h)[:max(0, h - 2)]
    return ([rule("┌", "┐")]
            + [f"{d}│{esc}0m " + fit(line, iw) + f" {d}│{esc}0m" for line in inner]
            + [rule("└", "┘")])[:h]


def look_tag(on, word_on="ACTIVE", word_off="IDLE"):
    return f"\033[38;5;42m● {word_on}\033[0m" if on else f"\033[2m○ {word_off}\033[0m"


def look_stack(panels, w, h):
    """Panels stacked to fill `h` rows: each is (rows or None, maker); the
    None ones share what the fixed ones leave. A panel under 3 rows is skipped."""
    fixed = sum(p for p, _ in panels if p)
    flex = [i for i, (p, _) in enumerate(panels) if not p]
    spare = max(0, h - fixed)
    out = []
    for i, (p, make) in enumerate(panels):
        n = p if p else spare // len(flex) + (spare % len(flex) if i == flex[-1] else 0)
        if n >= 3 and len(out) + n <= h:
            out += make(w, n)
    return (out + [" " * w] * h)[:h]


def record_stamp(r):
    """A log record's time as epoch seconds (0 if it has none)."""
    try:
        return time.mktime(time.strptime(r["time"][:19], "%Y-%m-%d %H:%M:%S"))
    except (KeyError, TypeError, ValueError):
        return 0


def look_crew(cols, rows, records, snap, busy, split, now):
    """01 CREW: each seat a cluster of braille dots in its colour, sized by
    its share of the context pool and breathing while it works; the notes of
    the last 30 minutes are links (in the sender's colour for 5 minutes),
    and a dot runs along each link sent in the last 10. You are the middle."""
    w, h = cols * 2, rows * 4
    bits = [[0] * cols for _ in range(rows)]
    ink = [[None] * cols for _ in range(rows)]
    text = {}

    def plot(px, py, style):
        px, py = int(px), int(py)
        if 0 <= px < w and 0 <= py < h:
            bits[py // 4][px // 2] |= _LOOK_DOT[py % 4][px % 2]
            ink[py // 4][px // 2] = style

    def label(px, py, s, style):
        r = int(py) // 4
        c = max(0, min(cols - len(s), int(px) // 2 - len(s) // 2))
        if 0 <= r < rows:
            for i, ch in enumerate(s):
                text[(r, c + i)] = (ch, style)

    seats = [s for s in tuple(AGENTS) + APP_SEATS if s not in HIDDEN_SEATS]
    pos = {}
    for i, s in enumerate(seats):
        ang = -math.pi / 2 + 2 * math.pi * i / max(1, len(seats))
        pos[s] = (w / 2 + math.cos(ang) * w * 0.38, h / 2 + math.sin(ang) * h * 0.34)
    pos["owner"] = (w / 2, h / 2)
    tokens = dict(split)
    biggest = max(tokens.values(), default=1) or 1
    phase = now / PULSE_EVERY
    recent = [r for r in records[-300:] if r.get("kind") == "message" and now - record_stamp(r) < 1800]
    ends = lambda r: [(pos.get(r["from"]), pos.get(t)) for t in (seats if r["to"] == "all" else r["to"].split("+"))]
    for r in recent:
        style = f"38;5;{colour(r['from']) if now - record_stamp(r) < 300 else 240}"
        for a, b in ends(r):
            if a and b and a != b:
                n = int(max(abs(b[0] - a[0]), abs(b[1] - a[1])) / 3) + 1
                for k in range(n + 1):
                    plot(a[0] + (b[0] - a[0]) * k / n, a[1] + (b[1] - a[1]) * k / n, style)
    look_crew.moving = False
    for r in recent:
        if now - record_stamp(r) > 600:
            continue
        look_crew.moving = True
        t = ((now + int(hashlib.sha256(r["id"].encode()).hexdigest()[:4], 16) / 65536 * 3) % 3) / 3
        for a, b in ends(r):
            if a and b and a != b:
                for dx, dy in ((0, 0), (1, 0), (0, 1), (1, 1)):
                    plot(a[0] + (b[0] - a[0]) * t + dx, a[1] + (b[1] - a[1]) * t + dy, f"1;38;5;{colour(r['from'])}")
    for s in seats:
        cx, cy = pos[s]
        n = int(14 + 140 * math.sqrt(tokens[s] / biggest)) if tokens.get(s) else 8
        seed = int(hashlib.sha256(s.encode()).hexdigest(), 16)
        on = s in busy
        spread = 3 + min(w, h) * 0.11 * math.sqrt(n / 154)
        for k in range(n):
            hh = (seed >> (k % 200)) ^ (k * 2654435761)
            ang = (hh % 6283) / 1000 + (now * 0.15 if on else 0)
            rad = (((hh >> 13) % 1000) / 1000) ** 0.6 * spread
            plot(cx + math.cos(ang) * rad, cy + math.sin(ang) * rad,
                 breathe_style(colour(s), k + phase) if on else f"38;5;{colour(s)}")
        state = (snap["seats"].get(s) or {}).get("state", "")
        dim = state in ("away", "not set up", "no chat yet")
        label(cx, min(h - 1, cy + spread + 5), f"[{seat_title(s, not dim).lower()}{' ●' if on else ''}]",
              "2;38;5;244" if dim else f"1;38;5;{colour(s)}")
    label(*pos["owner"], f"( {OWNER_NAME} )", "1;38;5;255")
    out = []
    for r in range(rows):
        row, cur = "", None
        for c in range(cols):
            if (r, c) in text:
                ch, st = text[(r, c)]
            elif bits[r][c]:
                ch, st = chr(0x2800 + bits[r][c]), ink[r][c]
            else:
                ch, st = " ", None
            if st != cur:
                row += "\033[0m" + (f"\033[{st}m" if st else "")
                cur = st
            row += ch
        out.append(row + "\033[0m")
    return out


_look_counts = {"n": -1, "day": "", "today": 0}


def look_header(cols, records, snap, busy, split):
    """The strip along the top: the deck's name, then big numbers -- seats,
    working, notes today (the whole log, counted once per new record), waiting,
    context, all-time cost (the ledger) and the version. Too narrow, stats drop from the right."""
    esc = "\033["
    day = time.strftime("%Y-%m-%d")
    if _look_counts["n"] != len(records) or _look_counts["day"] != day:
        _look_counts.update(n=len(records), day=day, today=sum(
            1 for r in records if r.get("kind") == "message" and str(r.get("time", "")).startswith(day)))
    waiting = sum(len(v) for v in snap["waiting"].values())
    total = sum(t for _, t in split)
    # All-time spend from the cost ledger (the owner, 23:08), dated from its
    # first entry: sessions before the ledger existed were never recorded.
    cost, estimated, since = ledger_total()
    cost_sub = ("est. " if estimated else "") + (
        "since " + time.strftime("%-d %b", time.localtime(since)) if since else "all time")
    count, _, h = (deck_version() or "?").partition("·")
    stats = [("SEATS", str(len(AGENTS) + len(APP_SEATS)), f"{len(busy)} working", 255),
             ("NOTES TODAY", str(_look_counts["today"]), "in the log", 45),
             ("WAITING", str(waiting), "in inboxes", 203 if waiting else 42),
             ("CONTEXT", short_tokens(total) if total else "–", f"{len(split)} reporting", 213),
             ("COST", f"${cost:,.0f}", cost_sub, 220),
             ("VERSION", f"v{count}", h, 141)]
    cells = [(f"{esc}2m{a}{esc}0m", f"{esc}1;38;5;{c}m{b}{esc}0m", f"{esc}2m{s}{esc}0m",
              max(len(a), len(b), len(s)) + 4) for a, b, s, c in stats]
    left = [f"{esc}48;5;208;38;5;232;1m  COMMS-DECK    {esc}0m  {esc}1;38;5;255mSTARSHIP CREW · LIVE ON {MACHINE.upper()}{esc}0m",
            f"{esc}48;5;208;38;5;232m  starship crew  {esc}0m  {esc}2mnotes · seats · context · usage · tasks{esc}0m",
            ""]
    while cells and max(visible_len(l) for l in left) + sum(c[3] for c in cells) + 1 > cols:
        cells = cells[:-1]
    rows = []
    for i in range(3):
        right = "".join(fit(c[i], c[3]) for c in cells)
        rows.append(fit(left[i] + " " * max(1, cols - visible_len(left[i]) - visible_len(right)) + right, cols))
    return rows


def look_ticker(cols, records, now):
    """The latest notes scrolling right to left along the bottom. A private
    note shows as '(private)', and names in the rest are redacted: the
    screen gets recorded for sim-deck (vibe, #87)."""
    esc = "\033["
    items = []
    for r in [r for r in records[-60:] if r.get("kind") == "message"][-10:][::-1]:
        text = "(private)" if r.get("private") else redact(" ".join(str(r.get("text", "")).split()))[:70]
        to = "everyone" if r["to"] == "all" else ", ".join(display_seat(t) for t in r["to"].split("+"))
        items.append((r["from"], f"{display_seat(r['from'])} → {to}: {text}"))
    if not items:
        return " " * cols
    plain = "".join(f"  ▪  {s}" for _, s in items)
    off = int(now * 8) % len(plain)
    out = (plain * (2 + cols // len(plain)))[off:off + cols]
    for seat in {s for s, _ in items}:
        out = out.replace(f"▪  {seat} →", f"{esc}38;5;208m▪{esc}0m  {esc}1;38;5;{colour(seat)}m{seat}{esc}0;2m →")
    return f"{esc}2m" + fit(out, cols)


def look_activity_parts(lines):
    """activity_panel draws ACTIVITY, TASKS and CONTEXT SPLIT in one column:
    cut it at those headings, so each gets its own frame."""
    parts, name = {"activity": [], "tasks": [], "split": []}, "activity"
    heads = {"ACTIVITY": "activity", "TASKS": "tasks", "CONTEXT SPLIT": "split"}
    for line in lines:
        plain = ANSI.sub("", line).strip()
        if plain in heads:
            name = heads[plain]
            continue
        parts[name].append(line)
    blank = lambda l: not ANSI.sub("", l).strip()
    for k, v in parts.items():
        while v and blank(v[0]):
            v.pop(0)
        while v and blank(v[-1]):
            v.pop()
    return parts


def look_widths(cols):
    """(left, centre, right) column widths for the look."""
    side = max(40, min(64, int(cols * 0.27)))
    return side, cols - 2 * side, side


def look_screen(cols, body_h, shown, records, now):
    """The look's lines: the strip (3 rows), `body_h` rows of panels, the ticker.
    `shown` is the chat's own wrapped note lines (chat_lines at the centre's inner width)."""
    snap = panel_scans()
    busy = busy_seats(snap)
    split = context_split()
    lw, cw, rw = look_widths(cols)
    usage = usage_panel(rw - 4)[2:]  # its own USAGE heading is in the frame now
    parts = look_activity_parts(activity_panel(lw - 4))
    # 02 sits under 01 on the left and 03 on the right (swapped by the
    # owner, 2026-11-26). Short of room, 02 drops the "↳ last note" lines
    # (one row per seat) and is cut to fit, rather than look_stack skipping it.
    crew_h = max(10, int(body_h * 0.45))
    room = body_h - crew_h - 4
    if len(parts["activity"]) > room:
        parts["activity"] = [l for l in parts["activity"]
                             if not ANSI.sub("", l).lstrip().startswith("↳")][:max(room, 0)]
    left = look_stack([
        (crew_h, lambda w, h: look_frame(
            "01", "CREW", "who talks to whom", look_tag(bool(busy), f"{len(busy)} WORKING"),
            LOOK_ACCENT["crew"], w, h, look_crew(w - 4, h - 4, records, snap, busy, split, now))),
        (None, lambda w, h: look_frame(
            "02", "ACTIVITY", "ready order", look_tag(bool(busy)), LOOK_ACCENT["activity"], w, h,
            parts["activity"][:h - 4])),
    ], lw, body_h)
    alerts = [l for l in notify_lines(cw - 4) if ANSI.sub("", l).strip()][:6]
    centre_panels = [(None, lambda w, h: look_frame(
        "04", "LIVE NOTES", "the crew's notes, newest last", "\033[38;5;42m● LIVE\033[0m",
        LOOK_ACCENT["notes"], w, h, ([""] * h + shown)[-(h - 4):]))]
    if alerts:
        centre_panels.append((len(alerts) + 4, lambda w, h: look_frame(
            "07", "ALERTS", "desktop notifications", "", LOOK_ACCENT["alerts"], w, h, alerts)))
    centre = look_stack(centre_panels, cw, body_h)
    tasks_h = len(parts["tasks"]) + 4 if parts["tasks"] else 0
    # 03 takes what it needs (cut to the column if short of room); 06 the rest.
    usage_h = min(len(usage) + 4, max(body_h - tasks_h, 0))
    right_panels = [
        # The look drops 03's own head line, so the /sort choice takes the
        # frame's subtitle (a narrow column would cut it off the end).
        (usage_h, lambda w, h: look_frame("03", "USAGE", "allocation · spend"
                                          if usage_sort() == "provider" else f"sorted by {usage_sort()}", "",
                                          LOOK_ACCENT["usage"], w, h, fit_column(usage, h - 4)))]
    if parts["tasks"]:
        right_panels.append((tasks_h, lambda w, h: look_frame(
            "05", "TASKS", "one task, one holder", "", LOOK_ACCENT["tasks"], w, h, parts["tasks"])))
    right_panels.append((None, lambda w, h: look_frame(
        "06", "CONTEXT SPLIT", "the shared pool", look_tag(bool(busy), "GLOWING", "STILL"),
        LOOK_ACCENT["split"], w, h, fit_column(parts["split"], h - 4))))
    right = look_stack(right_panels, rw, body_h)
    body = [fit(left[i], lw) + fit(centre[i], cw) + fit(right[i], rw) for i in range(body_h)]
    return look_header(cols, records, snap, busy, split) + body + [look_ticker(cols, records, now)]


def chat(history=200, hide_private=False):
    """Full-screen live view: notes on the left, usage on the right, status at the bottom."""
    path = DATA / "log.jsonl"
    path.parent.mkdir(parents=True, exist_ok=True)
    path.touch()
    out = sys.stdout

    # The chat box: the owner types on the line above the status bar.
    tty = sys.stdin.isatty()
    typed, notice, notice_until = "", "", 0.0
    decoder = __import__("codecs").getincrementaldecoder("utf-8")(errors="ignore")
    pending_esc = ""
    in_paste = False
    saved_tty = None
    if tty:
        import termios
        import tty as tty_mod
        saved_tty = termios.tcgetattr(sys.stdin)
        tty_mod.setcbreak(sys.stdin)
        out.write("\033[?2004h")  # bracketed paste: a pasted newline doesn't send

    def submit(line):
        nonlocal notice, notice_until
        line = line.strip()
        if not line:
            return
        # /sort switches 03's order without sending anyone a note: bare
        # /sort reports the current choice, /sort <mode> sets it. Unknown
        # words are refused loudly rather than half-applied or mailed.
        if line.split()[:1] == ["/sort"]:  # exactly /sort, so "/sorted…" is just a note
            arg = line[5:].strip()
            if not arg:
                notice, notice_until = "03 sorts by " + usage_sort() + " — /sort " + " | ".join(USAGE_SORTS), time.time() + 6
                return False  # keep the line, in case the owner was mid-edit
            error = set_sort(arg)
            if error:
                notice, notice_until = error, time.time() + 6
                return False
            notice, notice_until = "03 sorts by " + usage_sort(), time.time() + 4
            return True
        seats, error = route(line)
        if error:
            notice, notice_until = error, time.time() + 6
            return False
        record, _ = send("owner", seats, line)
        notice, notice_until = "sent to " + record["to"].replace("+", ", "), time.time() + 4
        return True

    def handle_keys():
        """Read whatever was typed. Returns True if the screen should redraw."""
        nonlocal typed, pending_esc, in_paste
        import select
        if not tty or not select.select([sys.stdin], [], [], 0)[0]:
            return False
        chars = pending_esc + decoder.decode(os.read(sys.stdin.fileno(), 4096))
        pending_esc = ""
        i = 0
        while i < len(chars):
            c = chars[i]
            if c == "\033":
                m = re.match(r"\033\[[0-9;?]*[ -/]*[@-~]", chars[i:])
                if m:
                    seq = m.group(0)
                    in_paste = {"\033[200~": True, "\033[201~": False}.get(seq, in_paste)
                    i += len(seq)
                    continue
                if i + 1 >= len(chars) or chars[i + 1] == "[":
                    pending_esc = chars[i:]  # sequence split across reads
                    break
                typed = ""  # Esc on its own clears the line
            elif c in "\r\n":
                if in_paste:
                    typed += " "
                elif submit(typed) is not False:
                    typed = ""
            elif c in "\x7f\x08":
                typed = typed[:-1]
            elif c == "\x15":
                typed = ""
            elif c == "\x17":
                typed = typed.rstrip().rsplit(" ", 1)[0] + " " if " " in typed.rstrip() else ""
            elif c >= " ":
                typed += c
            i += 1
        return True

    def input_line(cols):
        if not tty:
            return ""
        if typed:
            shown_text = typed[-(cols - 12):]
            highlighted = MENTION.sub(lambda m: f"\033[1;38;5;{colour(m.group(1).lower())}m@{m.group(1)}\033[0m", shown_text)
            line = f"  \033[1;38;5;{colour('owner')}m{OWNER_NAME.lower()} ›\033[0m {highlighted}\033[7m \033[0m"
        else:
            line = (f"  \033[1;38;5;{colour('owner')}m{OWNER_NAME.lower()} ›\033[0m \033[7m \033[0m\033[2m type a note · "
                    + " ".join(f"@{s}" for s in SEATS if s != "owner" and s not in HIDDEN_SEATS) + " · no @ = everyone\033[0m")
        if notice and time.time() < notice_until:
            line += f"   \033[38;5;{196 if notice.startswith('no seat') else 78}m{notice}\033[0m"
        return line

    records = []
    with open(path) as f:
        for line in f:
            try:
                records.append(json.loads(line))
            except ValueError:
                pass
        out.write("\033[?25l\033[2J")
        shown, layout, last_draw = [], None, 0.0
        try:
            while True:
                cols, rows = shutil.get_terminal_size((100, 40))
                look = cols >= LOOK_MIN_COLS and not setting("OLD_LOOK")
                if look:  # the deck look: notes in the centre frame (the owner, 2026-11-25)
                    usage_w = panel_w = 0
                    chat_w = look_widths(cols)[1] - 4
                elif cols >= 126:  # three columns: usage left, chat middle, the ready order right (the owner, 02:27)
                    usage_w = max(34, min(46, cols // 4))
                    panel_w = max(38, min(52, cols // 3))
                    chat_w = cols - usage_w - panel_w - 6
                elif cols >= 90:  # two columns: on a narrow screen the ready order wins the right
                    usage_w = 0
                    panel_w = max(40, min(52, cols // 3))  # 40: a full ACTIVITY row fits
                    chat_w = cols - panel_w - 3
                else:
                    usage_w = panel_w = 0
                    chat_w = cols
                changed = False
                if layout != (cols, rows):  # first time, or the window was resized
                    layout, changed = (cols, rows), True
                    shown = []  # (the name and version live in the fixed top bar now)
                    for r in records[-history:]:
                        if not (hide_private and r.get("private")):
                            shown += chat_lines(r, chat_w)
                line = f.readline()
                while line:
                    try:
                        r = json.loads(line)
                        records.append(r)
                        if not (hide_private and r.get("private")):
                            shown += chat_lines(r, chat_w)
                            changed = True
                    except ValueError:
                        pass
                    line = f.readline()
                shown = shown[-2000:]
                if handle_keys():
                    changed = True
                if not typed and not in_paste and not pending_esc and fresh_code():
                    raise FreshCode  # nothing half typed: reopen on the new code (after the finally)
                # The animation clock (04:02, tuned to devin's review): only
                # the busy bars' shimmer runs the fast clock -- the loop
                # wakes every ~16 ms and frames go out on a 30 fps cap (STOX,
                # 2026-11-26: at 120 fps the full chat held ~45% of a core and
                # froze kitty on the 4480 px screen; was 120)
                # (measured: ~1.4 ms to build a frame cached, so plenty of
                # headroom; kitty syncs and drops what can't keep up). A
                # ticking countdown (a spent reset, an app seat's next
                # check) keeps the old 1 s cadence: it changes once a
                # second, so 120 fps of it would be ~1 core of identical
                # frames for up to an hour. The scans sit behind a
                # half-second snapshot, so the fast clock doesn't hammer
                # /proc and the inboxes. Quiet screens keep the old pace --
                # 0.25 s polls, 1-2 s redraws. (#66, devin: a live ms
                # countdown redraws at 10 fps, between the two.)
                animating = getattr(usage_panel, "running", False) or (look and getattr(look_crew, "moving", False))
                gap = 1 / 30 if animating else (0.1 if getattr(activity_panel, "fast", False)
                                                 else 1 if getattr(activity_panel, "ticking", False) else 2)
                if look:
                    gap = max(gap, 1 / 5)  # a look frame costs tens of ms: at 15 fps the full chat held
                                           # ~40% of a core on this 8 GB box; 5 fps (STOX, 2026-11-26)
                if look and (changed or time.time() - last_draw >= gap):
                    body = rows - 4 - (1 if tty else 0)  # the strip (3), the ticker, the chat box
                    screen = ["\033[H", "\n".join(look_screen(cols, body, shown, records, time.time()))]
                    if tty:
                        screen.append(f"\n\033[48;5;234m{fit(input_line(cols), cols)}")
                    out.write("".join(screen))
                    out.flush()
                    last_draw = time.time()
                elif changed or time.time() - last_draw >= gap:
                    # A fixed top bar (the version, 04:26), the notes, then
                    # the chat box as the last line.
                    body = rows - (2 if tty else 1)  # top bar + (the chat box | just the bar)
                    left = shown[-body:]
                    left = [""] * (body - len(left)) + left
                    if usage_w:
                        usg = usage_panel(usage_w)  # sets usage_panel.running for the clock
                    else:
                        usage_panel.running = False  # no usage column: don't let a stale True spin the clock
                        usg = []
                    act = (activity_panel(panel_w) + notify_lines(panel_w)) if panel_w else []
                    usg = (fit_column(usg, body) + [""] * body)[:body]
                    right = (fit_column(act, body) + [""] * body)[:body]
                    screen = ["\033[H", deck_header(cols), "\n"]
                    for i in range(body):
                        row = (fit(usg[i], usage_w) + f" \033[38;5;238m│\033[0m ") if usage_w else ""
                        row += fit(left[i], chat_w)
                        if panel_w:
                            row += f" \033[38;5;238m│\033[0m " + fit(right[i], panel_w)
                        screen.append(row + ("\n" if i < body - 1 or tty else ""))
                    if tty:
                        screen.append(f"\033[48;5;234m{fit(input_line(cols), cols)}")
                    out.write("".join(screen))
                    out.flush()
                    last_draw = time.time()
                if tty:
                    import select
                    select.select([sys.stdin], [], [], 1 / 60 if animating else 0.25)
                else:
                    time.sleep(1 / 60 if animating else 0.25)
        finally:
            if saved_tty is not None:
                import termios
                termios.tcsetattr(sys.stdin, termios.TCSADRAIN, saved_tty)
                out.write("\033[?2004l")
            out.write("\033[0m\033[2J\033[H\033[?25h")
            out.flush()


# -----------------------------------------------------------------------------
# SECTION 9b: mail - a small email client for the owner's Proton account
# -----------------------------------------------------------------------------
#
# The owner reads and sends mail from the window on the mail desktop
# (workspace 10, Super+9). It talks to Proton Mail Bridge on localhost
# (IMAP 127.0.0.1:1143, SMTP 127.0.0.1:1025 unless mail.json says otherwise):
# Bridge is the only door Proton opens to outside programs, and the owner
# signs in to it themselves. The Bridge password is the first line of
# ~/.config/comms-deck/mail.secret (chmod 600); the address and ports are in
# mail.json next to it ("password" there works too). Neither is ever logged
# or sent anywhere, and the client only reads the mailbox (BODY.PEEK), so
# opening a message never marks it read on the server.
#
# The sync is its own: the screen re-checks the inbox every minute while
# it's open, so no agent has to stay up for mail to arrive.

MAIL_POLL = 60  # seconds between inbox checks while the screen is open
ESC_GRACE = 0.05  # a lone Esc sits this long waiting for a split sequence
MAIL_KEYS = {"\033[A": "up", "\033[B": "down", "\033[C": "right", "\033[D": "left",
             "\033[H": "home", "\033[F": "end", "\033[1~": "home", "\033[4~": "end",
             "\033[3~": "delete", "\033[5~": "pgup", "\033[6~": "pgdn",
             "\033OA": "up", "\033OB": "down", "\033OC": "right", "\033OD": "left",
             "\033OH": "home", "\033OF": "end"}


def mail_settings():
    """The mail client's setup, or None when it isn't configured yet.

    mail.json: {"address": "...", "imap_host": ..., "imap_port": ...,
    "smtp_host": ..., "smtp_port": ...}. mail.secret: the Bridge password,
    one line. Nothing here is ever logged or sent anywhere.
    """
    cfg = read_json(CONFIG / "mail.json", None)
    if not isinstance(cfg, dict) or not cfg.get("address"):
        return None
    secret = CONFIG / "mail.secret"
    password = ""
    if secret.exists():
        lines = secret.read_text().splitlines()
        password = lines[0].strip() if lines else ""
    password = password or str(cfg.get("password") or "")
    if not password:
        return None
    return {"address": str(cfg["address"]), "password": password,
            "imap": (str(cfg.get("imap_host") or "127.0.0.1"), int(cfg.get("imap_port") or 1143)),
            "smtp": (str(cfg.get("smtp_host") or "127.0.0.1"), int(cfg.get("smtp_port") or 1025))}


def mail_loopback(host):
    """True for 127.x, ::1 and localhost — the only hosts allowed plain Bridge."""
    import ipaddress
    try:
        return ipaddress.ip_address(host).is_loopback
    except ValueError:
        return host.lower().rstrip(".") == "localhost"


def mail_tls_context(host):
    """SSL context for the Bridge. Loopback gets an unverified context (the
    cert is self-signed and the connection never leaves the machine); any
    other host gets full certificate verification."""
    import ssl
    ctx = ssl.create_default_context()
    if mail_loopback(host):
        ctx.check_hostname = False
        ctx.verify_mode = ssl.CERT_NONE
    return ctx


def mail_imap_open(settings):
    """Connect to the Bridge's IMAP port, STARTTLS when offered (required
    off-loopback), and log in. Returns the open IMAP4."""
    import imaplib
    host, port = settings["imap"]
    imap = imaplib.IMAP4(host, port, timeout=20)
    try:
        if imap.has_capability("STARTTLS"):
            imap.starttls(mail_tls_context(host))
        elif not mail_loopback(host):
            raise ValueError(f"{host}:{port} offers no STARTTLS; refusing plain login")
        imap.login(settings["address"], settings["password"])
    except Exception:
        try:
            imap.logout()
        except Exception:
            pass
        raise
    return imap


def mail_decode(value):
    """A header value as plain text (encoded words decoded)."""
    import email.header
    try:
        return str(email.header.make_header(email.header.decode_header(value or "")))
    except Exception:
        return value or ""


def mail_stamp(date_text):
    """A Date header as a unix timestamp, or 0 when it can't be read."""
    import email.utils
    try:
        return email.utils.parsedate_to_datetime(date_text).timestamp()
    except (TypeError, ValueError, OverflowError):
        return 0.0


def mail_envelope(raw):
    """One inbox row from a message's headers (or a whole raw message)."""
    import email.utils
    msg = email.message_from_bytes(raw)
    name, addr = email.utils.parseaddr(mail_decode(msg.get("From", "")))
    date = mail_decode(msg.get("Date", ""))
    stamp = mail_stamp(date)
    return {"from": name or addr, "addr": addr,
            "subject": mail_decode(msg.get("Subject", "")) or "(no subject)",
            "date": date, "stamp": stamp,
            "when": time.strftime("%d %b %H:%M", time.localtime(stamp)) if stamp else ""}


def mail_body_text(raw):
    """The readable text of a raw RFC822 message: text/plain preferred, HTML stripped."""
    import email
    import html as html_mod
    msg = email.message_from_bytes(raw)
    plain, rich = [], []
    for part in msg.walk():
        if part.get_content_maintype() == "multipart" or part.get_content_disposition() == "attachment":
            continue
        if part.get_content_type() == "text/plain":
            plain.append(part)
        elif part.get_content_type() == "text/html":
            rich.append(part)

    def body_of(part):
        raw_part = part.get_payload(decode=True)
        if raw_part is None:
            raw_part = part.get_payload()
            return raw_part if isinstance(raw_part, str) else ""
        try:
            return raw_part.decode(part.get_content_charset() or "utf-8", "replace")
        except LookupError:
            return raw_part.decode("utf-8", "replace")

    if plain:
        return "\n".join(body_of(p) for p in plain).strip()
    if rich:
        text = "\n".join(body_of(p) for p in rich)
        text = re.sub(r"(?is)<(script|style).*?</\1>", " ", text)
        text = re.sub(r"(?s)<[^>]+>", " ", text)
        return re.sub(r"[ \t]+", " ", html_mod.unescape(text)).strip()
    if msg.get_content_maintype() == "text":
        return body_of(msg)
    return ""


def mail_inbox(settings, limit=60):
    """The inbox's newest `limit` messages as envelope dicts with `uid`, oldest first.

    Read-only: BODY.PEEK never sets \\Seen, and the mailbox is only SELECTed
    readonly, so looking never marks anything read on the server.
    """
    rows = []
    imap = mail_imap_open(settings)
    try:
        typ, _ = imap.select("INBOX", readonly=True)
        if typ != "OK":
            return rows
        typ, data = imap.uid("search", None, "ALL")
        uids = (data[0] or b"").split()[-limit:] if typ == "OK" else []
        for i in range(0, len(uids), 20):
            chunk = ",".join(u.decode() for u in uids[i:i + 20])
            typ, fetched = imap.uid("fetch", chunk, "(BODY.PEEK[HEADER.FIELDS (FROM SUBJECT DATE)])")
            if typ != "OK":
                continue
            for item in fetched:
                if not isinstance(item, tuple) or len(item) != 2:
                    continue
                meta, literal = item
                m = re.search(rb"UID (\d+)", meta if isinstance(meta, bytes) else b"")
                body = literal[0] if isinstance(literal, list) and literal else b""
                if m and body:
                    row = mail_envelope(body)
                    row["uid"] = m.group(1).decode()
                    rows.append(row)
    finally:
        try:
            imap.logout()
        except Exception:
            pass
    rows.sort(key=lambda r: (r["stamp"], int(r["uid"])))
    return rows


def mail_read_message(settings, uid):
    """One whole message as (envelope, plain-text body), or (None, "") when it's gone."""
    imap = mail_imap_open(settings)
    try:
        imap.select("INBOX", readonly=True)
        typ, fetched = imap.uid("fetch", str(uid), "(BODY.PEEK[])")
        raw = b""
        for item in fetched:
            if isinstance(item, tuple) and item[1]:
                raw = item[1][0] if isinstance(item[1], list) else item[1]
                break
        if not raw:
            return None, ""
        return mail_envelope(raw), mail_body_text(raw)
    finally:
        try:
            imap.logout()
        except Exception:
            pass


def mail_send(settings, to, subject, body):
    """Send one plain-text email through the Bridge's SMTP port. None, or the error."""
    import datetime
    import smtplib
    from email.message import EmailMessage
    from email.utils import format_datetime, make_msgid
    msg = EmailMessage()
    msg["From"] = settings["address"]
    msg["To"] = to
    msg["Subject"] = subject
    msg["Date"] = format_datetime(datetime.datetime.now().astimezone())
    msg["Message-ID"] = make_msgid("comms-deck")
    msg.set_content(body or "")
    try:
        smtp = smtplib.SMTP(settings["smtp"][0], settings["smtp"][1], timeout=20)
        try:
            host = settings["smtp"][0]
            try:
                smtp.ehlo()  # has_extn only sees features after EHLO
            except smtplib.SMTPHeloError:
                pass
            if smtp.has_extn("STARTTLS"):
                smtp.starttls(context=mail_tls_context(host))
            elif not mail_loopback(host):
                raise ValueError(f"{host}:{settings['smtp'][1]} offers no STARTTLS; refusing plain login")
            smtp.login(settings["address"], settings["password"])
            smtp.send_message(msg)
        finally:
            smtp.quit()
    except Exception as error:
        return str(error)
    return None


def mail_seen_uids():
    """Uids the owner has opened, kept locally so the server flags stay untouched."""
    return set(str(u) for u in (read_json(DATA / "mail-seen.json", []) or []))


def mail_mark_seen(uid):
    seen = mail_seen_uids() | {str(uid)}
    write_json(DATA / "mail-seen.json", sorted(seen)[-2000:])


# -- the compose editor: a tiny text buffer with a (row, col) cursor --------


def te_clamp(text, cur):
    """Keep a [row, col] cursor inside `text`."""
    row, col = cur
    lines = text.split("\n")
    return [max(0, min(row, len(lines) - 1)), max(0, min(col, len(lines[min(max(row, 0), len(lines) - 1)])))]


def te_insert(text, cur, ch):
    """Insert `ch` at the cursor; returns (text, cur)."""
    row, col = cur
    lines = text.split("\n")
    lines[row] = lines[row][:col] + ch + lines[row][col:]
    return "\n".join(lines), [row, col + len(ch)]


def te_newline(text, cur):
    """Enter at the cursor: split the line, cursor to the start of the new one."""
    row, col = cur
    lines = text.split("\n")
    lines[row:row + 1] = [lines[row][:col], lines[row][col:]]
    return "\n".join(lines), [row + 1, 0]


def te_backspace(text, cur):
    """Delete the character before the cursor, joining lines at a line start."""
    row, col = cur
    lines = text.split("\n")
    if col:
        lines[row] = lines[row][:col - 1] + lines[row][col:]
        return "\n".join(lines), [row, col - 1]
    if row:
        prev = len(lines[row - 1])
        lines[row - 1:row + 1] = [lines[row - 1] + lines[row]]
        return "\n".join(lines), [row - 1, prev]
    return text, cur


def te_delete(text, cur):
    """Delete the character at the cursor, joining lines at a line end."""
    row, col = cur
    lines = text.split("\n")
    if col < len(lines[row]):
        lines[row] = lines[row][:col] + lines[row][col + 1:]
        return "\n".join(lines), cur
    if row < len(lines) - 1:
        lines[row:row + 2] = [lines[row] + lines[row + 1]]
        return "\n".join(lines), cur
    return text, cur


def te_move(text, cur, key):
    """Arrow/Home/End movement for the compose editor."""
    row, col = cur
    lines = text.split("\n")
    if key == "left":
        if col:
            col -= 1
        elif row:
            row, col = row - 1, len(lines[row - 1])
    elif key == "right":
        if col < len(lines[row]):
            col += 1
        elif row < len(lines) - 1:
            row, col = row + 1, 0
    elif key == "up":
        if row:
            row -= 1
            col = min(col, len(lines[row]))
    elif key == "down":
        if row < len(lines) - 1:
            row += 1
            col = min(col, len(lines[row]))
    elif key == "home":
        col = 0
    elif key == "end":
        col = len(lines[row])
    return te_clamp(text, [row, col])


def te_cursor_line(line, col, width):
    """One compose line with the cursor cell in reverse video, fitted to `width`."""
    line = line[:width]
    col = min(col, len(line))
    cell = line[col] if col < len(line) else " "
    rest = line[col + 1:] if col < len(line) else ""
    return fit(line[:col] + "\033[7m" + cell + "\033[0m" + rest, width)


def mail():
    """The mail screen: inbox on the left, the open message on the right,
    a compose editor over both. Quits on q/Esc at the inbox; restarts itself
    on new code like the chat screen does."""
    settings = mail_settings()
    out = sys.stdout
    tty = sys.stdin.isatty()
    if not tty:
        # A script or a pipe: just say whether the client is set up.
        if settings:
            print(f"comms-deck mail: configured for {settings['address']} "
                  f"(imap {settings['imap'][0]}:{settings['imap'][1]}, smtp {settings['smtp'][0]}:{settings['smtp'][1]}); "
                  "run `comms-deck mail` in a terminal for the screen.")
        else:
            print("comms-deck mail: not set up yet. Create ~/.config/comms-deck/mail.json "
                  "({\"address\": \"...\"}) and ~/.config/comms-deck/mail.secret (the Bridge password), "
                  "then run `comms-deck mail` in a terminal.")
        return

    saved_tty = None
    if tty:
        import termios
        import tty as tty_mod
        saved_tty = termios.tcgetattr(sys.stdin)
        tty_mod.setcbreak(sys.stdin)
        attrs = termios.tcgetattr(sys.stdin)
        attrs[0] &= ~termios.IXON  # Ctrl+S is the compose screen's send key, not XOFF
        termios.tcsetattr(sys.stdin, termios.TCSANOW, attrs)
        out.write("\033[?2004h")  # bracketed paste

    S = {"mode": "list", "sel": 0, "msgs": [], "open": None, "scroll": 0,
         "compose": None, "return_mode": "list", "seen": mail_seen_uids(),
         "notice": "", "notice_until": 0.0, "last_poll": 0.0, "quitting": False}
    decoder = __import__("codecs").getincrementaldecoder("utf-8")(errors="ignore")
    pending_esc = ""
    pending_since = 0.0
    in_paste = False

    def flash(text, seconds=6):
        S["notice"], S["notice_until"] = text, time.time() + seconds

    def refresh_mail(force=False):
        if not force and time.time() - S["last_poll"] < MAIL_POLL:
            return
        S["last_poll"] = time.time()
        try:
            S["msgs"] = mail_inbox(settings)
            S["sel"] = min(S["sel"], max(0, len(S["msgs"]) - 1))
        except Exception as error:
            flash("mail unreachable: " + str(error)[:80], 10)

    def open_message(row):
        try:
            env, text = mail_read_message(settings, row["uid"])
        except Exception as error:
            env, text = row, f"(couldn't read the message: {error})"
        S["open"] = {"row": row, "env": env or row, "text": text}
        S["scroll"] = 0
        mail_mark_seen(row["uid"])
        S["seen"].add(str(row["uid"]))
        S["mode"] = "read"

    def compose_end(compose, name):
        lines = compose[name].split("\n")
        compose["cur"] = [len(lines) - 1, len(lines[-1])]

    def compose_go(compose, name):
        compose["field"] = name
        compose_end(compose, name)

    def start_compose(reply=None):
        to, subject = "", ""
        if reply:
            to = reply.get("addr") or reply.get("from") or ""
            subject = reply.get("subject") or ""
            if subject and not subject.lower().startswith("re:"):
                subject = "Re: " + subject
        S["compose"] = {"to": to, "subject": subject, "body": "", "field": "to", "cur": [0, 0]}
        compose_end(S["compose"], "to")
        S["return_mode"] = S["mode"]
        S["mode"] = "compose"

    def compose_send():
        compose = S["compose"]
        to = compose["to"].strip()
        if not to:
            flash("compose: no recipient")
            return
        subject = compose["subject"].strip() or "(no subject)"
        error = mail_send(settings, to, subject, compose["body"])
        if error:
            flash("send failed: " + error[:80], 10)
            return
        flash("sent to " + to, 4)
        S["compose"] = None
        S["mode"] = S["return_mode"]
        refresh_mail(force=True)

    def compose_key(key):
        """One key in the compose editor. Returns True when Esc cancels it."""
        compose = S["compose"]
        name = compose["field"]
        text, cur = compose[name], compose["cur"]
        order = ["to", "subject", "body"]
        if key in ("left", "right", "home", "end"):
            compose["cur"] = te_move(text, cur, key)
        elif key in ("up", "down"):
            if name == "body":
                compose["cur"] = te_move(text, cur, key)
                if key == "up" and cur[0] == 0:  # up from the body's first line: the subject
                    compose_go(compose, "subject")
            elif key == "down":
                compose_go(compose, order[min(order.index(name) + 1, 2)])
            else:
                compose_go(compose, order[max(order.index(name) - 1, 0)])
        elif key == "tab":
            compose_go(compose, order[(order.index(name) + 1) % 3])
        elif key == "enter":
            if name == "body":
                compose["body"], compose["cur"] = te_newline(compose["body"], cur)
            else:
                compose_go(compose, order[min(order.index(name) + 1, 2)])
        elif key == "backspace":
            compose[name], compose["cur"] = te_backspace(text, cur)
        elif key == "delete":
            compose[name], compose["cur"] = te_delete(text, cur)
        elif key == "esc":
            return True
        return False

    def type_char(c):
        if S["mode"] == "compose":
            compose = S["compose"]
            name = compose["field"]
            compose[name], compose["cur"] = te_insert(compose[name], compose["cur"], c)
        elif S["mode"] == "list":
            if c == "j" and S["msgs"]:
                S["sel"] = min(len(S["msgs"]) - 1, S["sel"] + 1)
            elif c == "k":
                S["sel"] = max(0, S["sel"] - 1)
            elif c == "c":
                start_compose()
            elif c == "g":
                refresh_mail(force=True)
            elif c == "q":
                S["quitting"] = True
        elif S["mode"] == "read":
            if c == "j":
                S["scroll"] += 1
            elif c == "k":
                S["scroll"] = max(0, S["scroll"] - 1)
            elif c == "r" and S["open"]:
                start_compose(reply=S["open"]["row"])
            elif c == "c":
                start_compose()
            elif c == "g":
                refresh_mail(force=True)
            elif c == "q":
                S["mode"] = "list"

    def press(key):
        mode = S["mode"]
        if key == "ctrl_s" and mode == "compose":
            compose_send()
        elif mode == "list":
            if key == "down" and S["msgs"]:
                S["sel"] = min(len(S["msgs"]) - 1, S["sel"] + 1)
            elif key == "up":
                S["sel"] = max(0, S["sel"] - 1)
            elif key == "enter" and S["msgs"]:
                open_message(S["msgs"][S["sel"]])
            elif key == "g":
                refresh_mail(force=True)
            elif key in ("q", "esc"):
                S["quitting"] = True
        elif mode == "read":
            if key in ("down", "pgdn"):
                S["scroll"] += 10 if key == "pgdn" else 1
            elif key in ("up", "pgup"):
                S["scroll"] = max(0, S["scroll"] - (10 if key == "pgup" else 1))
            elif key == "g":
                refresh_mail(force=True)
            elif key in ("esc", "q"):
                S["mode"] = "list"
        elif mode == "compose":
            if compose_key(key):  # Esc cancels the compose
                S["compose"] = None
                S["mode"] = S["return_mode"]

    def handle_keys():
        """Read whatever was typed. Returns True so the screen redraws."""
        nonlocal pending_esc, pending_since, in_paste
        import select
        ready = tty and select.select([sys.stdin], [], [], 0)[0]
        if pending_esc == "\033" and not ready and time.time() - pending_since > ESC_GRACE:
            pending_esc = ""
            press("esc")  # a lone Esc, not the start of a split sequence
            return True
        if not ready:
            return False
        chars = pending_esc + decoder.decode(os.read(sys.stdin.fileno(), 4096))
        pending_esc = ""
        i = 0
        while i < len(chars):
            c = chars[i]
            if c == "\033":
                m = re.match(r"\033\[[0-9;?]*[ -/]*[@-~]", chars[i:])
                if m:
                    seq = m.group(0)
                    in_paste = {"\033[200~": True, "\033[201~": False}.get(seq, in_paste)
                    key = MAIL_KEYS.get(seq)
                    if key and not in_paste:
                        press(key)
                    i += len(seq)
                    continue
                if i + 1 >= len(chars) or chars[i + 1] == "[":
                    pending_esc = chars[i:]  # sequence split across reads
                    pending_since = time.time()
                    break
                press("esc")
            elif c in "\r\n":
                if in_paste:
                    if S["mode"] == "compose":
                        compose = S["compose"]
                        compose["body"], compose["cur"] = te_insert(compose["body"], compose["cur"], "\n")
                else:
                    press("enter")
            elif c == "\t":
                press("tab")
            elif c in "\x7f\x08":
                press("backspace")
            elif c == "\x13":
                press("ctrl_s")
            elif c >= " ":
                type_char(c)
            i += 1
        return True

    def mail_header(cols):
        unread = sum(1 for m in S["msgs"] if str(m["uid"]) not in S["seen"])
        left = "comms-deck mail · " + settings["address"]
        right = f"{unread} unread"
        ver = deck_version()
        if ver:
            right += " · " + ver
        if visible_len(left) + visible_len(right) + 2 > cols:
            left = "comms-deck mail"
        if visible_len(left) + visible_len(right) + 2 > cols:
            right = f"{unread} unread"
        gap = max(1, cols - visible_len(left) - visible_len(right) - 2)
        return ("\033[48;5;234m\033[1;38;5;255m " + left + " " * gap
                + "\033[2;38;5;244m" + right + " \033[0m")

    def list_row(row, width, selected):
        unread = str(row["uid"]) not in S["seen"]
        dot = "\033[38;5;208m●\033[0m" if unread else "\033[2m·\033[0m"
        frm = (row["from"] or row["addr"])[:18].ljust(18)
        when = row.get("when", "")
        w_subj = max(8, width - 1 - 1 - 18 - 4 - len(when) - 2)
        subj = row["subject"][:w_subj].ljust(w_subj)
        plain = f"{'●' if unread else '·'} {frm}  {subj}  {when}"
        if selected:
            return "\033[7m" + fit(ANSI.sub("", plain), width)
        return fit(dot + " " + frm + "  " + subj + "  " + when, width)

    def read_lines(width, height):
        import textwrap
        op = S["open"]
        env = op["env"]
        head = []
        sender = env.get("from") or ""
        if env.get("addr") and env["addr"] != sender:
            sender += f" <{env['addr']}>"
        head += [f"From:    {sender}", f"Subject: {env.get('subject', '')}",
                 f"Date:    {env.get('when') or env.get('date', '')}", ""]
        body = []
        for para in op["text"].splitlines() or [""]:
            body += textwrap.wrap(para, max(20, width - 2)) or [""]
        lines = head + body
        start = min(max(0, S["scroll"]), max(0, len(lines) - height))
        return [fit(l, width) for l in lines[start:start + height]]

    def compose_lines(width, height):
        compose = S["compose"]
        lines = []
        for name, label in (("to", "To"), ("subject", "Subject")):
            active = compose["field"] == name
            if active:
                shown = te_cursor_line(compose[name], compose["cur"][1], width - len(label) - 4)
            else:
                shown = fit(compose[name], width - len(label) - 4)
            lines.append(f"  {label + ':':<10} " + shown)
        lines.append("  " + "\033[2m" + "─" * (width - 4) + "\033[0m")
        body_h = max(1, height - len(lines))
        blines = compose["body"].split("\n") or [""]
        cur = compose["cur"] if compose["field"] == "body" else None
        start = 0
        if cur and cur[0] >= body_h:
            start = min(cur[0] - body_h + 1, max(0, len(blines) - body_h))
        for i in range(start, min(len(blines), start + body_h)):
            if cur and i == cur[0]:
                lines.append("  " + te_cursor_line(blines[i], cur[1], width - 2))
            else:
                lines.append("  " + fit(blines[i], width - 2))
        return lines

    def mail_input(cols):
        hints = {"list": "j/k move · enter read · c compose · g refresh · q quit",
                 "read": "j/k scroll · r reply · c compose · g refresh · esc back",
                 "compose": "tab/↑↓ field · enter newline · ctrl+s send · esc cancel"}[S["mode"]]
        line = "  " + hints
        if time.time() < S["notice_until"]:
            line += "   " + S["notice"]
        return "\033[48;5;234m" + fit("\033[2m" + line, cols) + "\033[0m"

    def mail_frame(cols, rows):
        inner = cols - 2  # one-space margin each side
        body_h = rows - 2  # the header band and the input line
        split = cols >= 90 and S["mode"] != "compose"
        if S["mode"] == "compose":
            content = compose_lines(inner, body_h)
        elif split:
            list_w = max(28, min(44, inner // 3))
            pane_w = inner - list_w - 3
            # newest at the bottom, like the chat screen
            shown = S["msgs"][-body_h:] if len(S["msgs"]) > body_h else S["msgs"]
            offset = len(S["msgs"]) - len(shown)
            left = [list_row(row, list_w, offset + i == S["sel"]) for i, row in enumerate(shown)]
            left = ([""] * (body_h - len(left)) + left)[-body_h:]
            if S["mode"] == "read" and S["open"]:
                right = read_lines(pane_w, body_h)
            else:
                op = S["open"]
                right = ([fit("From: " + (op["env"].get("from") or ""), pane_w),
                          fit("Subj: " + op["env"].get("subject", ""), pane_w), ""]
                         if op else [])
                right += [fit("enter: read · c: compose", pane_w)]
            right = (right + [""] * body_h)[:body_h]
            content = [fit(l, list_w) + " \033[38;5;238m│\033[0m " + fit(r, pane_w)
                       for l, r in zip(left, right)]
        else:
            if S["mode"] == "read" and S["open"]:
                content = read_lines(inner, body_h)
            else:
                shown = S["msgs"][-body_h:] if len(S["msgs"]) > body_h else S["msgs"]
                offset = len(S["msgs"]) - len(shown)
                content = [list_row(row, inner, offset + i == S["sel"]) for i, row in enumerate(shown)]
        content = (content + [""] * body_h)[:body_h]
        lines = [mail_header(cols), ""] + [" " + l for l in content] + [mail_input(cols)]
        return [fit(l, cols) for l in lines[:rows]]

    out.write("\033[?25l\033[2J")
    last_draw = 0.0
    try:
        if settings is None:
            # The setup screen: what to create, then any key closes it.
            cols, rows = shutil.get_terminal_size((100, 40))
            notes = ["comms-deck mail isn't set up yet.", "",
                     "Create ~/.config/comms-deck/mail.json:",
                     '  {"address": "you@proton.me", "imap_port": 1143, "smtp_port": 1025}',
                     "and ~/.config/comms-deck/mail.secret (chmod 600) with the",
                     "Proton Mail Bridge password on the first line.", "",
                     "Bridge: sudo pacman -S protonmail-bridge, sign in, then",
                     "run `comms-deck mail` again once Bridge answers.", "", "any key closes this"]
            frame = ["", "", ""] + ["  " + fit(n, cols - 2) for n in notes] + [""] * (rows - 3 - len(notes))
            out.write("\033[H" + "\n".join(frame[:rows]) + "\n")
            out.flush()
            import select
            while True:
                select.select([sys.stdin], [], [], 0.25)
                if select.select([sys.stdin], [], [], 0)[0]:
                    os.read(sys.stdin.fileno(), 1024)
                    break
        else:
            while not S["quitting"]:
                cols, rows = shutil.get_terminal_size((100, 40))
                refresh_mail()
                typed = handle_keys()
                if typed or time.time() - last_draw >= 1 or S["mode"] == "compose":
                    out.write("\033[H" + "\n".join(mail_frame(cols, rows)) + "\n")
                    out.flush()
                    last_draw = time.time()
                fresh_ok = not (S["mode"] == "compose" and (S["compose"]["to"] or S["compose"]["subject"]
                                                            or S["compose"]["body"]))
                if fresh_ok and fresh_code():
                    raise FreshCode  # nothing half typed: reopen on the new code
                import select
                select.select([sys.stdin], [], [], 0.25)
    finally:
        if saved_tty is not None:
            import termios
            termios.tcsetattr(sys.stdin, termios.TCSADRAIN, saved_tty)
            out.write("\033[?2004l")
        out.write("\033[0m\033[2J\033[H\033[?25h")
        out.flush()


# The status line (`comms-deck statusline --source <agent>`): Claude Code and
# Grok both pipe their session details (model, context, cost, and for Claude
# plan limits) to a status line command as JSON. This saves that JSON as
# usage/<seat>.json for the chat view's usage panel, and prints a short row
# for the agent's own window.


def statusline(source):
    """Save the agent's status JSON and print a one-line summary."""
    try:
        data = json.loads(sys.stdin.read() or "{}")
    except ValueError:
        data = {}
    seat = setting("SEAT") or source
    record = {"time": time.time(), "source": source, "data": data}
    write_json(DATA / "usage" / f"{seat}.json", record)
    try:
        ledger_note(seat, record)  # catch the cost now: another session may overwrite this file first
    except (OSError, ValueError):
        pass  # the service's sweep catches it next pass
    parts = [dig(data, "model", "display_name")]
    pct = context_percent(data)
    if pct is not None:
        parts.append(f"ctx {pct:.0f}%")
    cost = dig(data, "cost", "total_cost_usd")
    if isinstance(cost, (int, float)) and cost >= 0.005:
        parts.append(f"${cost:.2f}")
    five = dig(data, "rate_limits", "five_hour", "used_percentage")
    if isinstance(five, (int, float)):
        parts.append(f"5h {five:.0f}%")
    waiting = len(pending(seat))
    if waiting:
        parts.append(f"{waiting} note(s) waiting")
    print(" · ".join(str(p) for p in parts if p))


# --- OTLP metrics: Devin CLI's usage export ---------------------------------
# Devin has no status line and its hooks carry no usage figures, but the CLI
# can push OTLP metrics (devin.token.usage and friends) to any HTTP endpoint.
# `comms-deck serve` listens on 127.0.0.1:OTEL_PORT (default 4318, the OTLP
# HTTP port) for POST /v1/metrics and folds each data point into a running
# total per seat, written as usage/<seat>.json so the panel shows it like any
# other meter. Install points Devin's otel.metrics_endpoint here and sets no
# logs endpoint, so prompts and tool text are never exported.

OTEL_PORT = int(setting("OTEL_PORT") or 4318)
OTEL_ACCUM_DIR = DATA / "usage" / "otel"   # running totals, kept across restarts


def _pb_varint(buf, i):
    """One protobuf varint from buf at i; returns (value, next index)."""
    result = shift = 0
    while True:
        byte = buf[i]
        i += 1
        result |= (byte & 0x7F) << shift
        if not byte & 0x80:
            return result, i
        shift += 7
        if shift > 70:
            raise ValueError("protobuf varint too long")


def pb_fields(buf):
    """Every (field number, wire type, value) in one protobuf message.

    value is an int for varints and bytes for the other wire types; callers
    decode further with pb_fields (submessages) or struct (fixed numbers).
    """
    fields, i = [], 0
    while i < len(buf):
        key, i = _pb_varint(buf, i)
        number, wire = key >> 3, key & 7
        if wire == 0:
            value, i = _pb_varint(buf, i)
        elif wire == 1:
            value = buf[i:i + 8]
            i += 8
        elif wire == 2:
            size, i = _pb_varint(buf, i)
            value = buf[i:i + size]
            i += size
        elif wire == 5:
            value = buf[i:i + 4]
            i += 4
        else:
            break  # groups and bad wire types: stop rather than misparse
        fields.append((number, wire, value))
    return fields


def _pb_msgs(fields, number):
    """The submessages stored under `number`."""
    return [v for n, w, v in fields if n == number and w == 2]


def _pb_text(fields, number):
    """The first string stored under `number`, or None."""
    for n, w, v in fields:
        if n == number and w == 2:
            return v.decode("utf-8", "replace")
    return None


def _pb_attr_map(kv_msgs):
    """{key: value} from protobuf KeyValue messages (opentelemetry common/v1)."""
    attrs = {}
    for msg in kv_msgs:
        fields = pb_fields(msg)
        key = _pb_text(fields, 1)
        if key is None:
            continue
        for n, w, v in fields:
            if n != 2 or w != 2:  # value: an AnyValue submessage
                continue
            for an, aw, av in pb_fields(v):
                if an == 1 and aw == 2:
                    attrs[key] = av.decode("utf-8", "replace")
                elif an == 2 and aw == 0:
                    attrs[key] = bool(av)
                elif an == 3 and aw == 0:
                    attrs[key] = av - (1 << 64) if av >= (1 << 63) else av  # int64 varint
                elif an == 4 and aw == 1 and len(av) == 8:
                    attrs[key] = struct.unpack("<d", av)[0]
                elif an == 7 and aw == 2:
                    attrs[key] = av.decode("utf-8", "replace")
            break
    return attrs


def _pb_number_point(msg):
    """(attributes, value) from a protobuf NumberDataPoint, or (attrs, None)."""
    fields = pb_fields(msg)
    attrs = _pb_attr_map(_pb_msgs(fields, 7))
    value = None
    for n, w, v in fields:
        if w == 1 and len(v) == 8:
            if n == 4:   # as_double: fixed64
                value = struct.unpack("<d", v)[0]
            elif n == 6:  # as_int: sfixed64
                value = struct.unpack("<q", v)[0]
    return attrs, value


def _otel_attr_map_json(attrs):
    """{key: value} from OTLP/JSON attributes ([{key, value:{stringValue...}}])."""
    out = {}
    for a in attrs or []:
        if not isinstance(a, dict):
            continue
        value = a.get("value") or {}
        for k in ("stringValue", "boolValue", "intValue", "doubleValue", "bytesValue"):
            if k in value:
                out[str(a.get("key", ""))] = value[k]
                break
    return out


def _otel_series_json(payload):
    """[(name, attrs, value, kind, temporality)] from an OTLP/JSON metrics body."""
    try:
        doc = json.loads(payload)
    except (ValueError, TypeError):
        return []
    out = []

    def points(name, data, kind, temp):
        for p in (data or {}).get("dataPoints") or []:
            if not isinstance(p, dict):
                continue
            value = p.get("asDouble", p.get("asInt"))
            try:
                value = float(value)
            except (TypeError, ValueError):
                continue
            out.append((name, _otel_attr_map_json(p.get("attributes")), value, kind, temp))

    for rm in (doc.get("resourceMetrics") or []):
        for sm in (rm.get("scopeMetrics") or []):
            for metric in (sm.get("metrics") or []):
                if not isinstance(metric, dict):
                    continue
                name = metric.get("name")
                if "sum" in metric:
                    temp = (metric["sum"] or {}).get("aggregationTemporality")
                    temp = {"AGGREGATION_TEMPORALITY_DELTA": 1,
                            "AGGREGATION_TEMPORALITY_CUMULATIVE": 2}.get(temp, temp)
                    points(name, metric["sum"], "sum", temp)
                if "gauge" in metric:
                    points(name, metric["gauge"], "gauge", None)
    return out


def _otel_series_pb(payload):
    """[(name, attrs, value, kind, temporality)] from an OTLP/protobuf body."""
    out = []
    for rm in _pb_msgs(pb_fields(payload), 1):        # resource_metrics
        for sm in _pb_msgs(pb_fields(rm), 2):         # scope_metrics
            for metric in _pb_msgs(pb_fields(sm), 2):  # metrics
                mfields = pb_fields(metric)
                name = _pb_text(mfields, 1)
                for kind, fnum in (("sum", 7), ("gauge", 5)):
                    for data in _pb_msgs(mfields, fnum):
                        dfields = pb_fields(data)
                        temp = next((v for n, w, v in dfields if n == 2 and w == 0), None) \
                            if kind == "sum" else None
                        for point in _pb_msgs(dfields, 1):  # data_points
                            attrs, value = _pb_number_point(point)
                            if value is not None:
                                out.append((name, attrs, value, kind, temp))
    return out


def otel_series(payload, content_type):
    """The data points in one OTLP metrics export, JSON or protobuf."""
    if "json" in (content_type or ""):
        return _otel_series_json(payload)
    return _otel_series_pb(payload)


def otel_series_key(name, attrs):
    """One series' identity: metric name plus its sorted attributes."""
    return name + "|" + ",".join(f"{k}={attrs[k]}" for k in sorted(attrs))


def record_otel_metrics(seat, payload, content_type):
    """Fold one OTLP metrics export into the seat's usage totals.

    Devin's counters are delta sums, so each export adds to a running total
    kept in usage/otel/<seat>.json (which survives a service restart). A
    cumulative sum adds only the growth since the last export. Returns the
    number of data points taken.
    """
    seat = re.sub(r"[^a-z0-9_-]", "", (seat or "devin").lower()) or "devin"
    series = otel_series(payload, content_type)
    if not series:
        return 0
    acc_path = OTEL_ACCUM_DIR / f"{seat}.json"
    acc = read_json(acc_path, {}) or {}
    totals = acc.get("totals") or {}
    last = acc.get("last") or {}      # cumulative series: value at last export
    points = 0
    for name, attrs, value, kind, temp in series:
        key = otel_series_key(name, attrs)
        if kind == "gauge":
            totals[key] = value       # a gauge's latest value is its reading
        elif temp == 2:               # cumulative: add only the growth
            totals[key] = totals.get(key, 0) + max(0.0, value - last.get(key, 0))
            last[key] = value
        else:                         # delta (and unspecified): add the export
            totals[key] = totals.get(key, 0) + value
        points += 1
    write_json(acc_path, {"time": time.time(), "totals": totals, "last": last})
    # Merge into any existing record: refresh_devin_usage may already have
    # filled model/context_window from the sessions database, and the otel
    # section is this writer's own.
    path = DATA / "usage" / f"{seat}.json"
    prev = read_json(path, {}) or {}
    data = dict(prev.get("data") or {})
    fresh = otel_panel_data(totals)
    data["otel"] = fresh.get("otel", {})
    if fresh.get("model"):
        data["model"] = fresh["model"]
    context = dict(data.get("context_window") or {})
    context.update(fresh.get("context_window") or {})
    if context:
        data["context_window"] = context
    write_json(path, {"time": time.time(), "source": prev.get("source") or "devin-otel",
                      "data": data})
    return points


def otel_panel_data(totals):
    """The usage/<seat>.json 'data' for the chat panel, from OTLP totals.

    devin.token.usage is keyed by model and type (input, output, cacheRead,
    cacheCreation); the panel's Session line shows input and output, the most
    used model names the row, and the full breakdown stays under 'otel' for
    later readers. Other counters (sessions, lines, commits, PRs, active
    time) are summed per metric name under 'otel'.metrics'.
    """
    tokens, model_totals, metrics = {}, {}, {}
    for key, total in totals.items():
        name, _, attr_text = key.partition("|")
        attrs = dict(p.split("=", 1) for p in attr_text.split(",") if "=" in p)
        if name == "devin.token.usage":
            tokens[attrs.get("type", "?")] = tokens.get(attrs.get("type", "?"), 0) + total
            model = attrs.get("model", "?")
            model_totals[model] = model_totals.get(model, 0) + total
        else:
            metrics[name] = metrics.get(name, 0) + total
    data = {}
    if model_totals:
        data["model"] = {"display_name": max(model_totals, key=model_totals.get)}
    if tokens:
        data["context_window"] = {"session_input_tokens": tokens.get("input", 0),
                                  "session_output_tokens": tokens.get("output", 0)}
    data["otel"] = {"tokens": tokens, "metrics": metrics}
    return data


class _OtelHandler(http.server.BaseHTTPRequestHandler):
    """POST /v1/metrics from Devin's OTLP export; /v1/logs and /v1/traces are
    accepted and dropped (the deck reads metrics only)."""

    def _answer(self, code, body=b"{}"):
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        if body:
            self.wfile.write(body)

    def do_POST(self):
        path = self.path.split("?", 1)[0]
        try:
            length = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            length = 0
        body = self.rfile.read(min(length, 64 * 1024 * 1024)) if length else b""
        if path == "/v1/metrics":
            seat = self.headers.get("X-Comms-Deck-Seat") or "devin"
            try:
                record_otel_metrics(seat, body, self.headers.get("Content-Type") or "")
            except Exception as error:  # a bad export must never bother the agent
                log(f"OTEL metrics from {seat} not recorded: {error}")
            self._answer(200)
        elif path in ("/v1/logs", "/v1/traces"):
            self._answer(200)
        else:
            self._answer(404)

    def do_GET(self):
        self._answer(200 if self.path.split("?", 1)[0] == "/" else 404,
                     b'{"status":"ok"}' if self.path == "/" else b"")

    def log_message(self, *args):
        pass  # the service log already says the listener is up


def otel_serve():
    """Listen for Devin's OTLP metrics until the service stops."""
    try:
        server = http.server.ThreadingHTTPServer(("127.0.0.1", OTEL_PORT), _OtelHandler)
        server.daemon_threads = True
    except OSError as error:
        log(f"OTEL listener on 127.0.0.1:{OTEL_PORT} not started: {error}")
        return
    log(f"OTEL metrics listener on 127.0.0.1:{OTEL_PORT}")
    server.serve_forever()


# --- Devin's sessions database ----------------------------------------------
# Devin CLI keeps every session in ~/.local/share/devin/cli/sessions.db. Each
# assistant message records per-request metrics (tokens, timings, model)
# under chat_message.metadata.metrics — the token figures this CLI build's
# OTEL export does not emit. refresh_devin_usage reads the latest session
# and writes usage/devin.json in the panel's shape, the same way
# refresh_grok_usage reads Grok's session files.

DEVIN_DB = Path(setting("DEVIN_DB") or Path.home() / ".local/share/devin/cli/sessions.db")


def devin_model_name(slug):
    """'swe-2-flash-medium' -> 'SWE-2 Flash Medium'; anything else title-cased."""
    if not slug:
        return None
    parts = str(slug).split("-")
    if parts[0].lower() == "swe" and len(parts) > 1:
        return "SWE-" + parts[1] + "".join(" " + p.title() for p in parts[2:])
    return str(slug).replace("-", " ").title()


def devin_usage_from_db():
    """Devin's usage from its local sessions database, as panel data.

    Totals cover the most recently active session: the Session line gets
    input/output tokens, context gets the newest context_input_tokens (an
    absolute count — this build does not report the window size), and the
    model comes from the latest generation_model. Returns None when the db
    is missing, locked or has no assistant metrics yet.
    """
    if not DEVIN_DB.exists():
        return None
    try:
        con = sqlite3.connect(f"file:{DEVIN_DB}?mode=ro", uri=True, timeout=2)
    except sqlite3.Error:
        return None
    try:
        sid = con.execute("SELECT id FROM sessions ORDER BY last_activity_at DESC LIMIT 1"
                          ).fetchone()
        if not sid:
            return None
        rows = con.execute(
            "SELECT json_extract(chat_message,'$.metadata.metrics'),"
            " json_extract(chat_message,'$.metadata.generation_model'),"
            " json_extract(chat_message,'$.metadata.metrics.context_input_tokens')"
            " FROM message_nodes WHERE session_id=?"
            " AND json_extract(chat_message,'$.role')='assistant' ORDER BY row_id",
            (sid[0],))
        sin = sout = cache_r = cache_c = reqs = 0
        model = context = None
        for metrics, gen_model, ctx in rows:
            if not metrics:
                continue
            try:
                mm = json.loads(metrics)
            except ValueError:
                continue
            reqs += 1
            sin += mm.get("input_tokens") or 0
            sout += mm.get("output_tokens") or 0
            cache_r += mm.get("cache_read_tokens") or 0
            cache_c += mm.get("cache_creation_tokens") or 0
            if ctx:
                context = ctx
            if gen_model:
                model = gen_model
    except sqlite3.Error:
        return None
    finally:
        con.close()
    if not reqs:
        return None
    context_window = {"session_input_tokens": sin, "session_output_tokens": sout}
    if context:
        context_window["context_tokens"] = context
    size = setting("DEVIN_CONTEXT")  # window size in tokens, when known
    if context and size:
        try:
            size = float(size)
            context_window["context_window_size"] = size
            context_window["used_percentage"] = round(100.0 * context / size, 1)
        except ValueError:
            pass
    data = {"context_window": context_window,
            "devin": {"requests": reqs, "cache_read_tokens": cache_r,
                      "cache_creation_tokens": cache_c}}
    name = devin_model_name(model)
    if name:
        data["model"] = {"display_name": name}
    return data


def refresh_devin_usage():
    """Write usage/devin.json from the sessions database, keeping the otel
    section an OTLP export may already have written."""
    found = devin_usage_from_db()
    if not found:
        return
    path = DATA / "usage" / "devin.json"
    prev = read_json(path, {}) or {}
    data = dict(prev.get("data") or {})
    data.update(found)
    if "otel" in (prev.get("data") or {}):
        data["otel"] = prev["data"]["otel"]
    write_json(path, {"time": time.time(), "source": prev.get("source") or "devin-db",
                      "data": data})


def grok_usage_from_session():
    """Grok's usage, read from its own session files, as a status-line-shaped dict.

    Grok's status line only runs while its UI is set to show one, so the
    service also reads what Grok writes for every session anyway:
    ~/.grok/active_sessions.json names the live session, its signals.json has
    the context size and window, and each turn_completed event in its
    updates.jsonl has that turn's tokens and cost. Returns (time, data) or None.
    """
    try:
        active = json.loads((HOME / ".grok/active_sessions.json").read_text())
    except (OSError, ValueError):
        return None
    live = [a for a in active if pid_alive(a.get("pid"))]
    if not live:
        return None
    session = live[-1]
    folder = HOME / ".grok/sessions" / session.get("cwd", "").replace("/", "%2F") / session["session_id"]
    data, newest, context_time = {"model": {}, "context_window": {}, "cost": {}}, 0.0, 0.0
    try:
        sig = json.loads((folder / "signals.json").read_text())
        newest = (folder / "signals.json").stat().st_mtime
        model = sig.get("primaryModelId")
        if model:
            data["model"] = {"id": model, "display_name": model.replace("grok-", "Grok ")}
        if sig.get("contextWindowTokens"):
            data["context_window"]["context_window_size"] = sig["contextWindowTokens"]
        if sig.get("contextTokensUsed") is not None:
            data["context_window"]["context_tokens"] = sig["contextTokensUsed"]
        context_time = newest
    except (OSError, ValueError):
        pass
    cost_ticks, sin, sout = 0, 0, 0
    try:
        with open(folder / "updates.jsonl", "rb") as f:
            for line in f:
                if b"turn_completed" not in line and b"auto_compact_completed" not in line:
                    continue
                try:
                    r = json.loads(line)
                except ValueError:
                    continue
                u = (r.get("params") or {}).get("update") or {}
                when = (r.get("timestamp_us") or 0) / 1e6
                if u.get("sessionUpdate") == "turn_completed":
                    usage = u.get("usage") or {}
                    cost_ticks += usage.get("costUsdTicks") or 0
                    sin += usage.get("inputTokens") or 0
                    sout += usage.get("outputTokens") or 0
                    # Every finished turn moves the clock: the session totals
                    # changed. Its inputTokens sum all of the turn's model
                    # calls, so they're not the context size; that comes from
                    # signals.json or a compaction. (Review by Grok.)
                    newest = max(newest, when)
                elif u.get("sessionUpdate") == "auto_compact_completed" and when >= context_time:
                    data["context_window"]["context_tokens"] = u.get("tokens_after")
                    context_time = when
                    newest = max(newest, when)
    except OSError:
        pass
    if sin:
        data["context_window"]["session_input_tokens"] = sin
        data["context_window"]["session_output_tokens"] = sout
    if cost_ticks:
        data["cost"]["total_cost_usd"] = cost_ticks / 1e10  # Grok counts cost in 1e-10 USD ticks
    return (newest, data) if newest else None


SCREEN_LIMIT = re.compile(r"hit your usage limit.*?try again\s+(?:at|on)\s+(?P<when>.+?)\.(?:\s|$)", re.IGNORECASE | re.DOTALL)


def screen_limit_reset(text, now=None):
    """The reset time an agent printed with its usage-limit message, or None.

    Codex prints "You've hit your usage limit. ... try again at Dec 9th, 2026
    3:02 PM." (or just "3:02 PM" when it is today), and the line can wrap.
    The newest such message on the screen counts. A time with no date is the
    next one; anything unreadable gives math.inf (spent, time unknown).
    """
    import datetime
    now = time.time() if now is None else now
    found = list(SCREEN_LIMIT.finditer(text or ""))
    if not found:
        return None
    raw = " ".join(found[-1].group("when").split())
    raw = re.sub(r"(\d)(st|nd|rd|th)\b", r"\1", raw)
    for fmt in ("%b %d, %Y %I:%M %p", "%B %d, %Y %I:%M %p", "%b %d %Y %I:%M %p", "%Y-%m-%d %H:%M"):
        try:
            return datetime.datetime.strptime(raw, fmt).timestamp()
        except ValueError:
            pass
    for fmt in ("%I:%M %p", "%H:%M"):
        try:
            t = datetime.datetime.strptime(raw, fmt)
        except ValueError:
            continue
        base = datetime.datetime.fromtimestamp(now)
        at = base.replace(hour=t.hour, minute=t.minute, second=0, microsecond=0)
        if at.timestamp() <= now:
            at += datetime.timedelta(days=1)
        return at.timestamp()
    return math.inf


def refresh_screen_limits():
    """Mark an agent spent when its terminal says it hit its usage limit.

    For agents with no usage meter (Codex): the ACTIVITY panel then shows it
    spent with a countdown to the reset it printed. A mark this set is
    cleared when the message is gone from the screen (the agent restarted);
    a mark set by hand with `comms-deck spent` is never touched.
    """
    for seat in AGENTS:
        state = load_seat(seat)
        socket, window = state.get("kitty_socket"), state.get("kitty_window")
        if not socket or not window or state.get("state") == "away":
            continue
        try:
            screen = kitty(socket, "get-text", "--match", f"id:{window}")
        except (RuntimeError, OSError, subprocess.SubprocessError):
            continue
        path = DATA / SPENT_DIR / f"{seat}.json"
        mark = read_json(path) or {}
        reset = screen_limit_reset(screen)
        if reset is None:
            if mark.get("set_by") == "screen":
                path.unlink(missing_ok=True)
                log(f"{seat}: usage-limit message gone from its screen; spent mark cleared")
            continue
        if reset <= time.time():
            continue  # an old message whose time has passed
        stored = None if reset == math.inf else reset
        if mark.get("set_by") != "screen" and spent_mark(seat) is not None:
            continue  # a hand-set mark wins
        if mark.get("set_by") == "screen" and (
                mark.get("resets_at") == stored
                or (stored is None and mark.get("reset_unknown"))):
            continue  # already marked from this message; don't rewrite every pass
        write_json(path, {"resets_at": stored if stored is not None else time.time() + 86400 * 7,
                          "reset_unknown": stored is None,
                          "set_by": "screen", "set_at": time.time()})
        log(f"{seat}: its screen says usage limit; spent until {when(reset) if stored else 'unknown (7d)'}")


def vibe_model_info(model):
    """(label, context window) for a Vibe model id, from Vibe's own model catalog."""
    try:
        catalog = json.loads((HOME / ".vibe/model_catalog_cache.json").read_text())
    except (OSError, ValueError):
        catalog = None
    found = []

    def walk(node):
        if isinstance(node, dict):
            if node.get("id") == model or model in (node.get("aliases") or []):
                found.append(node)
            for value in node.values():
                walk(value)
        elif isinstance(node, list):
            for value in node:
                walk(value)
    walk(catalog)
    if found:
        return found[0].get("label") or model, found[0].get("max_context_length")
    try:  # the window of the active model, as Vibe's UI last saw it
        ui = json.loads((HOME / ".vibe/ui_startup_config.json").read_text())
        return ui.get("activeModelDisplayName") or model, ui.get("contextWindow")
    except (OSError, ValueError):
        return model, None


def vibe_reported_context(session):
    """The context size Vibe's own status line shows ("ctx 17.4k/202k"), or None.

    It is last_reported_context_tokens in the newest generation's
    checkpoint.json. That file also holds the conversation, so only this one
    number is taken out of it, by pattern, and nothing else is kept.
    """
    generations = sorted((session / "generations").glob("*/checkpoint.json"))
    if not generations:
        return None
    try:
        text = generations[-1].read_text(errors="replace")
    except OSError:
        return None
    m = re.search(r'"last_reported_context_tokens"\s*:\s*(\d+)', text)
    return int(m.group(1)) if m else None


def vibe_usage_from_session():
    """Vibe's context use, from the files Vibe writes for its live session.

    The owner OK'd reading these (2026-11-25). Vibe keeps one folder per
    session under ~/.vibe/logs/session/unified/; the live one changed last.
    The tokens are the figure Vibe's own status line shows
    (vibe_reported_context). context-breakdown.json is only a fallback: it
    can count far more than is really in context (it read 578k of a 262k
    window on 2026-11-25, when Vibe's screen said 17.4k of 202k). The
    window is the one Vibe's UI uses (ui_startup_config.json), else the
    model catalog's. meta.json names the model. The monthly usage gauge
    isn't in these files; refresh_vibe_usage() reads it off the screen. Returns (time, data)
    in the status-line shape, or None if Vibe isn't running.
    """
    if not any(proc_name(int(d.name)) == AGENTS["vibe"] for d in Path("/proc").iterdir() if d.name.isdigit()):
        return None
    files = list((HOME / ".vibe/logs/session/unified").glob("*/context-breakdown.json"))
    if not files:
        return None
    newest = max(files, key=lambda f: f.stat().st_mtime)
    try:
        breakdown = json.loads(newest.read_text())
        meta = json.loads((newest.parent / "meta.json").read_text())
    except (OSError, ValueError):
        return None
    reported = vibe_reported_context(newest.parent)
    tokens = reported if reported is not None else sum(
        v for v in breakdown.values() if isinstance(v, (int, float)))
    model = dig(meta, "config", "active_model") or dig(meta, "config", "model_name") or ""
    label, window = vibe_model_info(model) if model else ("", None)
    try:  # the window Vibe's own status line divides by ("17.4k/202k")
        ui = json.loads((HOME / ".vibe/ui_startup_config.json").read_text())
        if ui.get("contextWindow") and str(ui.get("activeModelDisplayName") or "").startswith(label or "\0"):
            window = ui["contextWindow"]
    except (OSError, ValueError):
        pass
    data = {"model": {"id": model, "display_name": label}, "context_window": {"context_tokens": tokens}}
    if isinstance(window, (int, float)) and window > 0:
        data["context_window"]["context_window_size"] = window
    return newest.stat().st_mtime, data


VIBE_GAUGE = re.compile(r"\busage\s+[\u2580-\u259f ]*?(\d{1,3})%")


def vibe_screen_gauge():
    """The % on Vibe's footer usage bar ("usage ███▏   52% · ctx …"), or None.

    Vibe fetches its monthly usage from Mistral's billing service and only
    draws it; nothing on disk holds it. So, like refresh_screen_limits(),
    this reads Vibe's kitty window, but only its last three lines (the
    footer), so nothing from the conversation is matched or kept.
    """
    state = load_seat("vibe")
    socket, window = state.get("kitty_socket"), state.get("kitty_window")
    if not socket or not window or state.get("state") == "away":
        return None
    try:
        screen = kitty(socket, "get-text", "--match", f"id:{window}")
    except (RuntimeError, OSError, subprocess.SubprocessError):
        return None
    for line in reversed([l for l in screen.splitlines() if l.strip()][-3:]):
        m = VIBE_GAUGE.search(line)
        if m and 0 <= int(m.group(1)) <= 100:
            return int(m.group(1))
    return None


def refresh_vibe_usage():
    """Write usage/vibe.json from Vibe's session files and its footer gauge.

    The owner (23:01): Vibe's app shows a usage bar, so 03 should too. The
    gauge is the monthly allowance, stored as rate_limits.monthly with no
    reset time (the footer doesn't print one). It's rewritten when the
    session files are newer or the gauge has moved.
    """
    found = vibe_usage_from_session()
    if not found:
        return
    when, data = found
    current = read_json(DATA / "usage" / "vibe.json", {}) or {}
    gauge = vibe_screen_gauge()
    if gauge is None:  # the screen couldn't be read this pass: keep the last reading
        gauge = dig(current, "data", "rate_limits", "monthly", "used_percentage")
    if isinstance(gauge, (int, float)):
        data["rate_limits"] = {"monthly": {"used_percentage": gauge}}
    moved = gauge != dig(current, "data", "rate_limits", "monthly", "used_percentage")
    if when > float(current.get("time") or 0) or moved:
        write_json(DATA / "usage" / "vibe.json",
                   {"time": max(when, time.time() if moved else 0), "source": "vibe-session", "data": data})


def refresh_grok_usage():
    """Write usage/grok.json from Grok's session files when they're newer."""
    found = grok_usage_from_session()
    if not found:
        return
    when, data = found
    current = read_json(DATA / "usage" / "grok.json", {}) or {}
    if when > float(current.get("time") or 0):
        write_json(DATA / "usage" / "grok.json", {"time": when, "source": "grok-session", "data": data})


def dig(data, *keys):
    """data[k1][k2]... or None if any step is missing."""
    for key in keys:
        if not isinstance(data, dict):
            return None
        data = data.get(key)
    return data


def context_percent(data):
    """How full the context window is, 0-100, or None if unknown."""
    pct = dig(data, "context_window", "used_percentage")
    if isinstance(pct, (int, float)):
        return float(pct)
    used, size = dig(data, "context_window", "context_tokens"), dig(data, "context_window", "context_window_size")
    if isinstance(used, (int, float)) and isinstance(size, (int, float)) and size:
        return 100.0 * used / size
    return None


STALE_BUSY = 600  # a busy seat whose file hasn't changed this long, with notes waiting, is stale


def status_json(now=None):
    """Every seat, for programs (Chronophage): state, why it may be stuck, and ages.

    Plain facts only; the watchdog decides what to do with them.
    """
    now = time.time() if now is None else now
    seats = {}
    for seat in tuple(AGENTS) + APP_SEATS:
        s = load_seat(seat)
        st = app_seat_state(seat) if seat in APP_SEATS else s["state"]
        a = availability(seat, st, now)
        notes = pending(seat)
        oldest = min((path.stat().st_mtime for path, _ in notes), default=None)
        seats[seat] = {
            "kind": "app" if seat in APP_SEATS else "agent",
            "state": st, "shown": a["word"], "rank": list(a["rank"]),
            "waiting": len(notes),
            "waiting_normal": sum(1 for _, r in notes if not r.get("quiet")),
            "oldest_waiting_s": round(now - oldest) if oldest else 0,
            "since_s": round(now - float(s.get("since") or now)),
            "file_age_s": round(now - float(s.get("updated") or now)),
            "can_wake": bool(s.get("kitty_socket") and s.get("kitty_window")) if seat in AGENTS else None,
            "paused": int(s.get("auto") or 0) >= AUTO_LIMIT,
            "held_by_draft": bool(s.get("held_by_draft")) or st == "draft in box",
            "retry_at": float(s.get("app_retry_at") or 0) or None,
            "spent_until": spent_reset(a["usage"], spent_mark(seat, now), now),
            "hidden": seat in HIDDEN_SEATS,
        }
    return {"time": now, "machine": MACHINE, "seats": seats}


def wake_seat(seat, stale=False):
    """One wake attempt for `seat`, for a watchdog. Returns (done, reason).

    With `stale`, a seat that has said busy for STALE_BUSY seconds without
    its file changing, while notes wait, is treated as idle first: its Stop
    hook never ran, so nothing else would ever deliver to it. The wake pastes
    the notes and presses Enter; if the agent was in fact still working, that
    lands in its turn, which is why the bar is 10 minutes with no change.
    """
    if seat not in AGENTS:
        return False, "only terminal agents can be woken this way"
    s = load_seat(seat)
    if not pending(seat):
        return False, "nothing waiting"
    if seat_spent(seat):
        return False, "out of usage until its reset"  # before any write: a spent seat's state is left as it is
    if stale and s["state"] == "busy" and time.time() - float(s.get("updated") or 0) >= STALE_BUSY:
        update_seat(seat, state="idle")
        log(f"{seat}: busy with no change for {STALE_BUSY // 60} min while notes wait; treating as idle")
    if try_wake(seat):
        return True, "woken"
    s = load_seat(seat)
    reason = ("out of usage until its reset" if seat_spent(seat) else
              "paused by the loop guard" if int(s.get("auto") or 0) >= AUTO_LIMIT else
              "a draft is in its prompt" if s.get("held_by_draft") else
              f"state is {s['state']}" if s["state"] != "idle" else
              "no kitty window to type into" if not (s.get("kitty_socket") and s.get("kitty_window")) else
              "its window is focused or unreadable")
    return False, reason


def status_text():
    """A short table of every agent seat."""
    rows = []
    for seat in AGENTS:
        s = load_seat(seat)
        wake = "can wake" if s.get("kitty_socket") and s.get("kitty_window") else "no wake"
        paused = ", PAUSED (loop guard)" if s["auto"] >= AUTO_LIMIT else ""
        rows.append(f"{seat:8} {s['state']:5}  {len(pending(seat))} waiting  {wake}{paused}")
    for seat in APP_SEATS:
        rows.append(f"{display_seat(seat):8} {app_seat_state(seat):14} {len(pending(seat))} waiting")
    hook_state = "Discord mirror: on" if WEBHOOK_FILE.exists() else "Discord mirror: off"
    return "\n".join(rows + [hook_state])


def usage_report(days=7, now=None):
    """A text report of this deck's usage, from its own logs.

    `comms-deck usage [--days N]`: notes sent and received (log.jsonl), time
    each seat spent in each state (activity.jsonl, this machine only), and
    the plan-limit meters and spent marks (usage/, limits/). Plain text, no
    agent needed: everything is already on disk; this only reads it back.
    """
    now = time.time() if now is None else now
    since_epoch = now - days * 86400
    since_text = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(since_epoch))
    out = [f"comms-deck usage, last {days} day(s) (since {since_text[:16]})", ""]

    # Notes, from log.jsonl.
    msgs = []
    try:
        for line in (DATA / "log.jsonl").open():
            try:
                r = json.loads(line)
            except ValueError:
                continue
            if r.get("kind") == "message" and str(r.get("time", "")) >= since_text:
                msgs.append(r)
    except OSError:
        pass
    if not msgs:
        out.append("notes: none in the log for this period")
    else:
        per_day, by_from, to_seat, quiet, private = {}, {}, {}, 0, 0
        for r in msgs:
            day = str(r.get("time", ""))[:10]
            per_day[day] = per_day.get(day, 0) + 1
            by_from[r.get("from", "unknown")] = by_from.get(r.get("from", "unknown"), 0) + 1
            for seat in str(r.get("to") or "").split("+"):
                to_seat["(all) " if seat == "all" else seat] = to_seat.get("(all) " if seat == "all" else seat, 0) + 1
            quiet += 1 if r.get("quiet") else 0
            private += 1 if r.get("private") else 0
        out.append(f"notes: {len(msgs)} sent ({quiet} quiet, {private} private)")
        out.append("  by day:   " + "  ".join(f"{d}: {n}" for d, n in sorted(per_day.items())))
        fmt = lambda counts: ", ".join(f"{k.strip()} {v}" for k, v in
                                       sorted(counts.items(), key=lambda kv: -kv[1]) if v)
        out.append("  sent by:  " + fmt(by_from))
        out.append("  sent to:  " + fmt(to_seat))
    out.append("")

    # Time in state, from activity.jsonl (written by serve on this machine).
    spans, last = {}, {}
    by_program = {proc: seat for seat, proc in AGENTS.items() if proc != seat}
    try:
        for line in (DATA / "activity.jsonl").open():
            try:
                r = json.loads(line)
            except ValueError:
                continue
            seat, state, t = r.get("seat"), r.get("state"), r.get("time")
            seat = by_program.get(seat, seat)  # older records name a seat by its program (agy is gravity)
            if not seat or state is None or not isinstance(t, (int, float)):
                continue
            if seat in last:
                prev_state, prev_t = last[seat]
                if prev_state != state:
                    span = max(prev_t, since_epoch)
                    if span < t:
                        d = spans.setdefault(seat, {}).setdefault(prev_state, 0)
                        spans[seat][prev_state] = d + (t - span)
            last[seat] = (state, t)
    except OSError:
        pass
    if not spans and not last:
        out.append("activity: nothing recorded yet")
    else:
        out.append("activity (time in each state, hours):")
        for seat in sorted(set(spans) | (set(last) if last else set())):
            buckets = dict(spans.get(seat, {}))
            current = last.get(seat)
            if current and current[1] > since_epoch:
                buckets[current[0]] = buckets.get(current[0], 0) + max(0.0, now - max(current[1], since_epoch))
            bits = []
            for state, seconds in sorted(buckets.items(), key=lambda kv: -kv[1]):
                if seconds > 60:
                    mark = " *" if current and current[0] == state else ""
                    bits.append(f"{state} {seconds / 3600:.1f}h{mark}")
            if bits:
                out.append(f"  {seat:8} " + ", ".join(bits))
            else:
                out.append(f"  {seat:8} (less than a minute in each state)")
    out.append("")

    # Plan-limit meters and spent marks.
    out.append("plan limits:")
    rows = []
    for seat in tuple(AGENTS) + APP_SEATS:
        d = (read_json(DATA / "usage" / f"{seat}.json", {}) or {}).get("data") or {}
        bits = []
        for label, key in (("5-hour", "five_hour"), ("weekly", "seven_day")):
            used = dig(d, "rate_limits", key, "used_percentage")
            if isinstance(used, bool) or not isinstance(used, (int, float)):
                continue
            reset = dig(d, "rate_limits", key, "resets_at")
            when_text = f", resets {when(reset, now)}" if isinstance(reset, (int, float)) else ""
            bits.append(f"{label} {used:.0f}% used{when_text}")
        marked = spent_mark(seat, now)
        if marked is not None:
            bits.append(f"spent until {when(marked, now)} ({countdown(marked, now)})")
        if bits:
            rows.append(f"  {seat:8} " + "; ".join(bits))
    out.extend(rows if rows else ["  no meters reported and no spent marks"])
    return "\n".join(out)


