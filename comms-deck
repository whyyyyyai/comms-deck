HOME = Path.home()


# -- Fresh code -----------------------------------------------------------
# The service, the chat screen and each agent's MCP server run for hours.
# Python reads the program once, so after a merge into the live tree they
# would keep running the old code (that is how "-grok" missed on 2026-11-25:
# the chat box predated the merge). Each long-running loop asks fresh_code()
# and, when the file on disk has changed and has settled, starts itself
# again in place (os.execv) or, for an MCP server, hands calls to a fresh run.
PROGRAM = Path(__file__).resolve()


def _program_stamp():
    """(mtime, size) of the program file, or None if it can't be read."""
    try:
        st = PROGRAM.stat()
        return (st.st_mtime_ns, st.st_size)
    except OSError:
        return None


_STARTED_FROM = _program_stamp()
_seen_change = {"stamp": None, "at": 0.0}


def fresh_code(settle=3.0):
    """True when the program on disk is newer than this process and safe to run.

    "Safe" means unchanged for `settle` seconds (a git checkout has finished
    writing) and it compiles. A file that doesn't compile is left alone and
    asked about again later, so a bad write can't take a running loop down.
    """
    now_stamp = _program_stamp()
    if now_stamp is None or now_stamp == _STARTED_FROM:
        return False
    if now_stamp != _seen_change["stamp"]:
        _seen_change.update(stamp=now_stamp, at=time.time())
    if time.time() - _seen_change["at"] < settle:
        return False
    try:
        compile(PROGRAM.read_text(), str(PROGRAM), "exec")
    except (OSError, SyntaxError, ValueError):
        return False
    return True


def run_fresh():
    """Replace this process with the program on disk, same arguments. Doesn't return."""
    os.execv(sys.executable, [sys.executable, str(PROGRAM), *sys.argv[1:]])


def setting(name, default=None):
    """$COMMS_DECK_<name>, or the older $LAUNCHPAD_<name>, or `default`."""
    return os.environ.get(f"COMMS_DECK_{name}") or os.environ.get(f"LAUNCHPAD_{name}") or default


