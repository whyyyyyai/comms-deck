    shutil.rmtree(tmp, ignore_errors=True)
    print(f"\n{'all passed' if not failures else f'{len(failures)} failed'}")
    return 1 if failures else 0


# -----------------------------------------------------------------------------
# SECTION 13: command line
# -----------------------------------------------------------------------------


def main():
    """The command line: send, read, the chat screen, the service, hooks and install."""
    parser = argparse.ArgumentParser(prog="comms-deck", description=__doc__.split("\n")[0])
    parser.add_argument("--from", dest="sender", help="send as this seat")
    sub = parser.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("send")
    p.add_argument("to")
    p.add_argument("text", nargs="+")
    p.add_argument("--quiet", action="store_true")
    p.add_argument("--private", action="store_true")
    p = sub.add_parser("read")
    p.add_argument("--peek", action="store_true", help="show without taking")
    p = sub.add_parser("note")
    p.add_argument("text", nargs="+")
    sub.add_parser("status")
    sub.add_parser("watch")
    p = sub.add_parser("chat")
    p.add_argument("--hide-private", action="store_true")
    p.add_argument("--history", type=int, default=200)
    sub.add_parser("serve")
    sub.add_parser("mcp")
    p = sub.add_parser("hook")
    p.add_argument("--source", required=True, choices=("claude", "grok", "agy"))
    p.add_argument("--event", default="")
    p = sub.add_parser("statusline")
    p.add_argument("--source", required=True, choices=("claude", "grok", "agy"))
    p = sub.add_parser("install")
    p.add_argument("--yes", action="store_true")
    sub.add_parser("self-test")
    args = parser.parse_args()

    def me():
        seat = args.sender or find_agent()[0]
        if not seat:
            sys.exit("comms-deck: can't tell which seat you are; use --from <seat>")
        return seat

    try:
        if args.cmd == "send":
            text = " ".join(args.text)
            if text == "-":
                text = sys.stdin.read()
            record, warning = send(me(), args.to, text, args.quiet, args.private)
            print(f"sent to {record['to']}" + (" (private)" if record["private"] else ""))
            if warning:
                print(warning)
        elif args.cmd == "read":
            seat = me()
            notes = [r for _, r in pending(seat)] if args.peek else take(seat)
            print(render(notes, seat) if notes else "No notes waiting.")
        elif args.cmd == "note":
            add_note(me(), " ".join(args.text))
            print("added to the commentary")
        elif args.cmd == "status":
            print(status_text())
        elif args.cmd == "watch":
            watch()
        elif args.cmd == "chat":
            chat(args.history, args.hide_private)
        elif args.cmd == "serve":
            serve()
        elif args.cmd == "mcp":
            mcp()
        elif args.cmd == "hook":
            try:
                hook(args.source, args.event)
            except Exception as error:  # a hook must never break the agent
                print(f"comms-deck hook: {error}", file=sys.stderr)
        elif args.cmd == "statusline":
            try:
                statusline(args.source)
            except Exception as error:  # a status line must never break the agent
                print(f"comms-deck: {error}")
        elif args.cmd == "install":
            install(args.yes)
        elif args.cmd == "self-test":
            sys.exit(self_test())
    except ValueError as error:
        sys.exit(f"comms-deck: {error}")
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
