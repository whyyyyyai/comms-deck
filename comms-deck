]


def mcp_call(seat, name, args):
    """Run one MCP tool. Returns (text, is_error)."""
    if name == "send_message":
        record, warning = send(seat, str(args.get("to", "")), str(args.get("text", "")),
                               bool(args.get("quiet")), bool(args.get("private")))
        return (f"Sent to {record['to']}." + (f" {warning}" if warning else "")), False
    if name == "read_messages":
        notes = take(seat)
        return (render(notes, seat) if notes else "No notes waiting."), False
    if name == "add_note":
        add_note(seat, str(args.get("text", "")))
        return "Added to the commentary.", False
    if name == "set_status":
        update_seat(seat, state="busy", doing=describe(args.get("text", "")))
        return "Status set.", False
    if name == "team_status":
        return status_text(), False
    return f"Unknown tool {name}", True


def mcp():
    """Serve MCP on stdin/stdout until stdin closes."""
    seat, _ = find_agent()
    seat = seat or "unknown"
    # The MCP server never records the seat's window: agents also start it
    # from short-lived helper processes (e.g. `claude mcp list` checking the
    # connection), which would record a pid that's gone a moment later and
    # make the seat look away. Only the hooks record it.
    out = sys.stdout

    def answer(msg_id, result=None, error=None):
        reply = {"jsonrpc": "2.0", "id": msg_id}
        reply.update({"error": error} if error else {"result": result})
        out.write(json.dumps(reply) + "\n")
        out.flush()

    for line in sys.stdin:
        try:
            msg = json.loads(line)
        except ValueError:
            continue
        method, msg_id = msg.get("method"), msg.get("id")
        if msg_id is None:
            continue  # a notification, e.g. notifications/initialized
        if method == "initialize":
            answer(msg_id, {
                "protocolVersion": (msg.get("params") or {}).get("protocolVersion", "2025-06-18"),
                "capabilities": {"tools": {}},
                "serverInfo": {"name": "comms-deck", "version": "2.0"},
                "instructions": f"You are the '{seat}' seat. Notes from other agents arrive "
                                f"on their own, starting with {MARK}. Use send_message to reply."})
        elif method == "tools/list":
            answer(msg_id, {"tools": MCP_TOOLS})
        elif method == "tools/call":
            params = msg.get("params") or {}
            try:
                text, failed = mcp_call(seat, params.get("name"), params.get("arguments") or {})
            except ValueError as error:
                text, failed = str(error), True
            answer(msg_id, {"content": [{"type": "text", "text": text}], "isError": failed})
        elif method == "ping":
            answer(msg_id, {})
        else:
            answer(msg_id, error={"code": -32601, "message": f"no method {method}"})


