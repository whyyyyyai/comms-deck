def queue_actions(record):
    """Queue every '@deck ...' line in a note for the service to carry out."""
    if record.get("kind") != "message" or record.get("from") == "deck":
        return
    for request in DECK_LINE.findall(record.get("text", "")):
        write_json(DATA / "queue/actions" / f"{new_id()}.json",
                   {"from": record["from"], "request": request.strip()[:500], "time": time.time(),
                    "private": bool(record.get("private"))})


def free_agent():
    """The agent to hand a task to: the most available, as ACTIVITY ranks them."""
    return most_available()


def run_action(asker, request, private=False):
    """Carry out one request. Returns the text of the answer to `asker`."""
    words = request.split(None, 1)
    name, arg = (words[0].lower() if words else ""), (words[1] if len(words) > 1 else "")
    if name in ("", "help"):
        return "comms-deck can do: " + "; ".join(f"@deck {n} ({d})" for n, (_, d) in ACTIONS.items())
    if name in ACTIONS:
        try:
            done = ACTIONS[name][0](arg)
        except (ValueError, RuntimeError, OSError, subprocess.SubprocessError) as error:
            log(f"deck: {asker} asked for {name}: refused or failed: {error}")
            return f"couldn't do '{name}': {error}"
        log(f"deck: {asker} asked for {name}: {done}")
        return f"done: {done}"
    if asker not in HANDOFF_FROM:
        log(f"deck: {asker} asked for something not on the list; refused")
        return f"'{name}' is not on the list, so I did nothing. Try @deck help."
    agent = free_agent()
    send("deck", agent, f"Task from {asker}, asked of comms-deck: {request}\n\n"
                        f"It isn't one of comms-deck's own actions, so it's yours. Do it on this "
                        f"machine if it's appropriate and your rules allow it, then tell {asker} "
                        f"the result with send_message"
                        + (", with private set: this request was private." if private else "."),
                        private=private)
    log(f"deck: {asker} asked for something not on the list; handed to {agent}")
    return f"that isn't one of my actions, so I've passed it to {agent}"


def do_actions():
    """Carry out queued '@deck' requests, oldest first, within the rate limit."""
    queue = DATA / "queue/actions"
    if not queue.is_dir():
        return
    recent = [t for t in getattr(do_actions, "recent", []) if time.time() - t < 60]
    for path in sorted(queue.glob("*.json")):
        if len(recent) >= ACTION_RATE:
            break
        job = read_json(path)
        path.unlink(missing_ok=True)
        if not job:
            continue
        recent.append(time.time())
        private = bool(job.get("private"))
        answer = run_action(job["from"], job["request"], private)
        if job["from"] in SEATS:
            send("deck", job["from"], answer, quiet=job["from"] in AGENTS, private=private)
    do_actions.recent = recent


def serve():
    """Run forever: wake agents, drive Grok Bot seats, refresh usage, copy records, mirror to Discord."""
    log(f"comms-deck serving on {MACHINE}; data in {DATA}")
    last_sync, discord_wait_until, last_usage = 0.0, 0.0, 0.0
    while True:
        if fresh_code():
            log("the program changed on disk; restarting the service on the new code")
            run_fresh()
        for seat in AGENTS:
            try:
                try_wake(seat)
            except Exception as error:  # one bad seat must not stop the service
                log(f"wake check for {seat} failed: {error}")
        try:
            try_app_seats()
        except Exception as error:
            log(f"app seat check failed: {type(error).__name__}")
        try:
            do_actions()
        except Exception as error:  # an action must never stop the service
            log(f"desktop actions failed: {error}")
        if time.time() - last_usage >= 30:
            last_usage = time.time()
            try:
                refresh_grok_usage()
            except Exception as error:  # usage is a nicety; never stop the service for it
                log(f"couldn't read Grok's usage: {error}")
            try:
                refresh_vibe_usage()
            except Exception as error:  # the same: never stop the service for it
                log(f"couldn't read Vibe's usage: {error}")
            try:
                refresh_screen_limits()
            except Exception as error:  # never stop the service for it
                log(f"couldn't read a usage-limit screen: {error}")
        if time.time() - last_sync >= SYNC_EVERY:
            last_sync = time.time()
            sync_records()
        if time.time() >= discord_wait_until:
            discord_wait_until = time.time() + post_discord()
        time.sleep(1)


def watch():
    """Print every record as it's added to the log, like `tail -f`."""
    path = DATA / "log.jsonl"
    path.parent.mkdir(parents=True, exist_ok=True)
    path.touch()
    with open(path) as f:
        f.seek(0, 2)
        while True:
            line = f.readline()
            if not line:
