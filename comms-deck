                    # file we can't read back. Say so, and leave it.
                    print(f"     skipped {path}: it isn't plain JSON (comments?); add the comms-deck "
                          f"entries by hand")
                    continue
                shutil.copy(path, path.with_suffix(".json.comms-deck-backup"))
            updated = build(current, cmd)
