def proc_name(pid):
    """The short process name of `pid` (from /proc), or ''."""
    try:
        return Path(f"/proc/{pid}/comm").read_text().strip()
    except OSError:
        return ""


def parent_of(pid):
    """The parent pid of `pid`, or 0."""
    try:
        stat = Path(f"/proc/{pid}/stat").read_text()
        return int(stat.rsplit(")", 1)[1].split()[1])
    except (OSError, ValueError, IndexError):
        return 0


def find_agent():
    """Walk up from this process to the nearest agent. Return (seat, pid).

    $COMMS_DECK_SEAT wins if set. The program agy is the seat gravity.
    Returns (None, 0) outside any agent, e.g. in a plain terminal.
    """
    forced = setting("SEAT")
    if forced:
        return forced, 0
    by_proc = {proc: seat for seat, proc in AGENTS.items()}
    pid = os.getppid()
    for _ in range(40):
        if pid <= 1:
            break
        seat = by_proc.get(proc_name(pid))
        if seat:
            return seat, pid
        pid = parent_of(pid)
    return None, 0


def agent_env(pid):
    """The environment of process `pid`, as a dict (empty if unreadable)."""
    try:
        raw = Path(f"/proc/{pid}/environ").read_bytes()
    except OSError:
        return {}
    pairs = (item.split(b"=", 1) for item in raw.split(b"\0") if b"=" in item)
    return {k.decode(errors="replace"): v.decode(errors="replace") for k, v in pairs}


def seat_file(seat):
    """Path of this seat's state file (busy, window, loop count)."""
    return DATA / "seats" / f"{seat}.json"


def interactive_agents(seat):
    """Pids of `seat`'s agent processes that run in a terminal.

    Helpers the agents start in the background (e.g. `claude mcp list`)
    have no terminal, so they're left out.
    """
    want = AGENTS.get(seat)
    found = []
    for d in Path("/proc").iterdir():
        if not d.name.isdigit():
            continue
        try:
            if (d / "comm").read_text().strip() != want:
                continue
            fields = (d / "stat").read_text().rsplit(")", 1)[1].split()
            if int(fields[4]) != 0 and proc_name(int(fields[1])) != want:  # has a tty; not a child of itself
                found.append(int(d.name))
        except (OSError, ValueError, IndexError):
            continue
    return found


def load_seat(seat):
    """The seat's state dict. 'away' if its agent process has gone.

    If the recorded process has gone but exactly one copy of that agent is
    running in a terminal, that copy is adopted (it was restarted, or the
    record was stale), so the seat doesn't show away by mistake.
    """
    state = read_json(seat_file(seat), {}) or {}
    if seat in AGENTS and not (state.get("pid") and pid_alive(state["pid"])):
        live = interactive_agents(seat)
        if len(live) == 1:
            remember_window(seat, live[0])
            state = read_json(seat_file(seat), {}) or {}
            if state.get("state") in (None, "away"):
                state = update_seat(seat, state="idle")
        elif state.get("pid"):
            state["state"] = "away"
    state.setdefault("state", "away")
    state.setdefault("auto", 0)
    return state


_windows_cache = {"at": 0.0, "classes": None}


def window_classes(now=None):
    """The classes of the windows open on the Hyprland desktop, or None when
    Hyprland can't be asked (no session, no hyprctl). Cached for 3 s: the
    status snapshot asks for every seat every 2 s."""
    now = time.time() if now is None else now
    if now - _windows_cache["at"] < 3.0:
        return _windows_cache["classes"]
    classes = None
    try:
        out = subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True, timeout=3)
        if out.returncode == 0:
            classes = {c.get("class", "") for c in json.loads(out.stdout or "[]")}
    except (OSError, ValueError, subprocess.SubprocessError):
        classes = None
    _windows_cache.update(at=now, classes=classes)
    return classes


def app_seat_state(seat):
    """Busy or idle when the Grok Bot page was just read. Otherwise
    'connected' if a comms-deck MCP server is running for this seat,
    'not connected' if the Grok Bot app is open without one, 'away' if closed."""
    state = read_json(seat_file(seat), {}) or {}
    if APP_PROCESS.get(seat, "grok-bot") == "remote":
        # A remote seat (docs/REMOTE.md) is an agent on another device that
        # takes its own notes out of the git copies. Nothing on this machine
        # runs its process or its MCP server, so we can't watch it busy:
        # its seat file's last word wins, and the default is away.
        return state.get("state") or "away"
    seen = float(state.get("app_seen") or 0)
    if time.time() - seen < 15 and state.get("state") in (
            "busy", "idle", "away", "not connected", "chat not open", "no chat yet", "draft in box"):
        return state["state"]
    if APP_PROCESS.get(seat, "grok-bot") != "grok-bot":
        # Its window closed means away, even if the app (and its MCP server)
        # lives on in the tray: Y, t79, "when lumo's window is closed I don't
        # think lumo should appear in the warp drive". Window classes come
        # from Hyprland; without it this check is skipped.
        classes = window_classes()
        if classes is not None and APP_PROCESS[seat] not in classes:
            return "away"
        # Not a Grok Bot seat: it can only connect through its own app's MCP.
        # Nothing tells us when its turn ends, so busy is time-based: it set
        # a status in the last MCP_BUSY_FOR seconds. Otherwise idle.
        for d in Path("/proc").iterdir():
            try:
                cmd = (d / "cmdline").read_bytes()
                if b"comms-deck\0mcp" in cmd and f"COMMS_DECK_SEAT={seat}".encode() in \
                        (d / "environ").read_bytes().split(b"\0"):
                    busy = time.time() - float(state.get("status_at") or 0) < MCP_BUSY_FOR
                    return "busy" if busy else "idle"
            except OSError:
                continue
        return "not set up"
    app_open = False
    for d in Path("/proc").iterdir():
        if not d.name.isdigit():
            continue
        try:
            comm = (d / "comm").read_text().strip()
            if comm == "grok-bot":
                app_open = True
                continue
            cmd = (d / "cmdline").read_bytes()
            if b"comms-deck\0mcp" in cmd or b"launchpad\0mcp" in cmd:
                env = (d / "environ").read_bytes().split(b"\0")
                if f"COMMS_DECK_SEAT={seat}".encode() in env or f"LAUNCHPAD_SEAT={seat}".encode() in env:
                    return "connected"
        except OSError:
            continue
    return "not connected" if app_open else "away"


def update_seat(seat, **changes):
    """Change some fields of a seat's state file, under a lock."""
    path = seat_file(seat)
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(path.with_suffix(".lock"), "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        state = read_json(path, {}) or {}
        before, doing_before = state.get("state"), state.get("doing")
        state.update(changes)
        state["updated"] = time.time()
        if state.get("state") != "busy" and "doing" not in changes:
            state["doing"] = ""  # a finished turn is no longer working on anything
        moved = "state" in changes and changes["state"] != before
        new_task = state.get("state") == "busy" and state.get("doing") != doing_before
        if moved:
            state["since"] = time.time()
        if moved or new_task:
            record_activity(seat, state["state"], state.get("doing") if state["state"] == "busy" else "")
        write_json(path, state)
        return state


def describe(text, limit=70):
    """A few words for the activity log: what started this turn.

    A delivered note ("[comms-deck] 1 note(s)... From grok at 02:58: ...")
    becomes "note from grok: <its first line>"; anything else is its own
    first line. Private names are redacted.
    """
    # Claude Code wraps a pasted note in <pasted_content ...> tags before its
    # hook sees the prompt; those aren't part of the text.
    text = re.sub(r"</?pasted_content[^>]*>", "", str(text or ""))
    # A <system-reminder> block is the agent program's own text, not the task.
    text = re.sub(r"<system-reminder>.*?(</system-reminder>|$)", "", text, flags=re.S)
    text = re.sub(r"<[^>\n]{1,60}>", "", text).strip()  # any other markup tag
    if text.startswith(MARK):
        m = re.search(r"^From (\S+)[^\n]*:\n+(.+)$", text, re.M)
        if m:
            text = f"note from {m.group(1)}: {m.group(2)}"
    if looks_secret(text):
        return "(something private)"  # a key or password must never reach the screen (found by Grok)
    first = next((line.strip() for line in text.splitlines() if line.strip()), "")
    first = redact(re.sub(r"\s+", " ", first))
    return first if len(first) <= limit else first[:limit - 1] + "…"


def describe_notes(notes):
    """A few words for notes being handed over."""
    if not notes:
        return ""
    first = notes[0]
    more = f" (+{len(notes) - 1} more)" if len(notes) > 1 else ""
    return describe(f"note from {first['from']}: {first.get('text', '')}", 70 - len(more)) + more


def record_activity(seat, new_state, doing=""):
    """Add one line to activity.jsonl: a seat changed state. Kept to 2000 lines."""
    path = DATA / "activity.jsonl"
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(path, "a+") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        f.write(json.dumps({"time": time.time(), "seat": seat, "state": new_state,
                            "doing": doing or ""}) + "\n")
        f.flush()
        if f.tell() > 400_000:
            f.seek(0)
            keep = f.readlines()[-2000:]
            f.seek(0)
            f.truncate()
            f.writelines(keep)


def recent_activity(limit, path=None):
    """The newest `limit` state changes, newest first, with repeats folded."""
    try:
        lines = Path(path or DATA / "activity.jsonl").read_text().splitlines()[-400:]
    except OSError:
        return []
    rows = []
    for line in lines:
        try:
            rows.append(json.loads(line))
        except ValueError:
            continue
    # A state that lasted under 3 s is flicker (a page's typing signal, say):
    # leave it out of the view. The file keeps everything.
    next_time = {}
    keep = []
    for r in reversed(rows):
        later = next_time.get(r["seat"])
        next_time[r["seat"]] = r["time"]
        if later is not None and later - r["time"] < 3:
            continue
        keep.append(r)
    # Fold repeats, then give each entry its duration: until that seat's next
    # change, or (the newest one per seat) until now, marked live.
    folded = []
    for r in reversed(keep):  # oldest first
        if folded and any(f["seat"] == r["seat"] for f in folded):
            last = next(f for f in reversed(folded) if f["seat"] == r["seat"])
            if last["state"] == r["state"] and last.get("doing", "") == r.get("doing", ""):
                continue
        folded.append(dict(r))
    ends = {}
    for r in reversed(folded):  # newest first
        r["live"] = r["seat"] not in ends
        r["duration"] = (time.time() if r["live"] else ends[r["seat"]]) - r["time"]
        ends[r["seat"]] = r["time"]
    return list(reversed(folded))[:limit]


def remember_window(seat, pid):
    """Record which agent process and kitty window `seat` lives in."""
    env = dict(agent_env(pid)) if pid else {}
    # Our own kitty details only count if we run inside that agent (a hook);
    # a process elsewhere (the chat screen) has its own window's details.
    if "KITTY_WINDOW_ID" not in env and find_agent()[1] == pid:
        env.update({k: v for k, v in os.environ.items() if k.startswith("KITTY_")})
    update_seat(seat, pid=pid or None,
                kitty_window=env.get("KITTY_WINDOW_ID"),
                kitty_socket=env.get("KITTY_LISTEN_ON"))


# -----------------------------------------------------------------------------
# SECTION 4: the mailbox
# -----------------------------------------------------------------------------


def new_id():
    """A unique note id: <nanoseconds>-<machine>-<pid>. Sorts by time."""
    return f"{time.time_ns()}-{MACHINE}-{os.getpid()}"


def send(sender, to, text, quiet=False, private=False):
    """Send a note. Returns (record, warning or None).

    `to` is a seat, several seats ("claude, grok", "claude+grok" or a list),
    or "all" (every agent seat except the sender). A token starting with "-"
    (e.g. "all -grok", "claude, grok, alice -grok -alice") drops that seat from
    the recipients after everything else is worked out. Several seats make one
    note with several recipients, so it's shown and logged once.
    """
    text = text.strip()
    if not text:
        raise ValueError("the note is empty")
    tokens = to if isinstance(to, (list, tuple)) else re.split(r"[\s,+]+", str(to).strip().lower())
    names, excludes = [], []
    for token in tokens:
        token = token.strip().lstrip("@")
        if not token:
            continue
        exclude = token.startswith("-")
        name = seat_id(token.lstrip("-").lstrip("@"))
        (excludes if exclude else names).append(name)
    names = list(dict.fromkeys(names))
    excludes = list(dict.fromkeys(excludes))
    unknown = [n for n in names + excludes if n not in SEATS and n != "all"]
    if unknown or not names:
        raise ValueError(f"unknown seat {(unknown or [to])[0]!r}; seats are: {', '.join(display_seat(s).lower() if s in SEAT_DISPLAY_NAMES and s != "owner" else s for s in SEATS)}, all")
    if "all" in excludes:
        raise ValueError("- excludes seats, not 'all'")
    if "all" in names:
        targets = [s for s in tuple(AGENTS) + APP_SEATS if s != sender and s not in excludes]
        # the real recipients, not "all-grok": every reader of `to` (the
        # snapshot's "went to more than one agent", Discord, the chat view)
        # knows "+"-joined names, and "all" only when nobody was dropped.
        to = "all" if not excludes else "+".join(targets)
    else:
        targets = [n for n in names if n not in excludes]
        to = "+".join(targets)
    if not targets:
        raise ValueError(f"nothing left to send to after excluding {', '.join(excludes)}")
    warning = None
    if looks_secret(text) and not private:
        private = True
        warning = "That note looks like it holds a secret, so it was made private."
    record = {"kind": "message", "id": new_id(), "from": sender or "unknown",
              "to": to, "time": now(), "machine": MACHINE,
              "quiet": bool(quiet), "private": bool(private), "text": text}
    balancer = load_balancer() if sender == "owner" else None
    if balancer:
        try:
            task = balancer.create_task(record, targets)
        except Exception as error:  # the note must still go out
            task = None
            log(f"load-balancer couldn't make a task: {error}")
        if task:
            record["task"] = task["id"]
    deliver(record, targets)
    return record, warning


def deliver(record, targets, enqueue=True):
    """One delivery path, shared by send() (and, once #75 lands,
    import_remote()): each target gets the note (an inbox file; the desktop
    bell for the owner; nothing for a remote seat, whose mailbox is the git
    copy), then the git queue, then the log, then the @deck actions.

    `enqueue=False` is import_remote's case: the record came FROM the git
    copy of the flight-log, so queueing it again would commit it back a
    second time.

    Written by: mystra (2026-11-25); the body is send()'s tail moved rather
    than changed, with the `if enqueue` around queue_out — at the owner's
    instruction, from the Wave-1 package on quantum-kittens (PR #7).
    """
    for seat in targets:
        if seat == "owner":
            notify(f"Note from {record['from']}", record["text"])
        elif APP_PROCESS.get(seat) == "remote":
            pass  # a remote seat takes its notes from the git copy; nothing here
                  # would ever take it out of an inbox, so the screen's squares
                  # must not count one that won't be read
        else:
            write_json(DATA / "inbox" / seat / f"{record['id']}.json", record)
    if enqueue:
        queue_out(record)
    append_log(record)
    queue_actions(record)


def add_note(sender, text):
    """Add a commentary entry: what was done and why."""
    text = text.strip()
    if not text:
        raise ValueError("the note is empty")
    record = {"kind": "commentary", "id": new_id(), "from": sender or "unknown",
              "time": now(), "machine": MACHINE, "private": looks_secret(text),
              "text": text}
    queue_out(record)
    append_log(record)
    return record


# -- Load balancer: the task board, in its own repo -----------------------------
# The owner (2026-11-25): requests to several agents were being picked up by
# two or three of them at once. The task board that stops this lives in its
# own repo, https://github.com/whyyyyyai/load-balancer: a note from the owner
# to two or more agents becomes one task with one holder, chosen by the
# program, and the holder keeps it only while it can work on it.
#
# comms-deck loads it if it's installed (~/.local/bin/load-balancer, or
# $COMMS_DECK_LOAD_BALANCER) and hands it this module, so it uses the deck's
# own availability ranking, mailbox and notes. Without it, nothing changes:
# no tasks, and every note is delivered exactly as before.
_balancer = None


class _DeckView:
    """This module's globals as attributes, read live.

    The load balancer is handed the deck it runs in. When comms-deck runs as
    a script that's sys.modules["__main__"], but a loader (a test, another
    program) may load it without registering it, so this view stands in.
    """

    def __getattr__(self, name):
        try:
            return globals()[name]
        except KeyError:
            raise AttributeError(name) from None

    def __setattr__(self, name, value):
        globals()[name] = value


def load_balancer():
    """The load-balancer module, attached to this deck, or None if it isn't installed."""
    global _balancer
    if _balancer is None:
        path = Path(setting("LOAD_BALANCER") or HOME / ".local/bin/load-balancer")
        _balancer = False
        if path.exists():
            try:
                import importlib.machinery
                import importlib.util
                loader = importlib.machinery.SourceFileLoader("load_balancer", str(path))
                spec = importlib.util.spec_from_loader("load_balancer", loader)
                module = importlib.util.module_from_spec(spec)
                loader.exec_module(module)
                module.attach(sys.modules.get(__name__) or _DeckView())
                _balancer = module
            except Exception as error:  # a broken balancer must never stop the deck
                log(f"load-balancer at {path} didn't load: {error}")
    return _balancer or None


PRIVATE_NAMES_FILE = CONFIG / "private-names"


def redact(text):
    """`text` with every private name replaced by "the owner".

    Names live in ~/.config/comms-deck/private-names, one per line, on this
    machine only: never in this repo. Whole words, any case. Applied to
    every copy that leaves the machine (git, Discord); the local log keeps
    the original.
    """
    try:
        names = [n.strip() for n in PRIVATE_NAMES_FILE.read_text().splitlines()
                 if n.strip() and not n.strip().startswith("#")]
    except OSError:
        return text
    for name in sorted(names, key=len, reverse=True):
        text = re.sub(rf"(?<!\w){re.escape(name)}(?!\w)", "the owner", text, flags=re.IGNORECASE)
    return text


def queue_out(record):
    """Queue a record for the git copy, and for Discord if it's public.

    Both copies leave the machine, so private names are redacted first.
    """
    out = dict(record, text=redact(record["text"]))
    write_json(DATA / "queue/sync" / f"{record['id']}.json", out)
    if not record["private"] and WEBHOOK_FILE.exists():
        write_json(DATA / "queue/discord" / f"{record['id']}.json", out)


def pending(seat):
    """The notes waiting for `seat`, oldest first, as (path, record)."""
    box = DATA / "inbox" / seat
    if not box.is_dir():
        return []
    out = []
    for path in sorted(box.glob("*.json")):
        record = read_json(path)
        if record:
            out.append((path, record))
    return out


def take(seat, include_quiet=True, limit_chars=None):
    """Take notes from `seat`'s inbox. Returns the records taken.

    Taking is a rename into delivered/, so a note is only ever taken once
    even if two processes try at the same moment. `include_quiet=False`
    leaves quiet notes unless a normal note is being taken anyway (then they
    ride along). `limit_chars` stops before the hand-over gets too long.
    """
    waiting = pending(seat)
    if not include_quiet and not any(not r.get("quiet") for _, r in waiting):
        return []
    taken, size = [], 0
    done = DATA / "delivered" / seat
    done.mkdir(parents=True, exist_ok=True)
    for path, record in waiting:
        size += len(record.get("text", "")) + 80
        if limit_chars and taken and size > limit_chars:
            break
        try:
            os.rename(path, done / path.name)
        except OSError:
            continue  # someone else took it
        taken.append(record)
    return taken


# -----------------------------------------------------------------------------
# SECTION 5: delivery text - what the agent actually reads
# -----------------------------------------------------------------------------


def note_age(record):
    """How long ago a note was sent, e.g. '4m ago', for judging if it's stale."""
    try:
        sent = time.mktime(time.strptime(record["time"], "%Y-%m-%d %H:%M:%S"))
    except (KeyError, ValueError):
        return "time unknown"
    return ago(time.time() - sent)


def team_snapshot(seat, records):
    """The team as this note is delivered: who's busy or idle, since when,
    and how many notes each has waiting. Built by the service at delivery,
    so every agent can judge what the others are likely doing, and avoid two
    agents doing the same work (asked for by the owner)."""
    rows = []
    for other, st, since in current_states():
        if other == seat:
            continue
        began = f" since {when(since)}" if since else ""
        waiting = len(pending(other))
        rows.append(f"{other} {st}{began}, {waiting} waiting")
    text = f"Team at {time.strftime('%H:%M')}: " + "; ".join(rows) + "."
    balancer = load_balancer()
    board = [t for t in balancer.all_tasks() if t["state"] in balancer.TASK_ACTIVE][-5:] if balancer else []
    if board:
        text += " Tasks: " + "; ".join(f"{t['id']} {display_seat(t.get('holder')) if t.get('holder') else 'open'}" for t in board) + "."
    shared = [r for r in records if (r.get("to") == "all" or "+" in str(r.get("to"))) and not r.get("task")]
    if shared:
        text += (" This note went to more than one agent. Before starting work on it, check "
                 "who is already on it (team_status, or ask). If it was sent a while ago and "
                 "the others have been idle since, ask whether your part is still needed "
                 "rather than doing it twice.")
    return text


def render(records, seat):
    """Turn notes into one block of text for `seat` to read."""
    lines = []
    for r in records:
        tags = [t for t, on in (("quiet", r.get("quiet")), ("private", r.get("private"))) if on]
        to = "" if r.get("to") == seat else f" (to {', '.join(display_seat(t) for t in str(r.get('to')).split('+'))})"
        tag = f" [{', '.join(tags)}]" if tags else ""
        lines.append(f"From {display_seat(r['from'])}{to} at {r['time'][11:16]} ({note_age(r)}){tag}:\n{r['text']}")
        balancer = load_balancer() if r.get("task") else None
        task = balancer.load_task(r.get("task")) if balancer else None
        if task and task["state"] in balancer.TASK_ACTIVE:
            holder = task.get("holder")
            if holder == seat:
                lines.append(f"Task {task['id']} is YOURS (picked by the deck). Do it, then "
                             f"`done_task {task['id']}`; `release_task {task['id']}` if you can't.")
            elif holder:
                lines.append(f"Task {task['id']} is {display_seat(holder)}'s. Don't start it yourself; "
                             f"help only if {display_seat(holder)} asks.")
            else:
                lines.append(f"Task {task['id']} is open: nobody was free. `claim_task {task['id']}` "
                             f"to take it.")
    lines.append(team_snapshot(seat, records))
    senders = sorted({r["from"] for r in records} & set(SEATS))
    reply = (f"\n\nReply with the send_message tool (to: {senders[0]})"
             f" or `comms-deck send {senders[0]} \"...\"`." if senders else "")
    if seat in APP_SEATS and APP_PROCESS.get(seat, "grok-bot") == "grok-bot":
        # A Grok Bot seat reads this in its own chat and has no comms-deck tools:
        # its chat reply is picked up and filed, so tell it how that works.
        who = "owner" if "owner" in senders or not senders else senders[0]  # not just the first alphabetically
        return (f"{MARK} {len(records)} note(s) for {seat}:\n\n" + "\n\n".join(lines)
                + f"\n\nReply here in this chat. Your reply goes to {OWNER_NAME if who == 'owner' else who}"
                  " on the comms-deck screen; start it with @claude, @grok or another seat to send it"
                  " to that agent instead. To have something done on this iMac (the scratchpad,"
                  " a workspace, a link, a YouTube search), write a line starting @deck, e.g."
                  f" \"@deck scratchpad\"; \"@deck help\" lists them. Call the owner {OWNER_NAME}, never another name.")
    if "owner" in senders:
        reply = (f"\n\n{OWNER_NAME} (the owner) sent this from the comms-deck chat screen and reads "
                 "the answer there, not in this window. Answer with the send_message tool, to: owner "
                 "(or `comms-deck send owner \"...\"`). Anything you say only in this window, "
                 f"{OWNER_NAME} won't see. Call them {OWNER_NAME}, not \"the owner\" or \"you\".")
    return f"{MARK} {len(records)} note(s) for {seat}:\n\n" + "\n\n".join(lines) + reply


# -----------------------------------------------------------------------------
# SECTION 6: hooks - Claude Code, the Grok CLI, and Antigravity (agy)
# -----------------------------------------------------------------------------
#
# Claude and Grok events, and what each does:
#   SessionStart       remember the window; Claude is told about waiting notes
#   UserPromptSubmit   mark busy; record promptId; reset the loop count if the
#                      owner typed it. Claude also gets waiting notes.
#   Stop               hand over a waiting note and keep working. An allowed
#                      Stop marks Claude idle immediately. Grok's Stop does
#                      not. channel_closed / shutdown mark away.
#   StopCancelled      a late cancel can arrive after the next prompt, so this
#                      does not mark idle. Older promptIds are ignored on Stop.
#   Notification       idle_prompt only: mark idle. For Grok this is what
#                      settles idle. StopFailure is not hooked: idle_prompt
#                      also fires after an errored turn.
#   SessionEnd         mark away
#
# A child session's events carry subagentType. They are not this seat's.
#
# Antigravity (agy, the seat gravity) uses different events, in agy_hook:
#   SessionStart     remember the window
#   PreInvocation    notes before the next model call; save the model name
#   Stop             mark idle only when fullyIdle; a waiting note continues


def event_prompt_id(data):
    """The turn id on a hook payload, or None. Grok's field is promptId, Codex's turn_id."""
    value = data.get("promptId")
    if value is None or value == "":
        value = data.get("turn_id")
    if value is None or value == "":
        return None
    return str(value)


def turn_relation(state, data):
    """How this event sits against the newest promptId for the seat.

    'session' has no promptId (idle_prompt, a session-end Stop): act on it.
    'older' belongs to a turn that UserPromptSubmit has already moved past.
    'current' is the newest turn, or the first id this seat has seen.
    """
    pid = event_prompt_id(data)
    if pid is None:
        return "session"
    newest = state.get("prompt_id")
    if newest and pid != str(newest):
        return "older"
    return "current"


def paused_for_background(data):
    """True if this Stop is a pause for work that will wake the session."""
    return bool(data.get("backgroundTasks") or data.get("sessionCrons"))


# Devin's hooks use Claude Code's event names and replies (additionalContext
# on SessionStart and UserPromptSubmit, {"decision": "block"} on Stop), so it
# takes Claude's path through hook(). It has no idle_prompt notification.
# Codex (0.172+, ~/.codex/hooks.json) uses the same names and replies too,
# with turn_id for the turn; its Stop is the idle signal, as on Devin.
CLAUDE_LIKE = ("claude", "devin", "codex")
# Seats whose UserPromptSubmit reply can carry notes as additionalContext.
# Codex documents that reply only for SessionStart, so its notes wait for
# its Stop hook (block + reason) rather than being taken and maybe dropped.
PROMPT_CONTEXT = ("claude", "devin")


def hook(source, event):
    """Handle one hook event (JSON on stdin). Prints the reply, if any."""
    if source == "agy":
        return agy_hook(event)
    if source == "vibe":
        return vibe_hook(event)
    # Grok and Devin both also read ~/.claude/settings.json, so Claude's hooks
    # fire inside them too. Each agent marks its own hook runs: Grok sets
    # GROK_HOOK_EVENT, Devin sets DEVIN_PROJECT_DIR. Codex sets nothing, so
    # it is known by the agent process above the hook. Only the hook installed
    # for the agent we're running in acts.
    running_in = ("grok" if os.environ.get("GROK_HOOK_EVENT")
                  else "devin" if os.environ.get("DEVIN_PROJECT_DIR")
                  else "codex" if find_agent()[0] == "codex" else "claude")
    if source != running_in:
        return  # e.g. Grok reading Claude's settings file: not our hook here
    try:
        data = json.loads(sys.stdin.read() or "{}")
    except ValueError:
        data = {}
    event = event or data.get("hook_event_name") or ""
    if data.get("subagentType"):
        return
    seat, pid = find_agent()
    if seat not in AGENTS:
        return
    state = load_seat(seat)
    if pid and state.get("pid") != pid:
        remember_window(seat, pid)  # a restarted agent, or a stale record
        state = load_seat(seat)

    def reply(obj):
        print(json.dumps(obj))

    if event == "SessionStart":
        remember_window(seat, pid)
        update_seat(seat, state="idle", auto=0, prompt_id=None)
        count = len(pending(seat))
        if count and source in CLAUDE_LIKE:
            reply({"hookSpecificOutput": {"hookEventName": "SessionStart",
                   "additionalContext": f"{MARK} {count} note(s) are waiting for you "
                                        f"({seat}). Read them with read_messages."}})
    elif event == "UserPromptSubmit":
        # The text field is `prompt`. A missing key must not look like the
        # owner typed something, or the loop guard resets on every such event.
        if "prompt" in data and data.get("prompt") is not None:
            prompt = str(data.get("prompt"))
            woke = time.time() - float(state.get("woke_at") or 0) < 10
            automatic = prompt.lstrip().startswith(MARK) or woke
            auto = state["auto"] if automatic else 0
            owner_typed = not automatic
        else:
            auto = state["auto"]
            owner_typed = False
        changes = {"state": "busy", "auto": auto, "woke_at": 0}
        if "prompt" in data and data.get("prompt"):
            changes["doing"] = describe(data.get("prompt"))
        if auto == 0:
            changes["paused_notice"] = False
        prompt_id = event_prompt_id(data)
        if prompt_id:
            changes["prompt_id"] = prompt_id
        update_seat(seat, **changes)
        if source in PROMPT_CONTEXT and owner_typed:
            notes = take(seat, limit_chars=HANDOVER_MAX)
            if notes:
                reply({"hookSpecificOutput": {"hookEventName": "UserPromptSubmit",
                       "additionalContext": render(notes, seat)}})
    elif event == "Stop":
        if data.get("reason") in ("channel_closed", "shutdown"):
            update_seat(seat, state="away")
            return
        if turn_relation(state, data) == "older":
            return
        if paused_for_background(data):
            return  # the session will wake itself; leave the notes
        if state["auto"] < AUTO_LIMIT or owner_waiting(seat):
            notes = take(seat, include_quiet=False, limit_chars=HANDOVER_MAX)
            if notes:
                new_auto = next_auto(state, notes)
                changes = {"state": "busy", "auto": new_auto, "doing": describe_notes(notes)}
                if new_auto == 0:
                    changes["paused_notice"] = False
                update_seat(seat, **changes)
                reply({"decision": "block", "reason": render(notes, seat)})
                return
        elif any(not r.get("quiet") for _, r in pending(seat)):
            pause_notice(seat)
        if source in CLAUDE_LIKE:
            # On Claude an allowed Stop is the end of the turn (comms-deck's
            # is the only Stop hook), so idle now rather than waiting the
            # minute for idle_prompt. Devin has no idle_prompt, so its Stop
            # is the only idle signal. Grok settles idle on idle_prompt only.
            update_seat(seat, state="idle")
    elif event == "StopCancelled":
        # Idle waits for idle_prompt. An older cancel must not touch the seat:
        # Grok can deliver it after the next turn's UserPromptSubmit.
        return
    elif event == "Notification":
        # Claude's hook is installed with matcher idle_prompt, so whatever
        # reaches it is idle; Grok's payload is checked field by field.
        if source == "grok" and data.get("notification_type") != "idle_prompt":
            return
        if turn_relation(state, data) == "older":
            return
        update_seat(seat, state="idle")
    elif event == "SessionEnd":
        update_seat(seat, state="away")


def owner_waiting(seat):
    """True if a note from the owner is in `seat`'s inbox. The owner always gets through."""
    return any(r.get("from") == "owner" for _, r in pending(seat))


def next_auto(state, notes):
    """The loop count after handing `notes` over: reset by the owner, else one more."""
    if any(r.get("from") == "owner" for r in notes):
        return 0
    return state["auto"] + 1


def remember_gravity_model(data):
    """Save the model name from a PreInvocation hook, for the usage panel.

    The payload has modelName and no token or quota figures, so the panel
    names the model and draws no bar. A repeat of the same name inside a
    minute does not rewrite the file.
    """
    model = str(data.get("modelName") or "").strip()
    if not model:
        return
    path = DATA / "usage" / "gravity.json"
    prev = read_json(path) or {}
    same = (prev.get("source") == "gravity-hook"
            and dig(prev, "data", "model", "display_name") == model)
    if same and time.time() - float(prev.get("time") or 0) < 60:
        return
    write_json(path, {"time": time.time(), "source": "gravity-hook",
                      "data": {"model": {"display_name": model}}})


def agy_hook(event):
    """Hooks for the Antigravity CLI (program agy, seat gravity). Its events and replies differ:

      SessionStart   remember the window; say how many notes wait (injectSteps)
      PreInvocation  runs before every model call. Call 0 is a new turn: mark
                     busy, and reset the loop guard if the owner typed it.
                     Waiting notes are handed over here as a system message,
                     so they arrive mid-turn, not only at the end.
      Stop           a note waiting: {"decision": "continue", "reason": notes}.
                     Otherwise idle once fullyIdle says nothing is still running.
    Payload fields are camelCase (lastUserInput, invocationNum, fullyIdle).
    """
    try:
        data = json.loads(sys.stdin.read() or "{}")
    except ValueError:
        data = {}
    seat, pid = find_agent()
    if seat != "gravity":
        return  # not running inside agy: not this hook's business
    state = load_seat(seat)
    if pid and state.get("pid") != pid:
        remember_window(seat, pid)
        state = load_seat(seat)

    def system(text):
        return {"injectSteps": [{"systemMessage": {"systemMessage": text}}]}

    if event == "SessionStart":
        remember_window(seat, pid)
        update_seat(seat, state="idle", auto=0)
        count = len(pending(seat))
        if count:
            print(json.dumps(system(f"{MARK} {count} note(s) are waiting for you (gravity). "
                                    "Read them with the read_messages tool.")))
    elif event == "PreInvocation":
        remember_gravity_model(data)
        if int(data.get("invocationNum") or 0) == 0:
            typed = str(data.get("lastUserInput") or "")
            woke = time.time() - float(state.get("woke_at") or 0) < 10
            automatic = typed.lstrip().startswith(MARK) or woke or "lastUserInput" not in data
            update_seat(seat, state="busy", woke_at=0, **({} if automatic else {"auto": 0}),
                        **({"doing": describe(typed)} if typed and not typed.lstrip().startswith(MARK) else {}))
            state = load_seat(seat)
        if state["auto"] < AUTO_LIMIT or owner_waiting(seat):
            notes = take(seat, limit_chars=HANDOVER_MAX)
            if notes:
                update_seat(seat, auto=next_auto(state, notes), doing=describe_notes(notes))
                print(json.dumps(system(render(notes, seat))))
    elif event == "Stop":
        if state["auto"] < AUTO_LIMIT or owner_waiting(seat):
            notes = take(seat, include_quiet=False, limit_chars=HANDOVER_MAX)
            if notes:
                update_seat(seat, state="busy", auto=next_auto(state, notes), doing=describe_notes(notes))
                print(json.dumps({"decision": "continue", "reason": render(notes, seat)}))
                return
        elif any(not r.get("quiet") for _, r in pending(seat)):
            pause_notice(seat)
        if data.get("fullyIdle", True):
            update_seat(seat, state="idle")


# The deck's MCP tools Vibe may call without a per-call Allow prompt (the
# owner, 09:00). Vibe keys a tool's permission as [tools.<server>_<tool>]:
# checked live, where [tools."mcp_comms_deck.<tool>"] (the name it shows) and
# [tools.mcp_comms_deck_<tool>] both still asked.
VIBE_ALLOWED_TOOLS = ("team_status", "read_messages", "send_message", "add_note", "set_status",
                      "tasks", "claim_task", "release_task", "done_task")


def grant_vibe_tools(config):
    """`config` (the text of ~/.vibe/config.toml) with an always-allow table for
    each deck tool that has none. A table already there is left as it is."""
    for tool in VIBE_ALLOWED_TOOLS:
        header = f"[tools.comms-deck_{tool}]"
        if header not in config:
            config = config.rstrip("\n") + ("\n\n" if config.strip() else "") + f'{header}\npermission = "always"\n'
    return config


VIBE_MAX_DENIES = 3  # post_agent denies Vibe 3.1.4 honours per turn (_MAX_POST_AGENT_RETRIES)
VIBE_HOOK_TYPES = ("session_start", "pre_agent", "post_agent", "notification", "session_end")


def vibe_hooks_toml(cmd):
    """The comms-deck entries for ~/.vibe/hooks.toml (Mistral Vibe), one per hook type."""
    return "".join(
        f'[[hooks]]\nname = "comms-deck-{kind}"\ntype = "{kind}"\n'
        f'command = "{cmd} hook --source vibe --event {kind}"\ntimeout = 10.0\n'
        f'description = "comms-deck: notes in, seat state"\n\n'
        for kind in VIBE_HOOK_TYPES)


def vibe_hook(event):
    """Hooks for Mistral Vibe (program vibe-rs, seat vibe). Payloads, as Vibe 3.1.4 sends them:

      session_start  {source: startup|resume|clear|fork, session_id, cwd, model}
                     remember the window; say how many notes wait
                     ({"hook_specific_output": {"additional_context": ...}})
      pre_agent      {turn_id, prompt}: a turn starts. Busy; the loop guard
                     resets unless the prompt is a note the deck typed.
      post_agent     {turn_id, response_text}: the turn ended. A note waiting:
                     {"decision": "deny", "reason": notes}, and Vibe goes on
                     with it. Vibe 3.1.4 honours only 3 denies a turn and
                     drops the reason of a 4th, so after 3 handovers in one
                     turn_id the notes stay in the inbox for the idle wake
                     (Grok's review of #46). Otherwise idle.
      notification   notification_type turn_completed / turn_failed: idle.
      session_end    away.
    The event comes from hook_event_name when --event is not given.
    """
    try:
        data = json.loads(sys.stdin.read() or "{}")
    except ValueError:
        data = {}
    event = event or str(data.get("hook_event_name") or "")
    seat, pid = find_agent()
    if seat != "vibe":
        return  # not running inside Vibe: not this hook's business
    state = load_seat(seat)
    if pid and state.get("pid") != pid:
        remember_window(seat, pid)
        state = load_seat(seat)

    if event == "session_start":
        remember_window(seat, pid)
        update_seat(seat, state="idle", auto=0)
        count = len(pending(seat))
        if count:
            print(json.dumps({"hook_specific_output": {"additional_context":
                  f"{MARK} {count} note(s) are waiting for you (vibe). Read them with the "
                  "comms-deck read_messages tool."}}))
    elif event == "pre_agent":
        prompt = str(data.get("prompt") or "")
        woke = time.time() - float(state.get("woke_at") or 0) < 10
        automatic = prompt.lstrip().startswith(MARK) or woke or "prompt" not in data
        update_seat(seat, state="busy", woke_at=0, **({} if automatic else {"auto": 0, "paused_notice": False}),
                    **({"doing": describe(prompt)} if prompt and not prompt.lstrip().startswith(MARK) else {}))
    elif event == "post_agent":
        turn = str(data.get("turn_id") or "")
        handed = int(state.get("vibe_denies") or 0) if turn and turn == state.get("vibe_turn") else 0
        if handed >= VIBE_MAX_DENIES:
            update_seat(seat, state="idle")
            return  # Vibe would accept and drop a 4th: leave the notes for the idle wake
        if state["auto"] < AUTO_LIMIT or owner_waiting(seat):
            notes = take(seat, include_quiet=False, limit_chars=HANDOVER_MAX)
            if notes:
                update_seat(seat, state="busy", auto=next_auto(state, notes), doing=describe_notes(notes),
                            vibe_turn=turn, vibe_denies=handed + 1)
                print(json.dumps({"decision": "deny", "reason": render(notes, seat)}))
                return
        elif any(not r.get("quiet") for _, r in pending(seat)):
            pause_notice(seat)
        update_seat(seat, state="idle")
    elif event == "notification":
        if data.get("notification_type") in ("turn_completed", "turn_failed"):
            update_seat(seat, state="idle")
    elif event == "session_end":
        update_seat(seat, state="away")


