      if (fiber && fiber.current) fiber = fiber.current;
      else if (fiber && fiber.stateNode && fiber.stateNode.current) fiber = fiber.stateNode.current;
      const queue = fiber ? [fiber] : [];
      const seen = new Set();
      const seenObj = new Set();
      const skip = new Set(["child", "sibling", "return", "alternate", "elementType", "type", "ref", "dependencies", "_owner", "_store"]);
