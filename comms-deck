def draft_status(state, composer, now):
    """Track the text left in an app seat's chat box. Returns (changes, stale).

    The deck never types over a draft, in case the owner is writing one. But
    a draft left unchanged for DRAFT_STALE seconds (a stray "w" held Alice's
    notes for hours) is abandoned: `stale` is True, and the caller saves the
    text to the owner and clears the box, so delivery can't be blocked forever.
    """
    text = composer or ""
    if not text.strip():
        return ({"app_draft": "", "app_draft_since": 0} if state.get("app_draft") else {}), False
    if text != state.get("app_draft"):
        return {"app_draft": text, "app_draft_since": now}, False
    return {}, now - float(state.get("app_draft_since") or now) >= DRAFT_STALE
