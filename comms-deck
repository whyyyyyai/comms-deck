def git(repo, *args, timeout=120):
    """Run one git command in a repo and return its stdout, or raise."""
    result = subprocess.run(["git", "-C", str(repo), *args], capture_output=True,
                            text=True, timeout=timeout)
    if result.returncode:
        raise RuntimeError(f"git {args[0]}: {(result.stderr or result.stdout).strip()}")
    return result.stdout


def message_file(r):
    """The note in the flight-log's file format, and its path in the repo."""
    day, clock = r["time"][:10], r["time"][11:].replace(":", "")
    path = Path("messages") / day / f"{clock}-{r['from']}-to-{r['to']}-{r['id']}.txt"
    body = (f"From: {r['from']}\nTo: {r['to']}\nTime: {r['time']}\nMachine: {r['machine']}\n"
            f"Quiet: {'yes' if r['quiet'] else 'no'}\n"
            f"Visibility: {'private' if r['private'] else 'public'}\nId: {r['id']}\n\n{r['text']}\n")
    return path, body


def sync_records():
    """Copy queued records into the git repos: one commit and push per repo."""
    queue = DATA / "queue/sync"
    files = sorted(queue.glob("*.json")) if queue.is_dir() else []
    if not files:
        return
    by_repo = {}
    for path in files:
        r = read_json(path)
        if not r:
            path.unlink(missing_ok=True)
            continue
        repo = PRIVATE_REPO if r["private"] else PUBLIC_REPO
        by_repo.setdefault(repo, []).append((path, r))
    for repo, items in by_repo.items():
        if not (repo / ".git").exists():
            continue  # no clone here: the records wait until there is one
        try:
            git(repo, "pull", "--rebase", "--autostash", "-q")
            for _, r in items:
                if r["kind"] == "message":
                    rel, body = message_file(r)
                    (repo / rel).parent.mkdir(parents=True, exist_ok=True)
                    (repo / rel).write_text(body)
                else:
                    rel = Path("commentary") / f"{r['time'][:10]}.md"
                    (repo / rel).parent.mkdir(parents=True, exist_ok=True)
                    with open(repo / rel, "a") as f:
                        if f.tell() == 0:
                            f.write(f"# Commentary for {r['time'][:10]}\n")
                        f.write(f"\n### {r['time'][11:]} · {r['from']} ({r['machine']})\n\n{r['text']}\n")
            build = repo / "tools/build-log"
            if build.exists():
                subprocess.run([sys.executable, str(build)], cwd=repo, capture_output=True, timeout=60)
            git(repo, "add", "-A", "messages", "commentary", *(["LOG.md"] if (repo / "LOG.md").exists() else []))
            if git(repo, "status", "--porcelain").strip():
                git(repo, "commit", "-q", "-m", f"relay messages from {MACHINE}")
                git(repo, "push", "-q")
            for path, _ in items:
                path.unlink(missing_ok=True)
            log(f"copied {len(items)} record(s) to {repo.name}")
        except (RuntimeError, OSError, subprocess.SubprocessError) as error:
            log(f"couldn't copy to {repo.name} (will retry): {error}")


def post_discord():
    """Post queued public records to the Discord webhook. Returns seconds to wait."""
    queue = DATA / "queue/discord"
    if not queue.is_dir() or not WEBHOOK_FILE.exists():
        return 0
    url = WEBHOOK_FILE.read_text().strip()
    for path in sorted(queue.glob("*.json"))[:5]:
        r = read_json(path)
        if not r or r.get("private") or looks_secret(r.get("text", "")):
            path.unlink(missing_ok=True)
            continue
        who = shown_name(r["from"])
        to_names = "Everyone" if r["to"] == "all" else ", ".join(shown_name(t) for t in r["to"].split("+"))
        name = f"{who} → {to_names}" if r["kind"] == "message" else f"{who} (commentary)"
        text = r["text"] if len(r["text"]) <= 1900 else r["text"][:1900] + " …"
        body = json.dumps({"username": name[:80], "content": text,
                           "allowed_mentions": {"parse": []}}).encode()
        req = urllib.request.Request(url, data=body, headers={
            "Content-Type": "application/json", "User-Agent": "comms-deck (relay mirror)"})
        try:
            urllib.request.urlopen(req, timeout=15).close()
            path.unlink(missing_ok=True)
        except urllib.error.HTTPError as error:
            if error.code == 429:
                try:
                    return float(json.loads(error.read()).get("retry_after", 5)) + 0.5
                except ValueError:
                    return 5
            log(f"Discord refused a post ({error.code}); dropping it")
            path.unlink(missing_ok=True)
        except (urllib.error.URLError, OSError) as error:
            log(f"Discord unreachable (will retry): {error}")
            return 30
        time.sleep(1)
    return 0


def parse_message_file(path):
    """Read one flight-log message file (the format `message_file()` writes)
    back into a note record. Returns None if the file isn't a message."""
    try:
        body = path.read_text()
    except OSError:
        return None
    head, _, text = body.partition("\n\n")
    if not text:
        return None
    fields = {}
    for line in head.splitlines():
        name, _, value = line.partition(":")
        if name.strip() and _:
            fields[name.strip().lower()] = value.strip()
    if not (fields.get("from") and fields.get("to") and fields.get("id")):
        return None
    return {"kind": "message", "id": fields["id"], "from": fields["from"].lower(),
            "to": fields["to"], "time": fields.get("time", ""),
            "machine": fields.get("machine", "(unknown)"),
            "quiet": fields.get("quiet") == "yes",
            "private": fields.get("visibility") == "private",
            "text": text.rstrip("\n")}


def import_remote():
    """Deliver the notes that remote seats wrote to the git repos from their
    own machines, so they arrive like any other note.

    A remote seat (`name:remote` in ~/.config/comms-deck/app-seats, see
    docs/REMOTE.md) joins from another device: it reads the flight-log and
    writes its replies there itself, in `message_file()`'s format. This
    closes the loop. It runs in the service's sync pass next to
    `sync_records()`: each repo is pulled, and every message file that
    changed and came from a remote seat on another machine is handed to the
    normal path (the inbox, hooks and wakes, append_log, chat screen). The
    last-seen head lives in DATA/remote-heads/, so on a first sight the old
    backlog stays the archive it is, and a note is only ever imported when
    its own file changed.
    """
    remote = [s for s, app in APP_PROCESS.items() if app == "remote"]
    if not remote:
        return
    for repo in (PUBLIC_REPO, PRIVATE_REPO):
        if not (repo / ".git").exists():
            continue
        marker = DATA / "remote-heads" / f"{repo.name}.json"
        try:
            git(repo, "pull", "--rebase", "--autostash", "-q")
            current = git(repo, "rev-parse", "HEAD").strip()
        except (RuntimeError, OSError, subprocess.SubprocessError) as error:
            log(f"couldn't pull {repo.name} for the remote seats (will retry): {error}")
            continue
        last = (read_json(marker, {}) or {}).get("head")
        if not last:
            write_json(marker, {"head": current})
            continue
        if last == current:
            continue
        try:
            names = git(repo, "diff", "--name-only", last, current).split()
        except (RuntimeError, OSError, subprocess.SubprocessError) as error:
            log(f"couldn't compare {repo.name} {last[:7]}..{current[:7]} (will retry): {error}")
            continue
        write_json(marker, {"head": current})
        brought = 0
        for name in names:
            path = repo / name
            if not name.startswith("messages/") or not path.is_file():
                continue
            record = parse_message_file(path)
            if not record or record["from"] not in remote or record["machine"] == MACHINE:
                continue  # not a message, not from a remote seat, or the deck's own echo
            if any((DATA / "delivered" / seat / f"{record['id']}.json").exists()
                   for seat in SEATS):
                continue  # it was imported and taken once already (a crash after the inbox write)
            if record["to"] == "all":
                targets = [s for s in SEATS if s not in (record["from"], "owner")]
            else:
                targets = [t for t in record["to"].split("+") if t in SEATS or t == "owner"]
            if not targets:
                continue
            for seat in targets:
                if seat == "owner":
                    notify(f"Note from {record['from']}", record["text"])
                else:
                    write_json(DATA / "inbox" / seat / f"{record['id']}.json", record)
            append_log(record)
            queue_actions(record)
            brought += 1
        if brought:
            log(f"imported {brought} note(s) from the remote seats via {repo.name}")


