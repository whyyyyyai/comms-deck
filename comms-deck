def credited_seats(text, label):
    """Seat names on lines like 'Reviewed by: Claude'. 'owner' is not a seat here."""
    found = []
    for line in text.splitlines():
        if not re.match(rf"(?i)^\s*{label}\s+by\s*:", line):
            continue
        for seat in SEATS:
            if seat != "owner" and re.search(rf"(?i)\b{seat}\b", line) and seat not in found:
                found.append(seat)
    return found


def review_gap(text):
    """None if another seat reviewed this text, otherwise a short reason.

    The author is whoever `Written by:` names. A `Reviewed by:` line counts
    only when it names a different seat, so an author cannot pass their own PR.
    """
    writers = credited_seats(text, "Written")
    reviewers = credited_seats(text, "Reviewed")
    if not writers:
        return "no Written by line naming a seat"
    others = [seat for seat in reviewers if seat not in writers]
    if not reviewers:
        return "no Reviewed by line"
    if not others:
        return "Reviewed by names only the author (" + ", ".join(writers) + ")"
    return None


def pr_review_text(number):
    """The PR body plus review and comment text, from GitHub. Raises on failure."""
    result = subprocess.run(
        ["gh", "pr", "view", str(number), "--repo", "whyyyyyai/comms-deck",
         "--json", "body,comments,reviews"],
        capture_output=True, text=True, timeout=30)
    if result.returncode != 0:
        raise RuntimeError((result.stderr or result.stdout or "gh pr view failed").strip())
    data = json.loads(result.stdout or "{}")
    parts = [data.get("body") or ""]
    for key in ("comments", "reviews"):
        for item in data.get(key) or []:
            if isinstance(item, dict):
                parts.append(item.get("body") or "")
    return "\n".join(parts)


def pr_files(number):
    """The file paths a PR touches, from gh. Raises on failure. One
    --name-only call; no content is fetched.

    Written by: mystra (2026-11-25, Wave-1 piece 3).
    """
    result = subprocess.run(
        ["gh", "pr", "diff", str(number), "--repo", "whyyyyyai/comms-deck", "--name-only"],
        capture_output=True, text=True, timeout=30)
    if result.returncode != 0:
        raise RuntimeError((result.stderr or result.stdout or "gh pr diff failed").strip())
    return [line for line in result.stdout.splitlines() if line.strip()]


def cite_gap(text, number=None):
    """None if the PR text carries the authorship citation rule 4 asks for
    (docs/CITATION.md), otherwise a short reason.

    Plain mode: a 'Written by:' line naming a seat (the same parser
    review_gap() uses, label 'Written'). With `number` (--strict): every
    file the PR touches must be named somewhere in the PR text -- the
    body's citation list, a per-file 'Written by:' table, anything citable
    -- so a PR that cannot say who wrote each file does not merge. Two
    independent gates: cite_gap never reads review_gap's verdict and never
    looks at CREDITS tables.

    Written by: mystra (2026-11-25, Wave-1 piece 3).
    """
    writers = credited_seats(text, "Written")
    if not writers:
        return "no Written by line naming a seat"
    if number:
        # Markdown-emphasis and inline-code marks wouldn't stop a reader
        # from seeing the path, so strip them before matching (claude's
        # review of the first cut): `docs/CITATION.md` or **README.md**
        # cite the file just as plainly as bare text.
        plain = re.sub(r"`{1,3}([^`]*)`{1,3}", r"\1", text).replace("**", "")
        # Whole-path match: docs/README.md is not cited by README.md. A
        # sentence-ending period after the path still counts; a period that
        # starts another path segment (docs/README.md.backup) does not.
        cited = lambda path: re.search(r"(?<![\w./-])" + re.escape(path)
                                       + r"(?=$|[\s,;:)]|\.(?![\w]))", plain) is not None
        missing = [path for path in pr_files(number) if not cited(path)]
        if missing:
            return "files the PR touches that its text never cites: " + ", ".join(missing[:6])
    return None


def main():
    """The command line: send, read, the chat screen, the service, hooks and install."""
    parser = argparse.ArgumentParser(prog="comms-deck", description=__doc__.split("\n")[0])
    parser.add_argument("--from", dest="sender", help="send as this seat")
    sub = parser.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("send")
    p.add_argument("to")
    p.add_argument("text", nargs="+")
    p.add_argument("--quiet", action="store_true")
    p.add_argument("--private", action="store_true")
    p = sub.add_parser("read")
    p.add_argument("--peek", action="store_true", help="show without taking")
    p = sub.add_parser("note")
    p.add_argument("text", nargs="+")
    p = sub.add_parser("status")
    p.add_argument("--json", action="store_true", help="every seat as JSON, for programs")
    p = sub.add_parser("usage", help="notes, activity and plan limits for the deck, from its logs;"
                                     " with a seat (or 'all'), that seat's telemetry in full")
    p.add_argument("seat", nargs="?", help="a seat, account or provider; 'all' lists every record")
    p.add_argument("--days", type=int, default=7)
    sub.add_parser("watch")
    p = sub.add_parser("chat")
    p.add_argument("--hide-private", action="store_true")
    p.add_argument("--history", type=int, default=200)
    sub.add_parser("mail", help="the mail client (Proton Mail Bridge on localhost; the mail desktop, Super+9)")
    sub.add_parser("serve")
    sub.add_parser("mcp")
    sub.add_parser("mcp-call")  # internal: one tool call for an MCP server running old code
    p = sub.add_parser("hook")
    p.add_argument("--source", required=True, choices=("claude", "grok", "agy", "vibe", "devin", "codex"))
    p.add_argument("--event", default="")
    p = sub.add_parser("statusline")
    p.add_argument("--source", required=True, choices=("claude", "grok", "agy"))
    p = sub.add_parser("install")
    p.add_argument("--yes", action="store_true")
    sub.add_parser("self-test")
    p = sub.add_parser("wake", help="one wake attempt for a seat (for watchdogs)")
    p.add_argument("seat")
    p.add_argument("--stale", action="store_true", help="treat a long-unchanged busy seat as idle")
    p = sub.add_parser("settle", help="match seats' busy/idle to what their windows show (for watchdogs)")
    p.add_argument("seats", nargs="*")
    p = sub.add_parser("spent", help="mark a seat spent until its limit resets (for agents with no meter)")
    p.add_argument("seat")
    p.add_argument("until", nargs="+", help="+166h, +90m, +2d, 06:20, 'YYYY-MM-DD HH:MM', or clear")
    p = sub.add_parser("review-check")
    p.add_argument("number", nargs="?", type=int, help="pull request number on this repo")
    p.add_argument("--file", help="check this text instead of fetching the PR")
    sub.add_parser("fetch-remote", help="import the notes that remote seats wrote to the git repos")
    p = sub.add_parser("kitten", help="one small ASCII kitten (the deck is called quantum-kittens)")
    p.add_argument("seat", nargs="?", help="a seat name, for its own kitten")
    p.add_argument("--all", dest="kitten_all", action="store_true", help="the whole team, one kitten each")
    p = sub.add_parser("cite-check", help="fail unless the PR cites the seat that wrote it (docs/CITATION.md)")
    p.add_argument("number", nargs="?", type=int, help="pull request number on this repo")
    p.add_argument("--file", help="check this text instead of fetching the PR")
    p.add_argument("--strict", action="store_true",
                   help="also require every changed file to be cited in the PR text")
    args = parser.parse_args()

    def me():
        seat = args.sender or find_agent()[0]
        if not seat:
            sys.exit("comms-deck: can't tell which seat you are; use --from <seat>")
        return seat_id(seat)

    try:
        if args.cmd == "send":
            text = " ".join(args.text)
            if text == "-":
                text = sys.stdin.read()
            record, warning = send(me(), args.to, text, args.quiet, args.private)
            print(f"sent to {record['to']}" + (" (private)" if record["private"] else ""))
            if warning:
                print(warning)
        elif args.cmd == "read":
            seat = me()
            notes = [r for _, r in pending(seat)] if args.peek else take(seat)
            print(render(notes, seat) if notes else "No notes waiting.")
        elif args.cmd == "note":
            add_note(me(), " ".join(args.text))
            print("added to the commentary")
        elif args.cmd == "status":
            print(json.dumps(status_json(), indent=1) if args.json else status_text())
        elif args.cmd == "usage":
            if args.seat:
                print("\n".join(telemetry_detail(None if args.seat == "all" else args.seat)))
            else:
                print(usage_report(max(1, args.days)))
        elif args.cmd == "watch":
            watch()
        elif args.cmd == "chat":
            try:
                chat(args.history, args.hide_private)
            except FreshCode:
                run_fresh()  # the screen has been restored; same window, new code
        elif args.cmd == "mail":
            try:
                mail()
            except FreshCode:
                run_fresh()  # the screen has been restored; same window, new code
        elif args.cmd == "serve":
            serve()
        elif args.cmd == "mcp":
            mcp()
        elif args.cmd == "mcp-call":
            mcp_call_once()
        elif args.cmd == "hook":
            try:
                hook(args.source, args.event)
            except Exception as error:  # a hook must never break the agent
                print(f"comms-deck hook: {error}", file=sys.stderr)
        elif args.cmd == "statusline":
            try:
                statusline(args.source)
            except Exception as error:  # a status line must never break the agent
                print(f"comms-deck: {error}")
        elif args.cmd == "settle":
            print(json.dumps({"screen_turns": list(SCREEN_TURNS), "changed": settle_seats([x.lower() for x in args.seats] or None)}))
        elif args.cmd == "install":
            install(args.yes)
        elif args.cmd == "fetch-remote":
            import_remote()
        elif args.cmd == "kitten":
            print(kitten((args.seat or "").lower(), args.kitten_all))
        elif args.cmd == "self-test":
            sys.exit(self_test())
        elif args.cmd == "wake":
            done, reason = wake_seat(args.seat.lower(), args.stale)
            print(json.dumps({"seat": args.seat.lower(), "woken": done, "reason": reason}))
            sys.exit(0 if done else 3)
        elif args.cmd == "spent":
            print(mark_spent(args.seat.lower(), " ".join(args.until), me()))
        elif args.cmd == "review-check":
            try:
                if args.file:
                    text = Path(args.file).read_text()
                elif args.number:
                    text = pr_review_text(args.number)
                else:
                    sys.exit("comms-deck: review-check needs a PR number or --file")
            except (OSError, RuntimeError, json.JSONDecodeError, subprocess.SubprocessError) as error:
                sys.exit(f"comms-deck: {error}")
            gap = review_gap(text)
            if gap:
                sys.exit(f"comms-deck: PR #{args.number or args.file}: {gap}")
            others = [s for s in credited_seats(text, "Reviewed")
                      if s not in credited_seats(text, "Written")]
            print("ok: reviewed by " + ", ".join(others))
        elif args.cmd == "cite-check":
            # What it checks is the PR's *text* (rule 4, docs/CITATION.md);
            # commits' Co-Authored-By trailers are CI's job, not this verb's.
            if args.strict and not args.number:
                sys.exit("comms-deck: cite-check --strict needs a PR number to diff its files")
            try:
                if args.file:
                    text = Path(args.file).read_text()
                elif args.number:
                    text = pr_review_text(args.number)
                else:
                    sys.exit("comms-deck: cite-check needs a PR number or --file")
                gap = cite_gap(text, args.number if args.strict else None)  # may raise: gh fecthes the file list
            except (OSError, RuntimeError, json.JSONDecodeError, subprocess.SubprocessError) as error:
                sys.exit(f"comms-deck: {error}")
            if gap:
                who = f"PR #{args.number}" if args.number else f"file {args.file}"
                sys.exit(f"comms-deck: {who}: {gap}")
            print("ok: cited by " + ", ".join(credited_seats(text, "Written"))
                  + (" (strict: every file cited)" if args.strict else ""))
    except ValueError as error:
        sys.exit(f"comms-deck: {error}")
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
