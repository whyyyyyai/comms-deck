#!/usr/bin/env python3
"""net-watch: tick away checking the internet; if it's down, try to reconnect.

  net-watch              run forever (normally as net-watch.service)
  net-watch --once       check once, try to reconnect if down, exit

What it does each tick (every TICK seconds):
  1. Ask NetworkManager's connectivity check; fall back to pinging 1.1.1.1.
  2. If the link is down, walk a recovery ladder: rescan Wi-Fi, reconnect
     the active connection, toggle NetworkManager's networking off and on.
  3. Log every transition and every attempt to the journal
     (`journalctl --user -u net-watch -f`).
  4. Tell the owner once when it drops, and every REMIND seconds while it
     stays down, so a long outage doesn't go unnoticed.

Written by: devin (Y, t82, 2026-11-28)
"""

import shutil
import subprocess
import sys
import time
from pathlib import Path

TICK = 30          # seconds between checks
REMIND = 15 * 60   # re-tell the owner this often while still down
PING_HOST = "1.1.1.1"
DECK = Path.home() / ".local/bin/comms-deck"


def sh(args, timeout=15):
    try:
        r = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
        return r.returncode, (r.stdout or "") + (r.stderr or "")
    except (OSError, subprocess.TimeoutExpired) as e:
        return 1, str(e)


def nmcli(*args, timeout=15):
    return sh(["nmcli", *args], timeout=timeout)


def connectivity():
    """'up', 'down', or 'unknown' (can't tell - treat as up, don't flap)."""
    if shutil.which("nmcli"):
        rc, out = nmcli("networking", "connectivity", timeout=10)
        state = out.strip().splitlines()[-1].strip() if out.strip() else ""
        if rc == 0 and state in ("full", "limited"):
            return "up"
        if rc == 0 and state == "none":
            return "down"
        # 'unknown' or a failed check: fall through to ping.
    if shutil.which("ping"):
        rc, _ = sh(["ping", "-c1", "-W3", PING_HOST], timeout=8)
        return "up" if rc == 0 else "down"
    return "unknown"


def wifi_device():
    rc, out = nmcli("-t", "-f", "DEVICE,TYPE", "device", "status")
    if rc != 0:
        return None
    for line in out.splitlines():
        parts = line.split(":")
        if len(parts) >= 2 and parts[1] in ("wifi", "wifi-p2p") and "connected" not in line:
            continue
        if len(parts) >= 2 and parts[1] == "wifi":
            return parts[0]
    return None


def recover(step_no):
    """One rung of the reconnect ladder. Returns a description of what ran."""
    dev = wifi_device()
    if step_no == 0:
        if dev:
            nmcli("device", "wifi", "rescan", dev, timeout=20)
            return f"wifi rescan on {dev}"
        return "no wifi device; skipped rescan"
    if step_no == 1:
        # Bring up whatever connection is marked active, else the wifi one.
        rc, out = nmcli("-t", "-f", "NAME,TYPE", "connection", "show", "--active")
        names = [l.split(":")[0] for l in out.splitlines() if l.strip()]
        for name in names:
            if name and name != "lo":
                nmcli("connection", "up", name, timeout=30)
                return f"connection up {name!r}"
        if dev:
            nmcli("device", "connect", dev, timeout=30)
            return f"device connect {dev}"
        return "no saved connection to bring up"
    if step_no == 2:
        nmcli("networking", "off", timeout=10)
        time.sleep(3)
        nmcli("networking", "on", timeout=10)
        return "networking off/on"
    return "ladder exhausted this tick"


def tell_owner(text):
    if DECK.exists():
        sh([str(DECK), "--from", "deck", "send", "owner", text, "--quiet"], timeout=15)


def tick(state):
    """One check. state carries {down_since, last_remind, step}."""
    status = connectivity()
    now = time.time()
    if status == "up":
        if state["down_since"]:
            print(f"{time.strftime('%F %T')} back online "
                  f"(was down {int(now - state['down_since'])}s)", flush=True)
            tell_owner(f"net-watch: back online after {int(now - state['down_since'])}s.")
        state.update(down_since=0.0, last_remind=0.0, step=0)
        return
    if status == "unknown":
        return  # can't tell; don't flap on a broken probe
    if not state["down_since"]:
        state["down_since"] = now
        state["step"] = 0
        print(f"{time.strftime('%F %T')} connectivity check says DOWN; trying to reconnect", flush=True)
        tell_owner("net-watch: the internet looks down; trying to reconnect.")
    # Walk the ladder, one rung per tick, then loop back to the top.
    what = recover(state["step"])
    state["step"] = (state["step"] + 1) % 3
    print(f"{time.strftime('%F %T')} still down; {what}", flush=True)
    if now - state["last_remind"] > REMIND:
        state["last_remind"] = now
        tell_owner("net-watch: still offline, still trying.")


def main():
    once = "--once" in sys.argv
    state = {"down_since": 0.0, "last_remind": 0.0, "step": 0}
    while True:
        tick(state)
        if once:
            return
        time.sleep(TICK)


if __name__ == "__main__":
    main()
