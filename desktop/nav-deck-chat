#!/bin/sh
# Open the nav-deck in its own kitty window: fullscreen on the nav deck
# (workspace 2; the desk's default_name becomes "nav" once claude flips it,
# Command+1 either way).
# One copy per view. It reads the deck's public surfaces only; see the
# nav-deck docstring for what the screen shows.
#   nav-deck-chat        fullscreen on the nav deck
#   nav-deck-chat half   tiled on the nav deck, half the screen
# Written by: vibe (2026-11-26)
# The full view runs the Rust deck (deck/, the owner liked it 2026-11-26) when it has
# been built; otherwise, or with NAV_DECK_PYTHON=1, the Python nav-deck as before.
# The half view runs the Rust deck's two-column layout (--half) when built,
# the Python nav-deck otherwise. Same escape hatch: NAV_DECK_PYTHON=1.
# Nothing builds deck for you: after a pull, cd deck && cargo build --release
# (launch.sh does it, from launch-codes PR #4).
view=${1:-full}
case "$view" in
    full)  class=nav-deck;      font=13; pad=14 ;;
    half)  class=nav-deck-half; font=12; pad=10 ;;
    *) echo "usage: nav-deck-chat [full|half]" >&2; exit 2 ;;
esac
hyprctl clients -j | grep -q "\"class\": \"$class\"" && exit 0
cd "$HOME" || exit 1
prog="$HOME/.local/bin/nav-deck"
rust="$(dirname "$(readlink -f "$0")")/../deck/target/release/deck"
if [ -z "$NAV_DECK_PYTHON" ] && [ -x "$rust" ]; then
    case "$view" in
        full) prog="$rust --view nav" ;;
        half) prog="$rust --view nav --half" ;;
    esac
fi
kitty --class "$class" --title "nav-deck ($view)" \
    -o font_size=$font -o window_padding_width=$pad -o confirm_os_window_close=0 \
    $prog &
for _ in $(seq 1 40); do
    addr=$(hyprctl clients -j | python3 -c "import json,sys; print(next((c['address'] for c in json.load(sys.stdin) if c['class'] == '$class'), ''))" 2>/dev/null)
    [ -n "$addr" ] && break
    sleep 0.25
done
[ -n "$addr" ] || exit 0
w="window = \"address:$addr\""
if [ "$view" = full ]; then
    sleep 0.5
    hyprctl dispatch "hl.dsp.window.move({ $w, workspace = 2, follow = false })" >/dev/null
    hyprctl clients -j | grep "\"class\": \"$class\"" >/dev/null \
        && hyprctl dispatch "hl.dsp.window.fullscreen({ $w, action = \"set\" })" >/dev/null
# action = "set": the browser window rule already opens it fullscreen, and a
# bare fullscreen here would toggle it straight off again.
else
    hyprctl dispatch "hl.dsp.window.move({ $w, workspace = 2, follow = false })" >/dev/null
fi
wait
