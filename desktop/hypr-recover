#!/usr/bin/env python3
"""hypr-recover: put the desktop back after Hyprland crashes. No AI.

When Hyprland crashes, start-hyprland restarts it with --safe-mode. That
session does not load ~/.config/hypr/hyprland.lua. It writes a stock
config, recoverycfg.lua, into its runtime folder
($XDG_RUNTIME_DIR/hypr/<instance>/) and loads that instead. The stock
config says `autogenerated = true`, so Hyprland shows a warning, and none
of the autostart runs: no waybar, no dock, no deck windows. The user
services also keep the old instance's HYPRLAND_INSTANCE_SIGNATURE, so
scratchpad-keeper talks to a socket that is gone.

This does what was done by hand after the 2026-11-26 crash:

  1. Replaces recoverycfg.lua with a link to ~/.config/hypr/hyprland.lua.
     The swap is atomic (link under a temp name, then rename), so
     Hyprland never sees the file missing. Deleting it first made Hyprland
     show "Cannot open .../recoverycfg.lua".
  2. Runs `hyprctl reload`, so the session runs on the real config.
  3. Starts the programs in the config's hl.on("hyprland.start") block
     that aren't running (waybar, the dock, cliphist). A reload doesn't
     fire hyprland.start, so they would stay off otherwise.
  4. Gives the user services the new instance signature and restarts
     scratchpad-keeper.
  5. Runs launch-desktop, which opens the deck windows that are missing.
  6. Tells STOX on the comms-deck.

A recoverycfg.lua that is already a link has been handled, so running
this again changes nothing.

    hypr-recover              check once and recover any safe-mode session
    hypr-recover --watch      check every 5 seconds (hypr-recover.service)
    hypr-recover --dry-run    say what it would do, change nothing
    hypr-recover --self-test  check the parsing and the swap in a temp folder

Written by: Claude (2026-11-26)
"""
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

HOME = Path.home()
RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))
USER_CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "hypr" / "hyprland.lua"
RECOVERY_NAME = "recoverycfg.lua"
LAUNCHERS = [HOME / "quantum-kittens/launcher/launch-desktop"]
KEEPER = "scratchpad-keeper.service"
INTERVAL = 5


def log(msg):
    print(f"hypr-recover: {msg}", flush=True)


def pending(runtime=RUNTIME):
    """Instances whose recoverycfg.lua is still Hyprland's stock file."""
    out = []
    for f in sorted((runtime / "hypr").glob(f"*/{RECOVERY_NAME}")):
        if f.is_symlink() or not f.is_file():
            continue
        if not (f.parent / ".socket.sock").exists():
            continue  # a dead instance's leftovers
        out.append(f)
    return out


def autostart_commands(config_text):
    """The hl.exec_cmd("...") lines inside hl.on("hyprland.start", ...).

    Only double-quoted commands are taken. The first-login welcome screen
    uses a [[...]] string, so it is skipped on purpose. The block ends at
    the first "end)" at the start of a line, as in hyprland.lua; anything
    nested inside it is indented, so it doesn't end the block early.
    """
    m = re.search(r'hl\.on\(\s*"hyprland\.start"(.*?)\nend\)', config_text, re.S)
    if not m:
        return []
    cmds = []
    for line in m.group(1).splitlines():
        if line.lstrip().startswith("--"):
            continue
        c = re.search(r'hl\.exec_cmd\("((?:[^"\\]|\\.)*)"\)', line)
        if c:
            cmds.append(c.group(1))
    return cmds


def swap_in_link(recovery, target):
    """Make recovery a link to target, with no moment where it is missing."""
    tmp = recovery.with_name(f".{recovery.name}.{os.getpid()}")
    if tmp.is_symlink() or tmp.exists():
        tmp.unlink()
    tmp.symlink_to(target)
    os.replace(tmp, recovery)


def same_command(cmd, argv):
    """True if argv runs cmd: same arguments, program matched by its name,
    so /usr/bin/waybar counts as waybar (systemd-run starts it that way)."""
    try:
        want = shlex.split(cmd)
    except ValueError:  # unbalanced quotes; compare it as one word
        want = [cmd]
    return (len(argv) == len(want) and bool(want)
            and os.path.basename(argv[0]) == os.path.basename(want[0])
            and argv[1:] == want[1:])


def running(cmd, proc=Path("/proc")):
    for d in proc.glob("[0-9]*"):
        try:
            raw = (d / "cmdline").read_bytes()
        except OSError:
            continue
        if raw and same_command(cmd, raw.rstrip(b"\0").decode(errors="replace").split("\0")):
            return True
    return False


def hyprctl(sig, *args):
    return subprocess.run(["hyprctl", "-i", sig, *args],
                          capture_output=True, text=True)


def recover(recovery, dry):
    sig = recovery.parent.name
    log(f"Hyprland {sig} is in safe mode on {recovery}")
    if not USER_CONFIG.is_file():
        log(f"no {USER_CONFIG}; leaving the stock config")
        return
    if dry:
        log(f"would link {recovery} -> {USER_CONFIG} and reload")
    else:
        swap_in_link(recovery, USER_CONFIG)
        r = hyprctl(sig, "reload")
        log(f"linked the real config and reloaded: {r.stdout.strip() or r.stderr.strip()}")
        time.sleep(1)
        errs = hyprctl(sig, "configerrors").stdout.strip()
        if errs:
            log(f"config errors after reload: {errs}")

    for cmd in autostart_commands(USER_CONFIG.read_text()):
        if running(cmd):
            continue
        if dry:
            log(f"would start: {cmd}")
            continue
        # Hyprland starts it, so it gets the session's own environment.
        hyprctl(sig, "eval", f"hl.exec_cmd({lua_string(cmd)})")
        log(f"started: {cmd}")

    if dry:
        log(f"would set HYPRLAND_INSTANCE_SIGNATURE={sig} and restart {KEEPER}")
    else:
        subprocess.run(["systemctl", "--user", "set-environment",
                        f"HYPRLAND_INSTANCE_SIGNATURE={sig}"])
        if subprocess.run(["systemctl", "--user", "is-enabled", "--quiet", KEEPER]).returncode == 0:
            subprocess.run(["systemctl", "--user", "restart", KEEPER])
            log(f"restarted {KEEPER} on the new instance")

    env = dict(os.environ, HYPRLAND_INSTANCE_SIGNATURE=sig)
    for launcher in LAUNCHERS:
        if os.access(launcher, os.X_OK):
            if dry:
                log(f"would run {launcher}")
            else:
                subprocess.run([str(launcher)], env=env)
            break

    if not dry and shutil.which("comms-deck"):
        subprocess.run(["comms-deck", "--from", "hypr-recover", "send", "owner",
                        "STOX, Hyprland crashed and came back in safe mode. "
                        "hypr-recover has put your config back, started the "
                        "taskbar and dock, and reopened the deck windows. "
                        "No agent was needed."], capture_output=True)


def lua_string(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


def check_once(dry):
    for f in pending():
        try:
            recover(f, dry)
        except Exception as e:  # keep watching; say what failed
            log(f"recovery of {f} failed: {e!r}")


def self_test():
    sample = '''
hl.on("hyprland.start", function ()
    hl.exec_cmd("waybar")
    hl.exec_cmd("nwg-dock-hyprland -d") -- auto-hide
    -- hl.exec_cmd("commented-out")
    hl.exec_cmd([[welcome-screen]])
end)
hl.exec_cmd("outside-the-block")
'''
    got = autostart_commands(sample)
    assert got == ["waybar", "nwg-dock-hyprland -d"], got
    assert same_command("waybar", ["/usr/bin/waybar"])
    assert same_command("nwg-dock-hyprland -d", ["/usr/bin/nwg-dock-hyprland", "-d"])
    assert not same_command("nwg-dock-hyprland -d", ["/usr/bin/nwg-dock-hyprland"])
    text = "wl-paste --type text --watch cliphist store"
    image = "wl-paste --type image --watch cliphist store"
    assert same_command(text, ["/usr/bin/wl-paste", "--type", "text", "--watch", "cliphist", "store"])
    assert not same_command(image, ["/usr/bin/wl-paste", "--type", "text", "--watch", "cliphist", "store"])
    assert not same_command("bar", ["/usr/bin/waybar"])
    assert not same_command("say it's", ["/usr/bin/say", "it's"])  # no crash
    with tempfile.TemporaryDirectory() as fake:
        (Path(fake) / "42").mkdir()
        (Path(fake) / "42" / "cmdline").write_bytes(b"/usr/bin/nwg-dock-hyprland\0-d\0")
        assert running("nwg-dock-hyprland -d", Path(fake))
        assert not running("waybar", Path(fake))
    assert lua_string('a "b" \\c') == '"a \\"b\\" \\\\c"'

    with tempfile.TemporaryDirectory() as d:
        d = Path(d)
        inst = d / "hypr" / "sig1"
        inst.mkdir(parents=True)
        (inst / ".socket.sock").touch()
        (inst / RECOVERY_NAME).write_text("stock")
        dead = d / "hypr" / "sig0"
        dead.mkdir()
        (dead / RECOVERY_NAME).write_text("stock")  # no socket: ignored
        target = d / "hyprland.lua"
        target.write_text("real")
        assert pending(d) == [inst / RECOVERY_NAME]
        swap_in_link(inst / RECOVERY_NAME, target)
        assert (inst / RECOVERY_NAME).is_symlink()
        assert (inst / RECOVERY_NAME).read_text() == "real"
        assert pending(d) == []  # done once, so a rerun changes nothing
        assert sorted(p.name for p in inst.iterdir()) == [".socket.sock", RECOVERY_NAME]
    print("hypr-recover self-test: ok")


def main(argv):
    if "--self-test" in argv:
        self_test()
        return
    dry = "--dry-run" in argv
    if "--watch" in argv:
        log(f"watching {RUNTIME / 'hypr'} every {INTERVAL}s")
        while True:
            check_once(dry)
            time.sleep(INTERVAL)
    check_once(dry)


if __name__ == "__main__":
    main(sys.argv[1:])
