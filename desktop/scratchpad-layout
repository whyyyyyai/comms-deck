#!/usr/bin/env python3
"""scratchpad-layout: each agent on its own desktop, the warp core on the scratchpad.

    Super+`  comms   the terminal chat, fullscreen
    Super+1  claude      Super+5  gravity
    Super+2  grok        Super+6  lumo
    Super+3  vibe        Super+7  alice (Grok Bot)
    Super+4  devin       Super+8  nav deck    Super+9  mail
    Super+S  the warp core, fullscreen on the scratchpad (special:magic)

(Y, 2026-11-27: "agents on their own displays, Super-1 -2 -3 ..., and put
the warp core on the scratchpad". Until then the agents shared one grid on
the scratchpad.)

Finds each agent's window by what runs in it (the kitty holding `claude`,
`grok`, `vibe-rs`, `devin` or `agy`) or by its app (Lumo, Grok Bot), and
moves it, tiled, to its desktop without switching you there. Every window
of an agent goes there (two Claude sessions share Claude's desktop). Windows
that aren't open are skipped; a window already in place is left alone, so
running it again changes nothing.

The warp core (class warp-core) is kept fullscreen on the scratchpad, and
the full chat view (class comms-deck-chat) fullscreen on comms: Hyprland
takes a window out of fullscreen when another opens on its workspace, and
this puts it back.

    scratchpad-layout           arrange once (everything, hand moves included)
    scratchpad-layout --watch   keep it arranged: at login, and whenever a
                                window opens, closes, changes workspace or
                                floating. Also opens the full chat view if it
                                isn't open. Run by scratchpad-keeper.service.
    scratchpad-layout --self-test
                                check the plan; does not move windows.

After its first pass, --watch places only windows it hasn't placed before,
so an agent window you move to another desktop by hand stays there. Run
scratchpad-layout (no flag) to put everything back.

Written by: Claude (2026-11-24)
Written by: Alice (2026-11-25)
Written by: Claude (2026-11-27, desktops per agent)
"""
import json
import subprocess
from pathlib import Path

WORKSPACE = "special:magic"    # the scratchpad (Super+S): the warp core's
# Desktops are numbered workspaces carrying names (default_name in
# hyprland.lua), so the bar sorts them by number and shows the name.
# Super+1..9,0 reach workspaces 2..11; comms (1) is on Super+`.
DESKS = {"comms": 1, "claude": 2, "grok": 3, "vibe": 4, "devin": 5, "gravity": 6,
         "lumo": 7, "alice": 8, "nav": 9, "mail": 10, "0": 11}
CHAT_WORKSPACE = "comms"       # comms-deck's own desktop, Super+`

# (label, desktop, how to find its windows): ("run", program) is a kitty
# running that program; ("app", class) is an app window.
AGENT_DESKS = [
    ("Claude", "claude", ("run", "claude")),
    ("Grok", "grok", ("run", "grok")),
    ("Vibe", "vibe", ("run", "vibe-rs")),
    ("Devin", "devin", ("run", "devin")),
    ("Gravity", "gravity", ("run", "agy")),
    ("Lumo", "lumo", ("app", "lumo-desktop")),
    ("Alice", "alice", ("app", "grok-bot")),
]


def ws_target(name):
    """The Lua value for a move to desktop `name`: its number for a deck,
    the quoted name otherwise (special workspaces)."""
    return str(DESKS[name]) if name in DESKS else f'"{name}"'


def hypr(*args):
    return subprocess.run(["hyprctl", *args], capture_output=True, text=True, check=True).stdout


def dispatch(expr):
    out = hypr("dispatch", expr).strip()
    if out != "ok":
        raise SystemExit(f"hyprctl refused {expr}: {out}")


def proc_tree():
    """{pid: (parent pid, name)} for every process."""
    tree = {}
    for d in Path("/proc").iterdir():
        if d.name.isdigit():
            try:
                stat = (d / "stat").read_text()
                name = (d / "comm").read_text().strip()
                tree[int(d.name)] = (int(stat.rsplit(")", 1)[1].split()[1]), name)
            except (OSError, ValueError, IndexError):
                pass
    return tree


def windows_holding(clients, tree, program):
    """Every kitty window whose process tree contains `program`."""
    kitties = {c["pid"]: c for c in clients if c["class"] == "kitty"}
    found = []
    for pid, (_, name) in tree.items():
        if name != program:
            continue
        p = pid
        while p > 1:
            if p in kitties:
                if kitties[p] not in found:
                    found.append(kitties[p])
                break
            p = tree.get(p, (0, ""))[0]
    return found


def window_holding(clients, tree, program):
    """The first kitty window whose process tree contains `program`, or None."""
    found = windows_holding(clients, tree, program)
    return found[0] if found else None


def plan_desks(clients, tree):
    """[(label, window, desk)] for every agent window that is open."""
    plan = []
    for label, desk, (kind, what) in AGENT_DESKS:
        wins = (windows_holding(clients, tree, what) if kind == "run"
                else [c for c in clients if c["class"] == what])
        plan += [(label, w, desk) for w in wins]
    return plan


def keep_fullscreen_on(clients, cls, workspace):
    """Keep every window of class `cls` fullscreen on `workspace`.

    Hyprland drops a fullscreen window out of fullscreen when another window
    opens on its workspace; this puts it back. action "set" does nothing to a
    window that's already fullscreen, so it can't toggle it off.
    """
    changed = 0
    for c in clients:
        if c["class"] != cls:
            continue
        addr = f'window = "address:{c["address"]}"'
        if c["workspace"]["name"] != workspace:
            dispatch(f'hl.dsp.window.move({{ {addr}, workspace = {ws_target(workspace)}, follow = false }})')
            changed += 1
        if c["fullscreen"] != 2:
            dispatch(f'hl.dsp.window.fullscreen({{ {addr}, action = "set" }})')
            changed += 1
    return changed


def keep_chat_fullscreen(clients):
    """The full chat view stays fullscreen on its own desktop, comms (Super+`)."""
    return keep_fullscreen_on(clients, "comms-deck-chat", CHAT_WORKSPACE)


def keep_warp_core(clients):
    """The warp core stays fullscreen on the scratchpad (Super+S)."""
    return keep_fullscreen_on(clients, "warp-core", WORKSPACE)


PLACED = set()  # addresses of agent windows placed once already


def arrange(quiet=False, keep_hand_moves=False):
    """Put every agent window on its desktop. Returns how many were changed.

    With keep_hand_moves, a window placed once already is left wherever it
    is now: only windows that have just opened are placed.
    """
    clients = json.loads(hypr("clients", "-j"))
    tree = proc_tree()
    changed = keep_chat_fullscreen(clients) + keep_warp_core(clients)
    for label, win, desk in plan_desks(clients, tree):
        if keep_hand_moves and win["address"] in PLACED:
            continue
        PLACED.add(win["address"])
        on_desk = win["workspace"]["name"] == desk or win["workspace"].get("id") == DESKS[desk]
        if on_desk and not win["floating"]:
            continue
        addr = f'window = "address:{win["address"]}"'
        if not on_desk:
            dispatch(f'hl.dsp.window.move({{ {addr}, workspace = {ws_target(desk)}, follow = false }})')
        if win["floating"]:
            dispatch(f'hl.dsp.window.float({{ action = "disable", {addr} }})')  # tiled on its desktop
        changed += 1
        if not quiet:
            print(f"{label:8} to {desk} (Super+{(DESKS[desk] - 1) % 10})")
    return changed


WATCH_EVENTS = {"openwindow", "closewindow", "movewindow", "movewindowv2", "changefloatingmode", "fullscreen"}


def connect_event_socket():
    """Connect to the first event socket that answers, and use that instance.

    After a Hyprland crash the old instance's socket file is left behind but
    refuses connections, and HYPRLAND_INSTANCE_SIGNATURE (from the user
    services' environment) still names it. So try each candidate, and point
    HYPRLAND_INSTANCE_SIGNATURE (used by hyprctl) at the one that answers.
    """
    import os
    import socket
    runtime = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")) / "hypr"
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    candidates = [runtime / sig / ".socket2.sock"] if sig else []
    candidates += sorted(runtime.glob("*/.socket2.sock"), key=lambda p: p.stat().st_mtime, reverse=True)
    last = FileNotFoundError("no Hyprland event socket")
    for path in candidates:
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            sock.connect(str(path))
        except OSError as error:
            sock.close()
            last = error
            continue
        if path.parent.name != sig:
            os.environ["HYPRLAND_INSTANCE_SIGNATURE"] = path.parent.name
            print(f"now on Hyprland instance {path.parent.name}", flush=True)
        return sock, path
    raise last


def open_chat_views():
    """Start the full chat view if it isn't open. The launcher itself skips it if it is."""
    launcher = Path(__file__).resolve().parent / "comms-deck-chat"
    for view in ("full",):  # fullscreen on the comms desktop (Super+`); "half" stays on workspace 1
        subprocess.Popen([str(launcher), view], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


REOPEN_EVERY = 30  # seconds: at most one reopen this often, so a chat that dies at start can't loop


def chat_missing(clients):
    """True when no full chat view (class comms-deck-chat) is open."""
    return not any(c.get("class") == "comms-deck-chat" for c in clients)


def reopen_chat_if_closed(last, now=None):
    """Open the full chat again if it has closed. Returns the time of the last reopen.

    The chat is STOX's only window onto the deck. On 2026-11-26 it closed
    twice and stayed closed until someone noticed. The launcher itself does
    nothing if the window is open, so a reopen that races another one is
    harmless.
    """
    import json
    import time
    now = time.time() if now is None else now
    if now - last < REOPEN_EVERY:
        return last
    try:
        clients = json.loads(hypr("clients", "-j"))
    except (OSError, subprocess.SubprocessError, ValueError):
        return last
    if not chat_missing(clients):
        return last
    print("the chat is closed; reopening it", flush=True)
    open_chat_views()
    return now


def _stamp(path):
    """(mtime, size) of a file, or None."""
    try:
        st = path.stat()
        return (st.st_mtime_ns, st.st_size)
    except OSError:
        return None


def restart_if_changed(started, since):
    """Start this script again in place once its file has changed, settled and compiles.

    After a merge into the live tree the keeper would otherwise keep the old
    layout until someone restarted it. `started` is the file's stamp at start;
    `since` holds the newest stamp seen and when it was first seen.
    """
    import os
    import sys
    import time
    me = Path(__file__).resolve()
    now = _stamp(me)
    if now is None or now == started:
        return
    if now != since.get("stamp"):
        since.update(stamp=now, at=time.time())
        return
    if time.time() - since["at"] < 3:
        return
    try:
        compile(me.read_text(), str(me), "exec")
    except (OSError, SyntaxError, ValueError):
        return
    print("scratchpad-layout changed on disk; restarting on the new code", flush=True)
    os.execve(sys.executable, [sys.executable, str(me), *sys.argv[1:]],
              dict(os.environ, SCRATCHPAD_KEEPER_RESTARTED="1"))  # keep hand moves after it


def watch():
    """Arrange now, then again a moment after each window open, close or move. Runs forever."""
    import os
    import select
    import socket
    import time
    started, since = _stamp(Path(__file__).resolve()), {}
    open_chat_views()
    reopened = time.time()  # just opened above
    while True:
        try:
            sock, path = connect_event_socket()
        except OSError as error:
            print(f"waiting for Hyprland: {error}", flush=True)
            time.sleep(5)
            continue
        print(f"watching {path}", flush=True)
        buffer, due = b"", time.time() + 2  # first pass shortly after start, once windows exist
        # The first pass arranges everything; later ones keep hand moves. After
        # restarting on new code, even the first pass keeps them.
        first = not os.environ.get("SCRATCHPAD_KEEPER_RESTARTED")
        with sock:
            while True:
                restart_if_changed(started, since)
                timeout = min(max(0.0, due - time.time()), 5.0) if due else 5.0
                if select.select([sock], [], [], timeout)[0]:
                    data = sock.recv(65536)
                    if not data:
                        break  # Hyprland went away; reconnect
                    buffer += data
                    *lines, buffer = buffer.split(b"\n")
                    if any(line.split(b">>", 1)[0].decode(errors="replace") in WATCH_EVENTS for line in lines):
                        due = time.time() + 0.8  # let a burst of events settle first
                elif due:
                    due = None
                    try:
                        n = arrange(quiet=True, keep_hand_moves=not first)
                        first = False
                        if n:
                            print(f"rearranged {n} window(s)", flush=True)
                        reopened = reopen_chat_if_closed(reopened)
                    except (OSError, subprocess.SubprocessError, SystemExit, StopIteration, ValueError) as error:
                        print(f"arrange failed: {error}", flush=True)


def _fake_win(address, cls, pid, ws="x", floating=False):
    return {"address": address, "class": cls, "pid": pid, "workspace": {"name": ws},
            "floating": floating, "fullscreen": 0, "at": [0, 0], "size": [1, 1]}


def self_check():
    """Check the desktops and the plan. Does not talk to Hyprland or move windows."""
    assert ws_target("comms") == "1" and ws_target("claude") == "2"
    assert ws_target("alice") == "8" and ws_target("nav") == "9" and ws_target("mail") == "10"
    assert ws_target("0") == "11"
    assert ws_target("special:magic") == '"special:magic"'
    assert sorted(DESKS.values()) == list(range(1, 12))
    assert all(desk in DESKS for _, desk, _ in AGENT_DESKS)
    # Agents on Super+1..7, in Y's order.
    keys = [(DESKS[desk] - 1) % 10 for _, desk, _ in AGENT_DESKS]
    assert keys == [1, 2, 3, 4, 5, 6, 7], keys
    # The keeper reopens a closed chat, at most once per REOPEN_EVERY.
    assert chat_missing([{"class": "kitty"}, {"class": "comms-deck-chat-half"}])
    assert not chat_missing([{"class": "comms-deck-chat"}])
    assert reopen_chat_if_closed(100.0, now=110.0) == 100.0  # too soon: no query, no reopen
    # Each agent's windows go to its desktop; two Claude sessions both do.
    clients = [_fake_win("0x1", "kitty", 101), _fake_win("0x2", "kitty", 201),
               _fake_win("0x3", "kitty", 301), _fake_win("0x4", "grok-bot", 401),
               _fake_win("0x5", "firefox", 501), _fake_win("0x6", "warp-core", 601)]
    tree = {102: (101, "zsh"), 103: (102, "claude"), 202: (201, "claude"),
            302: (301, "vibe-rs"), 101: (1, "kitty"), 201: (1, "kitty"), 301: (1, "kitty")}
    plan = [(label, w["address"], desk) for label, w, desk in plan_desks(clients, tree)]
    assert sorted(plan) == sorted([("Claude", "0x1", "claude"), ("Claude", "0x2", "claude"),
                                   ("Vibe", "0x3", "vibe"), ("Alice", "0x4", "alice")]), plan
    assert window_holding(clients, tree, "grok") is None, "closed agents are skipped"
    print("desktops ok")


def main():
    import sys
    if "--watch" in sys.argv[1:]:
        watch()
    elif "--self-test" in sys.argv[1:]:
        self_check()
    else:
        arrange()


if __name__ == "__main__":
    main()
