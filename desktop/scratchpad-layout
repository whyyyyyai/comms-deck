#!/usr/bin/env python3
"""scratchpad-layout: arrange the agents on the scratchpad (Super+S).

    +-----------+-----------+-----------------------+
    |   Grok    | Grok Bot  |         Vibe          |
    +-----------+-----------+-----------+-----------+
    |        Claude         | Lumo, Gravity, Devin  |
    +-----------------------+-----------------------+

The bottom right is shared by whichever of Lumo, Gravity and Devin are
open, side by side in that order: one open window gets the whole cell.

Finds each window by what runs in it (the kitty holding `grok`, `claude`,
`agy` or `vibe-rs`, Mistral Vibe's program) or by its app (Grok Bot, Lumo), moves it to
special:magic without switching you there, floats it, and sets its size and
place. Windows that aren't open are skipped; a window already in place is
left alone, so running it again changes nothing.

    scratchpad-layout           arrange once
    scratchpad-layout --watch   keep it arranged: at login, and whenever a
                                window opens, closes, changes workspace or
                                floating. Also opens the chat views (full on
                                workspace 1) if it isn't open. The half and
                                small views are no longer opened here: the
                                full view covers workspace 1 (the owner,
                                2026-11-25), and the scratchpad has no room. Run by scratchpad-keeper.service.
    scratchpad-layout --self-test
                                check the cell maths; does not move windows.

After its first pass, --watch leaves a window that is already floating on
the scratchpad wherever it is, so a window you drag or resize by hand
stays put. It places only windows that open, come back to the scratchpad,
or stop floating. Run scratchpad-layout (no flag) to snap everything back.

The cells meet: the inner gap is 0 and the outer margin stays 22. Hyprland
still draws a 2px border, rounded corners and a shadow (general:border_size
2, decoration.rounding 10). noborder is gone in Hyprland 0.57, so this
script sets border_size 0, rounding 0 and no_shadow on the scratchpad
windows only, in the same pass that moves them. It does not change the
global Hyprland config.

Written by: Claude (2026-11-24)
Written by: Alice (2026-11-25)
"""
import json
import subprocess
from pathlib import Path

GAP_OUT, GAP_IN = 22, 0        # outer margin kept; cells meet
WORKSPACE = "special:magic"


def hypr(*args):
    return subprocess.run(["hyprctl", *args], capture_output=True, text=True, check=True).stdout


def dispatch(expr):
    out = hypr("dispatch", expr).strip()
    if out != "ok":
        raise SystemExit(f"hyprctl refused {expr}: {out}")


def set_window_prop(address, prop, value):
    """Set one Hyprland window property on this window only."""
    if isinstance(value, bool):
        # set_prop wants a string, not a Lua boolean (review by Devin on #58).
        lua_value = '"true"' if value else '"false"'
    elif isinstance(value, str):
        lua_value = '"' + value.replace("\\", "\\\\").replace('"', '\\"') + '"'
    else:
        lua_value = str(value)
    dispatch(
        f'hl.dsp.window.set_prop({{ window = "address:{address}", '
        f'prop = "{prop}", value = {lua_value} }})'
    )


def strip_cell_chrome(win):
    """Remove the border, rounding and shadow so neighbouring cells sit flush."""
    address = win["address"]
    set_window_prop(address, "border_size", 0)
    set_window_prop(address, "rounding", 0)
    set_window_prop(address, "no_shadow", True)


def proc_tree():
    """{pid: (parent pid, name)} for every process."""
    tree = {}
    for d in Path("/proc").iterdir():
        if d.name.isdigit():
            try:
                stat = (d / "stat").read_text()
                name = (d / "comm").read_text().strip()
                tree[int(d.name)] = (int(stat.rsplit(")", 1)[1].split()[1]), name)
            except (OSError, ValueError, IndexError):
                pass
    return tree


def window_holding(clients, tree, program):
    """The kitty window whose process tree contains `program`."""
    kitties = {c["pid"]: c for c in clients if c["class"] == "kitty"}
    for pid, (_, name) in tree.items():
        if name != program:
            continue
        p = pid
        while p > 1:
            if p in kitties:
                return kitties[p]
            p = tree.get(p, (0, ""))[0]
    return None


def plan_layout(mon, clients, tree):
    """[(label, window or None, x, y, w, h)] for the current monitor."""
    left, top, right, bottom = mon["reserved"]
    width = round(mon["width"] / mon["scale"]) - left - right - 2 * GAP_OUT
    height = round(mon["height"] / mon["scale"]) - top - bottom - 2 * GAP_OUT
    x0, y0 = mon["x"] + left + GAP_OUT, mon["y"] + top + GAP_OUT
    half_w = (width - GAP_IN) // 2
    half_h = (height - GAP_IN) // 2
    quarter_w = (half_w - GAP_IN) // 2
    lower_y, lower_h = y0 + half_h + GAP_IN, height - half_h - GAP_IN
    right_x, right_w = x0 + half_w + GAP_IN, width - half_w - GAP_IN
    by_class = lambda cls: next((c for c in clients if c["class"] == cls), None)
    shared = [("Lumo", by_class("lumo-desktop")), ("Gravity", window_holding(clients, tree, "agy")),
              ("Devin", window_holding(clients, tree, "devin"))]
    return [
        ("Grok", window_holding(clients, tree, "grok"), x0, y0, quarter_w, half_h),
        ("Grok Bot", by_class("grok-bot"), x0 + quarter_w + GAP_IN, y0, half_w - quarter_w - GAP_IN, half_h),
        ("Vibe", window_holding(clients, tree, "vibe-rs"), right_x, y0, right_w, half_h),
        ("Claude", window_holding(clients, tree, "claude"), x0, lower_y, half_w, lower_h),
    ] + share_row(shared, right_x, lower_y, right_w, lower_h)


def share_row(windows, x, y, w, h):
    """Split one cell side by side among the windows that are open.

    `windows` is [(label, window or None)]. Closed ones are listed with no
    place (so they're reported as skipped) and take no room.
    """
    open_ones = [(label, win) for label, win in windows if win]
    n = max(len(open_ones), 1)
    each = (w - GAP_IN * (n - 1)) // n
    plan = []
    for i, (label, win) in enumerate(open_ones):
        width = w - (each + GAP_IN) * (n - 1) if i == n - 1 else each  # the last takes the remainder
        plan.append((label, win, x + i * (each + GAP_IN), y, width, h))
    return plan + [(label, None, x, y, w, h) for label, win in windows if not win]


def arrange(quiet=False, keep_hand_moves=False):
    """Put every window in the plan where it belongs. Returns how many were changed.

    With keep_hand_moves, a window already floating on the scratchpad is left
    where it is, whatever its size and place: only a window that has just
    opened, or left the scratchpad, or stopped floating, is placed.
    """
    mon = next(m for m in json.loads(hypr("monitors", "-j")) if m["focused"])
    clients = json.loads(hypr("clients", "-j"))
    changed = 0
    for label, win, x, y, w, h in plan_layout(mon, clients, proc_tree()):
        if not win:
            if not quiet:
                print(f"skipped {label}: not open")
            continue
        strip_cell_chrome(win)  # even if the place is already right, or left by hand
        in_place = (win["workspace"]["name"] == WORKSPACE and win["floating"]
                    and abs(win["at"][0] - x) <= 2 and abs(win["at"][1] - y) <= 2
                    and abs(win["size"][0] - w) <= 8 and abs(win["size"][1] - h) <= 8)
        if in_place:  # (a few pixels of slack: some apps have a minimum size)
            continue
        if keep_hand_moves and win["workspace"]["name"] == WORKSPACE and win["floating"]:
            continue  # moved or resized by hand: leave it
        addr = f'window = "address:{win["address"]}"'
        if win["workspace"]["name"] != WORKSPACE:
            dispatch(f'hl.dsp.window.move({{ {addr}, workspace = "{WORKSPACE}", follow = false }})')
        if not win["floating"]:
            dispatch(f'hl.dsp.window.float({{ action = "enable", {addr} }})')
        dispatch(f"hl.dsp.window.resize({{ {addr}, x = {w}, y = {h} }})")
        dispatch(f"hl.dsp.window.move({{ {addr}, x = {x}, y = {y} }})")
        changed += 1
        if not quiet:
            print(f"{label:9} {w}x{h} at {x},{y}")
    return changed


WATCH_EVENTS = {"openwindow", "closewindow", "movewindow", "movewindowv2", "changefloatingmode"}


def event_socket():
    """Hyprland's event socket (socket2) for the running session."""
    import os
    runtime = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")) / "hypr"
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    candidates = [runtime / sig / ".socket2.sock"] if sig else []
    candidates += sorted(runtime.glob("*/.socket2.sock"), key=lambda p: p.stat().st_mtime, reverse=True)
    for path in candidates:
        if path.exists():
            return path
    raise FileNotFoundError("no Hyprland event socket")


def open_chat_views():
    """Start the full chat view if it isn't open. The launcher itself skips it if it is."""
    launcher = Path(__file__).resolve().parent / "comms-deck-chat"
    for view in ("full",):  # fullscreen on workspace 1 (the owner, 22:49); "half" sat on 1 too, under it
        subprocess.Popen([str(launcher), view], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def _stamp(path):
    """(mtime, size) of a file, or None."""
    try:
        st = path.stat()
        return (st.st_mtime_ns, st.st_size)
    except OSError:
        return None


def restart_if_changed(started, since):
    """Start this script again in place once its file has changed, settled and compiles.

    After a merge into the live tree the keeper would otherwise keep the old
    layout until someone restarted it. `started` is the file's stamp at start;
    `since` holds the newest stamp seen and when it was first seen.
    """
    import os
    import sys
    import time
    me = Path(__file__).resolve()
    now = _stamp(me)
    if now is None or now == started:
        return
    if now != since.get("stamp"):
        since.update(stamp=now, at=time.time())
        return
    if time.time() - since["at"] < 3:
        return
    try:
        compile(me.read_text(), str(me), "exec")
    except (OSError, SyntaxError, ValueError):
        return
    print("scratchpad-layout changed on disk; restarting on the new code", flush=True)
    os.execve(sys.executable, [sys.executable, str(me), *sys.argv[1:]],
              dict(os.environ, SCRATCHPAD_KEEPER_RESTARTED="1"))  # keep hand moves after it


def watch():
    """Arrange now, then again a moment after each window open, close or move. Runs forever."""
    import os
    import select
    import socket
    import time
    started, since = _stamp(Path(__file__).resolve()), {}
    open_chat_views()
    while True:
        try:
            sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            sock.connect(str(event_socket()))
        except OSError as error:
            print(f"waiting for Hyprland: {error}", flush=True)
            time.sleep(5)
            continue
        print(f"watching {event_socket()}", flush=True)
        buffer, due = b"", time.time() + 2  # first pass shortly after start, once windows exist
        # The first pass arranges everything; later ones keep hand moves. After
        # restarting on new code, even the first pass keeps them.
        first = not os.environ.get("SCRATCHPAD_KEEPER_RESTARTED")
        with sock:
            while True:
                restart_if_changed(started, since)
                timeout = min(max(0.0, due - time.time()), 5.0) if due else 5.0
                if select.select([sock], [], [], timeout)[0]:
                    data = sock.recv(65536)
                    if not data:
                        break  # Hyprland went away; reconnect
                    buffer += data
                    *lines, buffer = buffer.split(b"\n")
                    if any(line.split(b">>", 1)[0].decode(errors="replace") in WATCH_EVENTS for line in lines):
                        due = time.time() + 0.8  # let a burst of events settle first
                elif due:
                    due = None
                    try:
                        n = arrange(quiet=True, keep_hand_moves=not first)
                        first = False
                        if n:
                            print(f"rearranged {n} window(s)", flush=True)
                    except (OSError, subprocess.SubprocessError, SystemExit, StopIteration, ValueError) as error:
                        print(f"arrange failed: {error}", flush=True)


def _tiles(cells, x, y, w, h):
    """Raise if `cells` do not fill (x, y, w, h) exactly, with no overlap."""
    area = 0
    boxes = []
    for _label, _win, cx, cy, cw, ch in cells:
        if cw <= 0 or ch <= 0:
            raise AssertionError(f"empty cell {_label}: {cw}x{ch}")
        if not (cx >= x and cy >= y and cx + cw <= x + w and cy + ch <= y + h):
            raise AssertionError(f"{_label} {cx},{cy} {cw}x{ch} leaves {x},{y} {w}x{h}")
        for ox, oy, ow, oh in boxes:
            if not (cx + cw <= ox or ox + ow <= cx or cy + ch <= oy or oy + oh <= cy):
                raise AssertionError(f"{_label} overlaps {(ox, oy, ow, oh)}")
        boxes.append((cx, cy, cw, ch))
        area += cw * ch
    if area != w * h:
        raise AssertionError(f"area {area} != {w * h}")


def _fake_win(address, cls, pid):
    return {"address": address, "class": cls, "pid": pid,
            "workspace": {"name": "x"}, "floating": False, "at": [0, 0], "size": [1, 1]}


def _open_clients(shared_open):
    """Fake kitty/app windows so plan_layout can run without Hyprland."""
    clients = [
        _fake_win("0x1", "kitty", 101),
        _fake_win("0x2", "grok-bot", 201),
        _fake_win("0x3", "kitty", 301),
        _fake_win("0x4", "kitty", 401),
        _fake_win("0x5", "lumo-desktop", 501),
        _fake_win("0x6", "kitty", 601),
        _fake_win("0x7", "kitty", 701),
    ]
    programs = [("grok", 102), ("vibe-rs", 302), ("claude", 402)]
    if "Gravity" in shared_open:
        programs.append(("agy", 602))
    else:
        clients = [c for c in clients if c["pid"] != 601]
    if "Devin" in shared_open:
        programs.append(("devin", 702))
    else:
        clients = [c for c in clients if c["pid"] != 701]
    if "Lumo" not in shared_open:
        clients = [c for c in clients if c["class"] != "lumo-desktop"]
    tree = {}
    for name, pid in programs:
        tree[pid] = (pid - 1, name)
        tree[pid - 1] = (1, "kitty")
    return clients, tree


def self_check():
    """Check that the cells tile exactly. Does not talk to Hyprland or move windows."""
    if GAP_OUT != 22 or GAP_IN != 0:
        raise SystemExit(f"expected GAP_OUT 22 and GAP_IN 0, got {GAP_OUT}, {GAP_IN}")
    monitors = [
        {"reserved": [0, 0, 0, 0], "width": 1920, "height": 1080, "scale": 1, "x": 0, "y": 0},
        {"reserved": [0, 48, 0, 0], "width": 2560, "height": 1440, "scale": 1, "x": 0, "y": 0},
        {"reserved": [0, 0, 0, 0], "width": 1921, "height": 1081, "scale": 1, "x": 100, "y": 50},
        {"reserved": [10, 20, 30, 40], "width": 3840, "height": 2160, "scale": 2, "x": 0, "y": 0},
    ]
    shared_cases = [
        ("Lumo", "Gravity", "Devin"),
        ("Lumo", "Gravity"),
        ("Lumo", "Devin"),
        ("Gravity", "Devin"),
        ("Lumo",),
        ("Gravity",),
        ("Devin",),
        (),
    ]
    for mon in monitors:
        left, top, right, bottom = mon["reserved"]
        width = round(mon["width"] / mon["scale"]) - left - right - 2 * GAP_OUT
        height = round(mon["height"] / mon["scale"]) - top - bottom - 2 * GAP_OUT
        x0, y0 = mon["x"] + left + GAP_OUT, mon["y"] + top + GAP_OUT
        half_w = (width - GAP_IN) // 2
        half_h = (height - GAP_IN) // 2
        lower_y, lower_h = y0 + half_h + GAP_IN, height - half_h - GAP_IN
        right_x, right_w = x0 + half_w + GAP_IN, width - half_w - GAP_IN
        for shared in shared_cases:
            clients, tree = _open_clients(shared)
            plan = plan_layout(mon, clients, tree)
            by = {label: (x, y, w, h, win) for label, win, x, y, w, h in plan}
            top = [item for item in plan if item[0] in ("Grok", "Grok Bot", "Vibe") and item[1]]
            _tiles(top, x0, y0, width, half_h)
            claude = [item for item in plan if item[0] == "Claude" and item[1]]
            _tiles(claude, x0, lower_y, half_w, lower_h)
            vx, vy, vw, vh, vwin = by["Vibe"]
            if vwin is None or (vx, vy, vw, vh) != (right_x, y0, right_w, half_h):
                raise AssertionError(f"Vibe cell {by['Vibe']}")
            if by["Grok"][0] + by["Grok"][2] != by["Grok Bot"][0]:
                raise AssertionError("Grok and Grok Bot do not meet")
            if by["Grok Bot"][0] + by["Grok Bot"][2] != by["Vibe"][0]:
                raise AssertionError("Grok Bot and Vibe do not meet")
            if by["Grok"][1] + by["Grok"][3] + GAP_IN != by["Claude"][1]:
                raise AssertionError("top row and Claude do not meet")
            open_shared = [item for item in plan if item[0] in ("Lumo", "Gravity", "Devin") and item[1]]
            if open_shared:
                _tiles(open_shared, right_x, lower_y, right_w, lower_h)
                if open_shared[0][2] != right_x:
                    raise AssertionError("shared row does not start at the right column")
                last = open_shared[-1]
                if last[2] + last[4] != right_x + right_w:
                    raise AssertionError("shared row does not fill the right column")
                if any(item[3] != lower_y or item[5] != lower_h for item in open_shared):
                    raise AssertionError("shared row height is wrong")
            elif any(item[1] for item in plan if item[0] in ("Lumo", "Gravity", "Devin")):
                raise AssertionError("a closed shared seat was treated as open")
            # With no shared window open, the bottom-right cell is empty on purpose.
            present = [item for item in plan if item[1]]
            if open_shared:
                _tiles(present, x0, y0, width, height)
        for n in (1, 2, 3):
            wins = [(f"s{i}", {"i": i}) for i in range(n)] + [(f"closed{n}", None)]
            row = share_row(wins, right_x, lower_y, right_w, lower_h)
            open_row = [item for item in row if item[1]]
            if len(open_row) != n or len(row) != n + 1:
                raise AssertionError(f"share_row n={n} listed {row}")
            _tiles(open_row, right_x, lower_y, right_w, lower_h)
    print("layout tiles ok")


def main():
    import sys
    if "--watch" in sys.argv[1:]:
        watch()
    elif "--self-test" in sys.argv[1:]:
        self_check()
    else:
        arrange()


if __name__ == "__main__":
    main()
