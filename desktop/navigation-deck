def self_test():
    import tempfile

    now = time.time()
    status = make_fake_status(now)
    clients = [
        {"class": "comms-deck-chat", "fullscreen": True, "workspace": {"id": 1, "name": "comms"}},
        {"class": "kitty", "fullscreen": False, "workspace": {"id": 2147483645, "name": "special:magic"}},
        {"class": "navigation-deck", "fullscreen": False, "workspace": {"id": 2, "name": "navigation"}},
    ]
    workspaces = [{"id": 1, "name": "comms"}, {"id": 2, "name": "navigation"},
                  {"id": 2147483645, "name": "special:magic"}]
    info = {"MemTotal": 8 * 1024**3, "MemAvailable": 3 * 1024**3,
            "SwapTotal": 0, "SwapFree": 0}
    history = [(now - i * 5, (2.5 + (i % 11) / 12) * 1024**3) for i in range(40)]
    hours = {h: h * 3 for h in range(24)}
    busy = {"claude": 900.5, "grok": 120.0}

    for width, height in ((188, 52), (120, 40), (80, 30), (60, 24)):
        frame = build_frame(width, height, status, clients, workspaces,
                            hours, busy, history, 0, info, 1.25)
        assert len(frame) <= height, (width, height, len(frame))
        for line in frame:
            assert visible_len(line) <= width, (width, visible_len(line), line)
        text = "\n".join(ANSI.sub("", l) for l in frame)
        for needle in ("claude", "grok", "devin", "NAVIGATION-DECK", "special:magic"):
            assert needle in text, (needle, width)

    # the deck's ready order: by rank, not by name
    order = [n for n, _ in sorted(status["seats"].items(), key=lambda kv: kv[1]["rank"])]
    assert order == ["claude", "devin", "grok"], order
    seats_text = ANSI.sub("", "\n".join(seats_panel(status, 160)))
    assert "back 59m" in seats_text, seats_text  # spent countdown (1h minus a moment)

    # fit() keeps exact visible width, colours intact
    long_line = "word " * 30 + colour(78) + "tail" + "\033[0m"
    assert visible_len(fit(long_line, 40)) == 40

    # vitals maths: ~3 GiB free of 8, no swap, low-sample counter
    v = ANSI.sub("", "\n".join(vitals_panel(100, history, 1, info, 0.5)))
    assert "3.0 GiB free" in v and "swap  none" in v, v

    # the warp core: lights up, stays in its box, speeds with the deck's traffic
    HUD_STATE["stars"], HUD_STATE["last"] = [], None
    hud = hud_panel(42, 20, status, hours, info, 1.25)
