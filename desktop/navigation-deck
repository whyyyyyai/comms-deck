    slow = warp_factor(make_fake_status(now), {})
    fast = warp_factor(make_fake_status(now), {datetime.now().hour: 40, (datetime.now().hour - 1) % 24: 30}, 3.0)
    assert 1.0 <= slow < fast <= 9.9, (slow, fast)
    for _ in range(200):  # stars respawn forever and never leave the field
        HUD_STATE["last"] = None
        star_field(40, 14, 9.9)

    # the owner's sight: on a full-screen terminal the reticle sits on the
