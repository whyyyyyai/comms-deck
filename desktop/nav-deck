def cockpit_frame(width, height, status, clients, workspaces, hours, busy,
                  history, low, info, load, timing, records, now):
    """The wide dress: the comms-deck look, drawn with comms-deck's own
    frames. 01 CREW + 02 ACTIVITY on the left (the owner kept both), the
    warp core as 04 in the centre with 05 EVENT TAIL under it, usage and
    the instruments in the right column. The reticle sits on the screen's
    exact centre: the strip is 3 rows, 04's content starts 3 rows into its
    frame (border, head, blank), so the sight goes at rows//2 - 6."""
    frame = lambda *a, **k: CD.look_frame(*a, **k)
    tag = CD.look_tag
    esc = "\033["
    lw, cw, rw = CD.look_widths(width)
    body_h = height - 5                      # the strip (3), the keys, the ticker
    snap = CD.panel_scans()
    working = CD.busy_seats(snap)
    split = CD.context_split()
    warp = warp_factor(status, hours, load)
    now_t = time.time()                      # the framework speaks epoch

    # -- left: 01 CREW, 02 ACTIVITY (comms-deck's own builders)
    activity = CD.activity_panel(lw - 4)
    parts = CD.look_activity_parts(activity)
    crew_h = max(10, int(body_h * 0.45))     # chat's own share for 01
    room = body_h - crew_h - 4
    if len(parts["activity"]) > room:        # 02 sheds the ↳ lines, like the chat
        parts["activity"] = [l for l in parts["activity"]
                             if not CD.ANSI.sub("", l).lstrip().startswith("↳")][:max(room, 0)]
    left = CD.look_stack([
        (crew_h, lambda w, h: frame(
            "01", "CREW", "who talks to whom", tag(bool(working), f"{len(working)} WORKING"),
            CD.LOOK_ACCENT["crew"], w, h, CD.look_crew(w - 4, h - 4, records or [], snap, working, split, now_t))),
        (None, lambda w, h: frame(
            "02", "ACTIVITY", "ready order", tag(bool(working)), CD.LOOK_ACCENT["activity"], w, h,
            parts["activity"][:h - 4])),
    ], lw, body_h)

    # -- centre: 04 WARP CORE with 05 EVENT TAIL in the log bay under it
    tail_h = max(6, min(12, body_h // 5))
    tail_body = event_tail_panel(max(30, cw - 4), tail_h - 4, now, records)

    def warp_maker(w, h):
        field_h = max(3, h - 6)              # frame: border, head, blank, then canvas (field + 2 readouts)
        cy = max(0, height // 2 - 6)         # ⊕ on the screen's centre line (header 3 + frame 3)
        return frame("04", "WARP CORE", "the pilot's seat", f"WARP {warp:3.1f}",
                     81, w, h,
                     warp_canvas(w - 4, w - 4, field_h, status, hours, info, load, cy, split))

    def tail_maker(w, h):
        return frame("05", "EVENT TAIL", "the cockpit's log", f"{esc}38;5;42m● LIVE{esc}0m",
                     252, w, h, tail_body[:h - 4] if tail_body else [""])

    centre = CD.look_stack([(body_h - tail_h, warp_maker), (None, tail_maker)], cw, body_h)

    # -- right: 03 USAGE, then the instruments
    usage = CD.usage_panel(rw - 4)[2:]
    ws_body = workspaces_panel(clients, workspaces, rw - 4)[1:]
    vit_body = vitals_panel(rw - 4, history, low, info, load)[1:]
    nt_body = nav_time_panel(rw - 4, timing)[1:]
    pulse_body = pulse_panel(rw - 4, hours, busy)[1:]
    tc_body = twitch_chat_panel(rw - 4, 8, now)
    tc_state = (twitch_chat_state().get("state") or "")   # the reader's word
    CHAT_TAG = (f"{esc}38;5;42m● LIVE{esc}0m" if tc_state == "live"
                else f"{esc}38;5;196m⚠ AUTH{esc}0m" if tc_state == "auth-failed"
                else f"{esc}38;5;226m◌ connecting{esc}0m" if tc_state == "connecting"
                else f"{esc}38;5;214m○ config{esc}0m" if tc_state == "config"
                else f"{esc}2m○ idle{esc}0m")
    right = CD.look_stack([
        (min(len(usage) + 4, max(10, body_h // 3)), lambda w, h: frame(
            "03", "USAGE", f"sorted by {CD.usage_sort()}" if CD.usage_sort() != "provider" else "allocation · spend",
            "", CD.LOOK_ACCENT["usage"], w, h, CD.fit_column(usage, h - 4))),
        (min(max(6, len(ws_body) + 4), max(8, body_h // 4)), lambda w, h: frame(
            "06", "WORKSPACES", "hyprctl clients", "", 252, w, h, ws_body[:h - 4])),
        (min(max(7, len(vit_body) + 4), max(9, body_h // 4)), lambda w, h: frame(
            "07", "VITALS", "no swap: watch the spike", "", CD.LOOK_ACCENT["split"], w, h, vit_body[:h - 4])),
        (None, lambda w, h: frame(
            "10", "COCKPIT-CHAT", "what the channel says", CHAT_TAG, 99, w, h, tc_body[:h - 4])),
        (None, lambda w, h: frame(
            "08", "NAV-TIME", "are the two decks in step", "", 225, w, h, nt_body[:h - 4])),
        (None, lambda w, h: frame(
            "09", "DECK PULSE", "how hard the notes flew", "", 141, w, h, pulse_body[:h - 4])),
    ], rw, body_h)

    body = [fit(left[i], lw) + fit(centre[i], cw) + fit(right[i], rw) for i in range(body_h)]
    return (nav_header(width, records, status, info, hours, load, now)
            + body
            + [f"\033[48;5;234m{fit(KEYS_LINE, width)}\033[0m"]
            + [CD.look_ticker(width, records or [], now_t)])


def build_frame(width, height, status, clients, workspaces, hours, busy,
                history, low, info=None, load=0.0, timing=None, records=None):
    if CD and width >= LOOK_MIN_COLS and height >= 30:
        return cockpit_frame(width, height, status, clients, workspaces, hours, busy,
                             history, low, info or {}, load, timing, records or [],
                             datetime.now())
    lines = [""]
    lines.append(fit(f"  {colour(81)}NAVIGATION-DECK{colour(0)} {dim(datetime.now().strftime('%H:%M:%S'))}"
                     f"  {dim('seats · meters · warp core · workspaces · vitals · nav-time · pulse')}", width))
    lines.append("")
    if width >= 150 and height >= 30:
        # the cockpit owns the middle of the screen: side panels equal, so the
        # reticle lands on the screen's centre line, not just the column's
        body = height - 5
        hud_w = max(56, min(96, width * 2 // 5))
        side_w = max(24, int(width / 2 - 4 - (hud_w - 3) / 2))
        cols = (
            seats_panel(status, side_w) + [""] + meters_panel(side_w) + [""],
            hud_panel(hud_w, body, status, hours, info or {}, load),
            workspaces_panel(clients, workspaces, side_w) + [""] + vitals_panel(side_w, history, low, info, load)
            + [""] + nav_time_panel(side_w, timing) + [""] + pulse_panel(side_w, hours, busy) + [""],
        )
        cols = [(p + [""] * body)[:body] for p in cols]
        for i in range(body):
            line = " "
            for j, col_lines in enumerate(cols):
                line += fit(col_lines[i], side_w if j != 1 else hud_w)
                if j < 2:
                    line += f" {colour(240)}│{colour(0)} "
            lines.append(fit(line, width))
    else:
        for panel in (seats_panel(status, width), meters_panel(width),
                      workspaces_panel(clients, workspaces, width),
                      vitals_panel(width, history, low, info, load),
                      hud_panel(width, 14, status, hours, info or {}, load),
                      nav_time_panel(width, timing),
                      pulse_panel(width, hours, busy)):
            lines += [fit(l, width) for l in panel[:max(1, height - 5)]]
            lines.append("")
    lines.append(f"\033[48;5;234m{fit(KEYS_LINE, width)}\033[0m")
    return lines[:height - 1]


