def wake_seat(out):
    out.write("\033[0K\033[48;5;234m wake which seat? \033[0m")
    out.flush()


def run_forever():
    import select
    import termios
    import shutil
    import tty as tty_mod

    out = sys.stdout
    tty = sys.stdin.isatty()
    # The cockpit runs on the deck's own one-second heartbeat (REFRESH_S):
    # redraws happen at most once a second, plus a redraw on a keypress. The
    # imported look's animation flags (usage_panel.running / look_crew.moving,
    # which drive the CHAT at up to 120 fps) are deliberately never consulted
    # here — the crew graph is drawn still and the stars fly per-second — so
    # the cockpit can never claim the 240 Hz loop the chat can (claude's
    # caution, 2026-11-26: this 8 GB box runs both decks at once).
    saved = termios.tcgetattr(sys.stdin) if tty else None
    if tty:
        tty_mod.setcbreak(sys.stdin)
        out.write("\033[?25l\033[2J")
    prompting = ""
    stdin_open = tty
    last, force = 0.0, True
    try:
        while True:
            now = time.time()
            if force or now - last >= REFRESH_S:
                cols, rows = shutil.get_terminal_size((120, 40))
                frame = frame_from(collect(record=True), cols, rows)
                out.write("\033[H" + "\033[0K\n".join(frame) + "\033[0K")
                if prompting:
                    out.write(f"\033[48;5;234m{fit(prompting, cols)}\033[0m")
                out.flush()
                if not prompting:
                    last, force = now, False
            if tty and stdin_open and select.select([sys.stdin], [], [], 0.25)[0]:
                ch = sys.stdin.read(1)
                if not ch:  # EOF: the input pipe closed; keep rendering, keys off
                    stdin_open = False
                    continue
                if prompting:
                    if ch in "\r\n":
                        cmd, arg = prompting.rsplit(None, 1) if " " in prompting.strip() else (prompting.strip(), "")
                        if cmd == "wake" and arg:
                            subprocess.run(["comms-deck", "wake", arg], capture_output=True)
                            out.write(f"\033[0K")
                            prompting = ""
                            force = True
                        elif cmd == "goto" and arg:
                            dispatch_workspace(arg)
                            prompting = ""
                        else:
                            prompting = ""
                    elif ch in "\x7f\x08":
                        prompting = prompting[:-1]
                    elif ch == "\x15":
                        prompting = ""
                    elif ch >= " ":
                        prompting += ch
                    force = True
                    continue
                if ch in "q\003":
                    break
                if ch == "r":
                    force = True
                    last = 0.0
                elif ch == "w":
                    prompting = "wake "
                    force = True
                elif ch == "g":
                    prompting = "goto "
                    force = True
                elif ch == "c":
                    subprocess.Popen(["comms-deck-chat"], start_new_session=True)
                elif ch == "n":
                    subprocess.Popen(["comms-deck-chat", "half"], start_new_session=True)
                elif ch == "m":
                    subprocess.Popen(["comms-deck-mail"], start_new_session=True)
                elif ch == "`":
                    dispatch_workspace("comms")     # the decks, as STOX named them
                elif ch == "2":
                    dispatch_workspace("mail")
                elif ch == "1":
                    dispatch_workspace("nav")
            time.sleep(0.1)
    finally:
        if saved is not None:
            termios.tcsetattr(sys.stdin, termios.TCSADRAIN, saved)
        out.write("\033[0m\033[2J\033[H\033[?25h")
        out.flush()


