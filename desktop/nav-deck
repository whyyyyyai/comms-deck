    seats_text = ANSI.sub("", "\n".join(seats_panel(status, 160)))
    assert "back 59m" in seats_text, seats_text  # spent countdown (1h minus a moment)

    # fit() keeps exact visible width, colours intact
    long_line = "word " * 30 + colour(78) + "tail" + "\033[0m"
    assert visible_len(fit(long_line, 40)) == 40

    # the flight keys: deck labels fly by number (claude's DESKS, #123)
    assert goto_target("comms") == "1" and goto_target("nav") == "2"
    assert goto_target("mail") == "3" and goto_target("3") == "4" and goto_target("0") == "11"
    assert goto_target("somename") == '"name:somename"'

    # vitals maths: ~3 GiB free of 8, no swap, low-sample counter
    v = ANSI.sub("", "\n".join(vitals_panel(100, history, 1, info, 0.5)))
    assert "3.0 GiB free" in v and "swap  none" in v, v

    # the warp core: lights up, stays in its box, speeds with the deck's traffic
    HUD_STATE["stars"], HUD_STATE["last"] = [], None
    hud = hud_panel(42, 20, status, hours, info, 1.25)
    assert len(hud) == 20, len(hud)
    assert all(visible_len(l) <= 42 for l in hud), [visible_len(l) for l in hud]
    hud_text = ANSI.sub("", "\n".join(hud))
    assert "WARP" in hud_text and "G26" in hud_text and "D2" in hud_text, hud_text
    slow = warp_factor(make_fake_status(now), {})
    fast = warp_factor(make_fake_status(now), {datetime.now().hour: 40, (datetime.now().hour - 1) % 24: 30}, 3.0)
    assert 1.0 <= slow < fast <= 9.9, (slow, fast)
    for _ in range(200):  # stars respawn forever and never leave the field
        HUD_STATE["last"] = None
        star_field(40, 14, 9.9)

    # the warp core's stars burn in seat colours, doled out by the context
    # split: every reporting seat gets stars, shares follow the tokens
    owners = star_seats([("devin", 300.0), ("claude", 100.0)])
    assert len(owners) == STAR_COUNT, len(owners)
    assert owners.count("devin") > owners.count("claude") > 0, owners[:20]
    assert star_seats([]) == [] and star_seats([("solo", 1.0)]).count("solo") == STAR_COUNT
    HUD_STATE["stars"], HUD_STATE["last"] = [], None
    coloured = star_field(40, 14, 5.0, cols=[208] * STAR_COUNT)
    assert any(col == 208 for _, col in coloured.values()), coloured
    plain = star_field(40, 14, 5.0)
    assert not any(col == 208 for _, col in plain.values())
    HUD_STATE["stars"], HUD_STATE["last"] = [], None

    # the cockpit dress draws with comms-deck's own look functions (claude's):
    # the import is load-bearing, so render each shared builder once here —
    # when comms-deck's functions change shape, this test catches it, not the
    # pilot's screen. Read-only; the fake record feeds the text paths.
    if CD:
        recs = [{"kind": "message", "id": "probe-1", "from": "vibe", "to": "all", "private": False,
                 "time": datetime.now().strftime("%Y-%m-%d %H:%M:%S"), "text": "probe"}]
        snap = {"seats": {}}
        probe = lambda ok, what: (_ for _ in ()).throw(AssertionError(what)) if not ok else None
        probe(CD.look_frame("01", "CREW", "", "", 208, 40, 8, ["probe"]), "look_frame")
        probe(CD.look_crew(20, 8, recs, snap, set(), {}, time.time()), "look_crew")
        probe(CD.look_activity_parts(CD.activity_panel(52)), "activity_panel")
        probe(CD.usage_panel(50), "usage_panel")
        probe(CD.look_ticker(120, recs, time.time()) is not None, "look_ticker")
        probe(CD.context_split() is not None, "context_split")
        tail_plain = ANSI.sub("", "\n".join(event_tail_panel(60, 8, now, recs)))
        assert "vibe → all" in tail_plain, tail_plain
        # nan/1e30 through the event tail must drop the line, not the frame
        # (the event-tail twin of #129's cockpit-chat stamp guard)
        hostile = recs + [
            {"kind": "message", "time": float("nan"), "from": "vibe", "text": "nan event"},
            {"kind": "message", "time": 1e30, "from": "vibe", "text": "1e30 event"},
        ]
        kept = event_tail_panel(60, 8, now, hostile)
        assert kept is not None and len(kept) >= 1, kept
        assert not re.search(r"nan event|1e30 event", ANSI.sub("", "\n".join(kept))), kept
    else:
        raise AssertionError("comms-deck did not import — the cockpit dress has no frames to draw")

    # 10 COCKPIT-CHAT: devin's daemon feeds a jsonl; the panel renders it
    # newest last, marks the broadcaster and the mods, and goes quiet politely
    fake_chat = [
        {"time": now - 60, "user": "lurker_7", "text": "what deck is this", "badges": ""},
        {"time": now - 30, "user": "some_mod", "text": "the navigation one", "badges": "moderator/1"},
        {"time": now - 5, "user": "STOX", "text": "welcome aboard", "badges": "broadcaster/1"},
    ]
    tc = twitch_chat_panel(56, 8, now, lines=fake_chat)
    tc_plain = ANSI.sub("", "\n".join(tc))
    assert "lurker_7" in tc_plain and "some_mod" in tc_plain and "STOX" in tc_plain, tc_plain
    assert tc_plain.index("lurker_7") < tc_plain.index("STOX"), "chat must read newest last"
    empty = ANSI.sub("", "\n".join(twitch_chat_panel(56, 8, now, lines=[])))
    assert "no twitch chat" in empty, empty

    # a viewer must not reach STOX's terminal (claude's review, #129): every
    # control-bearing character arrives scrubbed — ESC, OSC 52 clipboard
    # writes, C1, BEL, zero-widths — and a hostile record can't kill the frame
    evil = [
        {"time": now, "user": "\x1b]52;c;aGVsbG8=\x07e Vi EW", "text": "hi\x1b[2J\x1b]0;pwned\x07\x9b there", "badges": "broadcaster/1"},
        "not a dict",
        42,
        {"time": "giraffe", "user": "still", "text": "renders fine", "badges": ""},  # bad time falls back
        {"user": "noshoes"},                                          # no time at all
        {"time": float("nan"), "user": "nanny", "text": "nan time", "badges": ""},   # fromtimestamp ValueError
        {"time": 1e30, "user": "bigtime", "text": "1e30", "badges": ""},             # fromtimestamp OverflowError
    ]
    tx = "\n".join(twitch_chat_panel(56, 8, now, lines=evil))
    # the panel's own SGR codes are the only escapes allowed: strip them and
    # nothing control-bearing may remain (scrubbed leftovers like "]52;" or
    # "[2J" are inert visible text — no ESC, no terminator, no function)
    bare = re.sub(r"\033\[[0-9;]*m", "", tx)
    assert "\x1b" not in bare and "\x9b" not in bare and "\x07" not in bare, bare
    assert not re.search(r"\x1b\][^\x07]*\x07", tx) and "\x1b[2J" not in tx, tx
    t_plain = ANSI.sub("", tx)
    assert "e Vi" in t_plain and " there" in t_plain and "renders fine" in t_plain, t_plain
    assert scrub("\x1b]52\x07abc\u200bf") == "]52abcf"   # controls gone, letters stay

    # the owner's sight: on a full-screen terminal the reticle sits on the
    # screen's centre line — panel height is "screen rows - 5", body starts
    # three rows down on screen, so the ⊕ lands on the middle row and column.
    for width, height in ((200, 52), (168, 40), (210, 44), (150, 36)):
        frame = build_frame(width, height, status, clients, workspaces,
                            hours, busy, history, 0, info, 1.25)
        plain_lines = [ANSI.sub("", l) for l in frame]
        sights = [(y, l.find("⊕")) for y, l in enumerate(plain_lines) if "⊕" in l]
        assert sights, (width, height)
        sy, sx = sights[0]
        expect_row = 3 + (height - 5) // 2      # body starts at screen row 3; its middle is the screen's
        assert abs(sy - expect_row) <= 1, (width, height, sy, expect_row)
        assert abs(sx - width // 2) <= 2, (width, height, sx)

    # usage limits: four schema shapes the agents actually write
    with tempfile.TemporaryDirectory() as d:
        d = Path(d)
        (d / "usage").mkdir()
        (d / "usage" / "claude.json").write_text(json.dumps(
            {"time": 1, "source": "claude", "data": {"rate_limits": {
                "five_hour": {"used_percentage": 2, "resets_at": now + 100},
                "seven_day": {"used_percentage": 76}}}}))
        (d / "usage" / "alice.json").write_text(json.dumps(
            {"time": 1, "source": "grok-bot", "data": {"rate_limits": {
                "seven_day": {"used_percentage": 98.9, "resets_at": now + 99999}}}}))
        (d / "usage" / "vibe.json").write_text(json.dumps(
            {"time": 1, "source": "vibe-session", "data": {"rate_limits": {
                "monthly": {"used_percentage": 63}}}}))
        (d / "usage" / "devin.json").write_text(json.dumps(
            {"time": 1, "source": "devin-db", "data": {"context_window": {
                "context_window_size": 262144.0, "used_percentage": 29.3}}}))
        (d / "usage" / "corrupt.json").write_text("{not json")
        (d / "navigation").mkdir()
        (d / "navigation" / "memory-2000-01-01.jsonl").write_text(
            '{"t": %d, "avail": 200000000}\n{bad\n' % (now - 86400 * 100))
        (d / "navigation" / "memory-now.jsonl").write_text(
            "\n".join(json.dumps({"t": now - i * 5, "avail": 3 * 1024**3 - i})
                      for i in range(120)))
        global_data = {"usage": usage_limits}
        old = (globals()["DATA"], globals()["NAV_DIR"])
        globals()["DATA"], globals()["NAV_DIR"] = d, d / "navigation"
        try:
            flat = {s: [lab for lab, _, _ in items] for s, items in usage_limits().items()}
            assert flat == {"claude": ["5h", "wk"], "alice": ["wk"],
                            "vibe": ["mo"], "devin": ["ctx"]}, flat
            recent, low = memory_history(now, d / "navigation")
            assert len(recent) == SPARK_POINTS + 1, len(recent)  # window edge included
            assert low == 1, low                                 # the ancient 200 MB sample
            data = {"status": status, "clients": clients, "workspaces": workspaces,
                    "hours": hours, "busy": busy, "history": recent, "low": low,
                    "info": info, "load": 0.5}
            frame = frame_from(data, 120, 40)
            plain = plain_frame(frame)
            assert "wk" in plain and "ctx" in plain and "mo" in plain
        finally:
            globals()["DATA"], globals()["NAV_DIR"] = old

    # hours() bucketing reads the log's {time} fields only
    with tempfile.TemporaryDirectory() as d:
        d = Path(d)
        (d / "log.jsonl").write_text(
            '{"time": %d, "from": "claude"}\n{bad\n{"time_str": "2026-11-26 05:00:00"}\n'
            % (datetime.now().replace(hour=5, minute=1).timestamp()))
        global_old = globals()["DATA"]
        globals()["DATA"] = d
        try:
            day_start = datetime.now().replace(hour=0, minute=0, second=0, microsecond=0).timestamp()
            h = read_hours(day_start)
            assert h == {5: 1}, h
        finally:
            globals()["DATA"] = global_old

    assert visible_len(fit("x\u0301" * 0 + "abcd", 2)) == 2  # combined chars: precomposed only, fits
    # nav-time: surface freshness, note latency, stall warning
    with tempfile.TemporaryDirectory() as d:
        d = Path(d)
        (d / "log.jsonl").write_text(
            json.dumps({"time": "2026-11-26 03:00:00", "from": "claude"}) + "\n")
        (d / "activity.jsonl").write_text(json.dumps({"time": now - 4}) + "\n")
        (d / "usage").mkdir()
        (d / "usage" / "devin.json").write_text(json.dumps({"time": now - 30}))
        seat_dir = d / "inbox" / "devin"
        seat_dir.mkdir(parents=True)
        note_ts = datetime(2026, 11, 26, 3, 0, 0).timestamp()
        nf = seat_dir / "n1.json"
        nf.write_text(json.dumps({"time": "2026-11-26 03:00:00", "from": "vibe", "to": "devin"}))
        os.utime(nf, (note_ts + 2.5, note_ts + 2.5))  # landed 2.5 s after its stamp
        global_old = globals()["DATA"]
        globals()["DATA"] = d
        try:
            tm = timing_surfaces({"time": now, "seats": {"devin": {"waiting": 0}}}, now)
            surf = {s["name"]: s for s in tm["surfaces"]}
            assert surf["status"]["age"] is not None and surf["status"]["age"] < 1
            assert surf["log.jsonl"]["age"] is not None and surf["log.jsonl"]["age"] > 0
            assert "write lag" in surf["log.jsonl"]["detail"]
            assert abs(tm["latency"][0] - 2.5) < 0.2, tm["latency"]
            panel = ANSI.sub("", "\n".join(nav_time_panel(120, tm)))
            assert "nav-time" in panel and "log.jsonl" in panel and "note" in panel
            assert "⚠" not in panel  # nothing waiting: no stall warning
            stalled = dict(tm, waiting=5, oldest_waiting_s=30)
            stalled["surfaces"] = [dict(s, age=7200 if s["name"] == "log.jsonl" else s["age"])
                                  for s in tm["surfaces"]]
            assert "⚠" in ANSI.sub("", "\n".join(nav_time_panel(120, stalled)))
        finally:
            globals()["DATA"] = global_old

    # parse_event_time accepts both deck timestamp shapes
    assert parse_event_time("2026-11-26 03:00:00") == datetime(2026, 11, 26, 3, 0, 0).timestamp()
    assert parse_event_time(1700000000.0) == 1700000000.0
    assert parse_event_time("garbage") == 0.0 and parse_event_time(None) == 0.0

    print("nav-deck self-test: ok")


def main(argv):
    if "--self-test" in argv:
        self_test()
        return
    if "--seat-scan" in argv:   # debug: kitty pid -> seat, for checking the walk
        clients, _ = read_hyprland()
        seats = seat_names_by_pid()
        for c in clients:
            if (c.get("class") or "") == "kitty":
                print(c.get("pid"), "->", seats.get(str(c.get("pid"))),
                      repr((c.get("title") or "")[:30]))
        return
    if "--once" in argv:
        import shutil
        cols, rows = shutil.get_terminal_size((120, 40))
        frame = frame_from(collect(record=False), cols, rows)
        print(plain_frame(frame) if "--plain" in argv else "\n".join(frame))
        return
    run_forever()


if __name__ == "__main__":
    main(sys.argv[1:])
