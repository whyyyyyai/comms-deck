# ------------------------------------------------------- the warp core ----
# The cockpit: a first-person view of the deck. Stars stream past a
# reticle at the vanishing point, and their speed is the deck's own traffic —
# notes this hour, busy seats, load average. Each star burns in its seat's
# colour, doled out by the context split (the owner's ask, 2026-11-26).
# Seats with waiting notes plot as contacts around the reticle, at a
# bearing of their own.

STAR_SEED, STAR_COUNT = 7, 90
STAR_GLYPHS = ("·", "*", "•")          # far, mid, near
HUD_STATE = {"rng": random.Random(STAR_SEED), "stars": [], "last": None}


def warp_factor(status, hours, load=0.0):
    """How fast the starfield flies, from the deck's own traffic (1.0–9.9)."""
    seats = status.get("seats") or {}
    busy = sum(1 for d in seats.values() if d.get("state") == "busy")
    waiting = sum(d.get("waiting", 0) for d in seats.values())
    hour_now = datetime.now().hour
    recent = hours.get(hour_now, 0) + 0.7 * hours.get((hour_now - 1) % 24, 0)
    f = 1.0 + 0.06 * recent + 0.4 * busy + 0.012 * waiting + min(4.0, load)
    return max(1.0, min(9.9, f))


def star_seats(split, count=STAR_COUNT):
    """Seat names, one per star slot, shared out by the context split.

    The same largest-remainder deal as comms-deck's context pie: every
    reporting seat gets at least one star and the rest split by tokens, so
    a seat holding a quarter of the context pool burns a quarter of the
    sky. [] when nobody reports a figure — the field stays plain grey.
    """
    if not split or count <= 0:
        return []
    order = sorted(split, key=lambda s: -s[1])
    total = sum(used for _, used in order)
    if total <= 0:
        return []
    if len(order) >= count:  # more reporters than stars: take turns
        return [order[i % len(order)][0] for i in range(count)]
    raw = [(seat, count * used / total) for seat, used in order]
    counts = {seat: max(1, int(share)) for seat, share in raw}
    spare = count - sum(counts.values())
    for seat, share in sorted(raw, key=lambda r: (-(r[1] - int(r[1])), r[0])):
        if spare <= 0:
            break
        counts[seat] += 1
        spare -= 1
    while spare < 0:  # the one-star minimum overshot: take from the biggest
        big = max(counts, key=counts.get)
        if counts[big] <= 1:
            break
        counts[big] -= 1
        spare += 1
    owners = [seat for seat, _ in order for _ in range(counts[seat])]
    if len(owners) < count:
        owners = (owners * (count // len(owners) + 1))[:count]
    return owners[:count]


def star_field(width, height, warp, cx=None, cy=None, cols=None):
    """The star layer as (char, colour) cells: stars stream from the
    vanishing point.

    cx/cy: where the vanishing point (the reticle) sits in the field; the
    sight steers the whole stream, so the caller aims it at the centre of
    the screen. cols: optional 256-colour code per star slot (star_seats'
    palette) — each seat's stars burn in its own colour; without it the
    field is the plain grey it always was.
    """
    rng, state = HUD_STATE["rng"], HUD_STATE
    now = time.time()
    dt = 0.5 if state["last"] is None else min(2.0, now - state["last"])
    state["last"] = now
    stars = state["stars"]
    while len(stars) < STAR_COUNT:
        stars.append([rng.uniform(0, 6.283), rng.uniform(0.05, 1.0), rng.random()])
    for s in stars:
        s[1] += dt * warp * (0.04 + s[2] * 0.16)
        if s[1] > 1.0:
            s[0], s[1], s[2] = rng.uniform(0, 6.283), rng.uniform(0.03, 0.1), rng.random()
    cx = (width - 1) / 2 if cx is None else cx
    cy = (height - 1) / 2 if cy is None else cy
    # one chosen centre for stars and sight alike, rounding half up so a
    # dead-centre view keeps its promise on even widths
    cx, cy = int((width - 1) / 2 + 0.5), int(cy + 0.5) if isinstance(cy, float) else int(cy)
    grid = {}
    rx, ry = max(2, width // 2 - 2), max(1, height // 2 - 1)
    for i, (ang, dist, depth) in enumerate(stars):
        seat_col = cols[i] if cols and i < len(cols) else 0

        def put(d, ch, col):
            x, y = int(round(cx + math.cos(ang) * d * rx)), int(round(cy + math.sin(ang) * d * ry))
            if 0 <= x < width and 0 <= y < height and (x, y) not in grid:
                grid[(x, y)] = (ch, col)
        trail = warp > 5.0 and dist > 0.5
        glyph = STAR_GLYPHS[0 if dist < 0.3 else (1 if dist < 0.7 else 2)]
        put(dist, glyph, seat_col or (250 if glyph == "·" else 252))
        if trail:
            put(dist * 0.9, "·", seat_col or 250)
            put(dist * 1.08, "·", seat_col or 250)
    # the reticle: a bull's own sight at the vanishing point
    for ox, ch in ((-2, "─"), (-1, "╼"), (1, "╾"), (2, "─")):
        grid[(cx + ox, cy)] = grid.get((cx + ox, cy), (ch, 252))
    for oy, ch in ((-1, "┊"), (1, "┊")):
        grid[(cx, cy + oy)] = (ch, 250)
    grid[(cx, cy)] = ("⊕", 78)
    return grid


def warp_canvas(fit_w, field_w, field_h, status, hours, info, load, cy, split=None):
    """The moving cockpit as strings: field rows (the starfield, the sight
    already plotted at row `cy`, contacts on the ring) plus the two readout
    rows. Shared by the 04 frame (the look) and the narrow hud_panel.
    `split` is comms-deck's context_split(); None asks for it (cached)."""
    rows = []
    warp = warp_factor(status, hours, load)
    seats = status.get("seats") or {}
    total, avail = info.get("MemTotal", 0), info.get("MemAvailable", 0)
    shield = avail / total if total else 1.0
    mem_gib = avail / 1024**3
    if split is None:
        split = CD.context_split() if CD else []
    palette = {seat: (CD.colour(seat) if CD else 245) for seat, _ in split}
    owners = star_seats(split)
    cols = [palette.get(seat, 245) for seat in owners] or None
    grid = star_field(field_w, field_h, warp, cy=cy, cols=cols)
    # contacts: a seat with something on its plate is a blip on the ring,
    # in that seat's colour like everywhere else on the deck
    live = [(n, d) for n, d in sorted(seats.items(), key=lambda kv: kv[1].get("rank", [9, 99]))
            if d.get("state") == "busy" or d.get("waiting", 0)]
    cx = (field_w - 1) / 2
    ring_x, ring_y = min(14, field_w // 2 - 4), min(3, field_h // 3)
    for i, (name, d) in enumerate(live[:12]):
        ang = 6.283 * i / max(4, len(live))
        x = int(round(cx + math.cos(ang) * ring_x))
        y = int(round(cy + math.sin(ang) * ring_y * 1.4))
        if 0 <= x < field_w and 0 <= y < field_h:
            grid[(x, y)] = (name[0].upper(), CD.colour(name) if CD else 226)
    for y in range(field_h):
        line = ""
        col_now = None
        for x in range(field_w):
            cell = grid.get((x, y))
            ch, col = cell if cell is not None else (" ", 0)
            if col != col_now:
                line += f"\033[0m\033[38;5;{col}m" if col else "\033[0m"
                col_now = col
            line += ch
        rows.append(fit(line + "\033[0m", fit_w))
    rows.append(f"  {colour(81)}WARP {warp:3.1f}{colour(0)} {bar(warp / 9.9, 8, 81)}"
                f"  {colour(78)}SHLD{colour(0)} {bar(shield, 8, 78 if shield > 0.3 else 214)}"
                f" {mem_gib:.1f}G")
    contacts = " ".join(f"{name[0].upper()}{min(999, d.get('waiting', 0))}"
                        for name, d in live[:6]) or "clear"
    alert_now = shield < 0.15 and int(time.time()) % 2 == 0
    flag = f" {colour(196)}⚠ LOW SHIELD{colour(0)}" if alert_now else ""
    rows.append(fit(f"  {dim('CONTACTS')} {colour(226)}{contacts}{colour(0)}{flag}", fit_w))
    return rows


def hud_panel(width, height, status, hours, info, load):
    """The cockpit, narrow-dress: title, then the shared canvas."""
    field_h = max(5, height - 3)
    rows = [panel_title("warp core", "(the deck from the pilot's seat)", width)]
    rows += warp_canvas(width, width - 2, field_h, status, hours, info, load,
                        (height - 3) // 2)
    rows = [fit(r, width) for r in rows]
    return (rows + [""] * height)[:max(5, height)]


