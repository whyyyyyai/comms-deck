def collect(record=False):
    status = read_status()
    clients, workspaces = read_hyprland()
    info = read_meminfo()
    load = read_loadavg()
    now = time.time()
    if record:
        record_memory(info, now)
    history, low = memory_history(now)
    day_start = datetime.now().replace(hour=0, minute=0, second=0, microsecond=0).timestamp()
    return {"status": status, "clients": clients, "workspaces": workspaces,
            "hours": read_hours(day_start), "busy": busy_minutes(day_start),
            "history": history, "low": low, "info": info, "load": load,
            "timing": timing_surfaces(status, now),
            "records": load_records() if CD else []}


def frame_from(data, width, height):
    return build_frame(width, height, data["status"], data["clients"],
                       data["workspaces"], data["hours"], data["busy"],
                       data["history"], data["low"], data["info"], data["load"],
                       data.get("timing"), data.get("records"))


def plain_frame(frame):
    return "\n".join(ANSI.sub("", l).rstrip() for l in frame)


