def nav_header(cols, records, status, info, hours, load, now):
    """The cockpit strip, three rows, in the chat look's own style: badge,
    title, and the live cells on the right (clock, warp, crew, memory)."""
    esc = "\033["
    badge = f"{esc}48;5;81;38;5;232;1m  NA    {esc}0m"
    badge2 = f"{esc}48;5;81;38;5;232m  flight deck  {esc}0m"
    machine = (status.get("machine") or "this box").upper()
    seats = status.get("seats") or {}
    working = sum(1 for d in seats.values() if d.get("state") == "busy")
    waiting = sum(d.get("waiting", 0) for d in seats.values())
    total, avail = info.get("MemTotal", 0), info.get("MemAvailable", 0)
    warp = warp_factor(status, hours, load)
    cells = [f"{now.strftime('%H:%M:%S')}", f"WARP {warp:3.1f}",
             f"{working}/{len(seats)} WORKING", f"{waiting} WAITING",
             f"{avail / 1024**3:.1f} G FREE" if total else "MEM ?"]
    left = [
        f"{badge}  {esc}1;38;5;255mNAVIGATION-DECK{esc}0m  {esc}2mFLIGHT DECK · LIVE ON {machine}{esc}0m",
        f"{badge2}  {esc}2mcrew · warp core · tail · usage · vitals{esc}0m",
        ""]
