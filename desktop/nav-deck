DESKS = {"comms": 1, "nav": 2, "mail": 3,
         **{str(k % 10): k + 1 for k in range(3, 11)}}


def goto_target(label):
    """The Lua workspace value for `goto <label>`."""
    if label in DESKS:
        return str(DESKS[label])
    return '"name:' + label.replace("\\", "").replace('"', "") + '"'
SPARK_POINTS = 100        # 5 s apart: the last ~8 minutes
MEM_FLOOR_MIB = 512       # below this the vitals row shouts

STATE_STYLE = {
    "ready": 78, "idle": 78,
    "busy": 226,
    "stuck": 214,
    "away": 245, "spent": 245, "not set up": 240, "hidden": 240,
    "no chat yet": 240, "chat not open": 240, "draft in box": 181,
}

ANSI = re.compile(r"\033\[[0-9;?]*[ -/]*[@-~]")
BLOCKS = " ▁▂▃▄▅▆▇█"


# --------------------------------------------------- comms-deck link ------
# The deck look is comms-deck's own (claude, the owner, 2026-11-25), and the
# owner asked for exactly that dress (2026-11-26): numbered panels, corner
# brackets, the strip and the ticker. The deck imports the installed script
# as a module — read-only, main-guarded — so the two decks can never drift
# apart in style, and 01/02 draw with comms-deck's own builders. If the
# import fails the deck falls back to its own plain panels (look=None).

def load_comms_deck():
    """The installed comms-deck script as a module, or None."""
    import importlib.util
    from importlib.machinery import SourceFileLoader
    seen = []
    for cand in (Path(__file__).resolve().parent.parent / "comms-deck",
                 HOME / ".local" / "bin" / "comms-deck"):
        if not cand.exists() or str(cand) in seen:
            continue
        seen.append(str(cand))
        try:
            loader = SourceFileLoader("comms_deck", str(cand))
            spec = importlib.util.spec_from_loader("comms_deck", loader)
            mod = importlib.util.module_from_spec(spec)
            loader.exec_module(mod)
            return mod
        except Exception:
            continue
    return None


CD = load_comms_deck()
LOOK_MIN_COLS = CD.LOOK_MIN_COLS if CD else 0


def load_records(tail_bytes=256 << 10):
    """The newest records of log.jsonl, read from the tail only: the chart
    room chat loads the whole file once; a screen redrawing every second
    just needs the recent end (the crew graph keeps its own 30 minutes)."""
    path = DATA / "log.jsonl"
    try:
        size = path.stat().st_size
        with open(path, "rb") as f:
            f.seek(max(0, size - tail_bytes))
            blob = f.read().decode(errors="replace")
    except OSError:
        return []
    out = []
    for line in blob.splitlines():
        try:
            out.append(json.loads(line))
        except ValueError:
            continue
    return out[-400:]


STREAM_PROCS = ("obs", "ffmpeg")
_stream_cache = {"t": 0.0, "found": ()}


def stream_state():
    """Streaming processes on this box (obs, ffmpeg), cached 5 s — the
    VITALS panel's stream row reads this."""
    now = time.time()
    if now - _stream_cache["t"] < 5:
        return _stream_cache["found"]
    found = []
    try:
        for p in Path("/proc").glob("[0-9]*"):
            try:
                cmd = (p / "cmdline").read_bytes().split(b"\0")
            except OSError:
                continue
            if cmd and cmd[0] and os.path.basename(cmd[0].decode(errors="replace")) in STREAM_PROCS:
                found.append(os.path.basename(cmd[0].decode(errors="replace")))
                if len(found) >= 4:
                    break
    except OSError:
        pass
    _stream_cache.update(t=now, found=tuple(sorted(found)))
    return _stream_cache["found"]


def visible_len(s):
    return len(ANSI.sub("", s))


def fit(s, width):
    """Truncate or pad to exactly `width` visible columns, keeping colours."""
    out, used, i = [], 0, 0
    while i < len(s) and used < width:
        m = ANSI.match(s, i)
        if m:
            out.append(m.group(0))
            i = m.end()
            continue
        out.append(s[i])
        used += 1
        i += 1
    if used < width:
        out.append(" " * (width - used))
    return "".join(out)


def colour(n):
    return f"\033[38;5;{n}m"


def dim(s):
    return f"\033[2m{s}\033[0m"


def bar(fraction, width, col_on=78):
    fill = max(0, min(width, round(max(0.0, min(1.0, fraction)) * width)))
    col = colour(col_on) if 0 < fill < width else ("\033[2m" if not fill else colour(col_on))
    return col + "█" * fill + f"\033[38;5;238m" + "░" * (width - fill) + "\033[0m"


def spark(values, col=250):
    if not values:
        return ""
    lo, hi = min(values), max(values)
    out = [colour(col)]
    for v in values:
        if hi <= lo:
            idx = len(BLOCKS) // 2
        else:
            idx = int((v - lo) / (hi - lo) * (len(BLOCKS) - 1) + 0.5)
        out.append(BLOCKS[idx])
    out.append("\033[0m")
    return "".join(out)


def human_dur(seconds):
    seconds = max(0, int(seconds))
    if seconds < 60:
        return f"{seconds}s"
    if seconds < 3600:
        return f"{seconds // 60}m"
    if seconds < 86400:
        return f"{seconds // 3600}h{(seconds % 3600) // 60:02d}m"
    return f"{seconds // 86400}d{(seconds % 86400) // 3600}h"


# ------------------------------------------------------- deck data reads ---

def read_status():
    """The deck's seats, through its own CLI. Empty dict when it is down."""
    try:
        r = subprocess.run(["comms-deck", "status", "--json"], capture_output=True,
                           text=True, timeout=5)
        return json.loads(r.stdout or "{}")
    except (OSError, ValueError, subprocess.SubprocessError):
        return {}


def read_hyprland():
    try:
        clients = subprocess.run(["hyprctl", "clients", "-j"], capture_output=True,
                                 text=True, timeout=3)
        work = subprocess.run(["hyprctl", "workspaces", "-j"], capture_output=True,
                              text=True, timeout=3)
        return json.loads(clients.stdout or "[]"), json.loads(work.stdout or "[]")
    except (ValueError, subprocess.SubprocessError, OSError):
        return [], []


def jsonl_records(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            for line in f:
                try:
                    yield json.loads(line)
                except ValueError:
                    continue
    except OSError:
        return


def read_hours(day_start):
    """Notes received today per hour-bucket, from the deck's note log.

    log.jsonl stores `time` as the string "YYYY-MM-DD HH:MM:SS" (the notes'
    own display format); other deck logs use epoch floats, so accept both.
    """
    day = datetime.now().strftime("%Y-%m-%d")
    hours = {}
    for r in jsonl_records(DATA / "log.jsonl"):
        t = r.get("time")
        try:
            if isinstance(t, str):
                if not t.startswith(day):
                    continue
                h = int(t[11:13])
            elif t and t >= day_start:
                h = datetime.fromtimestamp(t).hour
            else:
                continue
        except (OSError, OverflowError, ValueError, IndexError):
            continue
        hours[h] = hours.get(h, 0) + 1
    return hours


def busy_minutes(day_start):
    """Seconds spent busy per seat today, from the deck's activity log."""
    busy, last = {}, {}
    for r in jsonl_records(DATA / "activity.jsonl"):
        t = r.get("time") or 0
        seat, state = r.get("seat"), r.get("state")
        if not t or not seat or t < day_start:
            continue
        if last.get(seat) and last[seat][1] == "busy":
            busy[seat] = busy.get(seat, 0) + (min(t, time.time()) - last[seat][0])
        if state == "busy":
            last[seat] = (t, state)
        else:
            last.pop(seat, None)
    for seat, (t0, _) in list(last.items()):
        busy[seat] = busy.get(seat, 0) + max(0, time.time() - t0)
    return busy


def usage_limits():
    """Per seat: [(label, fraction, reset_ts)] from the saved statusline JSONs.

    The log entries share one shape problem the deck's owners never promised
    to keep stable: different agents write different limits. This reads
    what is there and falls back gracefully.
    """
    out = {}
    for rec in jsonl_records(DATA / "usage" / "index.jsonl") or []:
        pass  # no index file today; left here so the format gets a home
    try:
        for p in sorted((DATA / "usage").glob("*.json")):
            try:
                rec = json.loads(p.read_text())
            except ValueError:
                continue
            data = rec.get("data") or {}
            items = []
            rl = data.get("rate_limits") or {}
            for key, label in (("monthly", "mo"), ("five_hour", "5h"), ("seven_day", "wk")):
                if key in rl and isinstance(rl[key], dict) and "used_percentage" in rl[key]:
                    items.append((label, max(0.0, min(1.0, rl[key]["used_percentage"] / 100)),
                                  rl[key].get("resets_at")))
            ctx = data.get("context_window")
            if ctx and ctx.get("context_window_size"):
                items.append(("ctx", max(0.0, min(1.0, (ctx.get("used_percentage") or 0) / 100)),
                              None))
            if items:
                out[p.stem] = items
    except OSError:
        pass
    return out


# ----------------------------------------------------------------- memory ---

def read_meminfo():
    info = {}
    try:
        with open("/proc/meminfo") as f:
            for line in f:
                k, _, rest = line.partition(":")
                info[k] = int(rest.strip().split()[0]) * 1024
    except (OSError, ValueError, IndexError):
        pass
    return info


def read_loadavg():
    try:
        with open("/proc/loadavg") as f:
            return float(f.read().split()[0])
    except (OSError, ValueError, IndexError):
        return 0.0


def record_memory(info, now):
    """Append one sample per 5 s bucket. Several nav-decks write the same
    file; readers collapse the buckets, so duplication only costs bytes."""
    if not info or now - record_memory.last < 5:
        return
    record_memory.last = now
    try:
        NAV_DIR.mkdir(parents=True, exist_ok=True)
        name = NAV_DIR / f"memory-{datetime.now():%Y-%m-%d}.jsonl"
        with open(name, "a") as f:
            f.write(json.dumps({"t": now, "avail": info.get("MemAvailable", 0)}) + "\n")
        for old in NAV_DIR.glob("memory-*.jsonl"):
            day = old.stem[len("memory-"):]
            if day < (datetime.now() - timedelta(days=1)).strftime("%Y-%m-%d"):
                old.unlink()
    except OSError:
        pass


record_memory.last = 0.0


def memory_history(now, day_dir=NAV_DIR):
    """(samples from the last window, low-memory moments in the last two days)."""
    recent, low = [], 0
    floor = MEM_FLOOR_MIB * 1024 * 1024
    try:
        for name in sorted(day_dir.glob("memory-*.jsonl")):
            for r in jsonl_records(name):
                t, v = r.get("t", 0), r.get("avail", 0)
                if not v:
                    continue
                if v < floor:
                    low += 1
                if t >= now - SPARK_POINTS * 5:
                    recent.append((t, v))
    except OSError:
        pass
    return recent, low


# ---------------------------------------------------------------- panels ---

def panel_title(title, subtitle, width):
    return f"{colour(81)}{OWNER_NAME.lower()} › {title}{colour(241)}  {dim(subtitle)}"


def seats_panel(status, width):
    rows = [panel_title("seats", "(the deck's own ready order)", width)]
    seats = status.get("seats") or {}
    if not seats:
        return rows + [dim("  comms-deck is not answering — is the service up?")]
    fix = width - 46
    for name, d in sorted(seats.items(), key=lambda kv: kv[1].get("rank", [9, 99])):
        shown = d.get("shown") or d.get("state") or "?"
        col = STATE_STYLE.get(shown, 245)
        waiting = d.get("waiting", 0)
        load_col = 78 if waiting < 8 else (226 if waiting < 40 else 214)
        note = ""
        spent = d.get("spent_until")
        if shown == "spent" or (spent and spent > time.time()):
            col = STATE_STYLE["spent"]
            note = f"back {human_dur((spent or 0) - time.time())}"
        elif d.get("state") == "busy":
            note = f"since {human_dur(d.get('since_s', 0))}"
        elif waiting:
            note = f"oldest {human_dur(d.get('oldest_waiting_s', 0))}"
        rows.append(fit(f"  {colour(col)}{name:<7}{colour(0)}   ", 11) + " "
                    + bar(min(1.0, waiting / 30), 16, load_col)
                    + f" {colour(load_col)}{waiting:>3}{colour(245)} waiting{colour(0)}"
                    + f" {dim(human_dur(d.get('since_s', 0)))} {dim(note)}")
    return rows


def meters_panel(width, limits=None):
    rows = [panel_title("meters", "(what the plans say they have left)", width)]
    limits = usage_limits() if limits is None else limits
    if not limits:
        return rows + [dim("  no usage files yet — statuslines fill them as agents run")]
    for seat in sorted(limits):
        parts = []
        for label, frac, reset in limits[seat][:3]:
            col = 78 if frac < 0.8 else (226 if frac < 0.95 else 214)
            parts.append(f"{dim(f'{label}:')}{bar(frac, 10, col)}"
                         + (f" {dim('reset ' + human_dur(reset - time.time()))}" if reset else ""))
        rows.append(fit(f"  {colour(81)}{seat:<8}{colour(0)}", 11) + "   ".join(parts))
    return rows


def workspaces_panel(clients, workspaces, width, own_class="nav-deck"):
    rows = [panel_title("workspaces", "(hyprctl clients)", width)]
    try:
        named = sorted(workspaces, key=lambda w: w.get("id", 999))
    except (TypeError, AttributeError):
        named = []
    by_ws = {}
    for c in clients:
        by_ws.setdefault((c.get("workspace") or {}).get("name", "?"), []).append(c)
    seen = set()
    for w in named:
        name = w.get("name") or str(w.get("id"))
        seen.add(name)
        rows.append(ws_row(name, by_ws.get(name, []), width, own_class))
    for name in sorted(set(by_ws) - seen):
        rows.append(ws_row(name, by_ws[name], width, own_class))
    return rows


def ws_row(name, cls_list, width, own_class):
    chips = []
    for c in cls_list:
        label = window_label(c)
        shown = label[:15] + "…" if len(label) > 16 else label
        col = 81 if label == own_class else 250
        chip = f"{colour(col)}[{shown}]{colour(0)}"
        if c.get("fullscreen"):
            chip += f"{colour(81)}▣{colour(0)}"
        chips.append(chip)
    return (fit(f"  {colour(245)}{name:<14}{colour(0)}", 16)
            + (" ".join(chips) if chips else dim("(empty)")))[:width]


# A kitty window only says "kitty"; its seat is the process running inside
# it (claude, grok, vibe-rs, …). Scanning /proc once per frame per kitty is
# cheap and gives the map real names instead of 12 identical chips.
SEAT_PROCESS = {"claude": "claude", "grok": "grok", "vibe-rs": "vibe",
                "agy": "gravity", "codex": "codex", "devin": "devin"}
_seat_cache = {"t": 0.0, "map": {}}


def seat_names_by_pid():
    """pid -> seat name for kitty hosts, refreshed at most every 5 s. One
    pass over /proc: each process's cmdline basename + ppid; then each
    kitty's subtree is walked a few levels (kitty -> bash -> the agent)."""
    now = time.time()
    if now - _seat_cache["t"] < 5:
        return _seat_cache["map"]
    procs, kids = {}, {}
    for p in Path("/proc").glob("[0-9]*"):
        try:
            cmd = (p / "cmdline").read_bytes().rstrip(b"\0").decode(errors="replace")
            stat = (p / "stat").read_text()
            ppid = int(stat[stat.rindex(")") + 2:].split()[1])
        except (OSError, ValueError, IndexError):
            continue
        if not cmd:
            continue
        base = os.path.basename(cmd.split("\0")[0])
        procs[p.name] = base
        kids.setdefault(str(ppid), []).append(p.name)
    found = {}
    for pid, base in procs.items():
        if base != "kitty":
            continue
        frontier = [pid]
        for _ in range(4):     # kitty -> bash -> agent -> (a wrapper at most)
            nxt = []
            for cur in frontier:
                for child in kids.get(cur, ()):
                    lbl = procs.get(child, "")
                    if lbl in SEAT_PROCESS:
                        found[pid] = SEAT_PROCESS[lbl]
                        break
                    if lbl in ("bash", "sh", "zsh", "login", "fish", "systemd",
                               "kitten"):   # kitten wraps real seats too (devin's window)
                        nxt.append(child)
                if pid in found:
                    break
            if pid in found:
                break
            frontier = nxt
    _seat_cache.update(t=now, map=found)
    return found


def window_label(c):
    cls = (c.get("class") or "?").strip()
    if cls == "kitty":
        seat = seat_names_by_pid().get(c.get("pid"))
        if seat:
            return seat
        title = (c.get("title") or "").strip()
        if title and title != "~":
            return title[:16]
    return cls


def vitals_panel(width, history, low, info=None, load=0.0):
    if info is None:
        info = read_meminfo()
    rows = [panel_title("vitals", "(this box has no swap: watch the spike)", width)]
    total, avail = info.get("MemTotal", 0), info.get("MemAvailable", 0)
    if not total or not avail:
        return rows + [dim("  /proc/meminfo unreadable")]
    col = 214 if avail < (MEM_FLOOR_MIB * 2) * 1024 * 1024 else 78
    free_gib = avail / 1024**3
    rows.append(f"  memfree {bar(1 - avail / total, 26, col)}"
                + f" {colour(col)}{free_gib:>5.1f} GiB free{colour(0)}"
                + f" {dim('/ ' + f'{total / 1024**3:.0f}' + ' GiB')}")
    vals = [v / 1024**3 for _, v in sorted(history)[-SPARK_POINTS:]]
    if vals:
        span = int((sorted(history)[-1][0] - sorted(history)[0][0]) // 60)
        rows.append("  " + spark(vals, col=250 if len(vals) >= SPARK_POINTS else 245)
                    + f" {dim(f'{min(vals):.1f}–{max(vals):.1f} GiB, 5 s samples, {span} min')}")
    swap_total, swap_free = info.get("SwapTotal", 0), info.get("SwapFree", 0)
    if not swap_total:
        rows.append(f"  swap  {colour(214)}none — the next squeeze has nowhere to go{colour(0)}")
    else:
        rows.append(f"  swap  {bar((swap_total - swap_free) / max(1, swap_total), 10)}")
    lows = f"{colour(214)}{low}{colour(0)}" if low else f"{colour(78)}0{colour(0)}"
    rows.append(f"  {dim('load')} {load:.2f}   {dim('below-512-MiB samples in two days:')} {lows}")
    streams = stream_state()
    if streams:
        rows.append(f"  {dim('stream')} {colour(78)}{' · '.join(streams)}{colour(0)} {dim('up')}")
    else:
        rows.append(f"  {dim('stream')} {colour(240)}idle{colour(0)} {dim('(obs/ffmpeg on the box)')}")
    return rows


def pulse_panel(width, hours, busy):
    rows = [panel_title("deck pulse", "(how hard the notes flew today)", width)]
    if not hours:
        rows.append(dim("   no notes yet today"))
    else:
        peak = max(hours.values())
        w = max(6, min(width - 20, 36))
        cells = "".join(
            (BLOCKS[int(hours.get(h, 0) / peak * (len(BLOCKS) - 1) + 0.5)]
             if hours.get(h, 0) else ("┬" if h % 6 == 0 else "·"))
            for h in range(24))
        axis = ("0a    6a    12p   6p   " + " " * 24)
        rows.append(f"  {colour(81)}{cells[:w]}{colour(0)} {dim(str(sum(hours.values())) + ' notes, 0a to now')}")
        rows.append(f"  {dim(axis[:w])}")
    if busy:
        top = sorted(busy.items(), key=lambda kv: -kv[1])[:4]
        rows.append("  " + dim("busy today: ") + ",  ".join(
            f"{colour(81)}{s}{colour(0)}{dim(' ' + human_dur(t))}" for s, t in top))
    return rows


# ------------------------------------------------------- event tail -------
# The cockpit's log (the owner's "more live log"): seat state flips from
# activity.jsonl and the newest notes from log.jsonl, newest last. Devin's
# nav-time reads the same files for ages; this is the events themselves.

def activity_events(limit=40):
    """The newest seat-state records of activity.jsonl (tail read only)."""
    path = DATA / "activity.jsonl"
    out = []
    try:
        with open(path, "rb") as f:
            f.seek(0, os.SEEK_END)
            f.seek(max(0, f.tell() - (64 << 10)))
            for line in f.read().decode(errors="replace").splitlines():
                try:
                    out.append(json.loads(line))
                except ValueError:
                    continue
    except OSError:
        pass
    return out[-limit:]


def event_tail_panel(width, height, now, records=None, live=None):
    """05 EVENT TAIL's body: 'HH:MM  event' lines, newest last. Both decks'
    public logs feed it: what seats are doing (activity.jsonl) and what they
    said (log.jsonl, text redacted like the chat's ticker)."""
    rows = []
    evs = []
    for rec in (records or [])[-60:]:
        if rec.get("kind") != "message":
            continue
        t = CD.record_stamp(rec) if CD else 0.0
        to = "all" if rec.get("to") == "all" else str(rec.get("to", "?"))
        text = "(private)" if rec.get("private") else CD.redact(" ".join(str(rec.get("text", "")).split()))
        evs.append((t, f"{colour(CD.colour(rec.get('from', 'vibe'))) if CD else ''}{rec.get('from', '?')}"
                       f"{colour(0) if CD else ''} → {to}: {text}"))
    for act in activity_events(height):
        t = float(act.get("time") or 0)
        doing = " ".join(str(act.get("doing", "")).split())
        suffix = f"{colour(241)}{dim('· ' + doing[:max(0, width - 22)])}" if doing else ""
        evs.append((t, f"{colour(CD.colour(act.get('seat', '?'))) if CD else ''}{act.get('seat', '?')}"
                       f"{colour(0) if CD else ''} {act.get('state', '?')} {suffix}{colour(0) if CD else ''}"))
    # a nan or boundless time is truthy but undrawable: isfinite drops it
    # before the sort (nan poisons sorting, inf floats to the end), and the
    # stamp guard keeps a surviving impossible time from taking the frame
    # down — the same lesson #129's cockpit chat learned about fromtimestamp.
    evs = [(t, s) for t, s in evs if t and math.isfinite(t)]
    evs.sort(key=lambda e: e[0])
    for t, s in evs[-max(1, height - 1):]:
        try:
            stamp = datetime.fromtimestamp(t).strftime("%H:%M")
        except (TypeError, ValueError, OverflowError, OSError):
            continue
        rows.append(fit(f"  {dim(stamp)}  {s}", width))
    if not rows:
        rows.append(dim("  the decks are quiet"))
    return rows


# --------------------------------------------------- twitch chat ----------
# The world comms in: devin's twitch-chat daemon (#128) appends what the
# channel says to twitch-chat.jsonl; this panel is the deck's window on it,
# newest last like the event tail. Reading a file is all the piping either
# side needs — that's the whole comms-deck contract.

TWITCH_CHAT = DATA / "twitch-chat.jsonl"
TWITCH_STATUS = TWITCH_CHAT.with_suffix(".status.json")

# Viewer text goes raw into STOX's kitty, so nothing control-bearing gets
# through: strip every C0/C1/DEL/escape-class character from whatever a
# channel says (claude's review on #129 — a viewer must not be able to
# repaint the screen, retitle the window, or write the clipboard via OSC 52).
BAD_CHARS = re.compile(r"[\x00-\x1f\x7f\x80-\x9f\u00ad\u200b-\u200f\u2028\u2029\u202a-\u202e\u2060-\u206f\ufeff\ufff9-\ufffb]")

def scrub(s):
    return BAD_CHARS.sub("", str(s))

def twitch_chat_state():
    """What the reader says about itself (devin's #128 status file):
    live / connecting / auth-failed / config, else an empty dict."""
    try:
        return json.loads(TWITCH_STATUS.read_text())
    except (OSError, ValueError):
        return {}

def twitch_chat_panel(width, height, now, lines=None):
    """10 COCKPIT-CHAT's body: 'HH:MM  user: what was said', newest last.
    `lines` are pre-parsed records (the self-test's fake feed), else the
    file is tail-read (32 KiB is minutes of chat)."""
    if lines is None:
        rows_txt = []
        try:
            with open(TWITCH_CHAT, "rb") as f:
                f.seek(0, os.SEEK_END)
                f.seek(max(0, f.tell() - (32 << 10)))
                rows_txt = f.read().decode(errors="replace").splitlines()
        except OSError:
            pass
        lines = []
        for line in rows_txt:
            try:
                rec = json.loads(line)
            except ValueError:
                continue
            lines.append(rec)
    recs = [r for r in lines if isinstance(r, dict)]
    out = []
    for rec in recs[-max(1, height - 1):]:
        user = scrub(rec.get("user", "?"))[:32] or "?"
        text = scrub(" ".join(str(rec.get("text", "")).split()))[:max(8, width - 14)]
        badges = scrub(rec.get("badges", ""))
        chip = ("◆" if "broadcaster" in badges else
                "＋" if "moderator" in badges else " ")
        ch = 208 if "broadcaster" in badges else (86 if "moderator" in badges else 99)
        # a bad time must never take down the frame: fall back to now.
        # fromtimestamp raises ValueError on nan and OverflowError on inf
        # and huge magnitudes, which plain float() parsing lets through.
        try:
            stamp = datetime.fromtimestamp(
                float(rec.get("time"))).strftime("%H:%M")
        except (TypeError, ValueError, OverflowError, OSError):
            stamp = datetime.fromtimestamp(now).strftime("%H:%M")
        out.append(fit(f"  {dim(stamp)} {colour(ch)}{chip} {user}{colour(0)} {text}", width))
    if not out:
        return [dim("  no twitch chat — twitch-chat idle or the channel is quiet")]
    return out


# ------------------------------------------------------------- nav-time ---
# Are the two decks in step? Every surface is asked "when did you last
# speak?" — the status CLI (fresh each call), the two jsonl logs (their
# last record's own timestamp, plus the file's write lag), the usage
# statuslines, and the inboxes. Note latency is measured where a note
# lands: inbox file mtime minus the note's own timestamp, so a sender
# whose clock runs fast or slow shows up as skew, not silence.


def parse_event_time(t):
    """A deck timestamp as epoch: 'YYYY-MM-DD HH:MM:SS' string or epoch number."""
    if isinstance(t, str):
        try:
            return datetime.strptime(t, "%Y-%m-%d %H:%M:%S").timestamp()
        except ValueError:
            return 0.0
    return float(t) if isinstance(t, (int, float)) else 0.0


def tail_json(path, size=1 << 16):
    """The last JSON record in a .jsonl file, read from the tail only."""
    try:
        with open(path, "rb") as f:
            f.seek(0, os.SEEK_END)
            end = f.tell()
            f.seek(max(0, end - size))
            lines = f.read().decode(errors="replace").splitlines()
        for line in reversed(lines):
            line = line.strip()
            if not line:
                continue
            try:
                return json.loads(line)
            except ValueError:
                continue
    except OSError:
        pass
    return None


def mtime(path):
    try:
        return os.path.getmtime(path)
    except OSError:
        return 0.0


def timing_surfaces(status=None, now=None):
    """Freshness and latency for every deck surface the panels read.

    surfaces: [{name, ts, age, detail}] — ts is the newest event's own
    timestamp (epoch), age = now - ts (None when the surface never spoke).
    latency: note->inbox lags in seconds for the newest inbox files
    (negative means the sender's clock runs ahead of this machine's).
    """
    now = now or time.time()
    out = {"now": now, "surfaces": [], "latency": [],
           "waiting": 0, "oldest_waiting_s": 0}

    def add(name, ts, detail=""):
        out["surfaces"].append({"name": name, "ts": ts or 0.0,
                                "age": (now - ts) if ts else None,
                                "detail": detail})

    status = status or {}
    st = status.get("time")
    add("status", st, "cli round-trip")
    for seat, d in (status.get("seats") or {}).items():
        out["waiting"] += d.get("waiting", 0)
        out["oldest_waiting_s"] = max(out["oldest_waiting_s"],
                                     d.get("oldest_waiting_s") or 0)

    for label, path in (("log.jsonl", DATA / "log.jsonl"),
                        ("activity.jsonl", DATA / "activity.jsonl")):
        rec = tail_json(path)
        ts = parse_event_time(rec.get("time")) if rec else 0.0
        lag = mtime(path) - ts if ts else None
        add(label, ts, f"write lag {human_dur(max(0.0, lag))}" if lag is not None else "")

    newest_usage = 0.0
    try:
        for p in (DATA / "usage").glob("*.json"):
            try:
                newest_usage = max(newest_usage, float(json.loads(p.read_text()).get("time") or 0))
            except (ValueError, OSError):
                continue
    except OSError:
        pass
    add("usage/*.json", newest_usage, "newest statusline")

    inbox = DATA / "inbox"
    files = []
    try:
        for seat_dir in inbox.iterdir():
            if seat_dir.is_dir():
                files += list(seat_dir.glob("*.json"))
    except OSError:
        pass
    stamped = []
    for f in files:
        try:
            stamped.append((f.stat().st_mtime, f))
        except OSError:
            continue
    stamped.sort(key=lambda x: -x[0])
    newest_inbox = stamped[0][0] if stamped else 0.0
    add("inbox", newest_inbox, "newest note landed")
    for mt, f in stamped[:12]:
        try:
            note = json.loads(f.read_text())
        except (ValueError, OSError):
            continue
        ts = parse_event_time(note.get("time"))
        if ts:
            out["latency"].append(mt - ts)
    return out


def nav_time_panel(width, timing):
    """The NAV-TIME panel: per-surface freshness, note latency, stall warn."""
    rows = [panel_title("nav-time", "(are the two decks in step)", width)]
    if not timing:
        return rows + [dim("  no timing data")]
    for s in timing["surfaces"]:
        age = s["age"]
        if age is None:
            shown, col = "never", 245
        elif age < 60:
            shown, col = human_dur(age), 78
        elif age < 600:
            shown, col = human_dur(age), 226
        else:
            shown, col = human_dur(age), 214
        rows.append(fit(f"  {colour(245)}{s['name']:<14}{colour(0)}"
                        f"{colour(col)}{shown:>7}{colour(0)}  {dim(s['detail'])}", width))
    lat = sorted(timing.get("latency") or [])
    if lat:
        med, mx, mn = lat[len(lat) // 2], lat[-1], lat[0]
        lcol = 78 if mx < 5 else (226 if mx < 30 else 214)
        skew = f"  {colour(214)}min {human_dur(mn)}{colour(0)}" if mn < -1 else ""
        rows.append(fit(f"  {dim('note→inbox'.ljust(14))}{colour(lcol)}"
                        f"med {human_dur(med)}  max {human_dur(mx)}{colour(0)}{skew}"
                        f"  {dim('last ' + str(len(lat)) + ' notes')}", width))
    waiting, oldest = timing.get("waiting", 0), timing.get("oldest_waiting_s", 0)
    log_age = next((s["age"] for s in timing["surfaces"] if s["name"] == "log.jsonl"), None)
    if waiting and log_age is not None and log_age > max(60, oldest):
        rows.append(fit(f"  {colour(214)}⚠ {waiting} notes waiting but the log has been "
                        f"silent {human_dur(log_age)}{colour(0)}", width))
    return rows


